import pickle
import numpy as np
import tensorflow as tf
from tensorflow.keras import layers, models

with open('inputs/inputs/X.pkl', 'rb') as f:
    X = pickle.load(f)
with open('inputs/inputs/y.pkl', 'rb') as f:
    y = pickle.load(f)
with open('inputs/inputs/X_test.pkl', 'rb') as f:
    X_test = pickle.load(f)

X = X.astype('float32') / 255.0
X_test = X_test.astype('float32') / 255.0

model = models.Sequential([
    layers.Conv2D(32, (3,3), activation='relu', input_shape=(80,80,3)),
    layers.MaxPooling2D((2,2)),
    layers.Conv2D(64, (3,3), activation='relu'),
    layers.MaxPooling2D((2,2)),
    layers.Conv2D(64, (3,3), activation='relu'),
    layers.Flatten(),
    layers.Dense(64, activation='relu'),
    layers.Dense(1, activation='sigmoid'),
])

model.compile(optimizer='adam', loss='binary_crossentropy', metrics=['accuracy'])
model.fit(X, y, epochs=15, batch_size=32, validation_split=0.1)

# Evaluate on test set
preds = (model.predict(X_test) > 0.5).astype(int).flatten()
print('Test predictions distribution:', np.bincount(preds))

model.save('model.h5')
print('saved model.h5')
