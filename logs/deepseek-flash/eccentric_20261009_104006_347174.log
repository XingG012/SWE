# Smart's attack for anomalous curves (order = p)
def smart_attack(P, G, p):
    E = P.curve()
    Eqp = EllipticCurve(Qp(p, 2), [ZZ(t) + randint(0,p)*p for t in E.a_invariants()])
    
    P_Qps = Eqp.lift_x(ZZ(P.xy()[0]), all=True)
    for P_Qp in P_Qps:
        if GF(p)(P_Qp.xy()[1]) == P.xy()[1]:
            break
    
    G_Qps = Eqp.lift_x(ZZ(G.xy()[0]), all=True)
    for G_Qp in G_Qps:
        if GF(p)(G_Qp.xy()[1]) == G.xy()[1]:
            break
    
    P_Qp = P_Qp * (p // p)  # placeholder
    # Actually compute p*P and p*G
    p_times_P = p * P_Qp
    p_times_G = p * G_Qp
    
    # The x-coordinates are in p*Z_p, divide by p
    x_P = ZZ(p_times_P[0]) / p
    x_G = ZZ(p_times_G[0]) / p
    
    # d = x_P / x_G mod p
    d = ZZ(x_P / x_G) % p
    return d

d = smart_attack(P, G, p)
print("d =", d)
