import base64
from rfc8032 import point_add, point_compress, point_decompress, point_equal, point_mul, G

KEYLEN = 12
q = 2**252 + 27742317777372353535851937790883648493

negate = lambda p: (p[0], -p[1], -p[2], p[3])

ctxt = open('ciphertext','rb').read().strip()
points = [point_decompress(base64.b64decode(p)) for p in ctxt.split(b';')]
print("num points:", len(points))

table = {}
for v in range(-255, 256):
    table[point_compress(point_mul(v % q, G))] = v

def diff_val(i, j):
    d = point_add(points[i], negate(points[j]))
    return table.get(point_compress(d))

n = len(points)
x = [None]*n

# anchor flag prefix
for i,ch in enumerate("flag{"):
    x[i] = ord(ch)

# propagate using diffs
changed = True
while changed:
    changed = False
    for i in range(n-KEYLEN):
        d = diff_val(i, i+KEYLEN)
        if d is None:
            continue
        if x[i] is not None and x[i+KEYLEN] is None:
            x[i+KEYLEN] = x[i] - d
            changed = True
        if x[i+KEYLEN] is not None and x[i] is None:
            x[i] = x[i+KEYLEN] + d
            changed = True

# For unanchored residues, brute force base and score by english-likeness
import string
english = set(string.ascii_letters + string.digits + " {}_.,!?'\n-:;()")
for r in range(KEYLEN):
    idxs = list(range(r, n, KEYLEN))
    if x[idxs[0]] is not None:
        continue
    # cumulative diffs
    cum = [0]
    ok = True
    for a in range(len(idxs)-1):
        d = diff_val(idxs[a], idxs[a+1])
        if d is None:
            ok = False
            break
        cum.append(cum[-1] + d)
    if not ok:
        continue
    best = None
    best_score = -1
    for base in range(32, 127):
        vals = [base + c for c in cum]
        if not all(32 <= v <= 126 for v in vals):
            continue
        score = sum(1 for v in vals if chr(v) in english)
        if score > best_score:
            best_score = score
            best = (base, vals)
    if best:
        base, vals = best
        for i, v in zip(idxs, vals):
            x[i] = v

print("recovered:", sum(1 for v in x if v is not None), "of", n)
s = ''.join(chr(v) if v is not None else '?' for v in x)
print(s)
end_of_edit

