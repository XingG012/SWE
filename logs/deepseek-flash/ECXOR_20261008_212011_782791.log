import re
common_words = ['the','and','to','of','a','in','that','it','was','she','he','you','her','his','as','with','for','had','not','but','at','by','this','have','from','or','one','had','all','were','we','when','your','can','said','there','use','each','which','do','how','their','if','will','up','other','about','out','many','then','them','these','so','some','her','would','make','like','into','him','time','has','look','two','more','write','go','see','number','no','way','could','people','my','than','first','water','been','call','who','oil','its','now','find','long','down','day','did','get','come','made','may','part']

def score_text(s):
    sc = 0
    for w in common_words:
        sc += s.count(w)
    return sc

# Brute force key byte for each residue 5-11
for r in range(5, KEYLEN):
    idxs = list(range(r, n, KEYLEN))
    cum = [0]
    ok = True
    for a in range(len(idxs)-1):
        d = diff_val(idxs[a], idxs[a+1])
        if d is None:
            ok = False
            break
        cum.append(cum[-1] + d)
    if not ok:
        print(f"residue {r}: diff failed")
        continue
    best = None
    best_score = -1
    for base in range(0, 256):
        vals = [base + c for c in cum]
        if not all(v in (9,10,13) or 32 <= v <= 126 for v in vals):
            continue
        # build full text with this candidate
        tmp = list(x)
        for i, v in zip(idxs, vals):
            tmp[i] = v
        s = ''.join(chr(v) if v is not None else '?' for v in tmp)
        sc = score_text(s)
        if sc > best_score:
            best_score = sc
            best = (base, vals)
    if best:
        base, vals = best
        for i, v in zip(idxs, vals):
            x[i] = v
        print(f"residue {r}: base={base} score={best_score}")
