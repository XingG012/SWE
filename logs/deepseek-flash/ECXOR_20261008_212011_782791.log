import base64
from rfc8032 import point_add, point_compress, point_decompress, point_equal, point_mul, G

KEYLEN = 12

def catch(f, g, ty=Exception):
    try:
        return f()
    except ty as e:
        return g(e)

topoint = lambda n: point_mul(n, G)
frompoint = lambda p: catch(lambda: filter(lambda x: point_equal(p,topoint(x)), range(256)).__next__(), lambda _: None, StopIteration)

negate = lambda p: (p[0], -p[1], -p[2], p[3])

ctxt = open('ciphertext','rb').read().strip()
points = [point_decompress(base64.b64decode(p)) for p in ctxt.split(b';')]
print("num points:", len(points))

# For positions i and i+12 (same key byte), diff = (ord(p_i) - ord(p_{i+12})) * G
# brute force the difference in range -255..255
def diff_val(i, j):
    # returns ord(p_i) - ord(p_j)
    d = point_add(points[i], negate(points[j]))
    for v in range(-255, 256):
        if point_equal(d, topoint(v % (2**252 + 27742317777372353535851937790883648493))):
            return v
    return None

# Build constraints: p_i - p_{i+12} = diff
# We know flag starts with 'flag{'
# Let's collect all diffs
diffs = {}
for i in range(len(points)-KEYLEN):
    diffs[i] = diff_val(i, i+KEYLEN)

# Now solve. Let x_i = ord(p_i). x_i - x_{i+12} = diffs[i]
# We know x_0='f', x_1='l', x_2='a', x_3='g', x_4='{'
# Propagate
n = len(points)
x = [None]*n
x[0]=ord('f'); x[1]=ord('l'); x[2]=ord('a'); x[3]=ord('g'); x[4]=ord('{')
# propagate forward using diffs
changed = True
while changed:
    changed = False
    for i in range(n-KEYLEN):
        if x[i] is not None and x[i+KEYLEN] is None and diffs[i] is not None:
            x[i+KEYLEN] = x[i] - diffs[i]
            changed = True
        if x[i+KEYLEN] is not None and x[i] is None and diffs[i] is not None:
            x[i] = x[i+KEYLEN] + diffs[i]
            changed = True

print("recovered:", sum(1 for v in x if v is not None), "of", n)
s = ''.join(chr(v) if v is not None else '?' for v in x)
print(s)
end_of_edit

