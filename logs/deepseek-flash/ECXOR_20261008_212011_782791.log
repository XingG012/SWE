import base64
from rfc8032 import point_add, point_compress, point_decompress, point_equal, point_mul, G

KEYLEN = 12
q = 2**252 + 27742317777372353535851937790883648493

negate = lambda p: (p[0], -p[1], -p[2], p[3])

ctxt = open('ciphertext','rb').read().strip()
points = [point_decompress(base64.b64decode(p)) for p in ctxt.split(b';')]
print("num points:", len(points))

# Precompute table of v*G for v in -255..255
table = {}
for v in range(-255, 256):
    table[point_compress(point_mul(v % q, G))] = v

def diff_val(i, j):
    d = point_add(points[i], negate(points[j]))
    return table.get(point_compress(d))

diffs = {}
for i in range(len(points)-KEYLEN):
    diffs[i] = diff_val(i, i+KEYLEN)

n = len(points)
x = [None]*n
x[0]=ord('f'); x[1]=ord('l'); x[2]=ord('a'); x[3]=ord('g'); x[4]=ord('{')
changed = True
while changed:
    changed = False
    for i in range(n-KEYLEN):
        if x[i] is not None and x[i+KEYLEN] is None and diffs[i] is not None:
            x[i+KEYLEN] = x[i] - diffs[i]
            changed = True
        if x[i+KEYLEN] is not None and x[i] is None and diffs[i] is not None:
            x[i] = x[i+KEYLEN] + diffs[i]
            changed = True

print("recovered:", sum(1 for v in x if v is not None), "of", n)
s = ''.join(chr(v) if v is not None else '?' for v in x)
print(s)
