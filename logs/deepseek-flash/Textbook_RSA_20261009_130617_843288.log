import requests
from Crypto.Util.number import bytes_to_long, long_to_bytes
from param import n, e, c

c_int = bytes_to_long(c)
url = "http://crypto.csaw.io/rsa/decrypt"

for factor in [2, 3, 5, 7]:
    c_prime = (c_int * pow(factor, e, n)) % n
    req = requests.post(url=url, data=long_to_bytes(c_prime))
    m_prime = bytes_to_long(req.content)
    m = (m_prime * pow(factor, -1, n)) % n
    b = long_to_bytes(m)
    print(f"factor={factor}: {b}")
end_of_edit

