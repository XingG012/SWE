import requests
from Crypto.Util.number import bytes_to_long, long_to_bytes
from param import n, e

url = "http://crypto.csaw.io/rsa/decrypt"

def dec_raw(data):
    req = requests.post(url=url, data=data)
    return bytes_to_long(req.content)

# Try interpreting input as decimal string
for s in [b"2", b"3", b"6", b"100"]:
    d = dec_raw(s)
    val = int(s)
    print(f"input {s!r} (val {val}): pow(dec, e, n) == val? {pow(d, e, n) == val}")
