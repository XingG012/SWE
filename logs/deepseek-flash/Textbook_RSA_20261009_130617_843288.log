import requests
from Crypto.Util.number import bytes_to_long, long_to_bytes
from param import n, e, c

c_int = bytes_to_long(c)

# Multiplicative attack: send c * 2^e mod n, get m*2 mod n
factor = 2
c_prime = (c_int * pow(factor, e, n)) % n

url = "http://crypto.csaw.io/rsa/decrypt"
data = long_to_bytes(c_prime)
req = requests.post(url=url, data=data)
print("Status:", req.status_code)
m_prime = bytes_to_long(req.content)
print("m_prime:", m_prime)

# m = m_prime * inverse(factor) mod n
m = (m_prime * pow(factor, -1, n)) % n
print("m:", m)
print("Flag:", long_to_bytes(m))
end_of_edit

