edit 1:1
import requests
from Crypto.Util.number import bytes_to_long, long_to_bytes
from param import n, e

url = "http://crypto.csaw.io/rsa/decrypt"

def dec(x):
    req = requests.post(url=url, data=long_to_bytes(x))
    return bytes_to_long(req.content)

for x in [2, 3, 6, 100]:
    d = dec(x)
    print(f"x={x}: pow(dec(x), e, n) == x? {pow(d, e, n) == x}")
end_of_edit

