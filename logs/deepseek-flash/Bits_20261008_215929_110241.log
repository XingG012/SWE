edit 1:1
from pwn import *
import re, json

context.log_level = 'error'

r = remote("crypto.chal.csaw.io", 5000)
data = r.recvuntil(b"nbits = ")
line = r.recvline().decode().strip()
nbits = int(line)
flag_line = r.recvline().decode().strip()

full = data.decode()
N = int(re.search(r"N = (\d+)", full).group(1))
G = int(re.search(r"G = (\d+)", full).group(1))
publ = int(re.search(r"publ = (\d+)", full).group(1))
alice = int(re.search(r"alice = (\d+)", full).group(1))
flag_enc = re.search(r"FLAG = ([0-9a-f]+)", flag_line).group(1)

b = nbits - 123
print("bit position b =", b)

# Query G^(2^b * j) for j = 1, 2, 3, ...
# If 2^b * j < ORDER, bit b of (2^b * j) = j mod 2
results = []
for j in range(1, 30):
    k = (2**b) * j
    inp = pow(G, k, N)
    r.sendline(str(inp).encode())
    resp = r.recvline().decode().strip()
    bit = int(resp)
    results.append((j, bit))
    print(f"j={j}, bit={bit}, expected_if_small={j%2}")

r.close()
end_of_edit

