39:              + I hear there's a mythical oracle at Delphi. +\n\
40:              +++++++++++++++++++++++++++++++++++++++++++++++\n");
41:    let mut sysrng = SystemRandom;
42:    let mut rnd = RandState::new_custom(&mut sysrng);
43:    let d = Integer::from(&*ORDER).random_below(&mut rnd);
44:    let publ = Integer::from(&*G).pow_mod(&d, &*N).unwrap();
45:    let nbits = ORDER.significant_bits();
46:    let alice = Integer::from(&*G).pow_mod(&Integer::from(&*ORDER).random_below(&mut rnd), &*N).unwrap();
47:    println!("N = {}\nG = {}\npubl = {}\nalice = {}\nnbits = {}",
48:        *N,
49:        *G,
50:        publ,
51:        alice,
52:        nbits);
53:    encrypt_flag(alice.pow_mod(&d, &N).unwrap());
