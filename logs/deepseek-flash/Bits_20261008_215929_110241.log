edit 1:1
from pwn import *
import re, json

context.log_level = 'error'

r = remote("crypto.chal.csaw.io", 5000)
data = r.recvuntil(b"nbits = ")
line = r.recvline().decode().strip()
nbits = int(line)
flag_line = r.recvline().decode().strip()

full = data.decode()
N = int(re.search(r"N = (\d+)", full).group(1))
G = int(re.search(r"G = (\d+)", full).group(1))
publ = int(re.search(r"publ = (\d+)", full).group(1))
alice = int(re.search(r"alice = (\d+)", full).group(1))
flag_enc = re.search(r"FLAG = ([0-9a-f]+)", flag_line).group(1)

print("nbits =", nbits)
print("N =", N)
print("G =", G)
print("publ =", publ)
print("alice =", alice)
print("FLAG =", flag_enc)

# We need ORDER. Let's try to figure it out.
# N = p*q, p ≡ q ≡ 3 mod 4. G = 2. ORDER is the order of G mod N.
# Let's just query the oracle to gather samples.

# Query publ * G^k for various k, get bit 883 of (d+k) mod ORDER
b = nbits - 123
print("bit position b =", b)

samples = []
num_samples = 200
for i in range(num_samples):
    k = i + 1  # simple choice
    inp = (publ * pow(G, k, N)) % N
    r.sendline(str(inp).encode())
    resp = r.recvline().decode().strip()
    bit = int(resp)
    samples.append((k, bit))

with open("samples.json", "w") as f:
    json.dump({"N": N, "G": G, "publ": publ, "alice": alice, "nbits": nbits, "flag": flag_enc, "samples": samples}, f)

print("Gathered", len(samples), "samples")
print("First few:", samples[:5])
r.close()
end_of_edit

