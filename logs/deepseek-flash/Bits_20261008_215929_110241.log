from pwn import *
import re

context.log_level = 'error'

r = remote("crypto.chal.csaw.io", 5000)
data = r.recvuntil(b"nbits = ")
line = r.recvline().decode().strip()
nbits = int(line)
flag_line = r.recvline().decode().strip()

full = data.decode()
N = int(re.search(r"N = (\d+)", full).group(1))
G = int(re.search(r"G = (\d+)", full).group(1))

b = nbits - 123
print("bit position b =", b)

def query(k):
    inp = pow(G, k, N)
    r.sendline(str(inp).encode())
    resp = r.recvline().decode().strip()
    return int(resp)

# We know 2^1005 < ORDER <= 2^1006
# Binary search on j where 2^883 * j crosses ORDER
# lo: 2^883 * lo < ORDER, hi: 2^883 * hi >= ORDER
lo = 2**122
hi = 2**123

# Verify
print("lo check:", query(2**b * lo), "expected", lo % 2)
print("hi check:", query(2**b * hi), "expected", hi % 2)

# Binary search
while hi - lo > 1:
    mid = (lo + hi) // 2
    bit = query(2**b * mid)
    if bit == mid % 2:
        lo = mid
    else:
        hi = mid
    print(f"lo={lo}, hi={hi}")

print("ORDER is between", 2**b * lo, "and", 2**b * hi)
r.close()
end_of_edit

