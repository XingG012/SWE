24:fn encrypt_flag(shared: Integer) {
25:    let mut hasher = Sha256::new();
26:    hasher.update(shared.to_string());
27:    let key = hasher.finalize();
28:    let mut cipher = Aes256Ctr::from_block_cipher(
29:        Aes256::new_from_slice(&key.as_slice()).unwrap(),
30:        &GenericArray::clone_from_slice(&[0; 16])
31:        );
32:    let mut flag = FLAG.clone();
33:    cipher.apply_keystream(&mut flag);
34:    println!("FLAG = {}", flag.iter().map(|c| format!("{:02x}", c)).collect::<String>());
35:}
