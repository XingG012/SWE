edit 1:1
from pwn import *
import re

context.log_level = 'error'

r = remote("crypto.chal.csaw.io", 5000)
data = r.recvuntil(b"nbits = ")
line = r.recvline().decode().strip()
nbits = int(line)
flag_line = r.recvline().decode().strip()

full = data.decode()
N = int(re.search(r"N = (\d+)", full).group(1))
G = int(re.search(r"G = (\d+)", full).group(1))

b = nbits - 123
print("bit position b =", b)

def query(k):
    inp = pow(G, k, N)
    r.sendline(str(inp).encode())
    resp = r.recvline().decode().strip()
    return int(resp)

j0 = 9806111366188489219489389158082950968
base = 2**b * j0

# Binary search for first m in [0, 2^(b+1)) where bit becomes 1
# bit(m) = 0 for m < r + 2^b, 1 for m in [r+2^b, r+2^(b+1))
# where r = ORDER - base
lo = 0
hi = 2**(b+1)  # exclusive upper bound, bit should be 1 at hi-1? let's check

# Verify endpoints
print("bit at m=0:", query(base + 0))
print("bit at m=2^(b+1)-1:", query(base + 2**(b+1) - 1))

# Binary search: find smallest m with bit=1
while hi - lo > 1:
    mid = (lo + hi) // 2
    bit = query(base + mid)
    if bit == 1:
        hi = mid
    else:
        lo = mid

m_first = hi
r_val = m_first - 2**b
ORDER = base + r_val
print("m_first =", m_first)
print("r =", r_val)
print("ORDER =", ORDER)

with open("order.txt", "w") as f:
    f.write(str(ORDER))
r.close()
end_of_edit

