from pwn import *
import re, time

context.log_level = 'error'

r = remote("crypto.chal.csaw.io", 5000)
data = r.recvuntil(b"nbits = ")
line = r.recvline().decode().strip()
nbits = int(line)
flag_line = r.recvline().decode().strip()

full = data.decode()
N = int(re.search(r"N = (\d+)", full).group(1))
G = int(re.search(r"G = (\d+)", full).group(1))

def query(k):
    inp = pow(G, k, N)
    r.sendline(str(inp).encode())
    resp = r.recvline().decode().strip()
    return int(resp)

t0 = time.time()
for i in range(50):
    query(i)
t1 = time.time()
print("50 queries took", t1-t0, "seconds")
print("per query:", (t1-t0)/50)
r.close()
end_of_edit

