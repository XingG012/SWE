from pwn import *
import re

context.log_level = 'error'

r = remote("crypto.chal.csaw.io", 5000)
data = r.recvuntil(b"nbits = ")
line = r.recvline().decode().strip()
nbits = int(line)
flag_line = r.recvline().decode().strip()

full = data.decode()
N = int(re.search(r"N = (\d+)", full).group(1))
G = int(re.search(r"G = (\d+)", full).group(1))

b = nbits - 123
print("bit position b =", b)
print("N bits =", N.bit_length())

# Probe with j = 2^t for t = 0..140
# If 2^b * j < ORDER, bit b = j mod 2 = 0 for j even
# We want to find where it breaks
for t in range(0, 145):
    j = 2**t
    k = (2**b) * j
    inp = pow(G, k, N)
    r.sendline(str(inp).encode())
    resp = r.recvline().decode().strip()
    bit = int(resp)
    # if 2^b * j < ORDER, bit should be 0 (j even)
    print(f"t={t}, j=2^{t}, bit={bit}")

r.close()
end_of_edit

