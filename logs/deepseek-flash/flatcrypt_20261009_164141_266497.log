    results = {}
    for c in alphabet:
        f = guess + c + "x"*200
        results[c] = get_len(r, f)
    best = min(results, key=results.get)
    print(i, "best:", best, "len:", results[best], "all:", results)
    guess += best
    print("guess so far:", guess)
