from pwn import *
import string, os, random

context.log_level = 'error'

def get_len(f):
    r = remote("crypto.chal.csaw.io", 8040)
    r.recvuntil("Encrypting service")
    r.sendline(f.encode())
    data = r.recvuntil("Encrypting service")
    r.close()
    lines = data.split(b'\n')
    return lines[1][-1]

random.seed(42)
pad = ''.join(random.choice(string.ascii_letters + string.digits) for _ in range(100))

print("not_the_flag:", get_len("not_the_flag" + pad))
for _ in range(5):
    s = ''.join(random.choice(string.ascii_lowercase + "_") for _ in range(12))
    print("rand:", s, get_len(s + pad))
end_of_edit

