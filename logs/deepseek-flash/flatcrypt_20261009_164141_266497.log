from pwn import *
import string, os, random

context.log_level = 'error'

def get_len(f):
    r = remote("crypto.chal.csaw.io", 8040)
    r.recvuntil("Encrypting service")
    r.sendline(f.encode())
    data = r.recvall(timeout=2)
    r.close()
    # data ends with chr(len) + '\n'
    # find the last newline
    data = data.rstrip(b'\n')
    return data[-1]

print("match:", get_len("not_the_flag" + "x"*100))
print("nomatch:", get_len("zzzzzzzzzzzz" + "x"*100))
print("a"*20, get_len("a"*20))
print("a"*100, get_len("a"*100))
end_of_edit

