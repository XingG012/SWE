from pwn import *
import string, os, random

context.log_level = 'error'

def get_data(f):
    r = remote("crypto.chal.csaw.io", 8040)
    r.recvuntil("Encrypting service")
    r.sendline(f.encode())
    data = r.recvall(timeout=2)
    r.close()
    return data

for n in [20, 30, 50, 100, 200, 500, 1000]:
    d = get_data("a"*n)
    print(n, "a's: len=", len(d), "last=", d[-1:], "hex=", d.hex())
