from pwn import *
import string

context.log_level = 'error'

def get_len(f):
    r = remote("crypto.chal.csaw.io", 8040)
    r.recvuntil("Encrypting service")
    r.sendline(f.encode())
    data = r.recvline()
    r.close()
    # last char is chr(len)
    return ord(data[-1:])

# Test: send a long string of 'a's vs a string that might match
print("all a's:", get_len("a"*40))
print("all b's:", get_len("b"*40))
print("all z's:", get_len("z"*40))
end_of_edit

