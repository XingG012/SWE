from pwn import *
import string, os, random

context.log_level = 'error'

def get_len(r, f):
    r.sendline(f.encode())
    data = r.recvuntil("Encrypting service")
    lines = data.split(b'\n')
    return lines[1][-1]

r = remote("crypto.chal.csaw.io", 8040)
r.recvuntil("Encrypting service")

# Test known key vs random with large random padding
random.seed(42)
pad = ''.join(random.choice(string.ascii_letters + string.digits) for _ in range(300))

candidates = ["not_the_flag", "not_the_flag_", "flag", "problem_key", "PROBLEM_KEY"]
for cand in candidates:
    print(cand, get_len(r, cand + pad))

# random strings of same length
for _ in range(3):
    s = ''.join(random.choice(string.ascii_lowercase + "_") for _ in range(12))
    print("rand:", s, get_len(r, s + pad))
