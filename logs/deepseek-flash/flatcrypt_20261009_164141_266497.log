from pwn import *
import string, os, random

context.log_level = 'error'

def get_len(f):
    r = remote("crypto.chal.csaw.io", 8040)
    r.recvuntil("Encrypting service")
    r.sendline(f.encode())
    data = r.recvline()
    r.close()
    # data is repr(enc) + chr(len) + '\n'
    # strip trailing newline, last char is the length
    return ord(data[-2:-1])

# Test guess matching
