from pwn import *
import string, os

context.log_level = 'error'

def get_len(f):
    r = remote("crypto.chal.csaw.io", 8040)
    r.recvuntil("Encrypting service")
    r.sendline(f.encode())
    data = r.recvline()
    r.close()
    return ord(data[-1:])

# Test: does matching prefix reduce length?
# Send random 20-char strings vs strings starting with a guess
import random
random.seed(1)
for trial in range(5):
    s = ''.join(random.choice(string.ascii_lowercase) for _ in range(20))
    print("random:", s, get_len(s))

# Now try with a repeated pattern that might match
print("not_the_flag" + "a"*8, get_len("not_the_flag" + "a"*8))
print("aaaaaaaaaaaaaaaaaaaa", get_len("a"*20))
end_of_edit

