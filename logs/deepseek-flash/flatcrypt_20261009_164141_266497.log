from pwn import *
import string, os, random

context.log_level = 'error'

def get_len(f):
    r = remote("crypto.chal.csaw.io", 8040)
    r.recvuntil("Encrypting service")
    r.sendline(f.encode())
    data = r.recvall(timeout=2)
    r.close()
    lines = data.split(b'\n')
    return lines[1][-1]

# Test single char guesses with padding
for c in "abcdefghijklmnopqrstuvwxyz_":
    print(c, get_len(c + "x"*100))
