import struct

with open('/tmp/data.bin','rb') as f:
    raw = f.read()
N = len(raw)//4
data = list(struct.unpack('<%di' % N, raw))
print("N =", N)

target = b"flag{ph3w...u finaLly g0t it! jump into cell wHen U g3t t0 the next cha11}"
print("target len =", len(target))

init_bytes = [
0x3f,0x42,0x38,0x5f,0x7a,0x57,0x71,0x74,0x66,0x44,0x47,0x32,0x3d,0x16,99,0x1f,
0x12,0x1a,0x12,0x5c,0x2a,3,100,0x1c,0x15,0x40,1,0x3f,0x4c,2,0x3a,0x30,
0x1d,0x7c,0x69,0x4d,0x19,0x5f,0x48,0x5e,0x20,3,0x17,9,0x52,0x6b,0x4c,0x65,
0x6f,0x48,6,0x5b,0x2b,0x28,0x40,0x2e,0x4e,0x0b,0x16,0x31,0x30,0x56,0x21,0x6e,
0x2d,0x30,0x4b,0x1c,0x10,4,0x3f,0x18,0x41,0x34]
print("init len =", len(init_bytes))

# Step 3 forward simulation: given arr before step3, compute arr after step3
def step3_forward(arr):
    arr = list(arr)
    for i in range(5, len(arr)):
        for k in range(300):
            bVar2 = arr[i]
            iVar5 = (k << 5) & 0xFFFFFFFF
            cVar3 = arr[i-5]
            arr[i] = ((1 if cVar3 == ord('n') else 0) ^ bVar2 ^ (iVar5 & 0xFF)) & 0xFF
    return arr

# Step 3 inverse: we know arr after step3 (target). We need arr before step3.
# For i<5: arr_before[i] = target[i]
# For i>=5: arr_before[i-5] is already known (finalized). So we can compute the
# transformation applied to arr[i] and invert it.
def step3_inverse(target):
    arr = list(target)
    for i in range(5, len(arr)):
        # arr[i-5] is the final value (already computed)
        cVar3 = arr[i-5]
        # apply the 300 iterations to arr[i] to get final; we need to invert.
        # forward: x_{k+1} = const ^ x_k ^ ((k<<5)&0xFF), where const = (cVar3=='n')
        # This is invertible: x_k = const ^ x_{k+1} ^ ((k<<5)&0xFF)
        # We know final x_300 = target[i]. Invert from k=299 down to 0.
        const = 1 if cVar3 == ord('n') else 0
        x = target[i]
        for k in range(299, -1, -1):
            x = (const ^ x ^ ((k << 5) & 0xFF)) & 0xFF
        arr[i] = x
    return arr

arr2 = step3_inverse(target)  # arr before step3 == arr after step2
print("arr2 =", bytes(arr2))

# Step 2 inverse: arr2[i] = data[(input[i] + data[(i*10+0xc)%N])%N] ^ arr1[i]
# where arr1[i] = input[i] ^ init_bytes[i]
# So arr2[i] = data[(input[i] + data[(i*10+12)%N])%N] ^ input[i] ^ init_bytes[i]
# Let d1 = data[(i*10+12)%N]. We need to find input[i] in 0..255 such that:
#   data[(input[i] + d1) % N] ^ input[i] ^ init_bytes[i] == arr2[i]
# Brute force input[i] over 0..255.

input_bytes = []
for i in range(len(target)):
    d1 = data[(i*10 + 12) % N]
    found = None
    for c in range(256):
        val = (data[(c + d1) % N] & 0xFF) ^ c ^ init_bytes[i]
        if val == arr2[i]:
            found = c
            break
    if found is None:
        print("NOT FOUND at", i)
        found = 0
    input_bytes.append(found)

print("input =", bytes(input_bytes))
print("input str =", bytes(input_bytes).decode('latin1'))
