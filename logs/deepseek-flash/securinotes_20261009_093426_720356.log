import json
import random
import string
from ddp import DDP

d = DDP("ws://web.chal.csaw.io:5000/websocket")

# Register a user
username = "user_" + "".join(random.choices(string.ascii_lowercase, k=8))
password = "pass1234"
print("Registering", username)
res = d.call("createUser", [{"username": username, "password": password}])
print("createUser:", res)

# Login
res = d.call("login", [{"user": {"username": username}, "password": {"digest": None, "algorithm": "sha-256"}}])
print("login:", res)

# Test notes.count with empty filter
res = d.call("notes.count", [{}])
print("count {}:", res)

# Test with a filter
res = d.call("notes.count", [{"body": {"$regex": ".*"}}])
print("count regex:", res)

d.close()
end_of_edit

