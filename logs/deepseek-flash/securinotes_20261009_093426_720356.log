import json
from ddp import DDP

d = DDP("ws://web.chal.csaw.io:5000/websocket")

def count(filter):
    res = d.call("notes.count", [filter])
    if res and "result" in res:
        return res["result"]
    return None

# Total
print("total:", count({}))

# Notes with body containing "password"
print("body password:", count({"body": {"$regex": "password", "$options": "i"}}))

# Notes with body containing "flag"
print("body flag:", count({"body": {"$regex": "flag", "$options": "i"}}))

# Notes with body containing "terry"
print("body terry:", count({"body": {"$regex": "terry", "$options": "i"}}))

# Notes with body containing "pass"
print("body pass:", count({"body": {"$regex": "pass", "$options": "i"}}))

# Notes with body containing "secret"
print("body secret:", count({"body": {"$regex": "secret", "$options": "i"}}))

# Notes with body containing "csaw"
print("body csaw:", count({"body": {"$regex": "csaw", "$options": "i"}}))

d.close()
