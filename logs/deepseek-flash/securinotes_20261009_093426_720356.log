import json
import websocket
import threading
import time

URL = "ws://web.chal.csaw.io:5000/websocket"

class DDP:
    def __init__(self, url):
        self.url = url
        self.ws = websocket.create_connection(url, timeout=15)
        self.msg_id = 0
        self.results = {}
        self.lock = threading.Lock()
        self.connected = False
        self.thread = threading.Thread(target=self._recv_loop, daemon=True)
        self.thread.start()
        self._wait_connected()

    def _recv_loop(self):
        while True:
            try:
                data = self.ws.recv()
            except Exception:
                break
            if not data:
                break
            try:
                msg = json.loads(data)
            except Exception:
                continue
            if msg.get("msg") == "connected":
                self.connected = True
            if "id" in msg:
                with self.lock:
                    self.results[msg["id"]] = msg

    def _wait_connected(self):
        for _ in range(100):
            if self.connected:
                return
            time.sleep(0.1)
        raise Exception("not connected")

    def send(self, obj):
        self.ws.send(json.dumps(obj))

    def call(self, method, params, timeout=15):
        self.msg_id += 1
        mid = str(self.msg_id)
        self.send({"msg": "method", "method": method, "params": params, "id": mid})
        start = time.time()
        while time.time() - start < timeout:
            with self.lock:
                if mid in self.results:
                    return self.results.pop(mid)
            time.sleep(0.05)
        return None

    def close(self):
        try:
            self.ws.close()
        except Exception:
            pass
end_of_edit

