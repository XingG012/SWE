import struct, sys

# VM state
regs = [0]*16
mem = bytearray(0x14000)  # memory region
stack = []  # VM stack (rbp)
r10 = 0  # comparison flag
rax = 0
rdx = 0
rsi_sys = 0
rdi_sys = 0

# Load bytecode
with open("bytecode.bin","rb") as f:
    code = f.read()

# The bytecode is loaded at mem+0x1000 in the real binary.
# Memory base for VM is mmap+0xa000, and bytecode at mmap+0x1000.
# So relative to VM memory base, bytecode is at offset -0x9000.
# Let's just place code at offset 0x1000 in a separate code array and
# handle memory accesses relative to a base.

# Actually, let's model: VM memory base = M. bytecode loaded at M - 0x9000.
# The VM's rsi starts at M - 0x9000 (bytecode start).
# Memory accesses use regs as offsets from M.

CODE_BASE = -0x9000  # relative to mem base

def load_qword(off):
    # off is relative to mem base
    idx = off
    if idx < 0:
        # in code region
        ci = idx - CODE_BASE
        return struct.unpack("<Q", code[ci:ci+8])[0]
    return struct.unpack("<Q", mem[idx:idx+8])[0]

def store_qword(off, val):
    idx = off
    if idx < 0:
        ci = idx - CODE_BASE
        code[ci:ci+8] = struct.pack("<Q", val & 0xFFFFFFFFFFFFFFFF)
    else:
        mem[idx:idx+8] = struct.pack("<Q", val & 0xFFFFFFFFFFFFFFFF)

def load_byte(off):
    idx = off
    if idx < 0:
        return code[idx - CODE_BASE]
    return mem[idx]

def store_byte(off, val):
    idx = off
    if idx < 0:
        code[idx - CODE_BASE] = val & 0xFF
    else:
        mem[idx] = val & 0xFF

# rsi is instruction pointer, relative to mem base
rsi = CODE_BASE

def step():
    global rsi, r10, rax, rdx, rsi_sys, rdi_sys
    op = load_qword(rsi)
    r8 = load_qword(rsi+8)
    r9 = load_qword(rsi+16)
    r14 = load_qword(rsi+24)
    rsi += 32
    # dispatch
    if op & 0x1:
        if not (op & 0x2):
            stack.append(regs[r8])
        else:
            stack.append(r8)
    elif op & 0x10:
        if not (op & 0x20):
            regs[r8] = (regs[r8] + regs[r9]) & 0xFFFFFFFFFFFFFFFF
        else:
            regs[r8] = (regs[r8] + r14) & 0xFFFFFFFFFFFFFFFF
    elif op & 0x100:
        if not (op & 0x200):
            regs[r8] = (regs[r8] - regs[r9]) & 0xFFFFFFFFFFFFFFFF
        else:
            regs[r8] = (regs[r8] - r14) & 0xFFFFFFFFFFFFFFFF
    elif op & 0x1000:
        if not (op & 0x2000):
            regs[r8] = (regs[r8] ^ regs[r9]) & 0xFFFFFFFFFFFFFFFF
        else:
            regs[r8] = (regs[r8] ^ r14) & 0xFFFFFFFFFFFFFFFF
    elif op & 0x10000:
        if not (op & 0x20000):
            if not (op & 0x40000):
                if not (op & 0x80000):
                    regs[r8] = regs[r9]
                else:
                    store_qword(regs[r8]+r14, regs[r9])
            else:
                store_qword(regs[r8]+regs[r9], regs[r14])
        else:
            regs[r8] = r14
    elif op & 0x100000:
        regs[r8] = (regs[r8] + regs[r9]) & 0xFFFFFFFFFFFFFFFF
    elif op & 0x1000000:
        regs[r8] = (regs[r8] - regs[r9]) & 0xFFFFFFFFFFFFFFFF
    elif op & 0x10000000:
        if not (op & 0x20000000):
            r10 = 1 if regs[r8] == regs[r9] else 0
        else:
            r10 = 1 if regs[r8] == r14 else 0
    elif op & 0x100000000:
        if (r10 & 1) != 1:
            rsi = (rsi + r8) & 0xFFFFFFFFFFFFFFFF
    elif op & 0x1000000000:
        rsi = stack.pop()
    elif op & 0x10000000000:
        stack.append(rsi)
        rsi = (rsi + r8) & 0xFFFFFFFFFFFFFFFF
    elif op & 0x100000000000:
        # syscall
        if rax == 0:  # read
            data = sys.stdin.buffer.read(rdx)
            for i,b in enumerate(data):
                store_byte(rdi_sys+i, b)
            rax = len(data)
        elif rax == 1:  # write
            out = bytes(load_byte(rdi_sys+i) for i in range(rdx))
            sys.stdout.buffer.write(out)
            sys.stdout.buffer.flush()
            rax = rdx
        elif rax == 60:  # exit
            sys.exit(0)
    elif op & 0x1000000000000:
        regs[r8] = load_qword(regs[r9]+r14)
    elif op & 0x10000000000000:
        if not (op & 0x20000000000000):
            regs[r8] = (regs[r8] & regs[r9]) & 0xFFFFFFFFFFFFFFFF
        else:
            regs[r8] = (regs[r8] & r14) & 0xFFFFFFFFFFFFFFFF
    elif op & 0x100000000000000:
        regs[r8] = stack.pop()
    else:
        raise Exception("unknown opcode %x" % op)

# run
count = 0
while True:
    step()
    count += 1
    if count > 10000000:
        print("too many steps")
        break
