from Registry import Registry

reg = Registry.Registry("extracted/SAM")
users = reg.open("SAM\\Domains\\Account\\Users")
for sub in users.subkeys():
    if sub.name() == "Names":
        continue
    try:
        f = sub.value("F").value()
        # full name at offset 0x0c, length at 0x10
        import struct
        name_off = struct.unpack("<I", f[0x0c:0x10])[0] + 0xcc
        name_len = struct.unpack("<I", f[0x10:0x14])[0]
        fullname = f[name_off:name_off+name_len].decode("utf-16-le", errors="replace")
        print(sub.name(), "FullName:", repr(fullname))
    except Exception as e:
        print(sub.name(), "ERR", e)
end_of_edit

