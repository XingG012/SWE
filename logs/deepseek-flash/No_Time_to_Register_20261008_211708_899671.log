from Registry import Registry
import struct, datetime

reg = Registry.Registry("extracted/SAM")
users = reg.open("SAM\\Domains\\Account\\Users")
sub = users.subkey("000003E9")
v = sub.value("V").value()
print(len(v))
for off in [0x08, 0x10, 0x18, 0x20, 0x28]:
    t = struct.unpack("<Q", v[off:off+8])[0]
    try:
        dt = datetime.datetime(1601,1,1) + datetime.timedelta(microseconds=t/10)
        print(hex(off), "UTC:", dt, "SG:", dt+datetime.timedelta(hours=8))
    except Exception as e:
        print(hex(off), "ERR", e)
end_of_edit

