import hashlib

target = "a60458d2180258d47d7f7bef5236b33e86711ac926518ca4545ebf24cdc0b76c"

# List of hash algorithm names to try
methods = [
    "md5", "sha1", "sha224", "sha256", "sha384", "sha512",
    "sha3_224", "sha3_256", "sha3_384", "sha3_512",
    "blake2b", "blake2s", "ripemd160", "ripemd128",
    "whirlpool", "sha512_256", "sha512_224",
    "md4", "md5-sha1", "sm3", "shake_128", "shake_256",
]

# Try hashing the method name itself
for m in methods:
    try:
        h = hashlib.new(m)
        h.update(m.encode())
        if h.hexdigest() == target:
            print("MATCH (method name):", m)
    except Exception as e:
        pass

# Also try common words
words = ["example", "crackme", "crack", "me", "flag", "password", "csaw", "CrackMe", "Crack Me"]
for m in methods:
    for w in words:
        try:
            h = hashlib.new(m)
            h.update(w.encode())
            if h.hexdigest() == target:
                print("MATCH:", m, "word:", w)
        except Exception:
            pass

print("done")
end_of_edit

