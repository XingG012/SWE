            for combo in [s+p, p+s, s+":"+p, p+":"+s, s+"_"+p, p+"_"+s]:
                try:
                    h = hashlib.new(a)
                    h.update(combo.encode())
                    if h.hexdigest() == target:
                        print("MATCH: alg=", a, "combo=", combo)
                except Exception:
                    pass

print("done")
