import hashlib

target = "a60458d2180258d47d7f7bef5236b33e86711ac926518ca4545ebf24cdc0b76c"

algs = ["md5", "sha1", "sha224", "sha256", "sha384", "sha512",
        "sha3_224", "sha3_256", "sha3_384", "sha3_512",
        "blake2b", "blake2s", "ripemd160", "ripemd128",
        "whirlpool", "sha512_256", "sha512_224",
        "md4", "sm3"]

with open("/usr/share/dict/words", "r", errors="ignore") as f:
    words = [w.strip() for w in f]

print("Loaded", len(words), "words")

for a in algs:
    for w in words:
        try:
            h = hashlib.new(a)
            h.update(w.encode())
            if h.hexdigest() == target:
                print("MATCH: alg=", a, "word=", w)
        except Exception:
            pass

print("done")
end_of_edit

