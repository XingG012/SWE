import hashlib

target = "a60458d2180258d47d7f7bef5236b33e86711ac926518ca4545ebf24cdc0b76c"

methods = [
    "md5", "sha1", "sha224", "sha256", "sha384", "sha512",
    "sha3_224", "sha3_256", "sha3_384", "sha3_512",
    "blake2b", "blake2s", "ripemd160", "ripemd128",
    "whirlpool", "sha512_256", "sha512_224",
    "md4", "md5-sha1", "sm3",
]

# Try hashing the method name itself, and variations
for m in methods:
    for variant in [m, m.upper(), m.replace("_",""), m.replace("_","-"), m.replace("_","")]:
        try:
            h = hashlib.new(m)
            h.update(variant.encode())
            if h.hexdigest() == target:
                print("MATCH (method name variant):", m, "->", variant)
        except Exception:
            pass

# Try hashing method name with itself as salt (salt+pass, pass+salt)
for m in methods:
    for m2 in methods:
        for combo in [m+m2, m2+m, m+":"+m2, m2+":"+m]:
            try:
                h = hashlib.new(m)
                h.update(combo.encode())
                if h.hexdigest() == target:
                    print("MATCH combo:", m, "->", combo)
            except Exception:
                pass

print("done")
