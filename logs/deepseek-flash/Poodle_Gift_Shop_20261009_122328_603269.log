from pwn import *
from base64 import b64encode, b64decode

context.log_level = 'error'

def get_ciphertext(canine_type, canine_order):
    r = remote("crypto.chal.csaw.io", 6000)
    r.recvuntil(b"> ")
    r.sendline(b"1")
    r.recvuntil(b"> ")
    r.sendline(canine_type)
    r.recvuntil(b"> ")
    r.sendline(canine_order)
    data = r.recvuntil(b"\n\n")
    r.close()
    # extract base64
    marker = b"banner that reads: "
    idx = data.find(marker)
    ct = data[idx+len(marker):].strip()
    return ct

def oracle(ct_b64):
    r = remote("crypto.chal.csaw.io", 6000)
    r.recvuntil(b"> ")
    r.sendline(b"2")
    r.recvuntil(b"> ")
    r.sendline(ct_b64)
    data = r.recvuntil(b"\n", timeout=5)
    # read more
    try:
        data += r.recv(timeout=2)
    except:
        pass
    r.close()
    if b"Valid plaintext" in data:
        return "valid"
    if b"Something went wrong during decryption" in data:
        return "pad_ok"
    if b"Something went wrong......try again" in data:
        return "pad_bad"
    return "unknown: " + repr(data)

if __name__ == "__main__":
    ct = get_ciphertext(b"a", b"1")
    print("CT:", ct)
    print("len b64:", len(ct))
    raw = b64decode(ct)
    print("raw len:", len(raw))
    # test oracle on original
    print("orig:", oracle(ct))
    # test truncation: keep iv + first block
    trunc = b64encode(raw[:32])
    print("trunc1:", oracle(trunc))
end_of_edit

