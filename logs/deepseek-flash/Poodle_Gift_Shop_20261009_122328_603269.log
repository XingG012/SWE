from pwn import *
from base64 import b64encode, b64decode
context.log_level = 'error'

HOST = "crypto.chal.csaw.io"
PORT = 6000

class Conn:
    def __init__(self):
        self.r = remote(HOST, PORT)
        self.r.recvuntil(b"> ", timeout=10)
    def get_ciphertext(self, canine_type, canine_order):
        self.r.sendline(b"1")
        self.r.recvuntil(b"> ", timeout=10)
        self.r.sendline(canine_type)
        self.r.recvuntil(b"> ", timeout=10)
        self.r.sendline(canine_order)
        data = self.r.recvuntil(b"Enter your selection", timeout=10)
        self.r.recvuntil(b"> ", timeout=10)
        marker = b"banner that reads: "
        idx = data.find(marker)
        ct = data[idx+len(marker):].strip()
        if ct.startswith(b"b'"):
            ct = ct[2:]
        if ct.endswith(b"'"):
            ct = ct[:-1]
        return ct
    def oracle(self, ct_b64):
        self.r.sendline(b"2")
        self.r.recvuntil(b"> ", timeout=10)
        self.r.sendline(ct_b64)
        data = self.r.recvuntil(b"Enter your selection", timeout=10)
        self.r.recvuntil(b"> ", timeout=10)
        if b"Valid plaintext" in data:
            return "valid"
        if b"Something went wrong during decryption" in data:
            return "pad_ok"
        if b"Something went wrong......try again" in data:
            return "pad_bad"
        return "unknown"

def find_last_byte_D(conn, raw, end_block):
    ct = raw[:16*(end_block+1)]
    prev_off = 16*(end_block-1)
    valid_gs = []
    for g in range(256):
        mod = bytearray(ct)
        mod[prev_off+15] = g
        res = conn.oracle(b64encode(bytes(mod)))
        if res in ("pad_ok", "valid"):
            valid_gs.append(g)
    target = set(valid_gs)
    for d in range(256):
        s = set(d ^ v for v in range(1,33))
        if s == target:
            return d
    return None

def read_block_last_byte(conn, raw, blk):
    d = find_last_byte_D(conn, raw, blk)
    if d is None:
        return None
    return d ^ raw[16*(blk-1)+15]

if __name__ == "__main__":
    conn = Conn()
    j = 10
    flag = b""
    for k in range(45):
