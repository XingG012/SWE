from pwn import *
from base64 import b64encode, b64decode
context.log_level = 'error'

HOST = "crypto.chal.csaw.io"
PORT = 6000

def get_ciphertext(canine_type, canine_order):
    r = remote(HOST, PORT)
    r.recvuntil(b"> ", timeout=5)
    r.sendline(b"1")
    r.recvuntil(b"> ", timeout=5)
    r.sendline(canine_type)
    r.recvuntil(b"> ", timeout=5)
    r.sendline(canine_order)
    data = r.recvuntil(b"Enter your selection", timeout=5)
    r.close()
    marker = b"banner that reads: "
    idx = data.find(marker)
    ct = data[idx+len(marker):].strip()
    if ct.startswith(b"b'"):
        ct = ct[2:]
    if ct.endswith(b"'"):
        ct = ct[:-1]
    return ct

def oracle(ct_b64):
    r = remote(HOST, PORT)
    r.recvuntil(b"> ", timeout=5)
    r.sendline(b"2")
    r.recvuntil(b"> ", timeout=5)
    r.sendline(ct_b64)
    data = r.recvuntil(b"Enter your selection", timeout=5)
    r.close()
    if b"Valid plaintext" in data:
        return "valid"
    if b"Something went wrong during decryption" in data:
        return "pad_ok"
    if b"Something went wrong......try again" in data:
        return "pad_bad"
    return "unknown"

def find_last_byte_D(raw, end_block):
    ct = raw[:16*(end_block+1)]
    prev_off = 16*(end_block-1)
    valid_gs = []
    for g in range(256):
        mod = bytearray(ct)
        mod[prev_off+15] = g
        res = oracle(b64encode(bytes(mod)))
        if res in ("pad_ok", "valid"):
            valid_gs.append(g)
    target = set(valid_gs)
    for d in range(256):
        s = set(d ^ v for v in range(1,33))
        if s == target:
            return d
    return None

# Read the last byte of block `blk` (1-indexed ct block) of a given ciphertext
def read_block_last_byte(raw, blk):
    d = find_last_byte_D(raw, blk)
    if d is None:
        return None
    return d ^ raw[16*(blk-1)+15]

if __name__ == "__main__":
    # First determine flag length: vary canine_type length, observe padding value
    # msg+hmac = 205 + len(ct) + len(flag) + len(co)
    # We'll use co="1" (len 1)
    # padding value = 16 - (msg+hmac) % 16
    # Let's just read the last byte of the last block for a few lengths
    for L in [1, 2, 3]:
        ct = get_ciphertext(b"a"*L, b"1")
        raw = b64decode(ct)
        nblocks = len(raw)//16 - 1
        pb = read_block_last_byte(raw, nblocks)
        total = 16*nblocks
        print(f"L={L}: total_pt={total}, pad={pb}, msg+hmac={total-pb}")
