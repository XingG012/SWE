from pwn import *
from base64 import b64encode, b64decode
context.log_level = 'error'

HOST = "crypto.chal.csaw.io"
PORT = 6000

def get_ciphertext(canine_type, canine_order):
    r = remote(HOST, PORT)
    r.recvuntil(b"> ", timeout=5)
    r.sendline(b"1")
    r.recvuntil(b"> ", timeout=5)
    r.sendline(canine_type)
    r.recvuntil(b"> ", timeout=5)
    r.sendline(canine_order)
    data = r.recvuntil(b"Enter your selection", timeout=5)
    r.close()
    marker = b"banner that reads: "
    idx = data.find(marker)
    ct = data[idx+len(marker):].strip()
    if ct.startswith(b"b'"):
        ct = ct[2:]
    if ct.endswith(b"'"):
        ct = ct[:-1]
    return ct

def oracle(ct_b64):
    r = remote(HOST, PORT)
    r.recvuntil(b"> ", timeout=5)
    r.sendline(b"2")
    r.recvuntil(b"> ", timeout=5)
    r.sendline(ct_b64)
    data = r.recvuntil(b"Enter your selection", timeout=5)
    r.close()
    if b"Valid plaintext" in data:
        return "valid"
    if b"Something went wrong during decryption" in data:
        return "pad_ok"
    if b"Something went wrong......try again" in data:
        return "pad_bad"
    return "unknown"

# Find D(C_last)[-1] given the ciphertext blocks (raw bytes)
# We truncate to end at block index `end_block` (1-indexed among ct blocks, iv is block 0)
# We vary the last byte of the previous block.
def find_last_byte_D(raw, end_block):
    # raw = iv || C1 || ... ; we keep iv || C1 || ... || C_end_block
    # previous block is block end_block-1
    ct = raw[:16*(end_block+1)]
    prev_off = 16*(end_block-1)
    valid_gs = []
    for g in range(256):
        mod = bytearray(ct)
        mod[prev_off+15] = g
        res = oracle(b64encode(bytes(mod)))
        if res in ("pad_ok", "valid"):
            valid_gs.append(g)
    # find d such that {d^v : v in 1..32} == set(valid_gs)
    target = set(valid_gs)
    for d in range(256):
        s = set(d ^ v for v in range(1,33))
        if s == target:
            return d, valid_gs
    return None, valid_gs

if __name__ == "__main__":
    ct = get_ciphertext(b"a", b"1")
    raw = b64decode(ct)
    print("raw len:", len(raw), "blocks:", len(raw)//16)
    # find last byte of last block
    nblocks = len(raw)//16 - 1  # number of ct blocks
    d, vg = find_last_byte_D(raw, nblocks)
    print("D(C_last)[-1] =", d, "num valid:", len(vg))
    # plaintext last byte = d ^ C_{nblocks-1}[-1]
    prev_last = raw[16*(nblocks-1)+15]
    print("P_last[-1] =", d ^ prev_last)
end_of_edit

