edit 1:1
import socket
import concurrent.futures

host = "172.19.0.2"

def scan(port):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(0.5)
    try:
        s.connect((host, port))
        s.close()
        return port
    except:
        return None

open_ports = []
with concurrent.futures.ThreadPoolExecutor(max_workers=500) as ex:
    results = ex.map(scan, range(1, 65536))
    for r in results:
        if r:
            open_ports.append(r)
            print("OPEN:", r)

print("Done. Open ports:", open_ports)
end_of_edit

