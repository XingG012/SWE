import socket
import concurrent.futures

def scan(host, port):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(0.3)
    try:
        s.connect((host, port))
        s.close()
        return (host, port)
    except:
        return None

targets = []
for i in range(1, 255):
    for p in [80, 443, 8000, 8080, 5000, 3000, 1337, 8888, 9000, 4000]:
        targets.append(("172.19.0.%d" % i, p))

with concurrent.futures.ThreadPoolExecutor(max_workers=500) as ex:
    results = ex.map(lambda t: scan(t[0], t[1]), targets)
    for r in results:
        if r:
            print("OPEN:", r)
print("Done")
end_of_edit

