def transform(s):
    a = [ord(c) for c in s]
    for i in range(len(a)-1):
        d_i = a[i] - 0x30
        d_next = a[i+1] - 0x30
        f = (48*d_i + 11*(d_i+i) - 4) % 10
        a[i+1] = ((d_next + f) % 10) + 0x30
    return "".join(chr(c) for c in a)

inp = "7856445899213065428791"
print("input:", inp)
print("transformed:", transform(inp))
print("target:     7759406485255323229225")
