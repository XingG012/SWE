import struct

data = open("cell.pkg","rb").read()
print("size", len(data))

magic, revision, pkg_type, meta_off, meta_cnt, header_size = struct.unpack(">IIIIII", data[0:0x18])
data_off, data_size = struct.unpack(">QQ", data[0x18:0x28])
content_id = data[0x28:0x28+0x30]
print("magic %08x" % magic)
print("revision", revision)
print("pkg_type %08x" % pkg_type)
print("meta_off", hex(meta_off))
print("meta_cnt", meta_cnt)
print("header_size", hex(header_size))
print("data_off", hex(data_off))
print("data_size", hex(data_size))
print("content_id", content_id)
end_of_edit

