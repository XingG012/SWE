import struct

data = open("cell.pkg","rb").read()
print("file size", hex(len(data)))

magic, revision, pkg_type, meta_off, meta_cnt, header_size = struct.unpack(">IIIIII", data[0:0x18])
data_off, data_size = struct.unpack(">QQ", data[0x18:0x28])
content_id = data[0x30:0x30+0x30]
digest = data[0x60:0x70]
data_key = data[0x70:0x80]
print("magic %08x" % magic)
print("revision", revision)
print("pkg_type %08x" % pkg_type)
print("meta_off", hex(meta_off))
print("meta_cnt", meta_cnt)
print("header_size", hex(header_size))
print("data_off", hex(data_off))
print("data_size", hex(data_size))
print("content_id", content_id)
print("digest", digest.hex())
print("data_key", data_key.hex())

# metadata table
print("--- metadata ---")
for i in range(meta_cnt):
    off = 0xc0 + i*0x20
    if off+0x20 > len(data): break
    entry = data[off:off+0x20]
    t, doff, dsize, dsize2, idx, unk = struct.unpack(">IIQQII", entry)
    print("entry %d: type=%08x doff=%08x dsize=%08x dsize2=%08x idx=%d unk=%08x" % (i, t, doff, dsize, dsize2, idx, unk))
end_of_edit

