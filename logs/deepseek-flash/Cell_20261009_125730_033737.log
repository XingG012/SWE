edit 1:1
import math

data = open("cell.pkg","rb").read()
bs = 0x100
for i in range(0, len(data), bs):
    block = data[i:i+bs]
    if not block: break
    counts = [0]*256
    for b in block:
        counts[b] += 1
    ent = 0.0
    for c in counts:
        if c:
            p = c/len(block)
            ent -= p*math.log2(p)
    print("%08x: %.2f" % (i, ent))
