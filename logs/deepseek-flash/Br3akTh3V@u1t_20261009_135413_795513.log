import yaml

with open('main.yml') as f:
    data = yaml.safe_load(f)

sus14 = data['sus14']
raw = bytes.fromhex(sus14)

target = b'$ANSIBLE_VAULT'

# Try nibble swap
nibble_swap = bytes(((b & 0x0f) << 4) | ((b & 0xf0) >> 4) for b in raw)
print("nibble swap first 20:", nibble_swap[:20])

# Try XOR with single byte - find key from first byte
for key in range(256):
    x = bytes(b ^ key for b in raw[:20])
    if x.startswith(b'$A'):
        print("XOR key:", hex(key), x)

# Try bit reversal
def rev(b):
    r = 0
    for i in range(8):
        r = (r << 1) | ((b >> i) & 1)
    return r
bitrev = bytes(rev(b) for b in raw)
print("bitrev first 20:", bitrev[:20])

# Try XOR with repeating key derived from sus
sus = data['sus']
sus_bytes = sus.to_bytes((sus.bit_length()+7)//8, 'big')
print("sus bytes:", sus_bytes.hex())
print("sus bytes len:", len(sus_bytes))
end_of_edit

