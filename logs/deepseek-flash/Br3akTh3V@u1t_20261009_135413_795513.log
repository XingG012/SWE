raw = bytes.fromhex(sus14)
print("Raw bytes length:", len(raw))
print("First 64 bytes hex:", raw[:64].hex())
print("First 64 bytes repr:", raw[:64])

# Check byte frequency
from collections import Counter
c = Counter(raw)
print("Most common bytes:", c.most_common(10))
