84:
85:    let key = aes_gcm::Key::from_slice(SECRET_KEY);
86:    let cipher = aes_gcm::Aes128Gcm::new(key);
87:    
88:    let mut nonce_raw: [u8; 12] = [0; 12];
89:    let _ = getrandom(&mut nonce_raw).unwrap();
