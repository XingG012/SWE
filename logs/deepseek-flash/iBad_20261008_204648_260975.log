import requests

BASE = "http://crypto.chal.csaw.io:8000"

s = requests.Session()

# Login with crafted username so plaintext = "x|admin||regular|FLAG"
# Rotating left by 1 -> "|admin||regular|FLAGx" which starts with "|admin|"
r = s.post(BASE + "/login", data={"username": "x|admin|"}, allow_redirects=False)
print("Login status:", r.status_code)
print("Login headers:", dict(r.headers))
print("Cookies:", s.cookies.get_dict())

# Now access /profile which requires admin
r2 = s.get(BASE + "/profile")
print("Profile status:", r2.status_code)
print("Profile body:")
print(r2.text)
end_of_edit

