from pwn import *
import re

context.log_level = 'error'

r = remote("crypto.chal.csaw.io", 8000)

# Read curve parameters
data = r.recvuntil(b"Public key:")
print(data.decode())

# Read public key
pub_line = r.recvline().decode().strip()
print("PUB:", pub_line)
# Parse pub like (x, y)
nums = re.findall(r'-?\d+', pub_line)
pub = (int(nums[0]), int(nums[1]))
print("pub point:", pub)

# Curve params
p = 14753
a = 1
b = -1
g = (1, 1)
order = 7919

def inv(x, p):
    return pow(x, -1, p)

def add(P, Q):
    if P is None:
        return Q
    if Q is None:
        return P
    x1, y1 = P
    x2, y2 = Q
    if x1 == x2 and (y1 + y2) % p == 0:
        return None
    if P == Q:
        lam = (3*x1*x1 + a) * inv(2*y1, p) % p
    else:
        lam = (y2 - y1) * inv(x2 - x1, p) % p
    x3 = (lam*lam - x1 - x2) % p
    y3 = (lam*(x1 - x3) - y1) % p
    return (x3, y3)

def mult(k, P):
    R = None
    while k > 0:
        if k & 1:
            R = add(R, P)
        P = add(P, P)
        k >>= 1
    return R

# Brute force discrete log
secret = None
P = None
for k in range(order):
    if P == pub:
        secret = k
        break
    P = add(P, g)

print("Found secret:", secret)

r.recvuntil(b"Asking for secret")
r.sendline(str(secret).encode())
print(r.recvall(timeout=5).decode())
end_of_edit

