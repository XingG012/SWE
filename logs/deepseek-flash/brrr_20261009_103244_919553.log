import struct

data = open("brrr","rb").read()

def v2o(v):
    return v - 0x5c9000 + 0x5c8000

table_vaddr = 0x5ca780
ptrs = []
for i in range(44):
    off = v2o(table_vaddr + i*8)
    p = struct.unpack("<Q", data[off:off+8])[0]
    ptrs.append(p)

targets = []
for p in ptrs:
    off = v2o(p)
    targets.append(data[off:off+64])

# load computed hashes
hmap = {}
for line in open("hashes.txt"):
    parts = line.split()
    b = int(parts[0])
    h = bytes.fromhex(parts[1])
    hmap[h] = b

flag = bytearray()
for i,t in enumerate(targets):
    if t in hmap:
        flag.append(hmap[t])
    else:
        print("no match for", i)
        flag.append(ord('?'))

print("input:", flag)
print("input hex:", flag.hex())
open("brrito","wb").write(bytes(flag))
end_of_edit

