import struct

data = open("brrr","rb").read()

# .data: vaddr 0x5c9000 -> file offset 0x5c8000
def v2o(v):
    return v - 0x5c9000 + 0x5c8000

table_vaddr = 0x5ca780
ptrs = []
for i in range(44):
    off = v2o(table_vaddr + i*8)
    p = struct.unpack("<Q", data[off:off+8])[0]
    ptrs.append(p)

hashes = []
for p in ptrs:
    off = v2o(p)
    h = data[off:off+64]
    hashes.append(h)

for i,h in enumerate(hashes):
    print(i, h.hex())
