import gdb

base = 0x594714169000
hashfn = base + 0x78a6a

inf = gdb.selected_inferior()

# allocate buffers
inbuf = int(gdb.parse_and_eval("(char*)malloc(16)"))
outbuf = int(gdb.parse_and_eval("(char*)malloc(128)"))

results = {}
for b in range(256):
    inf.write_memory(inbuf, bytes([b]))
    gdb.execute("call ((void(*)(char*,int,char*))0x%x)((char*)0x%x, 1, (char*)0x%x)" % (hashfn, inbuf, outbuf))
    h = bytes(inf.read_memory(outbuf, 64))
    results[b] = h

with open("hashes.txt","w") as f:
    for b in range(256):
        f.write("%d %s\n" % (b, results[b].hex()))
print("done")
end_of_edit

