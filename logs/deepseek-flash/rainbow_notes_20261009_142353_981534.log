<!DOCTYPE html>
<html>
<head><meta charset="utf-8"></head>
<body>
<div id="out"></div>
<script>
function rainbowify(e) {
  const walker = document.createTreeWalker(e, NodeFilter.SHOW_ALL, null);
  let node;
  while (node = walker.nextNode()) {
    if (node.nodeType === Node.TEXT_NODE) {
      const frag = document.createDocumentFragment();
      for (const c of node.textContent) {
        const letter = document.createElement("span");
        letter.style = "color: hsl(" + (Math.random()*360) + ", 100%, 50%)";
        letter.textContent = c;
        frag.appendChild(letter);
      }
      node.parentNode.insertBefore(frag, node);
      const nextNode = walker.nextNode();
      node.parentNode.removeChild(node);
      node = nextNode;
      if (!node) break;
      walker.currentNode = node;
    }
  }
}
const payloads = JSON.parse(decodeURIComponent(location.hash.slice(1)));
const out = document.getElementById("out");
for (const p of payloads) {
  const noteP = document.createElement("p");
  try { noteP.setHTML(p); } catch(e) { noteP.textContent = "ERR:"+e; }
  try { rainbowify(noteP); } catch(e) {}
  const div = document.createElement("div");
  div.textContent = "PAYLOAD[" + p + "] => ";
  div.appendChild(noteP);
  out.appendChild(div);
}
</script>
</body>
</html>
end_of_edit

