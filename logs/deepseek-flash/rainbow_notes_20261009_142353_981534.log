42:		context = null
43:	} catch (e) {
44:		console.log(e)
45:	} finally {
46:		if (context) await context.close()
47:	}
48:}
49:
50:module.exports = visit
51:
52:if (require.main === module) {
53:	visit(process.argv[2])
54:}
