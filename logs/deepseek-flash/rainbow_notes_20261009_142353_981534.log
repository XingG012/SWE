import json, subprocess, urllib.parse, sys, re

def run(payloads):
    h = urllib.parse.quote(json.dumps(payloads))
    url = "file:///tmp/batch.html#" + h
    r = subprocess.run(["google-chrome","--headless","--no-sandbox","--disable-gpu",
                        "--virtual-time-budget=3000","--dump-dom", url],
                       capture_output=True, text=True, timeout=60)
    return r.stdout

if __name__ == "__main__":
    payloads = json.load(open(sys.argv[1]))
    out = run(payloads)
    # extract each div
    for m in re.finditer(r'PAYLOAD\[(.*?)\] =&gt; (.*?)</div>', out, re.S):
        print("PAYLOAD:", m.group(1))
        print("  RESULT:", m.group(2)[:500])
        print()
