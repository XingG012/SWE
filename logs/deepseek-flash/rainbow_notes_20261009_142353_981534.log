#!/bin/bash
# Test which elements survive the sanitizer
test_el() {
  local name="$1"
  local payload="<$name id=x>t</$name>"
  local enc=$(python3 -c "import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1]))" "$payload")
  local out=$(timeout 10 google-chrome --headless --no-sandbox --disable-gpu --dump-dom "file:///tmp/test.html?p=$enc" 2>/dev/null | grep -o '<p>.*</p>')
  echo "$name => $out"
}
