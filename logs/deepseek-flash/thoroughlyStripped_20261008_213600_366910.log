data = open('thoroughlyStripped','rb').read()

addrs = [0x374 + 0x14*i for i in range(17)]
charlist = ['f','l','a','g','{','s','t','y','_','i','n','c','o','e','k','d','}']
funcs = {}
for a,c in zip(addrs, charlist):
    funcs[a] = c

i = 0x4c8 + 3
result = []
while i < len(data):
    b = data[i]
    if b == 0xe8:
        off = int.from_bytes(data[i+1:i+5],'little',signed=True)
        target = i + 5 + off
        result.append((hex(i), hex(target), funcs.get(target,'?')))
        i += 5
    elif b == 0xc3:
        break
    else:
        i += 1
for r in result:
    print(r)
print(''.join(r[2] for r in result))
