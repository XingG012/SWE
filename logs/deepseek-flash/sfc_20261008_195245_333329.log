ram = [0]*256

# MOVFS R0, safe_rom[i] : bytes [0x0A, i, 0x00, 0x00]  (dest from ram[P+2]=0x00 -> R0)
# MOVT R0, 255-i        : bytes [0x03, 255-i]
pc = 0
for i in range(16):
    ram[pc] = 0x0A
    ram[pc+1] = i
    ram[pc+2] = 0x00  # dest R0
    ram[pc+3] = 0x00  # padding
    pc += 4
    ram[pc] = 0x03
    ram[pc+1] = 255 - i
    pc += 2

print(' '.join('%02x' % b for b in ram))
