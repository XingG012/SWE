from pwn import *
import re

context.log_level = 'error'

def gen_ram(nbytes):
    ram = [0]*256
    pc = 0
    for i in range(nbytes):
        ram[pc] = 0x0A
        ram[pc+1] = i
        ram[pc+2] = 0x00  # dest R0
        ram[pc+3] = 0x00
        pc += 4
        ram[pc] = 0x03
        ram[pc+1] = 255 - i
        pc += 2
    return ' '.join('%02x' % b for b in ram)

def run(nbytes):
    r = remote('rev.chal.csaw.io', 8000)
    r.recvuntil(b'WELCOME')
    r.sendline(gen_ram(nbytes).encode())
    data = r.recvall(timeout=10)
    r.close()
    return data

data = run(16)
print(data.decode(errors='replace'))
end_of_edit

