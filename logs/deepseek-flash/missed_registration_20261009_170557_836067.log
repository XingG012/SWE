for i in range(len(ns)):
    for j in range(i+1, len(ns)):
        a = int(ns[i], 16)
        b = int(ns[j], 16)
        g = gcd(a, b)
        if g != 1:
            print("shared factor between", i, j)
            print("g =", g)
            found = True
if not found:
    print("no shared factors")
