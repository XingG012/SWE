import urllib.parse

ns = []
with open('/tmp/posts.txt') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        params = urllib.parse.parse_qs(line)
        n = params.get('n', [''])[0]
        ns.append(n)

print("count", len(ns))
lens = {}
for n in ns:
    lens[len(n)] = lens.get(len(n), 0) + 1
print("lengths:", lens)
end_of_edit

