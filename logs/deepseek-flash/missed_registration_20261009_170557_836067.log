import urllib.parse

with open('/tmp/posts.txt') as f:
    for i, line in enumerate(f):
        line = line.strip()
        if not line:
            continue
        params = urllib.parse.parse_qs(line)
        text = params.get('text', [''])[0]
        name = params.get('name', [''])[0]
        lname = params.get('lname', [''])[0]
        print(i, repr(name), repr(lname), repr(text))
