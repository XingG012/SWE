import urllib.parse
from math import gcd

ns = []
with open('/tmp/posts.txt') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        params = urllib.parse.parse_qs(line)
        n = params.get('n', [''])[0]
        ns.append(int(n, 16))

print("count", len(ns))
found = False
for i in range(len(ns)):
    for j in range(i+1, len(ns)):
        g = gcd(ns[i], ns[j])
        if g != 1:
            print("shared factor between", i, j)
            print("g =", g)
            found = True
if not found:
    print("no shared factors")
end_of_edit

