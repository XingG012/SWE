import re
from math import gcd

ns = []
with open('/tmp/forms.txt') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        # last field is n, a long hex string
        parts = line.split(',')
        n = parts[-1]
        ns.append(n)

print("count", len(ns))
# find shared factors
