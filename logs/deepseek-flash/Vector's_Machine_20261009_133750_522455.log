from pwn import *
import time

context.log_level = 'error'

def try_input(inp):
    try:
        r = remote('misc.chal.csaw.io', 3001, timeout=5)
        r.recvuntil(b'Enter your input:', timeout=5)
        r.sendline(inp)
        time.sleep(0.5)
        data = r.recvall(timeout=3)
        r.close()
        return data
    except Exception as e:
        return b'ERR: ' + str(e).encode()

for inp in [b'1 2', b'1,2', b'(1,2)', b'1;2', b'1\t2', b'1.0 2.0', b'[1,2]', b'1 2 3']:
    print(repr(inp), '->', try_input(inp))
end_of_edit

