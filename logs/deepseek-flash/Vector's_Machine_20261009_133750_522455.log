from pwn import *
import time

context.log_level = 'error'

def query(x, y):
    for attempt in range(3):
        try:
            r = remote('misc.chal.csaw.io', 3001, timeout=5)
            r.recvuntil(b'Enter your input:', timeout=5)
            r.sendline(str(x).encode())
            r.sendline(str(y).encode())
            time.sleep(0.3)
            data = r.recvall(timeout=3)
            r.close()
            if b'Cool' in data:
                return 1
            elif b'Not cool' in data or b'not cool' in data:
                return 0
            else:
                return -1
        except Exception as e:
            time.sleep(0.5)
    return -1

# Query along axes to find boundary
for x in range(-10, 11):
    print(x, query(x, 0))
end_of_edit

