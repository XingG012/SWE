import socket
import pyte
import time
import re

HOST = "misc.chal.csaw.io"
PORT = 3535

s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.connect((HOST, PORT))
s.settimeout(2)

def recv_all():
    data = b""
    try:
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            data += chunk
            if b"\x1b[18t" in chunk:
                s.sendall(b"\x1b[8;24;80t")
    except socket.timeout:
        pass
    return data

def render(data):
    screen = pyte.Screen(80, 24)
    stream = pyte.Stream(screen)
    stream.feed(data.decode("latin-1"))
    return screen

data = recv_all()
screen = render(data)
print("=== LEVEL 0 ===")
for i, line in enumerate(screen.display):
    if line.strip():
        print(i, repr(line))

# The password is at row 7 (0-indexed)
pw = screen.display[7].strip()
print("PASSWORD:", repr(pw))

s.sendall(pw.encode() + b"\n")
time.sleep(1)
resp = recv_all()
print("RESP TAIL:", repr(resp[-200:]))

s.close()
