import socket
import pyte
import time
import re

HOST = "misc.chal.csaw.io"
PORT = 3535

s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.connect((HOST, PORT))
s.settimeout(2)

def recv_all():
    data = b""
    try:
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            data += chunk
            if b"\x1b[18t" in chunk:
                s.sendall(b"\x1b[8;24;80t")
    except socket.timeout:
        pass
    return data

def render(data):
    screen = pyte.Screen(80, 24)
    stream = pyte.Stream(screen)
    stream.feed(data.decode("latin-1"))
    return screen

def extract_password(screen):
    # Find the row containing "PASSWORD:" hint or the drawn password
    # The password is drawn at row 7 (0-indexed), columns 18-40
    return screen.display[7][18:40].strip()

data = recv_all()
screen = render(data)
print("=== LEVEL 0 ===")
for i, line in enumerate(screen.display):
    if line.strip():
        print(i, repr(line))

pw = extract_password(screen)
print("PASSWORD:", repr(pw))

s.sendall(pw.encode() + b"\n")
time.sleep(0.5)
resp = recv_all()
print("RESP TAIL:", repr(resp[-300:]))

s.close()
end_of_edit

