import socket
import pyte
import time

HOST = "misc.chal.csaw.io"
PORT = 3535

s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.connect((HOST, PORT))
s.settimeout(3)

def recv_all():
    data = b""
    try:
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            data += chunk
    except socket.timeout:
        pass
    return data

data = recv_all()
screen = pyte.Screen(80, 24)
stream = pyte.Stream(screen)
stream.feed(data.decode("latin-1"))
print("=== LEVEL 0 ===")
for i, line in enumerate(screen.display):
    if line.strip():
        print(i, repr(line))

# send password
s.sendall(b"Level 0 Is Really Easy\n")
time.sleep(1)
resp = recv_all()
print("RESP LEN:", len(resp))
print("RESP TAIL:", repr(resp[-200:]))

s.close()
end_of_edit

