import socket
import pyte
import time

HOST = "misc.chal.csaw.io"
PORT = 3535

s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.connect((HOST, PORT))
s.settimeout(2)

def recv_all():
    data = b""
    try:
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            data += chunk
            # respond to window size query immediately
            if b"\x1b[18t" in chunk:
                s.sendall(b"\x1b[8;24;80t")
    except socket.timeout:
        pass
    return data

data = recv_all()
print("DATA LEN:", len(data))
print("TAIL:", repr(data[-300:]))

s.close()
