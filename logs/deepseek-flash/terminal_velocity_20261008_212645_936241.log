def recv_all():
    data = b""
    last_pos = 0
    try:
        while True:
            chunk = s.recv(65536)
            if not chunk:
                break
            data += chunk
            idx = data.find(b"\x1b[18t", last_pos)
            while idx != -1:
                print("GOT WINDOW QUERY, responding")
                s.sendall(b"\x1b[8;24;80t")
                last_pos = idx + 5
                idx = data.find(b"\x1b[18t", last_pos)
    except socket.timeout:
        pass
    return data
