# Build the lattice
# Variables: u_0,u_1,u_2,u_3,u_4,k_0,k_1,k_2
# Equations: M*u_{i+2} - A0*M*u_{i+1} - A1*M*u_i - n1*k_i = -d_i

# Build matrix of the linear system (3 x 8)
rows = []
for i in range(3):
    row = [0]*8
    row[i] = -A1*M
    row[i+1] = -A0*M
    row[i+2] = M
    row[5+i] = -n1
    rows.append(row)

# We want to solve rows * v = -d (mod nothing, exact)
# Build augmented system and find kernel
from sage.all import *

# Build the lattice: we want small u_i. 
# Use the approach: build a lattice with basis vectors for the kernel of the map
# v -> (rows[0]*v, rows[1]*v, rows[2]*v) and add the particular solution.

# Let me use a different approach: build a lattice where the target vector is
# (u_0,...,u_4, k_0,...,k_2) and the equations are encoded as extra coordinates.

# Scaling: u_i ~ 2^205, k_i ~ 2^512. Let's scale u columns by 2^307 to balance.
S = 2^307

# Build lattice basis (11 x 11): 8 variable columns + 3 equation columns
# Rows: 8 identity rows (scaled) + 3 equation rows
B = Matrix(ZZ, 11, 11)
for i in range(8):
    B[i, i] = 1
# Scale u columns
for i in range(5):
    B[i, i] = S
# Equation rows
for i in range(3):
    for j in range(8):
        B[8+i, j] = rows[i][j]
    B[8+i, 8+i] = 1  # to track the equation value

# Add the constant term
# We want rows*v + d = 0, so the target vector has last 3 coords = 0
# Add d to the equation rows' last column? Let's embed d.
# Actually, let's add a row for the constant.
B2 = Matrix(ZZ, 12, 12)
for i in range(8):
    B2[i, i] = S if i < 5 else 1
for i in range(3):
    for j in range(8):
        B2[8+i, j] = rows[i][j]
    B2[8+i, 8+i] = 1
# constant row
for i in range(3):
    B2[11, 8+i] = d[i]
B2[11, 11] = 1

print("Running LLL...")
L = B2.LLL()
print("Done")
for r in L:
    print(r)
