import base64

# Test how different byte sequences decode
tests = [
    b"admin=False&access_sensitive=False",
    b"admin=False\\x26access_sensitive=False",
    b"admin\\x3dTrue",
    b"\\x26admin=True",
]

for t in tests:
    print("B:", t)
    try:
        ident = t.decode()
        print("  identifier (utf-8):", repr(ident))
    except Exception as e:
        print("  identifier error:", e)
    try:
        enc = t.decode('unicode-escape').encode('ISO-8859-1')
        print("  encode:", repr(enc))
    except Exception as e:
