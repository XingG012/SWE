475:void TCPSocket::PushFunctions(lua_State* L)
476:{
477:	auto bindable = new LuaBindable(L, "Tcp");
478:	bindable->AddFunction("Connect", this, &TCPSocket::lConnect);
479:	bindable->AddFunction("SetTopicHandler", this, &TCPSocket::lSetTopicHandler);
480:	bindable->AddFunction("SendLine", this, &TCPSocket::lSendLine);
481:	bindable->AddFunction("Close", this, &TCPSocket::lClose);
482:	bindable->Push();
483:	lua_settop(L, 0);
484:	m_boundStates.Add(L, bindable);
485:
486:	// Trigger the lua tcp init
487:	lua_getglobal(L, "init_tcp");
488:	if (lua_isfunction(L, -1))
489:	{
490:		if (lua_pcall(L, 0, 0, 0) != 0)
491:		{
492:			Logf("[Socket] Lua error on init_tcp: %s", Logger::Severity::Error, lua_tostring(L, -1));
493:			g_gameWindow->ShowMessageBox("Lua Error on init_tcp", lua_tostring(L, -1), 0);
494:		}
495:	}
496:	lua_settop(L, 0);
497:}
