298:// Push a json object onto the lua stack as a table
299:void TCPSocket::m_pushJsonObject(lua_State* L, const nlohmann::json& packet)
300:{
301:	assert(packet.is_object());
302:
303:	lua_newtable(L);
304:
305:	for (auto& el : packet.items())
306:	{
307:		const String& key = el.key();
308:		auto& val = el.value();
309:		
310:		lua_pushstring(L, key.c_str());
311:		m_pushJsonValue(L, val);
312:		lua_settable(L, -3);
313:	}
314:}
