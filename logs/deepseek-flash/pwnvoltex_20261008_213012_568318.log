203:	// If this loop exits, clean up user
204:	defer self.destroy()
205:
206:	// Sleep for a short bit to avoid race with the router
207:	time.Sleep(100 * time.Millisecond)
208:
209:	// Use to catch ^C
210:	sigchan := make(chan os.Signal, 1)
211:	signal.Notify(sigchan, os.Interrupt)
212:
213:	for {
214:		select {
215:		case <-sigchan:
216:			return
217:		default:
218:		}
219:
220:		mode, err := self.reader.ReadByte()
221:		if err != nil {
222:			if self.name != "" {
223:				fmt.Println("User disconnected:", self.name)
224:			}
225:			return
226:		}
227:
228:		// Newline delinitated JSON
229:		if mode == 1 {
230:			line, err := self.reader.ReadBytes('\n')
231:			if err != nil {
232:				fmt.Println("Error reading packet:", err.Error())
233:				return
234:			}
235:
236:			// Decode the JSON data
237:			json_data, err := JsonDecodeBytes(line)
238:			if err != nil {
239:				fmt.Println("Error converting JSON:", err.Error())
240:				continue
241:			}
242:
243:			// Get the topic from the JSON data
244:			topic, ok := json_data["topic"].(string)
245:			if !ok {
246:				fmt.Println("Error: Topic missing")
247:				continue
248:
249:			}
250:			if (DEBUG_LEVEL >= 2 && topic != "room.score.update") || DEBUG_LEVEL >= 3 {
251:				fmt.Println("-->", topic, json_data)
252:			}
253:
254:			// Take the lock so we wait until we have processed
255:			// the current packet
256:			// XXX we'll see if this causes any problems
257:			self.msg_block.Lock()
258:
259:			var pub message.Publisher
260:
261:			// NOTE: an unauthed user can only call user.auth
262:			if !self.authed && topic != "user.auth" {
263:				fmt.Println("Error: User not authorised for", topic)
264:				continue
265:
266:			} else if strings.HasPrefix(topic, "user.") {
267:				// Message for the user
268:				pub = self.pub_sub
269:
270:			} else if strings.HasPrefix(topic, "server.") {
271:				// Message for the server
272:				pub = self.server.pub_sub
273:
274:			} else if strings.HasPrefix(topic, "room.") {
275:				// Message for the current room
276:				if self.room == nil {
277:					continue
278:				}
279:				pub = self.room.pub_sub
280:
281:			} else {
282:				// We don't know where to send this message
283:				fmt.Println("Error: Unknown topic route", topic)
284:				continue
285:			}
