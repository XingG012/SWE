418:// Get a song for given audio hash and level
419:// If we find a match find a matching hash but not level, just go with any level
420:ChartIndex* MultiplayerScreen::m_getChartByHash(const String& hash, const String& path, uint32* diffIndex, int32 level)
421:{
422:	// Fallback on an empty hash
423:	if (hash.length() == 0)
424:		return m_getChartByShortPath(path, diffIndex, level, true);
425:	
426:	Logf("[Multiplayer] looking up song hash '%s' level %u", Logger::Severity::Info, *hash, level);
427:	for (auto folder : m_mapDatabase->FindFoldersByHash(hash))
428:	{
429:		ChartIndex* newChart = NULL;
430:
431:		for (size_t ind = 0; ind < folder.second->charts.size(); ind++)
432:		{
433:			ChartIndex* chart = folder.second->charts[ind];
434:			if (chart->level == level)
435:			{
436:				// We found a matching level for this hash, good to go
437:				newChart = chart;
438:				*diffIndex = ind;
439:			}
440:		}
441:
442:		// We didn't find the exact level, but we should still use this map anyway
443:		if (newChart == NULL)
444:		{
445:			assert(folder.second->charts.size() > 0);
446:			*diffIndex = 0;
447:			newChart = folder.second->charts[0];
448:		}
449:
450:		if (newChart != NULL)
451:		{
452:			Logf("[Multiplayer] Found: diff_id=%d mapid=%d index=%u path=%s", Logger::Severity::Info, newChart->id, newChart->folderId, *diffIndex, newChart->path.c_str());
453:			return newChart;
454:		}
455:	}
456:	Log("[Multiplayer] Could not find song by hash, falling back to foldername", Logger::Severity::Warning);
457:	return m_getChartByShortPath(path, diffIndex, level, true);
458:}
