916:void MultiplayerScreen::PerformScoreTick(Scoring& scoring, MapTime time)
917:{
918:	if (m_failed)
919:		return;
920:
921:	int scoreUpdateIndex = time / m_scoreInterval;
922:
923:	if (scoreUpdateIndex <= m_lastScoreSent)
924:		return;
925:
926:	m_lastScoreSent = scoreUpdateIndex;
927:
928:	uint32 score = scoring.CalculateCurrentScore();
929:
930:	nlohmann::json packet;
931:	packet["topic"] = "room.score.update";
932:	packet["time"] = Math::Max(0, scoreUpdateIndex) * m_scoreInterval;
933:	packet["score"] = score;
934:
935:	m_tcp.SendJSON(packet);
936:}
