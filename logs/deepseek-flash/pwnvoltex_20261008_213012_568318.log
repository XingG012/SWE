457:// This erases the data in the buffer up to start
458:void TCPSocket::m_eraseBuffer(size_t end)
459:{
460:	// Copy data to start of buffer
461:	m_amountRead -= end;
462:	memmove(m_dataBuff, m_dataBuff + end, m_amountRead);
463:
464:	// Find the new smallest buffer size to contain the data
465:	// Should always be less than 4096 but check to be safe
466:	for (m_dataLength = 4096; m_dataLength < m_amountRead; m_dataLength *= 2);
467:
468:	// Resize buffer to new buffer size
469:	char* new_dataBuff = static_cast<char*>(realloc(m_dataBuff, m_dataLength + 1));
470:	if (!new_dataBuff)
471:		free(m_dataBuff);
472:	m_dataBuff = new_dataBuff;
473:}
