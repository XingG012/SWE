200:void TCPSocket::m_processPacket(char* ptr, size_t length, TCPPacketMode mode)
201:{
202:	String packetData = String(ptr, length);
203:	if (mode != TCPPacketMode::JSON_LINE)
204:	{
205:		Logf("[Socket] Could not handle packet with mode %u", Logger::Severity::Error, mode);
206:		return;
207:	}
208:
209:	// TODO(itszn) Line handler callback?
210:
211:	auto jsonPacket = nlohmann::json::parse(packetData);
212:
213:	// TODO(itszn) Raw json handler callback?
214:
215:	if (!jsonPacket.is_object())
216:	{
217:		Logf("[Socket] Not an object %s", Logger::Severity::Error, static_cast<String>(jsonPacket.dump()));
218:		return;
219:	}
220:
221:	String topic = jsonPacket.value("topic", "");
222:	if (topic == "")
223:	{
224:		Logf("[Socket] No topic in %s", Logger::Severity::Error, static_cast<String>(jsonPacket.dump()));
225:		return;
226:	}
227:
228:	// Call any C++ topic handlers
229:	if (m_topicHandlers.find(topic) != m_topicHandlers.end())
230:	{
231:		IFunctionBinding<bool, nlohmann::json&>* f = m_topicHandlers[topic];
232:		if (!f->Call(jsonPacket))
233:			return;
234:	}
235:
236:	// Call any lua topic handlers
237:	if (m_luaTopicHandlers.find(topic) != m_luaTopicHandlers.end())
238:	{
239:		LuaTCPHandler* handler = m_luaTopicHandlers[topic];
240:		if (m_boundStates.Contains(handler->L))
241:		{
242:			lua_rawgeti(handler->L, LUA_REGISTRYINDEX, handler->callback);
243:			m_pushJsonObject(handler->L, jsonPacket);
244:			if (lua_pcall(handler->L, 1, 0, 0) != 0)
245:			{
246:				Logf("[Socket] Lua error on calling TCP handler: %s", Logger::Severity::Error, lua_tostring(handler->L, -1));
247:			}
248:			lua_settop(handler->L, 0);
249:		}
250:	}
251:}
