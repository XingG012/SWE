950:void MultiplayerScreen::SendFinalScore(class Game* game, ClearMark clearState)
951:{
952:	Scoring& scoring = game->GetScoring();
953:
954:	clearState = HasFailed() ? ClearMark::Played : clearState;
955:
956:	uint32 flags = (uint32)game->GetFlags();
957:
958:	nlohmann::json packet;
959:	packet["topic"] = "room.score.final";
960:	packet["score"] = scoring.CalculateCurrentScore();
961:	packet["combo"] = scoring.maxComboCounter;
962:	packet["clear"] = static_cast<int>(clearState);
963:	packet["gauge"] = scoring.currentGauge;
964:	packet["early"] = scoring.timedHits[0];
965:	packet["late"] = scoring.timedHits[1];
966:	packet["miss"] = scoring.categorizedHits[0];
967:	packet["near"] = scoring.categorizedHits[1];
968:	packet["crit"] = scoring.categorizedHits[2];
969:	packet["flags"] = flags;
970:	packet["mean_delta"] = scoring.GetMeanHitDelta();
971:	packet["median_delta"] = scoring.GetMedianHitDelta();
972:
973:	packet["graph"] = *(std::array<float, 256>*)game->GetGaugeSamples();
974:
975:	m_tcp.SendJSON(packet);
976:
977:	packet["name"] = m_userName;
978:	packet["uid"] = m_userId;
979:
980:	m_addFinalStat(packet);
