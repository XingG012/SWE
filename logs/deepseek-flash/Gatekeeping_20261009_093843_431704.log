1:#!/bin/bash
2:
3:if [ ! -f /.dockerenv ]; then
4:    echo "This is supposed to be run in a docker env";
5:    exit
6:fi
7:
8:if [[ $EUID -ne 0 ]]; then
9:    echo "This script must be run as root"
