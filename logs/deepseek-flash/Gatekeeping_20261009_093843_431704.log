13:cat > /etc/nginx/sites-enabled/default <<EOF
14:server {
15:    listen 80;
16:
17:    underscores_in_headers on;
18:
19:    location / {
20:        include proxy_params;
21:
22:        # Nginx uses the WSGI protocol to transmit the request to gunicorn through the domain socket 
23:        # We do this so the network can't connect to gunicorn directly, only though nginx
24:        proxy_pass http://unix:/tmp/gunicorn.sock;
25:        proxy_pass_request_headers on;
26:
27:        # INFO(brad)
28:        # Thought I would explain this to clear it up:
29:        # When we make a request, nginx forwards the request to gunicorn.
30:        # Gunicorn then reads the request and calculates the path (which is put into the WSGI variable `path_info`)
31:        #
32:        # We can prevent nginx from forwarding any request starting with "/admin/". If we do this 
33:        # there is no way for gunicorn to send flask a `path_info` which starts with "/admin/"
34:        # Thus any flask route starting with /admin/ should be safe :)
35:        location ^~ /admin/ {
36:            deny all;
37:        }
38:    }
39:}
40:
41:EOF
42:
