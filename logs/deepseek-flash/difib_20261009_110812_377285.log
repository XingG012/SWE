def fibs(n):
    a, b = 0, 1
    seq = []
    for _ in range(n):
        seq.append(a)
        a, b = b, a + b
    return seq

# Fibonacci mod 26 as Vigenere key
f = fibs(len(message) + 10)
for start in range(10):
    for sign in [1, -1]:
        result = ""
        for i, c in enumerate(message):
            shift = (f[i + start] * sign) % 26
            result += chr((ord(c) - ord('a') - shift) % 26 + ord('a'))
        print(f"start={start} sign={sign}: {result}")
