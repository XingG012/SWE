message = "snbwmuotwodwvcywfgmruotoozaiwghlabvuzmfobhtywftopmtawyhifqgtsiowetrksrzgrztkfctxnrswnhxshylyehtatssukfvsnztyzlopsv"

def vigenere_decrypt(ciphertext, key):
    result = ""
    key = key.lower()
    for i, c in enumerate(ciphertext):
        shift = ord(key[i % len(key)]) - ord('a')
        result += chr((ord(c) - ord('a') - shift) % 26 + ord('a'))
    return result

keys = ["fibonacci", "fib", "difib", "classic", "classics", "pangram", "quick", "brown", "fox", "jumps", "lazy", "dog", "thequickbrownfox", "abcdefghijklmnopqrstuvwxyz"]

for key in keys:
    result = vigenere_decrypt(message, key)
    print(f"key={key}: {result}")
