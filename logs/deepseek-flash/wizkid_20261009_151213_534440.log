import socket
import sys

def interact(inp):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(5)
    s.connect(("rev.chal.csaw.io", 4444))
    data = b""
    try:
        while b"secret code" not in data and b"?" not in data:
            chunk = s.recv(4096)
            if not chunk:
                break
            data += chunk
    except:
        pass
    print("BANNER:", data.decode(errors="replace"))
    s.sendall((inp + "\n").encode())
    resp = b""
    try:
        while True:
            chunk = s.recv(4096)
            if not chunk:
                break
            resp += chunk
    except:
        pass
    print("RESP:", resp.decode(errors="replace"))
    s.close()

if __name__ == "__main__":
    interact(sys.argv[1])
end_of_edit

