data = open("stage-2.bin","rb").read()
# data starts at file offset 0xe8 (memory 0x60e8, loaded at 0x6000)
payload = bytearray(data[0xe8:])

key = 0x69
out = bytearray()
i = 0
while i < len(payload):
    # check if qword is zero -> end
    if payload[i:i+8] == b"\x00"*8:
        break
    # process 4 bytes at offsets 0,2,4,6
    for j in range(4):
        idx = i + j*2
        b = payload[idx]
        b = (b ^ key) & 0xFF
        b = b >> 1
        payload[idx] = b
    # write 8 bytes to VGA (char, attr pairs)
    group = payload[i:i+8]
    out += group
    i += 8

# VGA: even bytes are chars
chars = bytes(out[k] for k in range(0, len(out), 2))
print(chars)
