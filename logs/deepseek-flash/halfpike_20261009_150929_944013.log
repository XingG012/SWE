import sys

rom = bytearray(open("chal.rom","rb").read())
rom += bytearray(4096 - len(rom))

class State:
    def __init__(self):
        self.pc = 0
        self.callstack = [0,0,0]
        self.cso = 0
        self.regs = [0]*16
        self.acc = 0
        self.carry = 0
        self.src = 0
        self.ram = [[0]*256 for _ in range(8)]
        self.bank = 0
        self.write_hold = None
        self.read_hold = None
        self.input = b""
        self.inpos = 0
        self.output = bytearray()

def getchar(s):
    if s.inpos < len(s.input):
        c = s.input[s.inpos]; s.inpos += 1
        return c
    return 0

def tick(s, trace=False):
    pc = s.pc
    op = rom[pc]
    hi = op >> 4
    lo = op & 0xf
    npc = pc + 1
    if trace:
        print("%03x: %02x acc=%x carry=%x r=%s" % (pc, op, s.acc, s.carry, s.regs))
    if hi == 0x0:
        pass
    elif hi == 0x1:
        cond = lo
        target = (pc & 0xf00) | rom[pc+1]
        should = False
        if cond & 1: should = should or False
        if cond & 2: should = should or (s.carry == 1)
        if cond & 4: should = should or (s.acc == 0)
        if cond & 8: should = not should
        if should: npc = target
        else: npc = pc + 2
    elif hi == 0x2:
        if lo & 1 == 0:
            pair = (lo & 0xe) >> 1
            data = rom[pc+1]
            s.regs[pair*2] = data >> 4
            s.regs[pair*2+1] = data & 0xf
            npc = pc + 2
        else:
            pair = (lo & 0xe) >> 1
            s.src = (s.regs[2*pair] << 4) | s.regs[2*pair+1]
    elif hi == 0x3:
        pair = (lo & 0xe) >> 1
        if lo & 1 == 0:
            pc_high = (s.pc & 0xf00) >> 8
            target = (pc_high << 8) | (s.regs[0] << 4) | s.regs[1]
            value = rom[target]
            s.regs[pair*2] = value >> 4
            s.regs[pair*2+1] = value & 0xf
        else:
            low = (s.regs[2*pair] << 4) | s.regs[2*pair+1]
            npc = (s.pc & 0xf00) | low
    elif hi == 0x4:
        npc = ((lo) << 8) | rom[pc+1]
    elif hi == 0x5:
        target = ((lo) << 8) | rom[pc+1]
        s.cso = (s.cso + 1) % 3
        s.callstack[s.cso] = s.pc
        npc = target
    elif hi == 0x6:
        s.regs[lo] = (s.regs[lo] + 1) & 0xf
    elif hi == 0x7:
        target = (pc & 0xf00) | rom[pc+1]
        s.regs[lo] = (s.regs[lo] + 1) & 0xf
        if s.regs[lo] == 0:
            npc = target
        else:
            npc = pc + 2
    elif hi == 0x8:
        will_carry = (s.regs[lo] + s.acc) > 0xf
        s.acc = (s.acc + s.regs[lo]) & 0xf
        s.carry = 1 if will_carry else 0
    elif hi == 0x9:
        result_full = s.acc + (~s.regs[lo] & 0xf) + ((~s.carry) & 1)
        s.carry = (result_full & 0x10) >> 4
        s.acc = result_full & 0xf
    elif hi == 0xa:
        s.acc = s.regs[lo]
    elif hi == 0xb:
        s.regs[lo], s.acc = s.acc, s.regs[lo]
    elif hi == 0xc:
        s.acc = lo
        npc = s.callstack[s.cso]
        if s.cso == 0: s.cso = 2
        else: s.cso -= 1
    elif hi == 0xd:
        s.acc = lo
    elif hi == 0xe:
        if lo == 0: # WRM
            s.ram[s.bank][s.src] = s.acc
        elif lo == 2: # WRR
            if s.write_hold is not None:
                c = (s.write_hold << 4) | s.acc
                s.output.append(c)
                s.write_hold = None
            else:
                s.write_hold = s.acc
        elif lo == 9: # RDM
            s.acc = s.ram[s.bank][s.src]
        elif lo == 10: # RDR
            if s.read_hold is not None:
                s.acc = s.read_hold
                s.read_hold = None
            else:
                c = getchar(s)
                s.acc = c >> 4
                s.read_hold = c & 0xf
        else:
            raise Exception("unimpl E%x at %03x" % (lo, pc))
    elif hi == 0xf:
        if lo == 0: s.acc = 0; s.carry = 0
        elif lo == 1: s.carry = 0
        elif lo == 2:
            if s.acc == 0xf: s.carry = 1
            s.acc = (s.acc + 1) & 0xf
        elif lo == 3: s.carry = 1 - s.carry
        elif lo == 4: s.acc = (~s.acc) & 0xf
        elif lo == 5:
            c = s.carry
            s.carry = (s.acc >> 3) & 1
            s.acc = ((s.acc << 1) | c) & 0xf
        elif lo == 6:
            c = s.carry
            s.carry = s.acc & 1
            s.acc = ((s.acc >> 1) | (c << 3)) & 0xf
        elif lo == 7:
            s.acc = s.carry
            s.carry = 0
        elif lo == 8:
            if s.acc == 0: s.carry = 1
            s.acc = (s.acc - 1) & 0xf
        elif lo == 9:
            if s.carry == 0: s.acc = (s.acc - 1) & 0xf
            s.carry = 0 if s.carry else 1
        elif lo == 10: s.carry = 1
        elif lo == 11:
            if s.acc > 9 or s.carry == 1:
                s.acc = (s.acc + 6) & 0xf
        elif lo == 12: pass
        else:
            raise Exception("unimpl F%x at %03x" % (lo, pc))
    else:
        raise Exception("bad op %02x at %03x" % (op, pc))
    s.pc = npc

def run(inp, maxsteps=10000000, trace=False):
    s = State()
    s.input = inp
    steps = 0
    while steps < maxsteps:
        tick(s, trace)
        steps += 1
        if s.pc == 0:
            break
    return s

if __name__ == "__main__":
    inp = sys.argv[1].encode() if len(sys.argv) > 1 else b""
    s = run(inp)
    print("OUTPUT:", s.output)
    print("steps done, pc=%03x" % s.pc)
