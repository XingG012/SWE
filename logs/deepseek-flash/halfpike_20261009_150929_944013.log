import sys

rom = open("chal.rom","rb").read()

def decode(pc):
    op = rom[pc]
    hi = op >> 4
    lo = op & 0xf
    if hi == 0x0:
        return "NOP", 1
    if hi == 0x1:
        return "JCN %x, %03x" % (lo, ((pc & 0xf00) | rom[pc+1])), 2
    if hi == 0x2:
        if lo & 1 == 0:
            return "FIM R%d, %02x" % ((lo>>1)&7, rom[pc+1]), 2
        else:
            return "SRC R%d" % ((lo>>1)&7), 1
    if hi == 0x3:
        if lo & 1 == 0:
            return "FIN R%d" % ((lo>>1)&7), 1
        else:
            return "JIN R%d" % ((lo>>1)&7), 1
