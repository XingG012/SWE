import struct
from collections import deque

with open('archive/data/0', 'rb') as f:
    data = f.read()
weights = struct.unpack('<%df' % (len(data)//4), data)
n = 42
grid = [list(weights[i*n:(i+1)*n]) for i in range(n)]

start = end = None
for i in range(n):
    for j in range(n):
        if grid[i][j] == 2.0:
            start = (i, j)
        if grid[i][j] == 3.0:
            end = (i, j)
print("start", start, "end", end)

# BFS with path tracking. W=up(-1,0), A=left(0,-1), S=down(1,0), D=right(0,1)
moves = [('W', -1, 0), ('A', 0, -1), ('S', 1, 0), ('D', 0, 1)]
q = deque([(start, "")])
visited = {start}
found = None
while q:
    (r, c), path = q.popleft()
    if (r, c) == end:
        found = path
        break
    for ch, dr, dc in moves:
        nr, nc = r+dr, c+dc
        if 0 <= nr < n and 0 <= nc < n and (nr, nc) not in visited and grid[nr][nc] != 1.0:
            visited.add((nr, nc))
            q.append(((nr, nc), path+ch))

print("path length:", len(found))
print("path:", found)

import hashlib
print("md5:", hashlib.md5(found.encode()).hexdigest())
