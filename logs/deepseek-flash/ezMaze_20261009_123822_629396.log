import struct
from collections import deque

with open('archive/data/0', 'rb') as f:
    data = f.read()
weights = struct.unpack('<%df' % (len(data)//4), data)
n = 42
grid = [list(weights[i*n:(i+1)*n]) for i in range(n)]

start = end = None
for i in range(n):
    for j in range(n):
        if grid[i][j] == 2.0:
            start = (i, j)
        if grid[i][j] == 3.0:
            end = (i, j)
print("start", start, "end", end)

# BFS
q = deque([(start, 0)])
visited = {start}
while q:
    (r, c), d = q.popleft()
    if (r, c) == end:
        print("shortest path length:", d)
        break
    for dr, dc in [(-1,0),(1,0),(0,-1),(0,1)]:
        nr, nc = r+dr, c+dc
        if 0 <= nr < n and 0 <= nc < n and (nr, nc) not in visited and grid[nr][nc] != 1.0:
            visited.add((nr, nc))
            q.append(((nr, nc), d+1))
end_of_edit

