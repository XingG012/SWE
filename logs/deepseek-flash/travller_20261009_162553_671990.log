from pwn import *
context.log_level = 'error'

def start():
    return remote("pwn.chal.csaw.io", 8000)

def add(p, dist_choice, data):
    p.sendlineafter(b"Action: ", b"1")
    p.sendlineafter(b"Distance: ", str(dist_choice).encode())
    p.sendlineafter(b"Destination: ", data)

def change(p, idx, data):
    p.sendlineafter(b"Action: ", b"2")
    p.sendlineafter(b"Trip: ", str(idx).encode())
    p.sendlineafter(b"Destination: ", data)

def delete(p, idx):
    p.sendlineafter(b"Action: ", b"3")
    p.sendlineafter(b"Trip: ", str(idx).encode())

def check(p, idx):
    p.sendlineafter(b"Action: ", b"4")
    p.sendlineafter(b"Trip: ", str(idx).encode())
    return p.recvline()

p = start()
print(p.recvuntil(b"Action: "))
p.close()
end_of_edit

