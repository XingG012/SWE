data = bytes.fromhex(enc)

import itertools, string

def score(text):
    # score by printable and common chars
    s = 0
    for c in text:
        if 32 <= c <= 126:
            s += 1
        if chr(c) in "etaoinshrdlu ":
            s += 2
    return s

# brute force 1-3 byte keys
best = []
for klen in range(1, 4):
    for key in itertools.product(range(256), repeat=klen):
        key = bytes(key)
        dec = bytes([data[i] ^ key[i % klen] for i in range(len(data))])
        sc = score(dec)
        best.append((sc, key, dec))

best.sort(reverse=True)
for sc, key, dec in best[:10]:
    print(f"score={sc} key={key}: {dec[:80]}")
end_of_edit

