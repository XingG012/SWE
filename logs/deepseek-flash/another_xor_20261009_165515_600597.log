from collections import Counter
english_freq = {
    'a': 8.167, 'b': 1.492, 'c': 2.782, 'd': 4.253, 'e': 12.702, 'f': 2.228,
    'g': 2.015, 'h': 6.094, 'i': 6.966, 'j': 0.153, 'k': 0.772, 'l': 4.025,
    'm': 2.406, 'n': 6.749, 'o': 7.507, 'p': 1.929, 'q': 0.095, 'r': 5.987,
    's': 6.327, 't': 9.056, 'u': 2.758, 'v': 0.978, 'w': 2.360, 'x': 0.150,
    'y': 1.974, 'z': 0.074, ' ': 15.0
}

def chi_squared(text):
    c = Counter(text)
    n = len(text)
    score = 0
    for ch, freq in english_freq.items():
        expected = freq / 100 * n
        observed = c.get(ord(ch), 0)
        score += (observed - expected) ** 2 / expected
    return score

# Try key lengths and for each, find the best key byte per position
for klen in range(1, 50):
    key = bytearray(klen)
    for i in range(klen):
        best = None
        best_score = float('inf')
        for b in range(256):
            sub = bytes([data[j] ^ b for j in range(i, len(data), klen)])
            sc = chi_squared(sub)
            if sc < best_score:
                best_score = sc
                best = b
        key[i] = best
    key = bytes(key)
    dec = bytes([data[i] ^ key[i % klen] for i in range(len(data))])
    printable = sum(1 for c in dec if 32 <= c <= 126)
    if printable > len(data) * 0.95:
