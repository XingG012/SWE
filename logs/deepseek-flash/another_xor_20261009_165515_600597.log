data = bytes.fromhex(enc)

# The key guess from "flag{" is "A qua" (5 bytes)
# Let's try to extend the key by assuming plaintext is readable
# Try key = "A quantum..." variants
import string

def try_key(key):
    dec = bytes([data[i] ^ key[i % len(key)] for i in range(len(data))])
    return dec

# Try common phrases starting with "A qua"
for suffix in ["ntum", "ntum ", "ntum c", "ntum co", "ntum com", "ntum comp", "ntum compu", "ntum comput", "ntum compute", "ntum computer"]:
    key = ("A qua" + suffix).encode()
    dec = try_key(key)
    print(f"key={key}: {dec[:60]}")

# Also try the key being the whole plaintext repeated? No.
# Let's try to find key length by looking at the structure
# The plaintext is 137 bytes. If key is short, we can find it.
print("\n--- Trying to find key by assuming plaintext is printable and using 'flag{' at start ---")
# We know plaintext[0:5] = "flag{", so key[0:5] = "A qua"
# Let's assume the key is a repeating phrase. Try to find it.
# Try key lengths and for each, find the most likely key bytes
for klen in range(5, 40):
    key = bytearray(klen)
    # known first 5
    known = b"A qua"
    for i in range(min(5, klen)):
        key[i] = known[i]
    # For remaining positions, find byte that gives most printable chars
    for i in range(5, klen):
        best = None
        best_score = -1
        for b in range(256):
            score = 0
            for j in range(i, len(data), klen):
                p = data[j] ^ b
                if 32 <= p <= 126:
                    score += 1
            if score > best_score:
                best_score = score
                best = b
        key[i] = best
    key = bytes(key)
    dec = try_key(key)
    printable = sum(1 for c in dec if 32 <= c <= 126)
    if printable > len(data) * 0.9:
        print(f"klen={klen} printable={printable}/{len(data)} key={key}")
        print(f"  {dec}")
