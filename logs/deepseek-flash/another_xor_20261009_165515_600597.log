data = bytes.fromhex(enc)

# Try to find key length using index of coincidence
def ic(text):
    from collections import Counter
    c = Counter(text)
    n = len(text)
    return sum(v*(v-1) for v in c.values()) / (n*(n-1))

print("Overall IC:", ic(data))
for klen in range(1, 40):
    avg_ic = 0
    for i in range(klen):
        sub = data[i::klen]
        if len(sub) > 1:
            avg_ic += ic(sub)
    avg_ic /= klen
    print(f"klen={klen}: avg IC = {avg_ic:.4f}")
