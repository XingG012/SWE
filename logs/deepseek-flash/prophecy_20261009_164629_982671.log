from pwn import *
import sys

context.log_level = 'error'

name = sys.argv[1] if len(sys.argv) > 1 else "ZERATUL"
key = sys.argv[2] if len(sys.argv) > 2 else "foo.starcraft"

p = process("./prophecy")
p.recvuntil(b">>")
p.sendline(name.encode())
p.recvuntil(b">>")
p.sendline(key.encode())
try:
    out = p.recvall(timeout=5)
except:
    out = b""
print(out.decode(errors='replace'))
end_of_edit

