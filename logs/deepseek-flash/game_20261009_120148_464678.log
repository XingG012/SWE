from pwn import *
import re, json, os

context.log_level = 'error'

def get_state_after(path):
    r = remote('rev.chal.csaw.io', 5000)
    try:
        data = r.recvuntil(b'Choice: ', timeout=5)
        for c in path:
            r.sendline(str(c).encode())
            data = r.recvuntil(b'Choice: ', timeout=5)
    except EOFError:
        r.close()
        return None, b''
    r.close()
    m = re.search(rb'\n(\d+)\nWhich cave', data)
    if m:
        return int(m.group(1)), data
    return None, data

# Load existing graph if present
if os.path.exists('graph.json'):
    with open('graph.json') as f:
        graph = {int(k):v for k,v in json.load(f).items()}
else:
    graph = {}

start_id, _ = get_state_after([])
print("start", start_id, flush=True)

# BFS with paths
queue = [([], start_id)]
seen = {start_id}

while queue:
    path, state = queue.pop(0)
    if state in graph and all(v is not None for v in graph[state].values()):
        continue
    graph[state] = {}
    for choice in [1,2,3]:
        nid, data = get_state_after(path + [choice])
        graph[state][choice] = nid
        print(f"state {state} choice {choice} -> {nid}", flush=True)
        if nid is not None and nid not in seen and nid <= 14:
            seen.add(nid)
            queue.append((path + [choice], nid))
    with open('graph.json','w') as f:
        json.dump({str(k):v for k,v in graph.items()}, f)

print("done", flush=True)
end_of_edit

