from pwn import *
context.log_level = 'error'

def get_state_after(path):
    r = remote('rev.chal.csaw.io', 5000)
    try:
        data = r.recvuntil(b'Choice: ', timeout=5)
        for c in path:
            r.sendline(str(c).encode())
            data = r.recvuntil(b'Choice: ', timeout=5)
    except EOFError:
        r.close()
        return None, b''
    r.close()
    if b'requires a password' in data:
        return 'EGG', data
    m = re.search(rb'\n(\d+)\nWhich cave', data)
    if m:
        return int(m.group(1)), data
    return None, data

# Test start state transitions multiple times
for i in range(3):
    print("run", i, [get_state_after([c])[0] for c in [1,2,3]])
end_of_edit

