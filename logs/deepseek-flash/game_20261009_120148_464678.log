def get_state_after(path):
    """Replay path, return (case_id, output) at the end."""
    r = remote('rev.chal.csaw.io', 5000)
    try:
        data = r.recvuntil(b'Choice: ', timeout=5)
        for c in path:
            r.sendline(str(c).encode())
            data = r.recvuntil(b'Choice: ', timeout=5)
    except EOFError:
        r.close()
        return None, b''
    r.close()
    # parse case id: the number on its own line before "Which cave"
    m = re.search(rb'\n(\d+)\nWhich cave', data)
    if m:
        return int(m.group(1)), data
    return None, data
