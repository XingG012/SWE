from pwn import *
import re

context.log_level = 'error'

def explore():
    # BFS over the game graph
    # state -> {choice: next_state}
    graph = {}
    # We need to track the path to reach each state
    # Start fresh each time
    visited = {}
    
    # Queue of (path_to_state, current_state)
    # We'll do DFS/BFS by replaying paths
    queue = [([], None)]  # empty path, start state unknown
    
    while queue:
        path, state = queue.pop(0)
        if state in graph:
            continue
        # Replay path to reach this state
        r = remote('rev.chal.csaw.io', 5000)
        r.recvuntil(b'Which cave')
        # Actually need to parse the case_id
        # Let's just replay choices
        for c in path:
            r.sendline(str(c).encode())
            data = r.recvuntil(b'Which cave', timeout=3)
        # Now we're at the state, get its id
        # The output before "Which cave" contains the case id
        # Let's capture full output
        r.close()
        break

explore()
end_of_edit

