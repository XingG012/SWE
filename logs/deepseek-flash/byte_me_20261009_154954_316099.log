import socket
from concurrent.futures import ThreadPoolExecutor

def check(ip):
    try:
        s = socket.socket()
        s.settimeout(0.5)
        s.connect((ip, 8000))
        s.close()
        return ip
    except:
        return None

ips = [f"172.19.0.{i}" for i in range(1, 255)]
with ThreadPoolExecutor(max_workers=100) as ex:
    for res in ex.map(check, ips):
        if res:
            print("OPEN:", res)
end_of_edit

