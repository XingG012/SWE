with open('encrypted_passwords.txt','rb') as f:
    data = f.read()

lines = data.split(b'\n')
lines = [l for l in lines if len(l) > 0]

# Known plaintexts (Pokemon names) - from the decryption with the 19-byte key
known = {
    0: b'Kingler-Water',
    1: b'Darkrai-Dark',
    2: b'Chingling-Psychic',
    3: b'Happiny-Normal',
    4: b'Clawitzer-Water',
    5: b'Cacturne-Grass-Dark',
    7: b'Sneasel-Dark-Ice',
    8: b'Hoopa-Psychic-Ghost',
    10: b'Seedot-Grass',
    12: b'Tsareena-Grass',
    14: b'Gumshoos-Normal',
    15: b'Kricketune-Bug',
    19: b'Basculin-Water',
    20: b'Hippowdon-Ground',
    22: b'Finneon-Water',
    23: b'Riolu-Fighting',
    24: b'Entei-Fire',
    25: b'Spritzee-Fairy',
    27: b'Silvally-Normal',
    30: b'Marill-Water-Fairy',
    31: b'Herdier-Normal',
    33: b'Thwackey-Grass',
    34: b'Spewpa-Bug',
    37: b'Chespin-Grass',
    39: b'Tornadus-Flying',
    40: b'Pupitar-Rock-Ground',
    43: b'Carnivine-Grass',
    44: b'Growlithe-Fire',
    45: b'Grubbin-Bug',
    47: b'Goomy-Dragon',
    48: b'Thievul-Dark',
    50: b'Seadra-Water',
}

# Recover key byte by byte
key = {}
for idx, pt in known.items():
    ct = lines[idx]
    for i in range(len(pt)):
        k = pt[i] ^ ct[i]
        if i in key:
            assert key[i] == k, f"Mismatch at pos {i}: {key[i]} vs {k}"
        else:
            key[i] = k

maxlen = max(key.keys()) + 1
keybytes = bytes(key[i] for i in range(maxlen))
print("Recovered key length:", maxlen)
print("Key:", keybytes)

# Now decrypt all passwords
def decrypt(ct):
    return bytes(ct[i] ^ keybytes[i] for i in range(min(len(ct), len(keybytes))))

for j, ct in enumerate(lines):
    print(f"{j}: {decrypt(ct)}")
