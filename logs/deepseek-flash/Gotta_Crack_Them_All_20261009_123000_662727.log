    50: b'Seadra-Water',
}

key = {}
for idx, pt in known.items():
    ct = lines[idx]
    assert len(ct) == len(pt), f"Line {idx}: ct len {len(ct)} != pt len {len(pt)}"
    for i in range(len(pt)):
        k = pt[i] ^ ct[i]
        if i in key:
            assert key[i] == k, f"Mismatch at pos {i}: {key[i]} vs {k}"
        else:
            key[i] = k

maxlen = max(key.keys()) + 1
keybytes = bytes(key[i] for i in range(maxlen))
print("Recovered key length:", maxlen)
print("Key:", keybytes)

def decrypt(ct):
    return bytes(ct[i] ^ keybytes[i] for i in range(min(len(ct), len(keybytes))))

for j, ct in enumerate(lines):
    print(f"{j}: {decrypt(ct)}")
