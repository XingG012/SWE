import json
from Crypto.Cipher import AES
from Crypto.Util.number import long_to_bytes, bytes_to_long
from hashlib import sha256
import math

# Load data
bob = json.load(open("bobs-key.json"))
carol = json.load(open("carols-key.json"))
msg = json.load(open("message.json"))

N = bob["N"]
DB = bob["D"]
DC = carol["D"]

# Replicate Go's crypto/rand.Int using AES-CTR keystream
def new_reader(seed):
    key = sha256(seed.encode()).digest()
    cipher = AES.new(key, AES.MODE_CTR, nonce=b"", initial_value=0)
    return cipher

def go_rand_int(seed, max_val):
    cipher = new_reader(seed)
    n_minus_1 = max_val - 1
    bitLen = n_minus_1.bit_length()
    if bitLen == 0:
        return 0
    k = (bitLen + 7) // 8
    b = bitLen % 8
    if b == 0:
        b = 8
    while True:
        # read k bytes from keystream (CTR encrypts zeros)
        keystream = cipher.encrypt(b"\x00" * k)
        bytes_arr = bytearray(keystream)
        bytes_arr[0] &= (1 << b) - 1
        n = int.from_bytes(bytes_arr, "big")
        if n < max_val:
            return n

def decrypter_id(name, N):
    n = go_rand_int(name, N)
    n |= 1  # SetBit(n, 0, 1)
    return n

nB = decrypter_id("Bob", N)
nC = decrypter_id("Carol", N)
nA = decrypter_id("Alice", N)

print("nB =", nB)
print("nC =", nC)
print("nA =", nA)

# Compute multiple of phi: (DB - DC)*x + (DB*nB - DC*nC) = 0 mod phi
# We have DB*(x+nB) = 1 mod phi, DC*(x+nC) = 1 mod phi
# DB*(x+nB) - DC*(x+nC) = 0 mod phi
# (DB-DC)*x + (DB*nB - DC*nC) = 0 mod phi
# So k*phi = (DB-DC)*x + (DB*nB - DC*nC) for some integer k
# We don't know x. But note DB*(x+nB) = 1 + a*phi, DC*(x+nC) = 1 + b*phi
# DB*(x+nB) - DC*(x+nC) = (a-b)*phi
# = DB*x + DB*nB - DC*x - DC*nC = (DB-DC)*x + (DB*nB - DC*nC)
# Hmm we still need x.

# Alternative: DB*(x+nB) = 1 mod phi means DB*(x+nB) - 1 = a*phi
# DC*(x+nC) - 1 = b*phi
# Multiply: (DB*(x+nB)-1)*(DC*(x+nC)-1) = ab*phi^2
# Not directly helpful.

# Better: We know DB and DC. Consider DB*DC*(x+nB)*(x+nC) ... 
# Actually: DB*(x+nB) = 1 + a*phi, DC*(x+nC) = 1 + b*phi
# DB*(x+nB)*DC*(x+nC) = (1+a*phi)(1+b*phi) = 1 + (a+b)*phi + ab*phi^2
# Hmm.

# Simplest: DB*(x+nB) - DC*(x+nC) = (a-b)*phi = M (a multiple of phi)
# We can compute M if we know x. But we don't.
# However, note that DB*(x+nB) ≡ 1 and DC*(x+nC) ≡ 1 mod phi.
# So DB*(x+nB) - DC*(x+nC) ≡ 0 mod phi.
# Let's denote f(x) = (DB-DC)*x + (DB*nB - DC*nC). This is ≡ 0 mod phi.
# We need another relation. 

# Actually there's a classic trick: DB*(x+nB) = 1 + a*phi. 
# Consider DB*(x+nB) - 1. This is a multiple of phi.
# Similarly DC*(x+nC) - 1 is a multiple of phi.
# Their product is a multiple of phi^2, but also we can compute:
# gcd(DB*(x+nB)-1, DC*(x+nC)-1) ... still need x.

# Let's think differently. We have two equations mod phi:
# DB*x ≡ 1 - DB*nB (mod phi)
# DC*x ≡ 1 - DC*nC (mod phi)
# Multiply first by DC, second by DB:
# DB*DC*x ≡ DC*(1-DB*nB) (mod phi)
# DB*DC*x ≡ DB*(1-DC*nC) (mod phi)
# Subtract: 0 ≡ DC - DC*DB*nB - DB + DB*DC*nC (mod phi)
# => DC - DB + DB*DC*(nC - nB) ≡ 0 (mod phi)
# So phi divides DC - DB + DB*DC*(nC - nB) =: M
M = DC - DB + DB*DC*(nC - nB)
print("M =", M)
print("M bits:", M.bit_length())
print("N bits:", N.bit_length())

# M is a multiple of phi. phi ~ N. So M/phi is small-ish.
# We can factor N using a multiple of phi.
# Standard: given k*phi, we can find p, q.
# phi = N - p - q + 1, so p+q = N - phi + 1.
# Let s = N - phi + 1 = p + q. Then p, q are roots of t^2 - s*t + N = 0.
# We know phi = M / k for some small k. Try small k.
