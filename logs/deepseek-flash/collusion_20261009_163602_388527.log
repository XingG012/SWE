64:        if x == 1 or x == N-1:
65:            continue
66:        for i in range(s):
67:            y = pow(x, 2, N)
68:            if y == 1:
69:                p = math.gcd(x - 1, N)
70:                if 1 < p < N:
71:                    return p, N // p
72:                break
73:            x = y
74:    return None
75:
76:res = factor_with_multiple_of_phi(N, M)
77:print("factor result:", res)
78:p, q = res
79:phi = (p-1)*(q-1)
80:print("phi bits:", phi.bit_length())
81:
82:invDB = pow(DB, -1, phi)
83:x = (invDB - nB) % phi
84:print("x =", x)
85:
86:invDC = pow(DC, -1, phi)
87:x2 = (invDC - nC) % phi
88:print("x matches:", x == x2)
89:
90:dA = pow((x + nA) % phi, -1, phi)
91:
92:A = msg["V"]
93:K = pow(A, dA, N)
94:print("K =", K)
95:
96:shared = sha256(long_to_bytes(K)).digest()
97:print("shared =", shared.hex())
