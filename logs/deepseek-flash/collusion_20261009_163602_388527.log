# M is a multiple of phi. Use it to factor N.
import random

def factor_with_multiple_of_phi(N, M):
    # M = k * phi(N). Find a nontrivial square root of 1.
    M = abs(M)
    # write M = 2^s * t
    s = 0
    t = M
    while t % 2 == 0:
        t //= 2
        s += 1
    for _ in range(100):
        a = random.randrange(2, N-1)
        g = math.gcd(a, N)
        if g > 1:
            return g, N // g
        x = pow(a, t, N)
        if x == 1 or x == N-1:
            continue
        for i in range(s):
            y = pow(x, 2, N)
            if y == 1:
                p = math.gcd(x - 1, N)
                if 1 < p < N:
                    return p, N // p
                break
            x = y
    return None

