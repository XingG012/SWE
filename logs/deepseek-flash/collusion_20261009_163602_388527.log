import json
import math
import random
from Crypto.Cipher import AES
from Crypto.Util.number import long_to_bytes, bytes_to_long
from hashlib import sha256

bob = json.load(open("bobs-key.json"))
carol = json.load(open("carols-key.json"))
msg = json.load(open("message.json"))

N = bob["N"]
DB = bob["D"]
DC = carol["D"]

def new_reader(seed):
    key = sha256(seed.encode()).digest()
    cipher = AES.new(key, AES.MODE_CTR, nonce=b"", initial_value=0)
    return cipher

def go_rand_int(seed, max_val):
    cipher = new_reader(seed)
    n_minus_1 = max_val - 1
    bitLen = n_minus_1.bit_length()
    if bitLen == 0:
        return 0
    k = (bitLen + 7) // 8
    b = bitLen % 8
    if b == 0:
        b = 8
    while True:
        keystream = cipher.encrypt(b"\x00" * k)
        bytes_arr = bytearray(keystream)
        bytes_arr[0] &= (1 << b) - 1
        n = int.from_bytes(bytes_arr, "big")
        if n < max_val:
            return n

def decrypter_id(name, N):
    n = go_rand_int(name, N)
    n |= 1
    return n

nB = decrypter_id("Bob", N)
nC = decrypter_id("Carol", N)
nA = decrypter_id("Alice", N)

M = DB - DC - (nC - nB) * DB * DC
print("M bits:", M.bit_length(), "N bits:", N.bit_length())

def factor_with_multiple_of_phi(N, M):
    M = abs(M)
    s = 0
    t = M
    while t % 2 == 0:
        t //= 2
        s += 1
    for _ in range(200):
        a = random.randrange(2, N-1)
        g = math.gcd(a, N)
        if g > 1:
            return g, N // g
        x = pow(a, t, N)
        if x == 1 or x == N-1:
            continue
        for i in range(s):
            y = pow(x, 2, N)
            if y == 1:
                p = math.gcd(x - 1, N)
                if 1 < p < N:
                    return p, N // p
                break
            x = y
    return None

res = factor_with_multiple_of_phi(N, M)
print("factor result:", res)
end_of_edit

