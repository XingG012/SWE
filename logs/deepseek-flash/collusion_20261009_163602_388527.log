99:import base64
100:nonce = base64.b64decode(msg["Nonce"])
101:ct = base64.b64decode(msg["Body"])
102:cipher = AES.new(shared, AES.MODE_GCM, nonce=nonce)
103:try:
104:    pt = cipher.decrypt_and_verify(ct[:-16], ct[-16:])
105:    print("TAG OK, plaintext:", pt)
106:except Exception as ex:
107:    print("TAG FAIL:", ex)
