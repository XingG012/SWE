from pwn import *
import re, subprocess, base64

context.log_level = 'error'
r = remote("crypto.chal.csaw.io", 6000)
data = r.recvuntil(b"public key", timeout=10)
r.sendline(b"y")
import time
time.sleep(1)
data2 = r.recv(timeout=10)
full = data.decode(errors='replace') + data2.decode(errors='replace')
print(full)
r.close()

# Parse cipher_enc
m = re.search(r'This is CIPHER.ENC.*?\n\s*(\S+)', full, re.S)
cipher_enc = m.group(1)
print("CIPHER_ENC:", cipher_enc)

# Parse pub_key
m = re.search(r'public key\? Take it then!:\s*\n\s*\((\d+)\s*:\s*(\d+)', full)
pub_x, pub_y = int(m.group(1)), int(m.group(2))
print("pub:", pub_x, pub_y)

# Parse mv_elgamel
m = re.search(r"SSL secret key for ya':\s*\n\s*MV_elgamel\(rG = \(([^)]+)\), c1 = (\d+), c2 = (\d+)\)", full)
print("mv match:", m)
