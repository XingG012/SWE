G = E([602046282375688656758213480587526111916698976636884684818, 174050332293622031404857552280219410364023488927386650641])
n = G.order()

pub = E([1376291677096536793341384931940921090784596019563852228955, 4095951091640912963153684808069716715715036990473354954285])
rG = E([2200444516446263641164162232813391645991235388348056755362, 5439874435316241417329467560022897470310397083427682773442])
c1 = 3278079469592705054905063602771307052428963936940300730723
