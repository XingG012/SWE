import random
from itertools import combinations

# We need 40 tickets, each 6 numbers from 1..70
# Goal: every 6-subset draw has profit > 0
# profit = sum over tickets of (winnings[matches]-1)
# winnings = [0,0,36,360,36000,3600000,360000000]

WIN = [0,0,36,360,36000,3600000,360000000]

def profit(tickets, draw):
    d = set(draw)
    p = 0
    for t in tickets:
