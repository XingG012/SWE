# Local search: simulated annealing over ticket sets.
# Objective: minimize number of bad draws in a fixed pool.

def random_ticket():
    return tuple(sorted(random.sample(range(1,71), 6)))

def profit_fast(tickets, draw):
    d = set(draw)
    p = 0
    for t in tickets:
        m = len(d & set(t))
        p += WIN[m] - 1
    return p

random.seed(42)

# Use a moderate pool for speed
POOL = [tuple(sorted(random.sample(range(1,71), 6))) for _ in range(20000)]

def count_bad(tickets):
    c = 0
    for draw in POOL:
        if profit_fast(tickets, draw) <= 0:
            c += 1
    return c

tickets = [random_ticket() for _ in range(40)]
print("initial bad:", count_bad(tickets))
