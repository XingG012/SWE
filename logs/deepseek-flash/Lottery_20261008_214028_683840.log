    p = 0
    for t in tickets:
        m = len(d & set(t))
        p += WIN[m] - 1
    return p

random.seed(42)

# Generate a large pool of draws to test against
POOL = [tuple(sorted(random.sample(range(1,71), 6))) for _ in range(200000)]

