# Direct randomized search with local moves.
# We maintain 40 tickets. We sample draws, find bad ones, and try to fix.

def random_ticket():
    return tuple(sorted(random.sample(range(1,71), 6)))

def profit_fast(tickets, draw):
    d = set(draw)
    p = 0
    for t in tickets:
        m = len(d & t)
        p += WIN[m] - 1
    return p

random.seed(42)
tickets = [random_ticket() for _ in range(40)]

# Sample draws and find bad ones
def find_bad(tickets, n=100000):
    bad = []
    for _ in range(n):
        draw = tuple(sorted(random.sample(range(1,71), 6)))
        if profit_fast(tickets, draw) <= 0:
            bad.append(draw)
    return bad

bad = find_bad(tickets)
print("initial bad count:", len(bad))
