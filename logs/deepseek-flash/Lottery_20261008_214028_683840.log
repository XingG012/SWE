# Local search: simulated annealing over ticket sets.
def random_ticket():
    return tuple(sorted(random.sample(range(1,71), 6)))

def profit_fast(tickets, draw):
    d = set(draw)
    p = 0
    for t in tickets:
        m = len(d & set(t))
        p += WIN[m] - 1
    return p

random.seed(42)
POOL = [tuple(sorted(random.sample(range(1,71), 6))) for _ in range(30000)]

def count_bad(tickets):
    c = 0
    for draw in POOL:
        if profit_fast(tickets, draw) <= 0:
            c += 1
    return c

# Start from group construction (4 per group)
groups = [list(range(i*7+1, i*7+8)) for i in range(10)]
tickets = []
for g in groups:
    for skip in range(4):
        t = tuple(sorted(x for i,x in enumerate(g) if i != skip))
        tickets.append(t)

best = count_bad(tickets)
print("start bad:", best)
