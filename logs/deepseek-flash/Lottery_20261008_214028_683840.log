def random_ticket():
    return tuple(sorted(random.sample(range(1,71), 6)))

def profit_fast(tickets, draw):
    d = set(draw)
    p = 0
    for t in tickets:
        m = len(d & set(t))
        p += WIN[m] - 1
    return p

random.seed(42)
POOL = [tuple(sorted(random.sample(range(1,71), 6))) for _ in range(30000)]

def count_bad(tickets):
    c = 0
    for draw in POOL:
        if profit_fast(tickets, draw) <= 0:
            c += 1
    return c

