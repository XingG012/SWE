from pwn import *
import collections

samples = []
for i in range(100):
    try:
        r = remote("rev.chal.csaw.io", 8000, timeout=5)
        data = r.recvall(timeout=3).decode(errors="ignore")
        r.close()
        lines = data.replace("\r","").split("\n")
        for line in lines:
            if len(line) == 21:
                samples.append(line)
                break
    except Exception as e:
        print("err", e)

print("collected", len(samples))

# Count character frequencies
cnt = collections.Counter()
for s in samples:
    cnt.update(s)
print("freqs:", dict(cnt))

# The flag is a permutation. We know it starts with 'flag{'.
# Use position-based analysis: for each position, count chars
pos = [collections.Counter() for _ in range(21)]
for s in samples:
    for i,c in enumerate(s):
        pos[i][c] += 1

for i in range(21):
    print(i, pos[i].most_common(5))
end_of_edit

