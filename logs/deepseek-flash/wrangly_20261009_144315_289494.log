from pwn import *
import collections

samples = []
for i in range(10):
    try:
        r = remote("rev.chal.csaw.io", 8000, timeout=5)
        data = r.recvall(timeout=3).decode(errors="ignore")
        r.close()
        lines = data.replace("\r","").split("\n")
        for line in lines:
            if len(line) == 21:
                samples.append(line)
                break
    except Exception as e:
        pass

print("collected", len(samples))
for s in samples:
    print(s)
# multiset
c = collections.Counter()
for s in samples:
    c.update(s)
print("multiset:", dict(c))
end_of_edit

