from pwn import *
import collections

samples = []
for i in range(50):
    try:
        r = remote("rev.chal.csaw.io", 8000, timeout=5)
        data = r.recvall(timeout=3).decode(errors="ignore")
        r.close()
        # find the shuffled line
        for line in data.split("\n"):
            line = line.strip()
            if len(line) == 22 and "win" not in line:
                samples.append(line)
                break
    except Exception as e:
        print("err", e)

print("collected", len(samples))
for s in samples:
    print(s)

# count char frequencies
cnt = collections.Counter()
for s in samples:
    cnt.update(s)
print("freqs:", cnt)
end_of_edit

