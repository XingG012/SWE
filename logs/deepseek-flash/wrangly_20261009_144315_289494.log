#include <stdio.h>
#include <string.h>
#include <stdlib.h>

int main() {
    // strfry uses random() with default seed 1
    // We need to replicate the exact sequence.
    // strfry implementation: for i from len-1 down to 1: j = random() % (i+1); swap(s[i], s[j])
    // But glibc strfry: for (i = 0; i < len; i++) { j = random() % len; swap }
    // Let's just use the actual strfry on an index array.
    char buf[22];
    for (int i = 0; i < 21; i++) buf[i] = 'A' + i; // A..U
    buf[21] = 0;
    // We need to reset random seed to match. But strfry uses random() which is seeded by srandom.
    // Default seed is 1.
    srandom(1);
    strfry(buf);
    printf("shuffled: %s\n", buf);
    // Now map: position i in output came from which original index
    for (int i = 0; i < 21; i++) {
        printf("%d ", buf[i] - 'A');
    }
    printf("\n");
    return 0;
}
end_of_edit

