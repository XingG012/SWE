import requests
import hashlib
import binascii

BASE = "http://crypto.chal.csaw.io:5000"

# Load recovered x
with open("x.txt") as f:
    x = int(f.read().strip())

# Get public key
pk = requests.get(BASE + "/public_key").json()
p = pk["p"]; q = pk["q"]; g = pk["g"]; y = pk["y"]

# Get a valid Fernet challenge
challenge = requests.get(BASE + "/challenge").content
print("challenge:", challenge)

# Sign the challenge with DSA using our x
# Use a random k (doesn't matter, we know x)
import os
k = int.from_bytes(os.urandom(32), "big") % (q - 2) + 2
r = pow(g, k, p) % q
h = int.from_bytes(hashlib.sha1(challenge).digest(), "big")
s = (pow(k, -1, q) * (h + r * x)) % q

# DER encode the signature
def der_int(n):
    b = n.to_bytes((n.bit_length() + 7) // 8 or 1, "big")
    if b[0] & 0x80:
        b = b"\x00" + b
    return b"\x02" + bytes([len(b)]) + b

def der_seq(content):
    return b"\x30" + bytes([len(content)]) + content

sig_der = der_seq(der_int(r) + der_int(s))
print("sig hex:", sig_der.hex())

# POST to /capture
resp = requests.post(BASE + "/capture", data={
    "signature": sig_der.hex(),
    "challenge": challenge.decode("ascii")
})
print("status:", resp.status_code)
print("response:", resp.text)
