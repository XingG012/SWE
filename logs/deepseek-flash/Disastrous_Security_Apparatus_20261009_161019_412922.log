import requests
import hashlib
import binascii
import json

BASE = "http://crypto.chal.csaw.io:5000"

def unshift_right_xor(y, shift):
    x = y
    for _ in range(32 // shift + 1):
        x = y ^ (x >> shift)
    return x & 0xffffffff

def unshift_left_xor_mask(y, shift, mask):
    x = y
    for _ in range(32 // shift + 1):
        x = y ^ ((x << shift) & mask)
    return x & 0xffffffff

def untemper(y):
    y = unshift_right_xor(y, 18)
    y = unshift_left_xor_mask(y, 15, 0xefc60000)
    y = unshift_left_xor_mask(y, 7, 0x9d2c5680)
    y = unshift_right_xor(y, 11)
    return y

class MTPredictor:
    def __init__(self, state, index):
        self.mt = state[:]
        self.index = index

    def genrand_uint32(self):
        if self.index >= 624:
            self.twist()
        y = self.mt[self.index]
        self.index += 1
        y ^= (y >> 11)
        y ^= (y << 7) & 0x9d2c5680
        y ^= (y << 15) & 0xefc60000
        y ^= (y >> 18)
        return y & 0xffffffff

    def twist(self):
        mt = self.mt
        for i in range(624):
            y = (mt[i] & 0x80000000) + (mt[(i+1) % 624] & 0x7fffffff)
            mt[i] = mt[(i + 397) % 624] ^ (y >> 1)
            if y % 2 != 0:
                mt[i] ^= 0x9908b0df
        self.index = 0

    def getrandbits(self, k):
        if k <= 32:
            return self.genrand_uint32() >> (32 - k)
        result = 0
        shift = 0
        while k > 0:
            if k <= 32:
                word = self.genrand_uint32() >> (32 - k)
                result |= word << shift
                k = 0
            else:
                word = self.genrand_uint32()
                result |= word << shift
                shift += 32
                k -= 32
        return result

    def randbelow(self, n):
        k = n.bit_length()
        r = self.getrandbits(k)
        while r >= n:
            r = self.getrandbits(k)
        return r

    def randrange(self, start, stop):
        width = stop - start
        return start + self.randbelow(width)

def twist_state(state):
    mt = state[:]
    for i in range(624):
        y = (mt[i] & 0x80000000) + (mt[(i+1) % 624] & 0x7fffffff)
        mt[i] = mt[(i + 397) % 624] ^ (y >> 1)
        if y % 2 != 0:
            mt[i] ^= 0x9908b0df
    return mt

# Get public key
pk = requests.get(BASE + "/public_key").json()
p = pk["p"]; q = pk["q"]; g = pk["g"]; y = pk["y"]
print("q bits:", q.bit_length())

# Collect leaks
N = 320
values = []
for i in range(N):
    r = requests.get(BASE + "/forgotpass")
    token = r.text.strip().split("/")[-1]
    values.append(int(token, 16))
print("collected", len(values))

words = []
for v in values:
    words.append(v & 0xffffffff)
    words.append((v >> 32) & 0xffffffff)

untempered = [untemper(w) for w in words]
twisted = twist_state(untempered[0:624])
pred = MTPredictor(twisted, 16)

# Predict k for next sign
k_pred = pred.randrange(2, q)
print("predicted k:", k_pred)

# Get signature
sig = requests.get(BASE + "/sign/test").json()
r_sig = sig["r"]; s_sig = sig["s"]

# Recover x: x = (s*k - h) * r^-1 mod q
h = int.from_bytes(hashlib.sha1(b"test").digest(), "big")
x = ((s_sig * k_pred - h) * pow(r_sig, -1, q)) % q
print("recovered x:", x)

# Verify: y == g^x mod p
y_check = pow(g, x, p)
print("y matches:", y_check == y)

with open("x.txt", "w") as f:
    f.write(str(x))
