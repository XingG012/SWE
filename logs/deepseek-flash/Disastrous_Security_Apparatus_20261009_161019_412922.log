import requests
import struct

BASE = "http://crypto.chal.csaw.io:5000"

values = []
for i in range(320):
    r = requests.get(BASE + "/forgotpass")
    token = r.text.strip().split("/")[-1]
    val = int(token, 16)
    values.append(val)
    if i % 50 == 0:
        print(f"collected {i}")

with open("leaks.txt", "w") as f:
    for v in values:
        f.write(f"{v}\n")
print("done, total:", len(values))
