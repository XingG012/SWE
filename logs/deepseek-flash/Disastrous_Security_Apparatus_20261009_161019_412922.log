import random

def unshift_right_xor(y, shift):
    x = y
    for _ in range(32 // shift + 1):
        x = y ^ (x >> shift)
    return x & 0xffffffff

def unshift_left_xor_mask(y, shift, mask):
    x = y
    for _ in range(32 // shift + 1):
        x = y ^ ((x << shift) & mask)
    return x & 0xffffffff

def untemper(y):
    y = unshift_right_xor(y, 18)
    y = unshift_left_xor_mask(y, 15, 0xefc60000)
    y = unshift_left_xor_mask(y, 7, 0x9d2c5680)
    y = unshift_right_xor(y, 11)
    return y

# Load leaks
values = []
with open("leaks.txt") as f:
    for line in f:
        values.append(int(line.strip()))

# Each value = b1 | (b2 << 32), b1 first, b2 second
words = []
for v in values:
    b1 = v & 0xffffffff
    b2 = (v >> 32) & 0xffffffff
    words.append(b1)
    words.append(b2)

print("total words:", len(words))

# Untemper all
untempered = [untemper(w) for w in words]

# Now reconstruct MT state. We have 640 untempered outputs.
# The state array has 624 entries. Consecutive outputs come from consecutive indices.
# We need to find the state. Use the twist relation to verify.
# Approach: take 624 consecutive untempered values as candidate state, then verify by twisting.

def twist(state):
    mt = state[:]
    for i in range(624):
        y = (mt[i] & 0x80000000) + (mt[(i+1) % 624] & 0x7fffffff)
        mt[i] = mt[(i + 397) % 624] ^ (y >> 1)
        if y % 2 != 0:
            mt[i] ^= 0x9908b0df
    return mt

# Try each starting offset
for start in range(len(untempered) - 624 + 1):
    candidate = untempered[start:start+624]
    twisted = twist(candidate)
