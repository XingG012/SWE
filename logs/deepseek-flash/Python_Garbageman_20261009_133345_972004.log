import ast, sys

BANNED = {
    ast.Import, ast.ImportFrom, ast.With, ast.alias, ast.Attribute, ast.Constant,
    ast.Subscript, ast.Assign, ast.AnnAssign, ast.AugAssign, ast.For, ast.Try,
    ast.ExceptHandler, ast.withitem, ast.FunctionDef, ast.Lambda, ast.ClassDef,
    ast.If, ast.And, ast.comprehension, ast.In, ast.Await, ast.Global, ast.Gt,
    ast.ListComp, ast.Slice, ast.Return, ast.List, ast.Dict, ast.Lt, ast.AsyncFunctionDef,
    ast.Eq, ast.keyword, ast.Mult, ast.arguments, ast.FormattedValue, ast.Not,
    ast.BoolOp, ast.Or, ast.Compare, ast.GtE, ast.Tuple, ast.NotEq, ast.IfExp,
    ast.UnaryOp, ast.arg, ast.JoinedStr,
}

def gadget(a, b):
    a.myExit = b

def banner():
    return ""

myExit = exit

def hook(event, args):
    if not hook.exec and 'exec' in event:
        hook.exec = True
        return
    strr = event + " ".join(f"{x}" for x in args)
    strr = strr.lower()
    if any(i in strr for i in ['exec','print','import','system','flag','spawn','fork','open','subprocess','sys','ast','os','audit','hookcompile','__new__','frame']):
        print("BONK audit!", event, args)
        myExit()
    print("audit!", event, args)

hook.exec = False

with open('payload.txt') as f:
    code = f.read()

tree = ast.parse(code)
for node in ast.walk(tree):
    if type(node) in BANNED:
        print("BANNED NODE:", type(node).__name__)
        sys.exit(1)

sys.addaudithook(hook)
exec(code, {"__builtins__": __builtins__, "gadget": gadget, "banner": banner})
end_of_edit

