ONE = "len(str(int()))"
TWO = f"({ONE}+{ONE})"

def num(n):
    # build expression for integer n using ONE and pow
    if n == 0:
        return "int()"
    if n == 1:
        return ONE
    # binary decomposition
    parts = []
    k = 0
    while n:
        if n & 1:
            if k == 0:
                parts.append(ONE)
            elif k == 1:
                parts.append(TWO)
            else:
                # pow(TWO, k)
                parts.append(f"pow({TWO},{num(k)})")
        n >>= 1
        k += 1
    return "(" + "+".join(parts) + ")"

def s(text):
    # build string from chars using chr
    return "+".join(f"chr({num(ord(c))})" for c in text)

if __name__ == "__main__":
    for t in ["__globals__", "__setitem__", "myExit", "flag.txt", "hook", "exec"]:
        print(t, "=>", s(t)[:200])
