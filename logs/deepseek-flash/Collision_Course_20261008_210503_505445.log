import csv
import hashlib
import sys
sys.path.insert(0, 'handout')
import my_aes

salt = 'v0o'

# Build hash -> id mapping
hash_to_id = {}
for i in range(1, 501):
    h = hashlib.md5((str(i) + salt).encode()).hexdigest()[:4]
    hash_to_id[h] = i

# Read the encrypted database in order and reconstruct the password
encryption_password = ''
with open('handout/encrypted_database.csv') as fin:
    reader = csv.DictReader(fin)
    for row in reader:
        encryption_password += str(hash_to_id[row['id']])

print(f"Reconstructed password length: {len(encryption_password)}")

# Decrypt the password file
data = my_aes.decrypt_from_file(encryption_password, 'handout/password.bin')
print(f"Decrypted data: {data}")
end_of_edit

