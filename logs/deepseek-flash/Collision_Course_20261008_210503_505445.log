edit 1:1
import csv
import hashlib
import itertools
import string

# Read the hashed IDs from the encrypted database
hashed_ids = []
with open('handout/encrypted_database.csv') as fin:
    reader = csv.DictReader(fin)
    for row in reader:
        hashed_ids.append(row['id'])

hashed_set = set(hashed_ids)
print(f"Number of hashed IDs: {len(hashed_ids)}, unique: {len(hashed_set)}")

# Try all possible salts
chars = 'abcdefghijklmnopqrstuvwxyz0123456789'
found = []
for salt in itertools.product(chars, repeat=3):
    salt = ''.join(salt)
    # Compute hashes for all IDs 1-500
    computed = {}
    ok = True
    for i in range(1, 501):
        h = hashlib.md5((str(i) + salt).encode()).hexdigest()[:4]
        if h in computed:
            ok = False
            break
        computed[h] = i
    if not ok:
        continue
    # Check if the set of computed hashes matches the CSV hashes
    if set(computed.keys()) == hashed_set:
        print(f"Found salt: {salt}")
        found.append(salt)

print(f"Total found: {found}")
