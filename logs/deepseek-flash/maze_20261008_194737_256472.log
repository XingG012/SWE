def dfs(node):
    visited.add(node)
    path.append(node)
    if len(path) == N:
        return True
    # Warnsdorff: sort by number of onward unvisited moves
    cands = []
    for d in sorted(adj[node].keys()):
        nxt = adj[node][d]
        if nxt not in visited:
            deg = sum(1 for t in adj[nxt].values() if t not in visited)
            cands.append((deg, d, nxt))
    cands.sort()
    for deg, d, nxt in cands:
        if dfs(nxt):
            return True
    visited.discard(node)
    path.pop()
    return False

ok = dfs(start)
print("found:", ok, "len:", len(path))
if ok:
    moves = []
    for i in range(len(path)-1):
        a, b = path[i], path[i+1]
        for d,t in adj[a].items():
            if t == b:
                moves.append(str(d))
                break
    print("moves:", "".join(moves))
end_of_edit

