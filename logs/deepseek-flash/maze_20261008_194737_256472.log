            p += 5
        else:
            continue
        # parse mov rcx
        if b[p:p+3] == bytes.fromhex("48c7c1"):
            rcx = struct.unpack("<i", b[p+3:p+7])[0]
        elif b[p] == 0xb9:
            rcx = struct.unpack("<i", b[p+1:p+5])[0]
        else:
