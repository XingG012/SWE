import struct

data = open("maze_public","rb").read()
# .text: vaddr 0x400080, offset 0x80, size 0x73dd
TEXT_VA = 0x400080
TEXT_OFF = 0x80
TEXT_SIZE = 0x73dd

def read(va, n):
    off = TEXT_OFF + (va - TEXT_VA)
    return data[off:off+n]

BLOCK_SIZE = 0xcd
# find all blocks: they start with 48 8d 05 f9 ff ff ff c6 00 c3
blocks = []
for va in range(TEXT_VA, TEXT_VA+TEXT_SIZE, 1):
    b = read(va, 10)
    if b == bytes.fromhex("488d05f9ffffffc600c3"):
        blocks.append(va)
print("num blocks:", len(blocks))
print("first:", hex(blocks[0]), "last:", hex(blocks[-1]))
# check spacing
diffs = set(blocks[i+1]-blocks[i] for i in range(len(blocks)-1))
print("diffs:", [hex(d) for d in diffs])
