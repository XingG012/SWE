# Find Hamiltonian path starting at 0x403eb6
start = 0x403eb6
N = len(blocks)
path = []
visited = set()

import sys
sys.setrecursionlimit(10000)

def dfs(node):
    visited.add(node)
    path.append(node)
    if len(path) == N:
        return True
    # try moves
    for d in sorted(adj[node].keys()):
        nxt = adj[node][d]
        if nxt not in visited:
            if dfs(nxt):
                return True
    visited.discard(node)
    path.pop()
    return False

ok = dfs(start)
print("found:", ok, "len:", len(path))
if ok:
    # reconstruct moves
    moves = []
    for i in range(len(path)-1):
        a, b = path[i], path[i+1]
        for d,t in adj[a].items():
            if t == b:
                moves.append(str(d))
                break
    print("moves:", "".join(moves))
