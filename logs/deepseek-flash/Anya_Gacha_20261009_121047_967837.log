import hashlib, base64, urllib.request, urllib.parse

counter = b"wakuwaku"
url = "http://rev.chal.csaw.io:10010/"

for i in range(1, 200):
    counter = hashlib.sha256(counter).digest()
    data = base64.b64encode(counter).decode()
    body = urllib.parse.urlencode({"data": data}).encode()
    try:
        req = urllib.request.Request(url, data=body)
        resp = urllib.request.urlopen(req, timeout=10).read().decode()
    except Exception as e:
        resp = "ERR:" + str(e)
    print(i, data, repr(resp))
    if resp and not resp.startswith("ERR"):
        print("FOUND at", i)
        break
