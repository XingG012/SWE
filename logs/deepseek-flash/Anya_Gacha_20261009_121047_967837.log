import hashlib, base64, urllib.request, urllib.parse

url = "http://rev.chal.csaw.io:10010"

def send(data_bytes):
    data = base64.b64encode(data_bytes).decode()
    body = urllib.parse.urlencode({"data": data}).encode()
    try:
        req = urllib.request.Request(url, data=body)
        resp = urllib.request.urlopen(req, timeout=10).read().decode()
    except Exception as e:
        resp = "ERR:" + str(e)
    return resp

# Try hashing common strings
candidates = ["wakuwaku", "anya", "Anya", "flag", "FLAG", "gacha", "Gacha", "rare", "coin", "wish", "lucky", "draw", "pull", "character", "server", "password", "secret", "admin", "root", "test"]
for c in candidates:
    h = hashlib.sha256(c.encode()).digest()
    r = send(h)
    print("hash of", c, "->", repr(r))
    if r and not r.startswith("ERR"):
        print("FOUND:", c)
        break
end_of_edit

