with open('qr_code.txt') as f:
    nums = [int(x) for x in f.read().split()]

print("count:", len(nums))
n = len(nums)
img = Image.new('1', (n, n), 1)
pixels = img.load()
for y, num in enumerate(nums):
    bits = format(num, '0{}b'.format(n))
    for x, b in enumerate(bits):
        pixels[x, y] = 0 if b == '1' else 1
img = img.resize((n*10, n*10), Image.NEAREST)
img.save('qr.png')
print("saved")
end_of_edit
```

