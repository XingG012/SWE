    nums = [int(x) for x in f.read().split()]

print("count:", len(nums))
print("max bits:", max(n.bit_length() for n in nums))

maxbits = max(n.bit_length() for n in nums)
for n in nums:
    print(format(n, '0{}b'.format(maxbits)))
