from pwn import *
import math

context.log_level = 'error'

def query(inputs):
    io = remote('mandf.csaw.io', 3000)
    io.recvuntil(b'Enter your input:')
    for i in inputs:
        io.sendline(str(i).encode())
        try:
            io.recvuntil(b'Enter your input:', timeout=2)
        except:
            break
    try:
        data = io.recvall(timeout=3)
    except:
        data = b''
    io.close()
    s = data.decode()
    idx = s.find('Your result is:')
    val = float(s[idx+len('Your result is:'):].strip())
    return val

def z_from_r(r):
    if r <= 0: return float('-inf')
    if r >= 1: return float('inf')
    return math.log(r/(1-r))

b = z_from_r(query([0]*30))
print("bias b =", b)

weights = []
for pos in range(30):
    inp = [0]*30
    inp[pos] = 1
    r = query(inp)
    z = z_from_r(r)
    w = z - b
    weights.append(w)

# The fractional part is constant; extract integer part
frac = 0.054958899550954
chars = []
for w in weights:
    n = round(-w + frac)
    chars.append(n)
print("N values:", chars)
flag = ''.join(chr(c) for c in chars)
print("FLAG:", flag)
