from pwn import *
import math

context.log_level = 'error'

def query(inputs):
    io = remote('mandf.csaw.io', 3000)
    io.recvuntil(b'Enter your input:')
    for i in inputs:
        io.sendline(str(i).encode())
        try:
            io.recvuntil(b'Enter your input:', timeout=2)
        except:
            break
    try:
        data = io.recvall(timeout=3)
    except:
        data = b''
    io.close()
    # parse result
    s = data.decode()
    idx = s.find('Your result is:')
    val = float(s[idx+len('Your result is:'):].strip())
    return val

def z_from_r(r):
    # sigmoid(z) = r => z = ln(r/(1-r))
    if r <= 0: return float('-inf')
    if r >= 1: return float('inf')
    return math.log(r/(1-r))

# bias
b = z_from_r(query([0]*30))
print("bias b =", b)

weights = []
for pos in range(30):
    inp = [0]*30
    inp[pos] = 1
    r = query(inp)
    z = z_from_r(r)
    w = z - b
    weights.append(w)
    print("pos", pos, "w =", w)
end_of_edit

