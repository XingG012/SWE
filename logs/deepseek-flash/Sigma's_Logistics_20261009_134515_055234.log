from pwn import *

context.log_level = 'error'

def query(inputs):
    io = remote('mandf.csaw.io', 3000)
    io.recvuntil(b'Enter your input:')
    for i in inputs:
        io.sendline(str(i).encode())
        try:
            io.recvuntil(b'Enter your input:', timeout=2)
        except:
            break
    try:
        data = io.recvall(timeout=3)
    except:
        data = b''
    io.close()
    return data

# Test various patterns
tests = {
    'all_1': [1]*30,
    'all_0': [0]*30,
    'all_neg1': [-1]*30,
    'all_100': [100]*30,
    'all_neg100': [-100]*30,
    'all_1000': [1000]*30,
    'all_neg1000': [-1000]*30,
    'all_10': [10]*30,
    'all_neg10': [-10]*30,
}

for name, inp in tests.items():
    print(name, "->", query(inp))
