edit 1:1
import hashlib
import itertools

target = "7f4986da7d7b52fa81f98278e6ec9dcb"

# Generate date range - Aaron's birthday likely in some reasonable range
# Try years 1970-2010, all months and days
dates = []
for year in range(1970, 2011):
    for month in range(1, 13):
        for day in range(1, 32):
            dates.append(f"{year:04d}{month:02d}{day:02d}")

names = ["aaron", "Aaron", "AARON"]

candidates = []
for name in names:
    for date in dates:
        candidates.append(name + date)
        candidates.append(date + name)
        candidates.append(name.capitalize() + date)

# Also try with separators
for name in names:
    for date in dates:
        candidates.append(name + "_" + date)
        candidates.append(name + "-" + date)

found = False
for c in candidates:
    h = hashlib.md5(c.encode()).hexdigest()
    if h == target:
        print("FOUND:", c)
        found = True
        break

if not found:
    print("Not found in", len(candidates), "candidates")
end_of_edit

