    lhs, rhs = expr.split('=')
    rhs = float(rhs.strip())
    # evaluate lhs with X=0 and X=1
    e0 = eval(lhs.replace('X', '(0)'))
    e1 = eval(lhs.replace('X', '(1)'))
    # lhs = e0 + X*(e1-e0)
    # e0 + X*(e1-e0) = rhs
    ans = (rhs - e0) / (e1 - e0)
    return ans

while True:
