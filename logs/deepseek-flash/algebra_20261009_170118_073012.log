from pwn import *
import re

context.log_level = 'debug'

io = remote('misc.chal.csaw.io', 4324)

while True:
    try:
        data = io.recvuntil(b'?', timeout=5)
    except EOFError:
        break
    print("RECV:", data)
    text = data.decode(errors='ignore')
    # find equation like "x + 3 = 7" or similar
    m = re.search(r'([\d\.]+)\s*([\+\-\*/])\s*([\d\.]+)', text)
    if m:
        a = float(m.group(1))
        op = m.group(2)
        b = float(m.group(3))
        if op == '+':
            ans = a + b
        elif op == '-':
            ans = a - b
        elif op == '*':
            ans = a * b
        elif op == '/':
            ans = a / b
        io.sendline(str(ans).encode())
    else:
        print("No equation found")
        break

io.interactive()
end_of_edit

