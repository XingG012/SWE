from pwn import *
import re
from fractions import Fraction

context.log_level = 'info'

io = remote('misc.chal.csaw.io', 4324)

def solve_expr(expr):
    lhs, rhs = expr.split('=')
    rhs = int(rhs.strip())
    e0 = eval(lhs.replace('X', '(0)'))
    e1 = eval(lhs.replace('X', '(1)'))
    # e0 + X*(e1-e0) = rhs
    num = rhs - e0
    den = e1 - e0
    ans = Fraction(num, den)
    return ans

while True:
    try:
        data = io.recvuntil(b'?:', timeout=5)
    except EOFError:
        break
    text = data.decode(errors='ignore')
    print("RECV:", repr(text))
    # complex expression case
    m = re.search(r'([\(\)\d\.\+\-\*/X ]+)\s*=\s*(-?[\d\.]+)\s*\nWhat does X equal', text)
    if m and 'X' in m.group(1) and '(' in m.group(1):
        expr = m.group(1) + ' = ' + m.group(2)
        ans = solve_expr(expr)
        io.sendline(str(ans).encode())
        continue
    # format: 10 - X = 51  OR  X + 5 = 119
    m = re.search(r'([\d\.]+)\s*([\+\-\*/])\s*X\s*=\s*([\d\.]+)', text)
    if m:
        a = float(m.group(1))
        op = m.group(2)
        c = float(m.group(3))
        if op == '+':
            ans = c - a
        elif op == '-':
            ans = a - c
        elif op == '*':
            ans = c / a
        elif op == '/':
            ans = a / c
        io.sendline(str(ans).encode())
        continue
    m = re.search(r'X\s*([\+\-\*/])\s*([\d\.]+)\s*=\s*([\d\.]+)', text)
    if m:
        op = m.group(1)
        b = float(m.group(2))
        c = float(m.group(3))
        if op == '+':
            ans = c - b
        elif op == '-':
            ans = c + b
        elif op == '*':
            ans = c / b
        elif op == '/':
            ans = c * b
        io.sendline(str(ans).encode())
        continue
    print("No equation found")
    break

io.interactive()
