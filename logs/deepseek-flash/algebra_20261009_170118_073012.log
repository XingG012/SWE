from pwn import *
import re

context.log_level = 'info'

io = remote('misc.chal.csaw.io', 4324)

while True:
    try:
        data = io.recvuntil(b'?:', timeout=5)
    except EOFError:
        break
    text = data.decode(errors='ignore')
    print("RECV:", repr(text))
    # format: 10 - X = 51  OR  X + 5 = 119
    m = re.search(r'([\d\.]+)\s*([\+\-\*/])\s*X\s*=\s*([\d\.]+)', text)
    if m:
        a = float(m.group(1))
        op = m.group(2)
        c = float(m.group(3))
        if op == '+':
            ans = c - a
        elif op == '-':
            ans = a - c
        elif op == '*':
            ans = c / a
        elif op == '/':
            ans = a / c
        io.sendline(str(ans).encode())
        continue
    m = re.search(r'X\s*([\+\-\*/])\s*([\d\.]+)\s*=\s*([\d\.]+)', text)
    if m:
        op = m.group(1)
        b = float(m.group(2))
        c = float(m.group(3))
        if op == '+':
            ans = c - b
        elif op == '-':
            ans = c + b
        elif op == '*':
            ans = c / b
        elif op == '/':
            ans = c * b
        io.sendline(str(ans).encode())
        continue
    print("No equation found")
    break

io.interactive()
end_of_edit

