def up(x):
    x = [f"{ord(x[i]) << 1:08b}" for i in range(len(x))]
    return ''.join(x)

def down(x):
    x = ''.join(['1' if x[i] == '0' else '0' for i in range(len(x))])
    return x

def right(x,d):
    x = x[d:] + x[0:d]
    return x

def left(x,d):
    x = right(x,len(x)-d)
    return x[::-1]

def encode(plain):
    d = 24
    x = up(plain)
    x = right(x,d)
    x = down(x)
    x = left(x,d)
    return x

# Reverse functions
def unleft(x,d):
    # left(x,d) = right(x, len-d)[::-1]
    # so to reverse: reverse first, then unright with len-d
    x = x[::-1]
    return unright(x, len(x)-d)

def unright(x,d):
    # right(x,d) = x[d:] + x[0:d]
    # reverse: rotate left by d
    return x[len(x)-d:] + x[0:len(x)-d]

def undown(x):
    return down(x)

def unup(x):
    # x is binary string, each 8 bits = ord(c) << 1
    chars = []
    for i in range(0, len(x), 8):
        b = x[i:i+8]
        val = int(b, 2)
        chars.append(chr(val >> 1))
    return ''.join(chars)

def decode(encoded):
    d = 24
    x = unleft(encoded, d)
    x = undown(x)
    x = unright(x, d)
    x = unup(x)
    return x

encoded = "1010000011111000101010101000001010100100110110001111111010001000100000101000111011000100101111011001100011011000101011001100100010011001110110001001000010001100101111001110010011001100"
print(decode(encoded))
