context.log_level = 'debug'
io = remote('cvv', 8000)
data = io.recvuntil(b'!')
print("PROMPT:", data)
card = data.split(b'new ')[1].split(b'!')[0]
print("CARD:", card)
io.sendline(card)
data = io.recv(timeout=3)
print("RESP1:", data)
# try sending a card number
io.sendline(b'4111111111111111')
data = io.recv(timeout=3)
print("RESP2:", data)
io.close()
