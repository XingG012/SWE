import socket, random

def luhn_check_digit(number):
    # number is string of digits without check digit
    digits = [int(d) for d in number]
    digits.reverse()
    total = 0
    for i, d in enumerate(digits):
        if i % 2 == 0:
            d *= 2
            if d > 9:
                d -= 9
        total += d
    return (10 - (total % 10)) % 10

def gen_card(prefix, length):
    body = prefix
    while len(body) < length - 1:
        body += str(random.randint(0, 9))
    check = luhn_check_digit(body)
    return body + str(check)

def gen_for_type(t):
    t = t.lower()
    if 'visa' in t:
        return gen_card('4', 16)
    if 'master' in t:
        return gen_card(str(random.randint(51,55)), 16)
    if 'discover' in t:
        return gen_card(random.choice(['6011','65','644','645','646','647','648','649']), 16)
    if 'american' in t or 'amex' in t:
        return gen_card(random.choice(['34','37']), 15)
    return None

s = socket.socket()
s.connect(('cvv', 8000))
s.settimeout(5)
buf = b''
count = 0
while True:
    try:
        data = s.recv(4096)
    except Exception as e:
        print("EXC:", e)
        break
    if not data:
        break
    buf += data
    print("RECV:", repr(data))
    if b'flag{' in buf:
        print("FLAG FOUND")
        break
    # check if asking for a card
    if b'I need a new ' in data:
        line = data.decode(errors='replace')
        # get last prompt
        idx = line.rfind('I need a new ')
        t = line[idx+len('I need a new '):].split('!')[0]
        card = gen_for_type(t)
        print("SENDING", t, card)
        s.sendall((card + '\n').encode())
        count += 1
        if count > 1000:
            print("too many")
            break
print("TOTAL:", count)
print("BUF:", buf[-500:])
s.close()
end_of_edit

