import socket
import time

HOST = "misc.chal.csaw.io"
PORT = 8000

s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.connect((HOST, PORT))
s.settimeout(5)

buf = b""
flag = ""

def recv_until_newline():
    global buf
    while b"\n" not in buf:
        data = s.recv(4096)
        if not data:
            return None
        buf += data
    line, buf = buf.split(b"\n", 1)
    return line

# Read initial banner lines
for _ in range(5):
    try:
        line = recv_until_newline()
        print("BANNER:", line)
    except Exception as e:
        print("err", e)
        break

while True:
    try:
        line = recv_until_newline()
    except Exception as e:
        print("timeout/err", e)
        break
    if line is None:
        break
    line = line.strip()
    print("RECV:", line)
    if len(line) == 11 and all(c in b"01" for c in line):
        bits = [int(c) for c in line]
        start = bits[0]
        data = bits[1:9]
        parity = bits[9]
        stop = bits[10]
        # LSB first
        val = 0
        for i, b in enumerate(data):
            val |= b << i
        ones = sum(data)
        # even parity: total ones in data+parity should be even
        ok = (start == 0) and (stop == 1) and ((ones + parity) % 2 == 0)
        if ok:
            flag += chr(val)
            print("BYTE OK:", chr(val), "flag so far:", flag)
            s.sendall(b"1\n")
        else:
            print("BYTE BAD, retransmit")
            s.sendall(b"0\n")
    else:
        print("non-frame line")

print("FINAL FLAG:", flag)
s.close()
end_of_edit

