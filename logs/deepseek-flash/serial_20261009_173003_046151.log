import socket

HOST = "misc.chal.csaw.io"
PORT = 8000

s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.connect((HOST, PORT))
s.settimeout(10)

buf = b""

def recv_until_newline():
    global buf
    while b"\n" not in buf:
        data = s.recv(4096)
        if not data:
            return None
        buf += data
    line, buf = buf.split(b"\n", 1)
    return line

print("BANNER:", recv_until_newline())

flag = ""
while True:
    try:
        line = recv_until_newline()
    except Exception as e:
        print("timeout/err", e)
        break
    if line is None:
        break
    line = line.strip()
    if len(line) == 11 and all(c in b"01" for c in line):
        bits = [int(c) for c in line]
        start = bits[0]
        data = bits[1:9]
        parity = bits[9]
        stop = bits[10]
        val = 0
        for i, b in enumerate(data):
            val |= b << i
        ones = sum(data)
        ok = (start == 0) and (stop == 1) and ((ones + parity) % 2 == 1)
        if ok:
            flag += chr(val)
            print("OK:", repr(chr(val)), "->", flag)
            s.sendall(b"1\n")
        else:
            print("BAD, retransmit")
            s.sendall(b"0\n")
    else:
        print("LINE:", line)

print("FINAL FLAG:", flag)
s.close()
end_of_edit

