edit 1:1
import socket

HOST = "misc.chal.csaw.io"
PORT = 8000

s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.connect((HOST, PORT))
s.settimeout(5)

buf = b""

def recv_until_newline():
    global buf
    while b"\n" not in buf:
        data = s.recv(4096)
        if not data:
            return None
        buf += data
    line, buf = buf.split(b"\n", 1)
    return line

# banner
print("BANNER:", recv_until_newline())

frames = []
for _ in range(60):
    line = recv_until_newline()
    if line is None:
        break
    line = line.strip()
    if len(line) == 11 and all(c in b"01" for c in line):
        frames.append(line.decode())
    s.sendall(b"0\n")  # always retransmit to keep getting frames

print("Collected", len(frames), "frames")
for f in frames:
    print(f)

# Analyze hypotheses
def analyze(frames):
    # hypothesis: start=bit0, data=bits1-9 (8 bits), parity=bit9, stop=bit10
    for order in ["lsb", "msb"]:
        for par in ["even", "odd"]:
            ok_count = 0
            for f in frames:
                bits = [int(c) for c in f]
                start = bits[0]
                data = bits[1:9]
                parity = bits[9]
                stop = bits[10]
                ones = sum(data)
                if par == "even":
                    good = (ones + parity) % 2 == 0
                else:
                    good = (ones + parity) % 2 == 1
                if start == 0 and stop == 1 and good:
                    ok_count += 1
            print(f"order={order} par={par}: {ok_count}/{len(frames)} valid")

analyze(frames)
s.close()
