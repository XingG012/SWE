# ncore VM program generator
# opcodes
ADD, SUB, AND, OR, RES, MOVF, MOVT, ENT, EXT, JGT, JEQ, JMP, INC, MOVFS = range(14)

ram = bytearray(256)

def emit(pc, byte0, byte1):
    ram[pc] = byte0
    ram[pc+1] = byte1

def enc(regA, regB, op):
    return ((regA & 3) << 6) | ((regB & 3) << 4) | (op & 0xF)

# data addresses
D_ZERO = 240
D_ONE  = 241
D_255  = 242
D_64   = 243

# ---- first loop: brute force key[13:0] ----
# pc=0: MOVF r0, D_ZERO   ; r0 = 0
emit(0, enc(0,0,MOVF), D_ZERO)
# pc=2: MOVF r1, D_ONE    ; r1 = 1
emit(2, enc(0,1,MOVF), D_ONE)
# pc=4: MOVF r2, D_ONE    ; r2 = 1
emit(4, enc(0,2,MOVF), D_ONE)
# pc=6: ENT
emit(6, enc(0,0,ENT), 0)
# pc=8: JEQ r3, r2, 12    ; if r3==r2 (fail), jump to 12
emit(8, enc(3,2,JEQ), 12)
# pc=10: JMP flag_start
FLAG_START = 16
emit(10, enc(0,0,JMP), FLAG_START)
# pc=12: INC r0
emit(12, enc(0,0,INC), 0)
# pc=14: JMP 6
emit(14, enc(0,0,JMP), 6)

# ---- second loop: read flag ----
# pc=16: MOVF r0, D_ZERO  ; r0 = 0 (i)
emit(16, enc(0,0,MOVF), D_ZERO)
# pc=18: MOVF r1, D_255   ; r1 = 255
emit(18, enc(0,1,MOVF), D_255)
# pc=20: MOVF r2, D_64    ; r2 = 64
emit(20, enc(0,2,MOVF), D_64)
# pc=22: MOVT r0, movfs_op ; patch MOVFS operand
MOVFS_OP = 29
emit(22, enc(0,0,MOVT), MOVFS_OP)
# pc=24: SUB r3, r1, r0   ; r3 = 255 - i
emit(24, enc(3,1,SUB), 0)
# pc=26: MOVT r3, movt_op  ; patch MOVT operand
MOVT_OP = 31
emit(26, enc(0,3,MOVT), MOVT_OP)
# pc=28: MOVFS r3, 0      ; r3 = safe_rom[i]  (operand patched)
emit(28, enc(0,3,MOVFS), 0)
# pc=30: MOVT r3, 0       ; ram[255-i] = r3  (operand patched)
emit(30, enc(0,3,MOVT), 0)
# pc=32: INC r0
emit(32, enc(0,0,INC), 0)
# pc=34: JGT r2, r0, 22   ; if 64 > i, loop
emit(34, enc(2,0,JGT), 22)

# data
ram[D_ZERO] = 0
ram[D_ONE]  = 1
ram[D_255]  = 255
ram[D_64]   = 64

# write ram.hex
with open("ram.hex", "w") as f:
    for b in ram:
        f.write("%02x\n" % b)

print("generated ram.hex")
