edit 1:49
from pwn import *

context.log_level = 'debug'

r = remote('misc.chal.csaw.io', 5000)

def query(bases):
    r.recvuntil(b'check?')
    r.sendline(str(len(bases)).encode())
    r.recvuntil(b'bases:')
    r.sendline(bases.encode())
    r.recvline()
    line = r.recvline()
    return int(line.split(b':')[1].strip())

N = 256
base = '+'*N
d = query(base)
print('baseline d =', d)

b = ['+']*N
for i in range(N):
    c = list(base)
    c[i] = 'x'
    e = query(''.join(c))
    if e == d - 1:
        b[i] = 'x'
    elif e == d + 1:
        b[i] = '+'
    else:
        print('unexpected', i, e)

print(''.join(b))
r.recvuntil(b'check?')
r.sendline(str(N).encode())
r.recvuntil(b'bases:')
r.sendline(''.join(b).encode())
import time
time.sleep(1)
try:
    data = r.recv(timeout=5)
    print('RESPONSE:', data)
except Exception as ex:
    print('err', ex)
r.close()
end_of_edit

