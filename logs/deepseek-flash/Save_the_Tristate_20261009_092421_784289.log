import socket, time

HOST, PORT = 'misc.chal.csaw.io', 5000

def recv_until(s, marker):
    data = b''
    while marker not in data:
        chunk = s.recv(4096)
        if not chunk:
            break
        data += chunk
    return data

def query(s, bases):
    recv_until(s, b'check?')
    s.sendall(str(len(bases)).encode() + b'\n')
    recv_until(s, b'bases:')
    s.sendall(bases.encode() + b'\n')
    data = recv_until(s, b'Errors:')
    # read rest of line
    line = b''
    while not line.endswith(b'\n'):
        line += s.recv(1)
    return int(line.split(b':')[1].strip())

s = socket.socket()
s.connect((HOST, PORT))

N = 256
base = '+'*N
t0 = time.time()
d = query(s, base)
print('baseline d =', d, 'time', time.time()-t0)

b = ['+']*N
for i in range(N):
    c = list(base)
    c[i] = 'x'
    e = query(s, ''.join(c))
    if e == d - 1:
        b[i] = 'x'
    elif e == d + 1:
        b[i] = '+'
    else:
        print('unexpected', i, e)

bstr = ''.join(b)
print('basis:', bstr)
print('time for queries:', time.time()-t0)
# submit
recv_until(s, b'check?')
s.sendall(str(N).encode() + b'\n')
recv_until(s, b'bases:')
s.sendall(bstr.encode() + b'\n')
time.sleep(1)
print('FINAL:', s.recv(65536))
s.close()
