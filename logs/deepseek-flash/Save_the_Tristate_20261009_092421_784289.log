from pwn import *

context.log_level = 'error'

r = remote('misc.chal.csaw.io', 5000)

def query(bases):
    r.recvuntil(b'check?')
    r.sendline(str(len(bases)).encode())
    r.recvuntil(b'bases:')
    r.sendline(bases.encode())
    r.recvline()
    line = r.recvline()
    return line

for _ in range(10):
    print(query('+'*100))
r.close()
