from pwn import *

context.log_level = 'error'

r = remote('misc.chal.csaw.io', 5000)

def query(bases):
    r.recvuntil(b'check?')
    r.sendline(str(len(bases)).encode())
    r.recvuntil(b'bases:')
    r.sendline(bases.encode())
    r.recvline()  # ' \r\n'
    line = r.recvline()  # 'Errors: X\r\n'
    return int(line.split(b':')[1].strip())

N = 256
base = '+'*N
d = query(base)
print('baseline d =', d)

b = ['+']*N
for i in range(N):
    c = list(base)
    c[i] = 'x'
    e = query(''.join(c))
    if e == d - 1:
        b[i] = 'x'
    elif e == d + 1:
        b[i] = '+'
    else:
        print('unexpected', i, e)

bstr = ''.join(b)
print('basis:', bstr)
# verify
print('verify errors:', query(bstr))
# now submit and read everything
r.recvuntil(b'check?')
r.sendline(str(N).encode())
