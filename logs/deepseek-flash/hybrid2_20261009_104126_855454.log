import gmpy2
from Crypto.Util.number import long_to_bytes

# Parse values
vals = {}
with open("values.txt") as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        k, v = line.split(":")
        vals[k] = int(v)

n1, c1 = vals["n1"], vals["c1"]
n2, c2 = vals["n2"], vals["c2"]
n3, c3 = vals["n3"], vals["c3"]
n4, c4 = vals["n4"], vals["c4"]
e = vals["e"]

print("e =", e)
print("n1 bits:", n1.bit_length())
print("n2 bits:", n2.bit_length())
print("n3 bits:", n3.bit_length())
print("n4 bits:", n4.bit_length())

# Try direct 5th root of c1 (if m^5 < n1)
for name, c in [("c1", c1), ("c2", c2), ("c3", c3), ("c4", c4)]:
    r, exact = gmpy2.iroot(c, e)
    if exact:
        print(f"Direct root worked on {name}: {long_to_bytes(int(r))}")
    else:
        print(f"Direct root failed on {name}")

# Hastad broadcast attack using CRT
ns = [n1, n2, n3, n4]
cs = [c1, c2, c3, c4]
# CRT
from functools import reduce
def crt(remainders, moduli):
    N = reduce(lambda a, b: a * b, moduli)
    result = 0
    for r, m in zip(remainders, moduli):
        Ni = N // m
        inv = gmpy2.invert(Ni, m)
        result += r * Ni * inv
    return result % N

N = reduce(lambda a, b: a * b, ns)
combined = crt(cs, ns)
r, exact = gmpy2.iroot(combined, e)
print("CRT exact:", exact)
if exact:
    print("CRT result:", long_to_bytes(int(r)))
end_of_edit

