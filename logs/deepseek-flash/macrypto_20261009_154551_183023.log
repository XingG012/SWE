from pwn import *
import sys

context.log_level = 'error'

def query(r, data):
    r.sendline(data)
    line = r.recvline().strip()
    return bytes.fromhex(line.decode())

r = remote("crypto.chal.csaw.io", 4512)

# Send input of length 1 (just newline handled by sendline)
# Actually sendline adds \n, so input n = data + "\n"
# Let's send a known input of length L
L = 1
data = b"A" * L
ct = query(r, data)
print("Input len:", L+1, "CT len:", len(ct))
print("CT:", ct.hex())

# The input n = data + "\n" (length L+1)
n = data + b"\n"
# First L+1 bytes of ct XOR n = keystream[0..L+1]
ks = bytes([ct[i] ^ n[i] for i in range(len(n))])
print("Recovered keystream prefix:", ks.hex())
# Remaining bytes are flag XOR keystream
flag_ct = ct[len(n):]
print("Flag ciphertext:", flag_ct.hex())
print("Flag len:", len(flag_ct))

r.close()
end_of_edit

