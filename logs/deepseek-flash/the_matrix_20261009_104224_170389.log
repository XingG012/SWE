import ast

# Read messages
messages = []
with open("messages.txt") as f:
    for line in f:
        line = line.strip()
        if line:
            messages.append(ast.literal_eval(line))

# Matrix: [3,6,a, b,4,2, 1,5,7]
# For each group of 3 outputs [o1,o2,o3]:
# o1 = 3x + 6y + a*z
# o2 = b*x + 4y + 2z
# o3 = x + 5y + 7z
# x,y,z in 0..26 (or -1 for padding)

# We need to find a, b such that all decrypted values are valid.
# Let's brute force a and b in a reasonable range.

def try_ab(a, b):
    for msg in messages:
        # process in groups of 3
        for i in range(0, len(msg), 3):
            o1, o2, o3 = msg[i], msg[i+1], msg[i+2]
            # Solve linear system:
            # 3x + 6y + a*z = o1
            # b*x + 4y + 2z = o2
            # x + 5y + 7z = o3
            # Use Cramer's rule
            # det = |3 6 a; b 4 2; 1 5 7|
            det = 3*(4*7 - 2*5) - 6*(b*7 - 2*1) + a*(b*5 - 4*1)
            if det == 0:
                return False
            # x: replace col0 with [o1,o2,o3]
            detx = o1*(4*7 - 2*5) - 6*(o2*7 - 2*o3) + a*(o2*5 - 4*o3)
            # y: replace col1
            dety = 3*(o2*7 - 2*o3) - o1*(b*7 - 2*1) + a*(b*o3 - o2*1)
            # z: replace col2
            detz = 3*(4*o3 - o2*5) - 6*(b*o3 - o2*1) + o1*(b*5 - 4*1)
            if detx % det != 0 or dety % det != 0 or detz % det != 0:
                return False
            x, y, z = detx//det, dety//det, detz//det
            for v in (x, y, z):
                if not (0 <= v <= 26 or v == -1):
                    return False
    return True

solutions = []
for a in range(-50, 51):
    for b in range(-50, 51):
        if try_ab(a, b):
            solutions.append((a, b))
print("Solutions:", solutions)
