edit 1:1
import ast
from pwn import *

messages = []
with open("messages.txt") as f:
    for line in f:
        line = line.strip()
        if line:
            messages.append(ast.literal_eval(line))

a, b = 1, 9
chars = " " + "abcdefghijklmnopqrstuvwxyz"

def decrypt(msg):
    out = []
    for i in range(0, len(msg), 3):
        o1, o2, o3 = msg[i], msg[i+1], msg[i+2]
        det = 3*(4*7 - 2*5) - 6*(b*7 - 2*1) + a*(b*5 - 4*1)
        detx = o1*(4*7 - 2*5) - 6*(o2*7 - 2*o3) + a*(o2*5 - 4*o3)
        dety = 3*(o2*7 - 2*o3) - o1*(b*7 - 2*1) + a*(b*o3 - o2*1)
        detz = 3*(4*o3 - o2*5) - 6*(b*o3 - o2*1) + o1*(b*5 - 4*1)
        x, y, z = detx//det, dety//det, detz//det
        for v in (x, y, z):
            if v == -1:
                continue
            out.append(chars[v])
    return "".join(out)

passwords = [decrypt(m) for m in messages]

r = remote("crypto.chal.csaw.io", 5000)
r.recvuntil(b"stop taking input) ")
for p in passwords:
    r.sendline(p.encode())
    r.recvuntil(b"stop taking input) ")
r.sendline(b"Close")
print(r.recvall(timeout=5))
r.close()
end_of_edit

