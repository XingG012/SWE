edit 1:1
import re, subprocess, os

data = open('out_a85.bin').read().strip()
parts = re.split(r'(?=M )', data)
parts = [p for p in parts if p.strip()]

# get x of each glyph
glyphs = []
for p in parts:
    m = re.match(r'M ([\d.]+) ([\d.]+)', p)
    x = float(m.group(1))
    glyphs.append((x, p))

glyphs.sort(key=lambda t: t[0])

os.makedirs('glyphs', exist_ok=True)
for i,(x,p) in enumerate(glyphs):
    svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 30 25"><rect width="30" height="25" fill="white"/><path d="%s" fill="black"/></svg>' % p
    fn = 'glyphs/g%02d.svg' % i
    open(fn,'w').write(svg)
    subprocess.run(['convert','-density','300',fn,'glyphs/g%02d.png'%i])
print("done", len(glyphs))
