edit 1:1
import re, subprocess, os

data = open('out_a85.bin').read().strip()
parts = re.split(r'(?=M )', data)
parts = [p for p in parts if p.strip()]

glyphs = []
for p in parts:
    m = re.match(r'M ([\d.]+) ([\d.]+)', p)
    x = float(m.group(1))
    glyphs.append((x, p))
glyphs.sort(key=lambda t: t[0])

for i,(x,p) in enumerate(glyphs):
    fn = 'glyphs/g%02d.png' % i
    r = subprocess.run(['tesseract',fn,'stdout','--psm','10'],capture_output=True,text=True)
    txt = r.stdout.strip().replace('\n','')
    print("%2d x=%7.2f  [%s]" % (i, x, txt))
end_of_edit

