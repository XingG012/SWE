import struct

# Read the binary
with open("beleaf", "rb") as f:
    data = f.read()

# The .data section starts at file offset 0x1000 (vaddr 0x201000)
# Tree at vaddr 0x201020 -> file offset 0x1020
# Expected at vaddr 0x2014e0 -> file offset 0x14e0

# Tree: 4-byte ints, need enough entries (up to index 53+)
tree = []
for i in range(0x14e0 - 0x1020):
    pass

# Read tree entries as 4-byte signed ints from 0x1020 until 0x14e0
tree_bytes = data[0x1020:0x14e0]
tree = list(struct.unpack("<%di" % (len(tree_bytes)//4), tree_bytes))

# Read expected indices as 8-byte signed ints from 0x14e0
exp_bytes = data[0x14e0:0x14e0 + 33*8]
expected = list(struct.unpack("<%dq" % (len(exp_bytes)//8), exp_bytes))

flag = ""
for idx in expected:
    flag += chr(tree[idx])

print(flag)
