from Crypto.PublicKey import RSA
import base64
import gmpy2

# Load public key
with open('pubkey.pem', 'rb') as f:
    key = RSA.import_key(f.read())
N = key.n
e = key.e
print("N =", N)
print("e =", e)

# Load Y (encrypted key)
with open('key.enc', 'rb') as f:
    Y = int(f.read().strip())
print("Y =", Y)

# K^3 = Y + N
val = Y + N
K, exact = gmpy2.iroot(val, 3)
print("exact cube:", exact)
print("K =", K)

# Verify
print("K^3 == Y+N:", K**3 == val)

# Y should equal K^e mod N
print("K^e mod N == Y:", pow(int(K), e, N) == Y)

# Now XOR Y octet string with C to get S
# Y as big-endian octet string, 192 bytes
Y_bytes = int(Y).to_bytes(192, 'big')

# Load C
with open('file.enc', 'rb') as f:
    C = base64.b64decode(f.read())
print("C len:", len(C))

# S = Y xor C
S = bytes(a ^ b for a, b in zip(Y_bytes, C))
print("S =", S)
EOF
