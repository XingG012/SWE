import binascii

OFFSET = 9133337
NIBBLE_LEN = 8

def unduck(val):
    if 0 <= val <= 9:
        return str(val)
    elif 11 <= val <= 16:
        return "abcdef"[val - 11]
    else:
        raise ValueError(f"Invalid nibble value: {val}")

def decodeText(encoded):
    output = ""
    for i in range(0, len(encoded), NIBBLE_LEN):
        chunk = encoded[i:i+NIBBLE_LEN]
        val = int(chunk) - OFFSET
        output += unduck(val)
    return output

with open('DES2Bytes.enc') as f:
    enc = f.read().strip()

hexstr = decodeText(enc)
print("Decoded hex length:", len(hexstr))
data = binascii.unhexlify(hexstr)
with open('DES2Bytes.dec', 'wb') as f:
    f.write(data)
print("Wrote DES2Bytes.dec, length:", len(data))
end_of_edit

