import binascii

OFFSET = 9133337
NIBBLE_LEN = 8

def unduck(val):
    if 0 <= val <= 9:
        return str(val)
    elif 11 <= val <= 16:
        return "abcdef"[val - 11]
    else:
        raise ValueError(f"Invalid nibble value: {val}")

def decodeText(encoded):
    output = ""
    for i in range(0, len(encoded), NIBBLE_LEN):
        chunk = encoded[i:i+NIBBLE_LEN]
        val = int(chunk) - OFFSET
        output += unduck(val)
    return output

def decode_file(path):
    with open(path) as f:
        enc = f.read().strip()
    hexstr = decodeText(enc)
    return binascii.unhexlify(hexstr)

des2bytes_ct = decode_file('DES2Bytes.enc')
flag_ct = decode_file('FLAG.enc')
with open('DES2Bytes.txt', 'rb') as f:
    des2bytes_pt = f.read()

print("DES2Bytes ciphertext len:", len(des2bytes_ct))
print("DES2Bytes plaintext len:", len(des2bytes_pt))
print("FLAG ciphertext len:", len(flag_ct))

# combined keystream = ct XOR pt (for the known pair)
ks = bytes(a ^ b for a, b in zip(des2bytes_ct, des2bytes_pt))
# flag plaintext = flag_ct XOR ks
flag_pt = bytes(a ^ b for a, b in zip(flag_ct, ks))
print("Flag plaintext (first 200):", flag_pt[:200])
end_of_edit

