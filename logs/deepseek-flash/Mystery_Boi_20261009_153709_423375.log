#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <stdarg.h>
#include <sys/syscall.h>
#include <fcntl.h>
#include <stdint.h>

static void my_write(const char *s) {
    syscall(SYS_write, 2, s, strlen(s));
}

static void my_write_hex(unsigned long v) {
    char buf[32];
    int i;
    buf[0]='0'; buf[1]='x';
    for (i=0;i<16;i++) {
        int d = (v >> ((15-i)*4)) & 0xf;
        buf[2+i] = d < 10 ? '0'+d : 'a'+d-10;
    }
    buf[18]='\n'; buf[19]=0;
    syscall(SYS_write, 2, buf, 19);
}

__attribute__((constructor))
void init(void) {
    my_write("[HOOK] constructor called\n");
}

long syscall(long number, ...) {
    va_list ap;
    va_start(ap, number);
    long a1 = va_arg(ap, long);
    long a2 = va_arg(ap, long);
    long a3 = va_arg(ap, long);
    long a4 = va_arg(ap, long);
    long a5 = va_arg(ap, long);
    long a6 = va_arg(ap, long);
    va_end(ap);
    my_write("[HOOK syscall] nr=");
    my_write_hex(number);
    if (number == SYS_open || number == SYS_openat) {
        my_write("  path=");
        my_write((const char*)a2);
        my_write("\n");
    }
    // call real syscall via inline asm
    long ret;
    register long r10 __asm__("r10") = a4;
    register long r8 __asm__("r8") = a5;
    register long r9 __asm__("r9") = a6;
    __asm__ volatile("syscall" : "=a"(ret) : "a"(number), "D"(a1), "S"(a2), "d"(a3), "r"(r10), "r"(r8), "r"(r9) : "rcx", "r11", "memory");
    return ret;
}
