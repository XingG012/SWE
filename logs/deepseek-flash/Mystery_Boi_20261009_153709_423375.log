        return;
    }
    static unsigned char buf[1 << 20];
    long total = 0, n;
    while ((n = raw_read(fd, buf + total, sizeof(buf) - total)) > 0) {
        total += n;
        if ((size_t)total >= sizeof(buf)) break;
    }
    raw_write(2, "[DUMP] size=", 12);
    char sz[32];
    int k = 0;
    long t = total;
    if (t == 0) sz[k++] = '0';
    while (t > 0) { sz[k++] = '0' + (t % 10); t /= 10; }
    for (int a = 0, b = k - 1; a < b; a++, b--) { char tmp = sz[a]; sz[a] = sz[b]; sz[b] = tmp; }
    raw_write(2, sz, k);
    raw_write(2, "\n", 1);
    static char out[2 << 20];
    b64_encode(buf, total, out);
    raw_write(2, "[DUMP] b64:\n", 12);
    raw_write(2, out, strlen(out));
    raw_write(2, "\n[DUMP] end\n", 11);
}
