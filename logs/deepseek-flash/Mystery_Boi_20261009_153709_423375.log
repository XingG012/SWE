#define _GNU_SOURCE
#include <unistd.h>
#include <string.h>
#include <sys/syscall.h>

static void raw_write(int fd, const void *buf, size_t n) {
    register long r10 __asm__("r10") = 0;
    register long r8 __asm__("r8") = 0;
    register long r9 __asm__("r9") = 0;
    long ret;
    __asm__ volatile("syscall" : "=a"(ret) : "a"(SYS_write), "D"((long)fd), "S"(buf), "d"(n), "r"(r10), "r"(r8), "r"(r9) : "rcx", "r11", "memory");
}

static int my_strcmp(const char *a, const char *b) {
    while (*a && *a == *b) { a++; b++; }
    return (unsigned char)*a - (unsigned char)*b;
}

__attribute__((constructor))
void init(void) {
    raw_write(2, "[HOOK8] constructor called\n", 27);
}

int strcmp(const char *a, const char *b) {
    raw_write(2, "[HOOK8 strcmp] '", 16);
    raw_write(2, a, strlen(a));
    raw_write(2, "' vs '", 6);
    raw_write(2, b, strlen(b));
    raw_write(2, "'\n", 2);
    return my_strcmp(a, b);
}
