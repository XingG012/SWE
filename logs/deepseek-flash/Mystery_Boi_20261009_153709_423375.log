#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <stdarg.h>
#include <sys/syscall.h>

extern void *__libc_dlsym(void *handle, const char *name);

static void my_write(const char *s) {
    syscall(SYS_write, 2, s, strlen(s));
}

static void my_write_hex(unsigned long v) {
    char buf[32];
    int i;
    buf[0]='0'; buf[1]='x';
    for (i=0;i<16;i++) {
        int d = (v >> ((15-i)*4)) & 0xf;
        buf[2+i] = d < 10 ? '0'+d : 'a'+d-10;
    }
    buf[18]='\n'; buf[19]=0;
    syscall(SYS_write, 2, buf, 19);
}

__attribute__((constructor))
void init(void) {
    my_write("[HOOK] constructor called\n");
}

int puts(const char *s) {
    my_write("[HOOK puts] ");
    my_write(s);
    my_write("\n");
    return 0;
}

int printf(const char *fmt, ...) {
    my_write("[HOOK printf] ");
    my_write(fmt);
    my_write("\n");
    return 0;
}

int strcmp(const char *a, const char *b) {
    my_write("[HOOK strcmp] '");
    my_write(a);
    my_write("' vs '");
    my_write(b);
    my_write("'\n");
    return 0;
}

int strncmp(const char *a, const char *b, size_t n) {
    my_write("[HOOK strncmp] '");
    my_write(a);
    my_write("' vs '");
    my_write(b);
    my_write("'\n");
    return 0;
}
