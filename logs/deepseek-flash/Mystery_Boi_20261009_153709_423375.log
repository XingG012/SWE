#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <stdarg.h>
#include <sys/syscall.h>
#include <fcntl.h>

static void my_write(const char *s) {
    syscall(SYS_write, 2, s, strlen(s));
}

static void my_write_hex(unsigned long v) {
    char buf[32];
    int i;
    buf[0]='0'; buf[1]='x';
    for (i=0;i<16;i++) {
        int d = (v >> ((15-i)*4)) & 0xf;
        buf[2+i] = d < 10 ? '0'+d : 'a'+d-10;
    }
    buf[18]='\n'; buf[19]=0;
    syscall(SYS_write, 2, buf, 19);
}

__attribute__((constructor))
void init(void) {
    my_write("[HOOK] constructor called\n");
}

int open(const char *path, int flags, ...) {
    my_write("[HOOK open] ");
    my_write(path);
    my_write("\n");
    return -1;
}

int openat(int dirfd, const char *path, int flags, ...) {
    my_write("[HOOK openat] ");
    my_write(path);
    my_write("\n");
    return -1;
}

FILE *fopen(const char *path, const char *mode) {
    my_write("[HOOK fopen] ");
    my_write(path);
    my_write("\n");
    return NULL;
}

ssize_t read(int fd, void *buf, size_t count) {
    my_write("[HOOK read] fd=");
    my_write_hex(fd);
    return 0;
}

ssize_t write(int fd, const void *buf, size_t count) {
    my_write("[HOOK write] fd=");
    my_write_hex(fd);
    my_write(" data: ");
    syscall(SYS_write, 2, buf, count);
    my_write("\n");
    return count;
}

size_t fwrite(const void *ptr, size_t size, size_t nmemb, FILE *stream) {
    my_write("[HOOK fwrite] ");
    syscall(SYS_write, 2, ptr, size*nmemb);
    my_write("\n");
    return nmemb;
}

int fputs(const char *s, FILE *stream) {
    my_write("[HOOK fputs] ");
    my_write(s);
    my_write("\n");
    return 0;
}

int puts(const char *s) {
    my_write("[HOOK puts] ");
    my_write(s);
    my_write("\n");
    return 0;
}

int printf(const char *fmt, ...) {
    my_write("[HOOK printf] ");
    my_write(fmt);
    my_write("\n");
    return 0;
}
