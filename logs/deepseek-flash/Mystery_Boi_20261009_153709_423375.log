#define _GNU_SOURCE
#include <unistd.h>
#include <string.h>
#include <sys/syscall.h>

static void raw_write(int fd, const void *buf, size_t n) {
    register long r10 __asm__("r10") = 0;
    register long r8 __asm__("r8") = 0;
    register long r9 __asm__("r9") = 0;
    long ret;
    __asm__ volatile("syscall" : "=a"(ret) : "a"(SYS_write), "D"((long)fd), "S"(buf), "d"(n), "r"(r10), "r"(r8), "r"(r9) : "rcx", "r11", "memory");
}

__attribute__((constructor))
void init(void) {
    raw_write(2, "[HOOK7] constructor called\n", 27);
}

ssize_t write(int fd, const void *buf, size_t count) {
    raw_write(2, "[HOOK7 write] fd=", 17);
    char c = '0' + fd;
    raw_write(2, &c, 1);
    raw_write(2, " data: ", 7);
    raw_write(2, buf, count);
    raw_write(2, "\n", 1);
    return syscall(SYS_write, fd, buf, count);
}
