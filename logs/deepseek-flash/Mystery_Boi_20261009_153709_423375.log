#define _GNU_SOURCE
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#include <stdarg.h>
#include <sys/syscall.h>
#include <fcntl.h>

static void my_write(const char *s) {
    syscall(SYS_write, 2, s, strlen(s));
}

static void my_write_hex(unsigned long v) {
    char buf[32];
    int i;
    buf[0]='0'; buf[1]='x';
    for (i=0;i<16;i++) {
        int d = (v >> ((15-i)*4)) & 0xf;
        buf[2+i] = d < 10 ? '0'+d : 'a'+d-10;
    }
    buf[18]='\n'; buf[19]=0;
    syscall(SYS_write, 2, buf, 19);
}

__attribute__((constructor))
void init(void) {
    my_write("[HOOK] constructor called\n");
}

char *getenv(const char *name) {
    my_write("[HOOK getenv] ");
    my_write(name);
    my_write("\n");
    return NULL;
}

int puts(const char *s) {
    my_write("[HOOK puts] ");
    my_write(s);
    my_write("\n");
    return 0;
}

int printf(const char *fmt, ...) {
    my_write("[HOOK printf] ");
    my_write(fmt);
    my_write("\n");
    return 0;
}

int strcmp(const char *a, const char *b) {
    my_write("[HOOK strcmp] '");
    my_write(a);
    my_write("' vs '");
    my_write(b);
    my_write("'\n");
    return 0;
}

int strncmp(const char *a, const char *b, size_t n) {
    my_write("[HOOK strncmp] '");
    my_write(a);
    my_write("' vs '");
    my_write(b);
    my_write("'\n");
    return 0;
}

char *strstr(const char *h, const char *n) {
    my_write("[HOOK strstr] '");
    my_write(h);
    my_write("' contains '");
    my_write(n);
    my_write("'\n");
    return NULL;
}

FILE *fopen(const char *path, const char *mode) {
    my_write("[HOOK fopen] ");
    my_write(path);
    my_write(" mode=");
    my_write(mode);
    my_write("\n");
    return NULL;
}

int open(const char *path, int flags, ...) {
    my_write("[HOOK open] ");
    my_write(path);
    my_write("\n");
    return -1;
}

ssize_t read(int fd, void *buf, size_t count) {
    my_write("[HOOK read] fd=");
    my_write_hex(fd);
    return 0;
}
