import struct

data = open("app","rb").read()
sec = data[0x31a0:0x31a0+0x304]

movb_bytes = []
movl_vals = []
cmp_vals = []

i = 0
while i < len(sec):
    # movb $byte, off(%rbp)  -> c6 45 XX YY
    if sec[i] == 0xc6 and sec[i+1] == 0x45:
        movb_bytes.append(sec[i+3])
        i += 4
    # movl $X, -0x4(%rbp) -> c7 45 fc XX XX XX XX
    elif sec[i] == 0xc7 and sec[i+1] == 0x45 and sec[i+2] == 0xfc:
        movl_vals.append(struct.unpack("<I", sec[i+3:i+7])[0])
        i += 7
    # cmpl $Y, -0x4(%rbp) -> 81 7d fc YY YY YY YY
    elif sec[i] == 0x81 and sec[i+1] == 0x7d and sec[i+2] == 0xfc:
        cmp_vals.append(struct.unpack("<I", sec[i+3:i+7])[0])
        i += 7
    else:
        i += 1

print("movb bytes:", [hex(b) for b in movb_bytes])
print("movl vals:", [hex(v) for v in movl_vals])
print("cmp vals:", [hex(v) for v in cmp_vals])
print("num movb:", len(movb_bytes), "num movl:", len(movl_vals), "num cmp:", len(cmp_vals))
end_of_edit

