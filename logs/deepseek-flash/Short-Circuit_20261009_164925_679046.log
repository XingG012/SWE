from PIL import Image
import numpy as np

img = Image.open("short-circuit.jpg").convert("L")
arr = np.array(img)
h, w = arr.shape
# 40 columns wide
cols = 60
rows = int(h / w * cols * 0.5)
chars = " .:-=+*#%@"
for i in range(rows):
    line = ""
    for j in range(cols):
        y0, y1 = i*h//rows, (i+1)*h//rows
        x0, x1 = j*w//cols, (j+1)*w//cols
        v = arr[y0:y1, x0:x1].mean()
        line += chars[min(9, int(v)*10//256)]
    print(line)
end_of_edit

