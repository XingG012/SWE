from PIL import Image, ImageOps, ImageEnhance
import numpy as np

img = Image.open("short-circuit.jpg").convert("L")
# Upscale
img2 = img.resize((img.width*2, img.height*2), Image.LANCZOS)
# Enhance contrast
img2 = ImageOps.autocontrast(img2)
img2.save("/tmp/enhanced.png")

# Also try threshold
arr = np.array(img)
thresh = (arr > 128) * 255
Image.fromarray(thresh.astype(np.uint8)).save("/tmp/thresh.png")
print("done")
end_of_edit

