edit 1:1
from PIL import Image
import subprocess

img = Image.open("short-circuit.jpg")
w, h = img.size
# Split into 4 vertical sections
for i in range(4):
    crop = img.crop((0, i*h//4, w, (i+1)*h//4))
    crop.save(f"/tmp/crop_{i}.png")
    subprocess.run(["tesseract", f"/tmp/crop_{i}.png", f"/tmp/crop_{i}", "--psm", "6"], capture_output=True)
    with open(f"/tmp/crop_{i}.txt") as f:
        text = f.read().strip()
    print(f"=== Section {i} ===")
    print(text)
