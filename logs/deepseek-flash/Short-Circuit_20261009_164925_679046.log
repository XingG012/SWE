from PIL import Image
import numpy as np

img = Image.open("short-circuit.jpg")
print("Size:", img.size)
print("Mode:", img.mode)

arr = np.array(img)
print("Shape:", arr.shape)
print("Dtype:", arr.dtype)

# Check LSB of each channel
for c in range(arr.shape[2]):
    lsb = arr[:,:,c] & 1
    print(f"Channel {c} LSB sum:", lsb.sum())
end_of_edit

