from PIL import Image
import numpy as np
from collections import Counter

img = Image.open("short-circuit.jpg").convert("RGB")
arr = np.array(img)
# Quantize colors
q = (arr // 32) * 32
flat = q.reshape(-1, 3)
c = Counter(map(tuple, flat))
for color, count in c.most_common(20):
    print(color, count)
end_of_edit

