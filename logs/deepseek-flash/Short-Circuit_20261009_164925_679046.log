from PIL import Image
import numpy as np

img = Image.open("short-circuit.jpg").convert("L")
# Downsample to ASCII
w = 100
h = int(img.height / img.width * w * 0.5)
small = img.resize((w, h))
arr = np.array(small)
chars = " .:-=+*#%@"
for row in arr:
    line = "".join(chars[min(9, v * 10 // 256)] for v in row)
    print(line)
end_of_edit

