edit 1:1
import re

# Read the script
with open("banana.script") as f:
    data = f.read()

# Find all banana words
words = re.findall(r'[Bb][Aa][Nn][Aa][Nn][Aa][Ss]', data)

print("Number of words:", len(words))

# Each word encodes 6 bits: uppercase=0, lowercase=1
bits = ""
for w in words:
    val = 0
    for ch in w:
        val = (val << 1) | (1 if ch.islower() else 0)
    bits += format(val, '06b')

print("Total bits:", len(bits))

# Convert bits to bytes
out = bytearray()
for i in range(0, len(bits) - 7, 8):
    out.append(int(bits[i:i+8], 2))

print("Bytes:", len(out))
print(out.hex())
end_of_edit

