from pwn import *
import re
from avl_solver import insert, preorder

context.log_level = 'info'

def solve_tree(nums):
    root = None
    for n in nums:
        root = insert(root, n)
    out = []
    preorder(root, out)
    return ','.join(str(x) for x in out)

io = remote('misc.chal.csaw.io', 8000)
io.recvuntil(b'preorder traversal!')
data = io.recvuntil(b'\n\n', timeout=5)
text = data.decode(errors='ignore')
nums = [int(x) for x in re.findall(r'\d+', text)]
log.info(f"Got {len(nums)} numbers")
ans = solve_tree(nums)
log.info(f"Answer: {ans}")
io.sendline(ans.encode())
io.interactive()
end_of_edit

