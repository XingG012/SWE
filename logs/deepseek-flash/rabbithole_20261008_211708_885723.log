from pwn import ELF
import struct

elf = ELF("rabbithole", checksec=False)

def read(addr, n):
    return elf.read(addr, n)

def u64_at(addr):
    return struct.unpack("<Q", read(addr, 8))[0]

roots_addr = 0x28f900
roots = [u64_at(roots_addr + i*8) for i in range(59)]

def check(c, node):
    while True:
        flag = read(node, 1)[0]
        if flag != 0:
            return read(node+8, 1)[0]
        low = read(node+8, 1)[0]
        high = read(node+9, 1)[0]
        if low <= c < high:
            node = u64_at(node+0x10)
        else:
            node = u64_at(node+0x18)

flag = []
for i in range(59):
    for c in range(256):
        if check(c, roots[i]) == 1:
            flag.append(c)
            break
    else:
        flag.append(ord('?'))

print(bytes(flag))
end_of_edit

