from pwn import *
from Crypto.Util.number import long_to_bytes
import math, re

context.log_level = 'error'

def wiener(e, n):
    def cf(n, d):
        a = []
        while d:
            a.append(n // d)
            n, d = d, n % d
        return a
    def convs(a):
        res = []
        for i in range(len(a)):
            num, den = 1, 0
            for j in reversed(a[:i+1]):
                num, den = den + j*num, num
            res.append((num, den))
        return res
    for k, d in convs(cf(e, n)):
        if k == 0:
            continue
        if (e*d - 1) % k != 0:
            continue
        phi = (e*d - 1) // k
        b = n - phi + 1
        disc = b*b - 4*n
        if disc < 0:
            continue
        s = math.isqrt(disc)
        if s*s != disc:
            continue
        if (b + s) % 2 != 0:
            continue
        p = (b + s) // 2
        q = (b - s) // 2
        if p*q == n:
            return d
    return None

r = remote("crypto.chal.csaw.io", 5000)
r.recvuntil(b"(Y/n)")
r.sendline(b"Y")
data = r.recvuntil(b"plaintext?")
print("=== PART 1 DATA ===")
print(data.decode())
text = data.decode()
N = int(re.search(r'N = (\d+)', text).group(1))
e = int(re.search(r'e = (\d+)', text).group(1))
c = int(re.search(r'c = (\d+)', text).group(1))
d = wiener(e, N)
m = pow(c, d, N)
ans = long_to_bytes(m).decode()
print("ANSWER:", repr(ans))
r.sendline(ans.encode())
resp = r.recvuntil(b"plaintext?", timeout=5)
print("=== RESPONSE ===")
print(resp.decode())
end_of_edit

