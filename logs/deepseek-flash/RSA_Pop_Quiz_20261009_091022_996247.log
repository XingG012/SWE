import math
from Crypto.Util.number import long_to_bytes

N = 
e = 
c = 

def cf(n, d):
    a = []
    while d:
        a.append(n // d)
        n, d = d, n % d
    return a

def convs(a):
    res = []
    for i in range(len(a)):
        num, den = 1, 0
        for j in reversed(a[:i+1]):
            num, den = den + j*num, num
        res.append((num, den))
    return res

for k, d in convs(cf(e, N)):
    if k == 0:
        continue
    if (e*d - 1) % k != 0:
        continue
    phi = (e*d - 1) // k
    b = N - phi + 1
    disc = b*b - 4*N
    if disc < 0:
        continue
    s = math.isqrt(disc)
    if s*s != disc:
        continue
    if (b + s) % 2 != 0:
        continue
    p = (b + s) // 2
    q = (b - s) // 2
    if p*q == N:
        m = pow(c, d, N)
        print("Plaintext:", long_to_bytes(m))
        break
