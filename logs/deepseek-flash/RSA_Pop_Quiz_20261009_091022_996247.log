from pwn import *
from Crypto.Util.number import long_to_bytes, inverse
import math, re, time

context.log_level = 'error'

def wiener(e, n):
    def cf(n, d):
        a = []
        while d:
            a.append(n // d)
            n, d = d, n % d
        return a
    def convs(a):
        res = []
        for i in range(len(a)):
            num, den = 1, 0
            for j in reversed(a[:i+1]):
                num, den = den + j*num, num
            res.append((num, den))
        return res
    for k, d in convs(cf(e, n)):
        if k == 0:
            continue
        if (e*d - 1) % k != 0:
            continue
        phi = (e*d - 1) // k
        b = n - phi + 1
        disc = b*b - 4*n
        if disc < 0:
            continue
        s = math.isqrt(disc)
        if s*s != disc:
            continue
        if (b + s) % 2 != 0:
            continue
        p = (b + s) // 2
        q = (b - s) // 2
        if p*q == n:
            return d
    return None

def parse(text):
    N = int(re.search(r'N = (\d+)', text).group(1))
    e = int(re.search(r'e = (\d+)', text).group(1))
    c = int(re.search(r'c = (\d+)', text).group(1))
    return N, e, c

r = remote("crypto.chal.csaw.io", 5000)
r.recv(timeout=5)
r.sendline(b"Y")

data = r.recvuntil(b"plaintext?", timeout=10).decode()
N, e, c = parse(data)
d = wiener(e, N)
m = pow(c, d, N)
ans1 = long_to_bytes(m).decode()
r.sendline(ans1.encode())

data = r.recvuntil(b"plaintext?", timeout=10).decode()
if "Please try again" in data:
    data = r.recvuntil(b"plaintext?", timeout=10).decode()
N, e, c = parse(data)
disc = 36 + 4*N
s = math.isqrt(disc)
p = (-6 + s) // 2
q = p + 6
phi = (p-1)*(q-1)
d = inverse(e, phi)
m = pow(c, d, N)
ans2 = long_to_bytes(m).decode()
r.sendline(ans2.encode())

data = r.recvuntil(b"integer)", timeout=10).decode()
if "Please try again" in data:
    data = r.recvuntil(b"integer)", timeout=10).decode()
N, e, c = parse(data)
print("Part3 N:", N, flush=True)
print("Part3 e:", e, flush=True)
print("Part3 c:", c, flush=True)

# Test oracle with c itself
r.sendline(str(c).encode())
time.sleep(0.5)
resp = r.recv(timeout=5)
print("Oracle response for c:", repr(resp), flush=True)
end_of_edit

