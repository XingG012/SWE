from pwn import *
from Crypto.Util.number import long_to_bytes, inverse
import math, re

context.log_level = 'error'

def wiener_attack(e, n):
    def cf(n, d):
        a = []
        while d:
            a.append(n // d)
            n, d = d, n % d
        return a
    def convs(a):
        res = []
        for i in range(len(a)):
            num, den = 1, 0
            for j in reversed(a[:i+1]):
                num, den = den + j*num, num
            res.append((num, den))
        return res
    for k, d in convs(cf(e, n)):
        if k == 0:
            continue
        if (e*d - 1) % k != 0:
            continue
        phi = (e*d - 1) // k
        b = n - phi + 1
        disc = b*b - 4*n
        if disc < 0:
            continue
        s = math.isqrt(disc)
        if s*s != disc:
            continue
        if (b + s) % 2 != 0:
            continue
        p = (b + s) // 2
        q = (b - s) // 2
        if p*q == n:
            return d
    return None

r = remote("crypto.chal.csaw.io", 5000)

# Part 1
r.recvuntil(b"(Y/n)")
r.sendline(b"Y")
data = r.recvuntil(b"plaintext?")
text = data.decode()
N1 = int(re.search(r'N = (\d+)', text).group(1))
e1 = int(re.search(r'e = (\d+)', text).group(1))
c1 = int(re.search(r'c = (\d+)', text).group(1))
d1 = wiener_attack(e1, N1)
m1 = pow(c1, d1, N1)
ans1 = long_to_bytes(m1).decode()
print("Part1:", ans1)
r.sendline(("flag{" + ans1 + "}").encode())

# Part 2
data = r.recvuntil(b"plaintext?")
text = data.decode()
N2 = int(re.search(r'N = (\d+)', text).group(1))
e2 = int(re.search(r'e = (\d+)', text).group(1))
c2 = int(re.search(r'c = (\d+)', text).group(1))
disc = 36 + 4*N2
s = math.isqrt(disc)
p = (-6 + s) // 2
q = p + 6
phi = (p-1)*(q-1)
d2 = inverse(e2, phi)
m2 = pow(c2, d2, N2)
ans2 = long_to_bytes(m2).decode()
print("Part2:", ans2)
r.sendline(("flag{" + ans2 + "}").encode())

# Part 3 - LSB oracle
data = r.recvuntil(b"integer)")
text = data.decode()
N3 = int(re.search(r'N = (\d+)', text).group(1))
e3 = int(re.search(r'e = (\d+)', text).group(1))
c3 = int(re.search(r'c = (\d+)', text).group(1))
print("Part3 N:", N3)

def oracle(ct):
    r.sendline(str(ct).encode())
    line = r.recvline().decode().strip()
    # response is the LSB
    return int(line)

# LSB oracle attack
lo = 0
hi = N3
factor = 1
for i in range(N3.bit_length()):
    ct = (c3 * pow(2**(i+1), e3, N3)) % N3
    lsb = oracle(ct)
    mid = (lo + hi) // 2
    if lsb == 1:
        # 2*m mod N is odd -> m > N/2 in current interval
        lo = mid
    else:
        hi = mid
    if hi - lo < 2:
        break

m3 = hi
ans3 = long_to_bytes(m3)
print("Part3:", ans3)
r.sendline(ans3)
print(r.recvall(timeout=5))
end_of_edit

