from Crypto.Util.number import long_to_bytes

N = 
e = 
c = 

# Wiener's attack
def continued_fractions(n, d):
    cf = []
    while d:
        cf.append(n // d)
        n, d = d, n % d
    return cf

def convergents(cf):
    convs = []
    for i in range(len(cf)):
        num, den = 1, 0
        for j in reversed(cf[:i+1]):
            num, den = den + j*num, num
        convs.append((num, den))
    return convs

def wiener_attack(e, n):
    cf = continued_fractions(e, n)
    for k, d in convergents(cf):
        if k == 0:
            continue
        if (e*d - 1) % k != 0:
            continue
        phi = (e*d - 1) // k
        # solve x^2 - (n - phi + 1)x + n = 0
        b = n - phi + 1
        disc = b*b - 4*n
        if disc < 0:
            continue
        s = int(disc**0.5)
        if s*s != disc:
            continue
        if (b + s) % 2 != 0:
            continue
        p = (b + s) // 2
        q = (b - s) // 2
        if p*q == n:
            return d, p, q
    return None

res = wiener_attack(e, N)
print("Wiener result:", res)
if res:
    d, p, q = res
    m = pow(c, d, N)
    print("Plaintext:", long_to_bytes(m))
end_of_edit

