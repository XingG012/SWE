from pwn import *
from Crypto.Util.number import long_to_bytes, inverse
import math, re, time

context.log_level = 'error'

def wiener(e, n):
    def cf(n, d):
        a = []
        while d:
            a.append(n // d)
            n, d = d, n % d
        return a
    def convs(a):
        res = []
        for i in range(len(a)):
            num, den = 1, 0
            for j in reversed(a[:i+1]):
                num, den = den + j*num, num
            res.append((num, den))
        return res
    for k, d in convs(cf(e, n)):
        if k == 0:
            continue
        if (e*d - 1) % k != 0:
            continue
        phi = (e*d - 1) // k
        b = n - phi + 1
        disc = b*b - 4*n
        if disc < 0:
            continue
        s = math.isqrt(disc)
        if s*s != disc:
            continue
        if (b + s) % 2 != 0:
            continue
        p = (b + s) // 2
        q = (b - s) // 2
        if p*q == n:
            return d
    return None

def parse(text):
    N = int(re.search(r'N = (\d+)', text).group(1))
    e = int(re.search(r'e = (\d+)', text).group(1))
    c = int(re.search(r'c = (\d+)', text).group(1))
    return N, e, c

r = remote("crypto.chal.csaw.io", 5000)
r.recv(timeout=5)
r.sendline(b"Y")

# Part 1
data = r.recvuntil(b"plaintext?", timeout=10).decode()
N, e, c = parse(data)
d = wiener(e, N)
m = pow(c, d, N)
ans1 = long_to_bytes(m).decode()
print("Part1:", repr(ans1), flush=True)
r.sendline(ans1.encode())

# Read past "Please try again!" and get Part 2
data = r.recvuntil(b"plaintext?", timeout=10).decode()
if "Please try again" in data:
    data = r.recvuntil(b"plaintext?", timeout=10).decode()
print("Part2 data received", flush=True)
N, e, c = parse(data)
disc = 36 + 4*N
s = math.isqrt(disc)
p = (-6 + s) // 2
q = p + 6
assert p*q == N, "sexy primes failed"
phi = (p-1)*(q-1)
d = inverse(e, phi)
m = pow(c, d, N)
ans2 = long_to_bytes(m).decode()
print("Part2:", repr(ans2), flush=True)
r.sendline(ans2.encode())

# Read past "Please try again!" and get Part 3
data = r.recvuntil(b"integer)", timeout=10).decode()
if "Please try again" in data:
    data = r.recvuntil(b"integer)", timeout=10).decode()
print("Part3 data received", flush=True)
N, e, c = parse(data)
print("Part3 N bits:", N.bit_length(), flush=True)

# LSB oracle attack
def oracle(ct):
    r.sendline(str(ct).encode())
    line = r.recvline(timeout=5).decode().strip()
    return int(line)

lo = 0
hi = N
for i in range(N.bit_length()):
    ct = (c * pow(2**(i+1), e, N)) % N
    lsb = oracle(ct)
    mid = (lo + hi) // 2
    if lsb == 1:
        lo = mid
    else:
        hi = mid
    if i % 200 == 0:
        print("iter", i, flush=True)

m3 = hi
ans3 = long_to_bytes(m3)
print("Part3:", ans3, flush=True)
r.sendline(ans3)
time.sleep(1)
print(r.recv(timeout=5), flush=True)
print(r.recv(timeout=5), flush=True)
end_of_edit

