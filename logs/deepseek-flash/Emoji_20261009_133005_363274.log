import re

with open('emoji.txt', 'r', encoding='utf-8') as f:
    data = f.read()

# Find all emoji characters
emojis = re.findall(r'\X', data)
print("Total grapheme clusters:", len(emojis))
print("First 50:", emojis[:50])

# Count unique
from collections import Counter
c = Counter(emojis)
for k, v in c.most_common():
    print(repr(k), v)
end_of_edit

