import regex

with open('emoji.txt', 'r', encoding='utf-8') as f:
    data = f.read()

emojis = regex.findall(r'\X', data)

pair_map = {
    '👎': 0, '👍': 0,
    '🥩': 1, '🍼': 1,
    '🍺': 2, '🦴': 2,
    '🌚': 3, '🌝': 3,
    '🏈': 4, '⚽️': 4,
    '💔': 5, '❤️\u200d🩹': 5,
    '🔔': 6, '🔕': 6,
    '➕': 7, '➖': 7,
    '📉': 8, '📈': 8,
    '❌': 9, '⭕️': 9,
}

idxs = [pair_map[e] for e in emojis]

# Find positions where index 0 appears
zeros = [i for i, x in enumerate(idxs) if x == 0]
print("Positions of 0:", zeros)
print("Diffs:", [zeros[i+1]-zeros[i] for i in range(len(zeros)-1)])
end_of_edit

