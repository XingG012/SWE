edit 1:1
from PIL import Image

im = Image.open('emoji.png').convert('RGB')
w, h = im.size
px = im.load()

# Find the band rows
rows_with_content = []
for y in range(h):
    cnt = 0
    for x in range(0, w, 50):
        r, g, b = px[x, y]
        if not (r > 240 and g > 240 and b > 240):
            cnt += 1
    if cnt > 0:
        rows_with_content.append(y)
print("Rows with content:", rows_with_content[0], "-", rows_with_content[-1])

# For the middle row, find columns with content
y = (rows_with_content[0] + rows_with_content[-1]) // 2
cols = []
for x in range(w):
    r, g, b = px[x, y]
    if not (r > 240 and g > 240 and b > 240):
        cols.append(x)
print("Num content cols:", len(cols))
print("First 50 cols:", cols[:50])
print("Last 20 cols:", cols[-20:])
end_of_edit

