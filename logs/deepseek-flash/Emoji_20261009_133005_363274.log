from PIL import Image

im = Image.open('emoji.png').convert('RGB')
w, h = im.size
px = im.load()

# Check if image is mostly white
white = 0
total = 0
for y in range(0, h, 3):
    for x in range(0, w, 3):
        r, g, b = px[x, y]
        total += 1
        if r > 240 and g > 240 and b > 240:
            white += 1
print("White fraction:", white / total)

# Look at a horizontal strip - find non-white columns
# Check row by row for content
for y in range(0, h, 10):
    row = [px[x, y] for x in range(0, w, 100)]
    nonwhite = sum(1 for c in row if not (c[0]>240 and c[1]>240 and c[2]>240))
    print(y, nonwhite, row[:5])
end_of_edit

