import regex

with open('emoji.txt', 'r', encoding='utf-8') as f:
    data = f.read()

emojis = regex.findall(r'\X', data)

# Map each emoji to its pair index (0-9)
pair_map = {
    '👎': 0, '👍': 0,
    '🥩': 1, '🍼': 1,
    '🍺': 2, '🦴': 2,
    '🌚': 3, '🌝': 3,
    '🏈': 4, '⚽️': 4,
    '💔': 5, '❤️\u200d🩹': 5,
    '🔔': 6, '🔕': 6,
    '➕': 7, '➖': 7,
    '📉': 8, '📈': 8,
    '❌': 9, '⭕️': 9,
}

idxs = [pair_map[e] for e in emojis]
print("Pair indices:")
print(idxs)

# Look for repeating cycle
for period in range(1, 50):
    ok = True
    for i in range(len(idxs)):
        if idxs[i] != idxs[i % period]:
            ok = False
            break
    if ok:
        print("Period:", period)
        break
