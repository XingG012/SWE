from PIL import Image
import collections

im = Image.open('emoji.png')
print("Size:", im.size, "Mode:", im.mode)
im = im.convert('RGB')
w, h = im.size
px = im.load()

# Count colors
colors = collections.Counter()
for y in range(0, h, 5):
    for x in range(0, w, 5):
        colors[px[x, y]] += 1
print("Top colors:")
for c, n in colors.most_common(20):
    print(c, n)
