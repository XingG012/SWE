from pwn import *
import re, time

context.log_level = 'error'

def smart_attack(P, Q, p):
    E = P.curve()
    Eqp = EllipticCurve(Qp(p, 2), [ZZ(t) + randint(0,p)*p for t in E.a_invariants()])
    P_Qps = Eqp.lift_x(ZZ(P.xy()[0]), all=True)
    for P_Qp in P_Qps:
        if GF(p)(P_Qp.xy()[1]) == P.xy()[1]:
            break
    Q_Qps = Eqp.lift_x(ZZ(Q.xy()[0]), all=True)
    for Q_Qp in Q_Qps:
        if GF(p)(Q_Qp.xy()[1]) == Q.xy()[1]:
            break
    p_times_P = p*P_Qp
    p_times_Q = p*Q_Qp
    x_P, y_P = p_times_P.xy()
    x_Q, y_Q = p_times_Q.xy()
    phi_P = -(x_P/y_P)
    phi_Q = -(x_Q/y_Q)
    k = phi_Q/phi_P
    return ZZ(k)

r = remote("crypto.chal.csaw.io", 5000)
time.sleep(1)
data = r.recv(timeout=5).decode(errors='replace')
print(data)
r.sendline(b"")
time.sleep(1)
data = r.recv(timeout=5).decode(errors='replace')
print(data)

# parse
p = int(re.search(r'p = (\d+)', data).group(1))
a = int(re.search(r'a = (\d+)', data).group(1))
b = int(re.search(r'b = (\d+)', data).group(1))
P1m = re.search(r'P1: \((\d+) : (\d+)', data)
P2m = re.search(r'P2: \((\d+) : (\d+)', data)
P1 = (int(P1m.group(1)), int(P1m.group(2)))
P2 = (int(P2m.group(1)), int(P2m.group(2)))

E = EllipticCurve(GF(p), [a, b])
P1E = E(P1)
P2E = E(P2)
secret = smart_attack(P1E, P2E, p)
print("Secret:", secret)
r.sendline(str(secret).encode())
time.sleep(1)
data = r.recv(timeout=5).decode(errors='replace')
print("RESP:", data)
r.close()
end_of_edit

