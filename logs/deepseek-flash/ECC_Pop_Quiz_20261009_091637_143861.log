4:def smart_attack(P, Q, p):
5:    E = P.curve()
6:    Eqp = EllipticCurve(Qp(p, 2), [ZZ(t) + randint(0,p)*p for t in E.a_invariants()])
7:    P_Qps = Eqp.lift_x(ZZ(P.xy()[0]), all=True)
8:    for P_Qp in P_Qps:
9:        if GF(p)(P_Qp.xy()[1]) == P.xy()[1]:
10:            break
11:    Q_Qps = Eqp.lift_x(ZZ(Q.xy()[0]), all=True)
12:    for Q_Qp in Q_Qps:
13:        if GF(p)(Q_Qp.xy()[1]) == Q.xy()[1]:
14:            break
15:    p_times_P = p*P_Qp
16:    p_times_Q = p*Q_Qp
17:    x_P, y_P = p_times_P.xy()
18:    x_Q, y_Q = p_times_Q.xy()
19:    phi_P = -(x_P/y_P)
20:    phi_Q = -(x_Q/y_Q)
21:    k = phi_Q/phi_P
22:    return ZZ(k)
