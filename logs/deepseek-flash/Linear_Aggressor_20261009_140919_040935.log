from pwn import *

io = remote('android-dropper.csaw.io', 3000)

def query(vals):
    io.recvuntil(b'Enter your input:')
    for v in vals:
        io.recvuntil(b'Enter your input:')
        io.sendline(str(v).encode())
    io.recvuntil(b'Your result is:')
    res = io.recvline().strip()
    return int(res)

# bias with all zeros
b = query([0]*30)
print("bias:", b)

weights = []
for i in range(30):
    v = [0]*30
    v[i] = 1
    w = query(v) - b
    weights.append(w)
    print(i, w)

print("weights:", weights)
end_of_edit

