from pwn import *
from concurrent.futures import ThreadPoolExecutor

def query(vals):
    io = remote('android-dropper.csaw.io', 3000)
    io.recvuntil(b'Enter your input:')
    for i, v in enumerate(vals):
        io.sendline(str(v).encode())
        if i < len(vals) - 1:
            io.recvuntil(b'Enter your input:')
    io.recvuntil(b'Your result is:')
    data = io.recvall(timeout=3)
    io.close()
    return int(data.strip())

# bias with all zeros
b = query([0]*30)
print("bias:", b)

def get_w(i):
    v = [0]*30
    v[i] = 1
    return i, query(v) - b

weights = [0]*30
with ThreadPoolExecutor(max_workers=30) as ex:
    for i, w in ex.map(get_w, range(30)):
        weights[i] = w
        print(i, w)

print("weights:", weights)
end_of_edit

