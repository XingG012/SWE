import socket
import struct
# Build a DNS query for scp-terminal.foundation
def build_query(domain):
    tid = 0x1234
    flags = 0x0100
    q = struct.pack('>HHHHHH', tid, flags, 1, 0, 0, 0)
    for part in domain.split('.'):
        q += bytes([len(part)]) + part.encode()
    q += b'\x00'
    q += struct.pack('>HH', 1, 1)
    return q
