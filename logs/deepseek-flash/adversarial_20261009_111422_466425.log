import base64
import re

# Read the assignment file
with open('assignment.txt', 'r') as f:
    content = f.read()

# Find the section with ciphertexts (between "enemy control:" and "Upon further investigation")
start = content.find('enemy control:')
end = content.find('Upon further investigation')
section = content[start:end]

# Split into blocks separated by blank lines
blocks = re.split(r'\n\s*\n', section)
cts = []
for block in blocks:
    # Remove the header line
    lines = block.strip().split('\n')
    # Skip the first line if it contains "enemy control"
    b64 = ''
    for line in lines:
        line = line.strip()
        if line and not line.startswith('enemy control') and not line.startswith('While digging'):
            b64 += line
    if b64:
        try:
            ct = base64.b64decode(b64)
            cts.append(ct)
        except Exception as e:
            print(f"Error: {e} for {b64[:50]}")

print(f"Number of ciphertexts: {len(cts)}")
for i, ct in enumerate(cts):
    print(f"[{i}] len={len(ct)}")

# Save to file
import pickle
with open('cts.pkl', 'wb') as f:
    pickle.dump(cts, f)
end_of_edit

