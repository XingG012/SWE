import base64
import re

# Read the assignment file
with open('assignment.txt', 'r') as f:
    content = f.read()

start = content.find('enemy control:')
end = content.find('Upon further investigation')
section = content[start:end]

blocks = re.split(r'\n\s*\n', section)
cts = []
for block in blocks:
    lines = block.strip().split('\n')
    b64 = ''
    for line in lines:
        line = line.strip()
        if line and not line.startswith('enemy control') and not line.startswith('While digging'):
            b64 += line
    if b64:
        try:
            ct = base64.b64decode(b64)
            cts.append(ct)
        except Exception as e:
            pass

print(f"Number of ciphertexts: {len(cts)}")
maxlen = max(len(c) for c in cts)

# Known plaintexts (cribs) - from the Matrix movie quotes
# We'll use these to recover the keystream exactly
cribs = {
    0: "What is real? How do you define real? If you're talking about what you can feel, what you can smell, what you can taste and see, then real is simply electrical signals interpreted by your brain.",
    1: "Neo, sooner or later you're going to realize, just as I did, that there's a difference between knowing the path, and walking the path.",
    5: "Attack at dawn. Use the address 37.9257 10.2036 1939.283 - Do not reply to this message. Attack at dawn. Use the address 37.9257 10.2036 1939.283 - Do not reply to this message.",
    6: "Have you ever had a dream Neo, that you were so sure was real? What if you were unable to wake from that dream? How would you know the difference between the dream world, and the real world?",
    10: "The Matrix is older than you know. I prefer counting from the emergence of one integral anomaly to the emergence of the next, in which case this is the sixth version.",
    15: "I won't lie to you, Neo. Every single man or woman who has stood their ground, everyone who has fought an agent has died. But where they have failed, you will succeed.",
    18: "Everything that has a beginning has an end. I see the end coming. I see the darkness spreading. I see death... and you are all that stands in his way.",
}

# Recover keystream from cribs
keystream = [None] * maxlen
for idx, crib in cribs.items():
    ct = cts[idx]
    crib_bytes = crib.encode()
    for i in range(min(len(crib_bytes), len(ct))):
        ks = ct[i] ^ crib_bytes[i]
        if keystream[i] is None:
            keystream[i] = ks
        elif keystream[i] != ks:
            print(f"Conflict at pos {i}: {keystream[i]} vs {ks} (crib {idx})")

# Fill in unknown positions with statistical method
freq = {
    ' ': 15.0, 'e': 12.7, 't': 9.1, 'a': 8.2, 'o': 7.5, 'i': 7.0, 'n': 6.7,
    's': 6.3, 'h': 6.1, 'r': 6.0, 'd': 4.3, 'l': 4.0, 'c': 2.8, 'u': 2.8,
    'm': 2.4, 'w': 2.4, 'f': 2.2, 'g': 2.0, 'y': 2.0, 'p': 1.9, 'b': 1.5,
    'v': 1.0, 'k': 0.8, 'j': 0.15, 'x': 0.15, 'q': 0.10, 'z': 0.07,
    'E': 12.7, 'T': 9.1, 'A': 8.2, 'O': 7.5, 'I': 7.0, 'N': 6.7,
    'S': 6.3, 'H': 6.1, 'R': 6.0, 'D': 4.3, 'L': 4.0, 'C': 2.8, 'U': 2.8,
    'M': 2.4, 'W': 2.4, 'F': 2.2, 'G': 2.0, 'Y': 2.0, 'P': 1.9, 'B': 1.5,
    'V': 1.0, 'K': 0.8, 'J': 0.15, 'X': 0.15, 'Q': 0.10, 'Z': 0.07,
    '.': 1.0, ',': 1.0, '\n': 1.0, "'": 0.5, '"': 0.5, '-': 0.5,
}

def score_byte(b):
    c = chr(b)
    if c in freq:
        return freq[c]
    if 32 <= b < 127:
        return 0.1
    return -5.0

for pos in range(maxlen):
    if keystream[pos] is None:
        best_ks = 0
        best_score = -1e9
        for ks in range(256):
            score = 0
            for ct in cts:
                if pos < len(ct):
                    pt_byte = ct[pos] ^ ks
                    score += score_byte(pt_byte)
            if score > best_score:
                best_score = score
                best_ks = ks
        keystream[pos] = best_ks

# Decrypt all ciphertexts
print("\n=== Decrypted ciphertexts ===")
for i, ct in enumerate(cts):
    pt = bytes(c ^ keystream[j] for j, c in enumerate(ct))
    try:
        text = pt.decode('ascii')
    except:
        text = pt.decode('latin-1')
    print(f"[{i}] {repr(text)}")
