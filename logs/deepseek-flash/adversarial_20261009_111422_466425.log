import base64
import re
import pickle

# Read the assignment file
with open('assignment.txt', 'r') as f:
    content = f.read()

# Find the section with ciphertexts
start = content.find('enemy control:')
end = content.find('Upon further investigation')
section = content[start:end]

# Split into blocks separated by blank lines
blocks = re.split(r'\n\s*\n', section)
cts = []
for block in blocks:
    lines = block.strip().split('\n')
    b64 = ''
    for line in lines:
        line = line.strip()
        if line and not line.startswith('enemy control') and not line.startswith('While digging'):
            b64 += line
    if b64:
        try:
            ct = base64.b64decode(b64)
            cts.append(ct)
        except Exception as e:
            pass

print(f"Number of ciphertexts: {len(cts)}")
maxlen = max(len(c) for c in cts)
print(f"Max length: {maxlen}")

# XOR two byte strings
def xor(a, b):
    return bytes(x ^ y for x, y in zip(a, b))

# Crib dragging: try a crib at each position in each ciphertext
def crib_drag(crib):
    crib_bytes = crib.encode()
    results = []
    for i, ct in enumerate(cts):
        for pos in range(len(ct) - len(crib_bytes) + 1):
            # XOR crib with ciphertext at position
            keystream_guess = xor(ct[pos:pos+len(crib_bytes)], crib_bytes)
            # Try to decrypt other ciphertexts with this keystream guess
            decrypted = []
            for j, ct2 in enumerate(cts):
                if j == i:
                    continue
                if pos + len(crib_bytes) <= len(ct2):
                    pt = xor(ct2[pos:pos+len(crib_bytes)], keystream_guess)
                    decrypted.append((j, pt))
            results.append((i, pos, decrypted))
    return results

# Try common cribs
cribs = ["the ", "The ", "and ", "ing ", "tion", "flag", "flag{", "HTB{", "csaw", "CSAW", "secret", "message", "http", "://", "password", "key", "KEY", "IV", "AES", "CTR", "encrypt", "decrypt", "cipher", "plaintext", "ciphertext"]

for crib in cribs:
    results = crib_drag(crib)
    for (i, pos, decrypted) in results:
        # Check if any decrypted text looks readable
        for (j, pt) in decrypted:
            try:
                text = pt.decode('ascii')
                # Check if mostly printable
                printable = sum(1 for c in text if 32 <= ord(c) < 127)
                if printable >= len(text) * 0.8:
                    print(f"Crib '{crib}' at ct[{i}] pos {pos} -> ct[{j}]: {repr(text)}")
            except:
                pass
