from bls.scheme import *
from bls.utils import *
from bls.utils import o

params = setup()
(sks, vks) = ttp_keygen(params, 2, 3)

s_chester = sign(params, sks[2], "this stuff")

print("o =", o)
print("lagrange_basis(2, o, 1, 0) =", lagrange_basis(2, o, 1, 0))
print("lagrange_basis(2, o, 2, 0) =", lagrange_basis(2, o, 2, 0))

s0 = s_chester
s1 = 2 * s_chester
print("s0 == s1:", s0 == s1)
print("s1 == 2*s0:", s1 == 2*s0)

# manual aggregate
l1 = lagrange_basis(2, o, 1, 0)
l2 = lagrange_basis(2, o, 2, 0)
manual = l1 * s0 + l2 * s1
print("manual isinf:", manual.isinf())
print("manual == -4*s_chester:", manual == -4*s_chester)

aggr_sigma = aggregate_sigma(params, [s0, s1], threshold=True)
print("aggr_sigma isinf:", aggr_sigma.isinf())
end_of_edit

