from bls.scheme import *
from bls.utils import *

params = setup()
(sks, vks) = ttp_keygen(params, 2, 3)

# Get Chester's signature on "this stuff"
s_chester = sign(params, sks[2], "this stuff")

# Our crafted values
s0 = s_chester
s1 = 2 * s_chester
p0 = vks[0]
p1 = vks[1]
p2 = -3 * vks[1] - vks[2]

aggr_vk = aggregate_vk(params, [p0, p1, p2], threshold=True)
aggr_sigma = aggregate_sigma(params, [s0, s1], threshold=True)

print("Verify:", verify(params, aggr_vk, aggr_sigma, "this stuff"))
end_of_edit

