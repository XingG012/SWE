1:""" BLS signature scheme """
2:from bplib.bp import BpGroup, G2Elem
3:from bls.utils import *
4:
5:
6:def setup():
7:	""" generate all public parameters """
8:	G = BpGroup()
9:	(g1, g2) = G.gen1(), G.gen2()
10:	(e, o) = G.pair, G.order()
11:	return (G, o, g1, g2, e)
12:
13:
14:def ttp_keygen(params, t, n):
15:	""" generate keys for threshold signature (executed by a TTP) """
16:	assert n >= t and t > 0
17:	(G, o, g1, g2, e) = params
18:	# generate polynomials
19:	v = [o.random() for _ in range(0,t)]
20:	# generate shares
21:	sk = [poly_eval(v,i) % o for i in range(1,n+1)]
22:	# set keys
23:	vk = [xi*g2 for xi in sk]
24:	return (sk, vk)
25:
26:
27:def aggregate_vk(params, vk, threshold=True):
28:	""" aggregate the verification keys """
29:	(G, o, g1, g2, e) = params
30:	t = len(vk)
31:	# evaluate all lagrange basis polynomial li(0)
32:	l = [lagrange_basis(t, o, i, 0) for i in range(1,t+1)] if threshold else [1 for _ in range(t)]
33:	# aggregate keys
34:	aggr_vk = ec_sum([l[i]*vk[i] for i in range(t)])
35:	return aggr_vk
36:
37:
38:def sign(params, sk, m):
39:	""" sign messages """
40:	assert len(m) > 0
41:	(G, o, g1, g2, e) = params
42:	digest = hash(m)
43:	h = G.hashG1(digest)
44:	sigma = sk*h
45:	return sigma
46:
47:
48:def aggregate_sigma(params, sigs, threshold=True):
49:	""" aggregate partial signatures """
50:	(G, o, g1, g2, e) = params
51:	t = len(sigs)
52:	# evaluate all lagrange basis polynomial li(0)
53:	l = [lagrange_basis(t, o, i, 0) for i in range(1,t+1)] if threshold else [1 for _ in range(t)]
54:	# aggregate sigature
55:	aggr_s = ec_sum([l[i]*sigs[i] for i in range(t)])
56:	return aggr_s
57:
58:
59:def verify(params, aggr_vk, sigma, m):
60:	""" verify the signature """
61:	(G, o, g1, g2, e) = params
62:	digest = hash(m)
63:	h = G.hashG1(digest)
64:	return not h.isinf() and e(sigma, g2) == e(h, aggr_vk)
