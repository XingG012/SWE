9:def poly_eval(coeff, x):
10:	""" evaluate a polynomial defined by the list of coefficient coeff at point x """
11:	return sum([coeff[i] * (x ** i) for i in range(len(coeff))])
12:
13:def lagrange_basis(t, o, i, x=0):
14:	""" generates the lagrange basis polynomial li(x), for a polynomial of degree t-1 """
15:	numerator, denominator = 1, 1
16:	for j in range(1,t+1):
17:		if j != i:
18:			numerator = (numerator * (x - j)) % o
19:			denominator = (denominator * (i - j)) % o 
20:	return (numerator * denominator.mod_inverse(o)) % o
