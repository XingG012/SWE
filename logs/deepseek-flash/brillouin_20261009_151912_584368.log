from bls.scheme import *
from bls.utils import *

params = setup()
(sks, vks) = ttp_keygen(params, 2, 3)

s_chester = sign(params, sks[2], "this stuff")

s0 = s_chester
s1 = 2 * s_chester
p0 = vks[0]
p1 = vks[1]
p2 = -3 * vks[1] - vks[2]

print("p2 isinf:", p2.isinf())
print("s0 isinf:", s0.isinf())
print("s1 isinf:", s1.isinf())

aggr_vk = aggregate_vk(params, [p0, p1, p2], threshold=True)
aggr_sigma = aggregate_sigma(params, [s0, s1], threshold=True)
print("aggr_vk isinf:", aggr_vk.isinf())
print("aggr_sigma isinf:", aggr_sigma.isinf())

# Check the math: aggr_vk should equal -4*sk2*g2 = -4*vks[2]
expected_vk = -4 * vks[2]
print("aggr_vk == -4*vk2:", aggr_vk == expected_vk)

# Check sigma
expected_sigma = -4 * s_chester
print("aggr_sigma == -4*s_chester:", aggr_sigma == expected_sigma)

print("Verify:", verify(params, aggr_vk, aggr_sigma, "this stuff"))
