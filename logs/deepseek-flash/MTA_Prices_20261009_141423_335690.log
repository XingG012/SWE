import socket
from concurrent.futures import ThreadPoolExecutor

def check(ip, port):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(0.5)
    try:
        s.connect((ip, port))
        return (ip, port)
    except:
        return None
    finally:
        s.close()

targets = []
for i in range(1, 30):
    for p in [80, 443, 5000, 5800, 8000, 8080, 3000, 5001, 9000]:
        targets.append((f"172.19.0.{i}", p))

with ThreadPoolExecutor(max_workers=100) as ex:
    for r in ex.map(lambda t: check(*t), targets):
        if r:
            print(f"{r[0]}:{r[1]} OPEN")
end_of_edit

