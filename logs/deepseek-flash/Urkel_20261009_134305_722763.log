import hashlib

tests = [
    ('Laura!... Bazooms!', '98767cec58ce4cdb6181ff97710bef2ef2684dbe5c3f9b8f847d2a4d3c1540f0'),
    ('WHOA, MAMA!', 'd3776e045781f2a916b1eb6ff941fed6087d2f6bc02ad130fae6b9cbbe57b2e6'),
    ('I hurt myself. Can you carry me home?', 'f99b946aa21aa9d953063e5ef55340e9e5e36072f1c16e6e75b892c640c03095'),
]

for pt, h in tests:
    for name in ['md5', 'sha1', 'sha256', 'sha512', 'sha224', 'sha384', 'blake2b', 'blake2s']:
        try:
            d = hashlib.new(name, pt.encode()).hexdigest()
            if d == h:
                print("MATCH", name, pt)
        except Exception as e:
            pass
    # also try with newline
    for name in ['md5', 'sha1', 'sha256', 'sha512']:
        d = hashlib.new(name, (pt+'\n').encode()).hexdigest()
        if d == h:
            print("MATCH+nl", name, pt)
print("done")
