edit 1:1
import hashlib
import string

targets = {'1d': None, 'de': None, '1b': None, '00': None, 'c3': None, '5b': None}

# try single characters
chars = string.printable
for c in chars:
    h = hashlib.sha256(c.encode()).hexdigest()
    first = h[:2]
    if first in targets and targets[first] is None:
        targets[first] = repr(c)
        print("FOUND", first, repr(c))

print(targets)
end_of_edit

