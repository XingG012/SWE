python3 -c "
import re
coords=set()
for line in open('/tmp/decoded.txt',errors='ignore'):
    m=re.match(r'\\\$GPGGA,,([\d.]+),N,([\d.]+),W',line)
    if m: coords.add((float(m.group(1)),float(m.group(2))))
lats=[c[0] for c in coords]; lons=[c[1] for c in coords]
min_lat,max_lat=min(lats),max(lats); min_lon,max_lon=min(lons),max(lons)
rows=int(max_lon-min_lon)+1; cols=int(max_lat-min_lat)+1
grid=[[' ']*cols for _ in range(rows)]
for lat,lon in coords:
    grid[int(lon-min_lon)][int(lat-min_lat)]='#'
for row in grid: print(''.join(row))
"

