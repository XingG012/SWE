edit 1:1
import base64

coords = set()
with open('/tmp/coords_b64.txt') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            decoded = base64.b64decode(line).decode('ascii', errors='ignore')
        except Exception:
            continue
        parts = decoded.split(',')
        if len(parts) >= 6:
            try:
                lat = float(parts[2])
                lon = float(parts[4])
                coords.add((lat, lon))
            except ValueError:
                pass

print("num unique coords:", len(coords))
lats = [c[0] for c in coords]
lons = [c[1] for c in coords]
min_lat, max_lat = min(lats), max(lats)
min_lon, max_lon = min(lons), max(lons)
print("lat range:", min_lat, max_lat)
print("lon range:", min_lon, max_lon)

rows = int(max_lat - min_lat) + 1
cols = int(max_lon - min_lon) + 1
print("grid:", rows, "x", cols)

grid = [[' ' for _ in range(cols)] for _ in range(rows)]
for lat, lon in coords:
    r = int(lat - min_lat)
    c = int(lon - min_lon)
    grid[r][c] = '#'

for row in grid:
    print(''.join(row))
end_of_edit

