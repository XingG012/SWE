import base64

coords = []
with open('/tmp/coords_order.txt') as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        try:
            decoded = base64.b64decode(line).decode('ascii', errors='ignore')
        except Exception:
            continue
        parts = decoded.split(',')
        if len(parts) >= 6:
            try:
                lat = float(parts[2])
                lon = float(parts[4])
                coords.append((lat, lon))
            except ValueError:
                pass

print("num coords:", len(coords))

# Plot trajectory: mark each point, and draw lines between consecutive points
min_lat = min(c[0] for c in coords)
max_lat = max(c[0] for c in coords)
min_lon = min(c[1] for c in coords)
max_lon = max(c[1] for c in coords)
rows = int(max_lat - min_lat) + 1
cols = int(max_lon - min_lon) + 1
print("grid:", rows, "x", cols)

grid = [[' ' for _ in range(cols)] for _ in range(rows)]

def draw_line(r0, c0, r1, c1):
    # Bresenham
    dr = abs(r1 - r0)
    dc = abs(c1 - c0)
    sr = 1 if r0 < r1 else -1
    sc = 1 if c0 < c1 else -1
    err = dr - dc
    while True:
        if 0 <= r0 < rows and 0 <= c0 < cols:
            grid[r0][c0] = '#'
        if r0 == r1 and c0 == c1:
            break
        e2 = 2 * err
        if e2 > -dc:
            err -= dc
            r0 += sr
        if e2 < dr:
            err += dr
            c0 += sc

prev = None
for lat, lon in coords:
    r = int(lat - min_lat)
    c = int(lon - min_lon)
    if prev is not None:
        draw_line(prev[0], prev[1], r, c)
    prev = (r, c)

for row in grid:
    print(''.join(row))
end_of_edit

