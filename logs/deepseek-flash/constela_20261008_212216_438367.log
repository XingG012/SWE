import re

# Parse events in order
events = []
cur_lat = None
cur_lon = None
with open('/tmp/decoded.txt', errors='ignore') as f:
    for line in f:
        m = re.match(r'\$GPGGA,,([\d.]+),N,([\d.]+),W', line)
        if m:
            cur_lat = float(m.group(1))
            cur_lon = float(m.group(2))
        m2 = re.match(r'00,,([\d.]+),ft', line)
        if m2:
            alt = float(m2.group(1))
            events.append((cur_lat, cur_lon, alt))

# Dedup consecutive
dedup = []
for e in events:
    if not dedup or dedup[-1] != e:
        dedup.append(e)

print("dedup events:", len(dedup))

# Unique coordinates in order of first appearance
seen = set()
unique_order = []
for lat, lon, alt in dedup:
    if (lat, lon) not in seen:
        seen.add((lat, lon))
        unique_order.append((lat, lon, alt))

print("unique coords:", len(unique_order))

# Plot path
lats = [c[0] for c in unique_order]
lons = [c[1] for c in unique_order]
min_lat, max_lat = min(lats), max(lats)
min_lon, max_lon = min(lons), max(lons)
rows = int(max_lat - min_lat) + 1
cols = int(max_lon - min_lon) + 1
print("grid:", rows, "x", cols)

grid = [[' ' for _ in range(cols)] for _ in range(rows)]

def draw_line(r0, c0, r1, c1):
    dr = abs(r1 - r0); dc = abs(c1 - c0)
    sr = 1 if r0 < r1 else -1
    sc = 1 if c0 < c1 else -1
    err = dr - dc
    while True:
        if 0 <= r0 < rows and 0 <= c0 < cols:
            grid[r0][c0] = '#'
        if r0 == r1 and c0 == c1:
            break
        e2 = 2 * err
        if e2 > -dc:
            err -= dc; r0 += sr
        if e2 < dr:
            err += dr; c0 += sc

prev = None
for lat, lon, alt in unique_order:
    r = int(lat - min_lat)
    c = int(lon - min_lon)
    if prev is not None:
        draw_line(prev[0], prev[1], r, c)
    prev = (r, c)

for row in grid:
    print(''.join(row))
end_of_edit

