python3 -c "
import re,math
events=[]
cur=None
for line in open('/tmp/decoded.txt',errors='ignore'):
    m=re.match(r'\\\$GPGGA,,([\d.]+),N,([\d.]+),W',line)
    if m: cur=(float(m.group(1)),float(m.group(2)))
    m2=re.match(r'00,,([\d.]+),ft',line)
    if m2 and cur: events.append(cur)
dedup=[]
for e in events:
    if not dedup or dedup[-1]!=e: dedup.append(e)
seen=set(); uo=[]
for e in dedup:
    if e not in seen: seen.add(e); uo.append(e)
print('unique:',len(uo))
dists=[]
for i in range(1,len(uo)):
    d=math.hypot(uo[i][0]-uo[i-1][0],uo[i][1]-uo[i-1][1])
    dists.append(d)
print('avg dist:',sum(dists)/len(dists))
print('max dist:',max(dists))
print('first 30 dists:',[round(d,1) for d in dists[:30]])
