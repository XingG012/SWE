edit 1:1
import re

# Parse the decoded file into a sequence of (lat, lon, alt) events
events = []
cur_lat = None
cur_lon = None
with open('/tmp/decoded.txt', errors='ignore') as f:
    for line in f:
        m = re.match(r'\$GPGGA,,([\d.]+),N,([\d.]+),W', line)
        if m:
            cur_lat = float(m.group(1))
            cur_lon = float(m.group(2))
        m2 = re.match(r'00,,([\d.]+),ft', line)
        if m2:
            alt = float(m2.group(1))
            events.append((alt, cur_lat, cur_lon))

# Deduplicate consecutive identical events
dedup = []
for e in events:
    if not dedup or dedup[-1] != e:
        dedup.append(e)

print("total events:", len(events), "dedup:", len(dedup))

# Group into frames: a frame is a sequence of events with distinct altitudes
frames = []
cur_frame = {}
for alt, lat, lon in dedup:
    idx = int(alt - 10000)
    if idx in cur_frame:
        # new frame
        frames.append(cur_frame)
        cur_frame = {}
    cur_frame[idx] = (lat, lon)
if cur_frame:
    frames.append(cur_frame)

print("num frames:", len(frames))
for i, fr in enumerate(frames[:5]):
    print("frame", i, "size", len(fr))
end_of_edit

