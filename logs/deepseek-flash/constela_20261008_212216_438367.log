import re

# Parse events: (lat, lon, alt)
events = []
cur_lat = None
cur_lon = None
with open('/tmp/decoded.txt', errors='ignore') as f:
    for line in f:
        m = re.match(r'\$GPGGA,,([\d.]+),N,([\d.]+),W', line)
        if m:
            cur_lat = float(m.group(1))
            cur_lon = float(m.group(2))
        m2 = re.match(r'00,,([\d.]+),ft', line)
        if m2:
            alt = float(m2.group(1))
            events.append((cur_lat, cur_lon, alt))

# Dedup consecutive
dedup = []
for e in events:
    if not dedup or dedup[-1] != e:
        dedup.append(e)

print("dedup events:", len(dedup))

# For each unique coordinate, collect altitudes
from collections import defaultdict
coord_alts = defaultdict(list)
for lat, lon, alt in dedup:
    coord_alts[(lat, lon)].append(alt)

print("unique coords:", len(coord_alts))

# Check if each coord has a consistent altitude
for c, alts in list(coord_alts.items())[:10]:
    print(c, set(alts))
