def parse_round_output(text):
    # returns (color, count, ips, bets, wons)
    color = None
    m = re.search(r"The color was (\w+)", text)
    if m:
        color = m.group(1)
    lines = text.split("\n")
    ips = []
    bets = []
    wons = []
    for line in lines:
        m = re.match(r"xxx\.xxx\.(\d+)\.(\d+) (Won|Lost)! This player betted (\d+) dollars!", line.strip())
        if m:
            x = int(m.group(1)); y = int(m.group(2))
            ip = (x << 8) | y
            ips.append(ip)
            wons.append(m.group(3) == "Won")
            bets.append(int(m.group(4)))
    return color, ips, bets, wons

def color_of(winning):
    if winning == 0:
        return "green"
    elif winning <= 7:
        return "red"
    else:
        return "black"

def find_seed0(color, ips, bets, wons):
    count = len(ips)
    for seed in range(65536):
        w, c, sips, sbets, swons = simulate_round(seed)
        if c != count:
            continue
        if color_of(w) != color:
            continue
        if sips != ips:
            continue
        if sbets != bets:
            continue
        if swons != wons:
            continue
        return seed
    return None
