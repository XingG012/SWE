edit 1:1
MASK48 = (1 << 48) - 1
MULT = 0x5DEECE66D
ADD = 0xB

class JavaRandom:
    def __init__(self, seed):
        self.setSeed(seed)
    def setSeed(self, seed):
        self.seed = (seed ^ MULT) & MASK48
    def next(self, bits):
        self.seed = (self.seed * MULT + ADD) & MASK48
        return self.seed >> (48 - bits)
    def nextInt(self):
        v = self.next(32)
        if v >= (1 << 31):
            v -= (1 << 32)
        return v

r = JavaRandom(12345)
for _ in range(10):
    print(r.nextInt())
