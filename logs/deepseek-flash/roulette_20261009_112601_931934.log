def main():
    s = socket.create_connection(("rev.chal.csaw.io", 4200))
    f = s.makefile("rwb", buffering=0)
    def read_until(prompt):
        data = b""
        while not data.endswith(prompt):
            ch = f.read(1)
            if not ch:
                break
            data += ch
        return data.decode(errors="replace")
    def sendline(x):
        f.write((x + "\n").encode())

    # read initial banner up to first ">"
    buf = read_until(b">")
    print(buf)

    # Round 0: bet 0
    sendline("0")
    buf = read_until(b">")
    print(buf)
    # parse color
    color, ips, bets, wons = parse_round_output(buf)
    print("Round0 color:", color, "count:", len(ips))
    seed0 = find_seed0(color, ips, bets, wons)
    print("seed0 =", seed0)
    if seed0 is None:
        print("Failed to find seed0")
        return

    # Now we know seed0. Maintain random state.
    # After round 0, state is at seed0 advanced by (2 + 3*count0) calls.
    count0 = len(ips)
    r = JavaRandom(seed0)
    # advance through round 0 calls
    for _ in range(2 + 3*count0):
        r.nextInt()
    # i3 for round 1 = last IP & 65535
    i3 = ips[-1] & 65535

    money = 50
    rounds = 1
    while rounds < 21:
        # K for this round
        K = r.nextInt() & 65535
        # find bet i in [0, money] such that new Random(i3 + i + K).nextInt() & 15 == 0
        chosen = None
        for i in range(0, money + 1):
            rr = JavaRandom(i3 + i + K)
            if (rr.nextInt() & 15) == 0:
                chosen = i
                break
        if chosen is None:
            # try any i up to money, fallback bet 0
            chosen = 0
        print("Round", rounds, "betting", chosen, "on green (K=%d, i3=%d)" % (K, i3))
        sendline(str(chosen))
        buf = read_until(b">")
        print(buf)
        color, ips, bets, wons = parse_round_output(buf)
        # advance r through this round's calls
        cnt = len(ips)
        for _ in range(2 + 3*cnt):
            r.nextInt()
        i3 = ips[-1] & 65535
        rounds += 1
        if "Flag" in buf or "flag" in buf:
            print("FLAG FOUND")
            break

    # read remaining
    try:
        rest = read_until(b"}")
        print(rest)
    except Exception as e:
        print(e)

main()
end_of_edit

