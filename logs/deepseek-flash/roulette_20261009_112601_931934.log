import socket
import re
import sys

MASK48 = (1 << 48) - 1
MULT = 0x5DEECE66D
ADD = 0xB

class JavaRandom:
    def __init__(self, seed):
        self.setSeed(seed)
    def setSeed(self, seed):
        self.seed = (seed ^ MULT) & MASK48
    def next(self, bits):
        self.seed = (self.seed * MULT + ADD) & MASK48
        return self.seed >> (48 - bits)
    def nextInt(self):
        v = self.next(32)
        # convert to signed 32-bit
        if v >= (1 << 31):
            v -= (1 << 32)
        return v

def simulate_round(seed):
    r = JavaRandom(seed)
    winning = r.nextInt() & 15
    count = 1 + abs(r.nextInt()) % 10
    ips = [r.nextInt() for _ in range(count)]
    bets = [abs(r.nextInt() % 50) for _ in range(count)]
    wons = [(abs(r.nextInt()) & 1) == 0 for _ in range(count)]
    return winning, count, ips, bets, wons

def ip2str(ip):
    return "xxx.xxx.%d.%d" % ((ip & 65280) >> 8, ip & 255)
end_of_edit

