MASK48 = (1 << 48) - 1
MULT = 0x5DEECE66D
ADD = 0xB

class JavaRandom:
    def __init__(self, seed):
        self.setSeed(seed)
    def setSeed(self, seed):
        self.seed = (seed ^ MULT) & MASK48
    def next(self, bits):
        self.seed = (self.seed * MULT + ADD) & MASK48
        return self.seed >> (48 - bits)
    def nextInt(self):
        v = self.next(32)
        if v >= (1 << 31):
            v -= (1 << 32)
        return v

obs_ips = [52048, 26447, 34772, 63812, 26150, 43372]
obs_bets = [4, 41, 19, 35, 36, 27]
obs_wons = [True, True, False, True, False, True]
obs_color = "red"

def color_of(w):
    if w == 0: return "green"
    elif w <= 7: return "red"
    else: return "black"

best = None
for seed in range(65536):
    r = JavaRandom(seed)
    winning = r.nextInt() & 15
    count = 1 + abs(r.nextInt()) % 10
    if count != 6: continue
    if color_of(winning) != obs_color: continue
    ips = [r.nextInt() for _ in range(count)]
    bets = [abs(r.nextInt() % 50) for _ in range(count)]
    wons = [(abs(r.nextInt()) & 1) == 0 for _ in range(count)]
    if [(x & 65535) for x in ips] == obs_ips and bets == obs_bets and wons == obs_wons:
        print("FOUND seed", seed)
        best = seed
        break
if best is None:
    print("not found")
end_of_edit

