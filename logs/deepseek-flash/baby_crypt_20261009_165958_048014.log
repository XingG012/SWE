edit 1:1
from pwn import *

def get_cookie(username):
    r = remote("crypto.chal.csaw.io", 8000)
    r.recvuntil(b"username")
    r.sendline(username.encode())
    data = r.recvuntil(b"username", timeout=3)
    r.close()
    # extract cookie
    import re
    m = re.search(rb'Your Cookie is: ([0-9a-f]+)', data)
    return m.group(1).decode() if m else None

for n in range(1, 20):
    u = "a" * n
    c = get_cookie(u)
    print(n, len(c)//2, c)
end_of_edit

