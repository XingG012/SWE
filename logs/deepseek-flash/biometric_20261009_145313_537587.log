edit 1:1
import numpy as np

enc1 = np.array([0.1 * i for i in range(128)])

def test(enc2, label):
    try:
        dist = np.linalg.norm(np.array(enc1) - enc2)
        print(f"{label}: dist={dist}, status={dist < 0.6}")
    except Exception as e:
        print(f"{label}: ERROR {e}")

test([], "empty list")
test([[]], "list of empty list")
test(0, "scalar 0")
test([0]*128, "128 zeros")
test([[0]*128], "list of list of 128 zeros")
test([0]*128 + [0], "129 zeros")
test([0]*127, "127 zeros")
test("abc", "string")
test([float('nan')]*128, "128 NaN")
test([float('inf')]*128, "128 inf")
test([float('-inf')]*128, "128 -inf")
test([0]*128, "128 zeros again")
test(np.zeros(128), "np zeros")
test([0]*128, "zeros")
# Try a list of 128 lists each of length 1
test([[0] for _ in range(128)], "128 lists of 1 zero")
# Try a list of 1 list of 128
test([[0]*128], "1 list of 128 zeros")
end_of_edit

