from pwn import *

def self_descriptive(b):
    # digits[0] is most significant
    digits = [0] * b
    digits[0] = b - 4
    digits[1] = 2
    digits[2] = 1
    digits[b - 4] = 1
    # build the number
    r = 0
    for d in digits:
        r = r * b + d
    return r

r = remote("crypto.chal.csaw.io", 21200)
data = r.recvuntil(b">")
print(data.decode())
# extract base
import re
m = re.search(rb"base (\d+)", data)
b = int(m.group(1))
print("base =", b)
num = self_descriptive(b)
r.sendline(str(num).encode())
print(r.recvall().decode())
end_of_edit

