import sys

def decode_case(filename):
    with open(filename) as f:
        data = f.read()
    # keep only letters
    letters = [c for c in data if c.isalpha()]
    bits = ''.join('1' if c.isupper() else '0' for c in letters)
    # try 8-bit chunks
    out = bytearray()
    for i in range(0, len(bits) - 7, 8):
        out.append(int(bits[i:i+8], 2))
    return bytes(out)

for fn in ['rooster', 'pig', 'sheep']:
    print('===', fn, '===')
    try:
        print(decode_case(fn))
    except Exception as e:
        print('err', e)
