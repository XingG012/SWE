import re
from itertools import permutations

with open('sheep') as f:
    data = f.read().replace('\n', '')
toks = re.findall('baa', data, re.IGNORECASE)
print('num toks', len(toks))

cmds = ['>', '<', '+', '-', '.', ',', '[', ']']
uniq = sorted(set(toks))
print('uniq', uniq)

def run_bf(bf, maxsteps=1000000):
    mem = [0]*30000
    ptr = 0
    pc = 0
    out = []
    steps = 0
    # precompute jumps
    stack = []
    jump = {}
    for i,c in enumerate(bf):
        if c == '[':
            stack.append(i)
        elif c == ']':
            j = stack.pop()
            jump[i] = j
            jump[j] = i
    while pc < len(bf):
        steps += 1
        if steps > maxsteps:
            return None
        c = bf[pc]
        if c == '>': ptr += 1
        elif c == '<': ptr -= 1
        elif c == '+': mem[ptr] = (mem[ptr]+1)%256
        elif c == '-': mem[ptr] = (mem[ptr]-1)%256
        elif c == '.': out.append(chr(mem[ptr]))
        elif c == ',': mem[ptr] = 0
        elif c == '[':
            if mem[ptr] == 0: pc = jump[pc]
        elif c == ']':
            if mem[ptr] != 0: pc = jump[pc]
        pc += 1
    return ''.join(out)

count = 0
for perm in permutations(cmds):
    m = dict(zip(uniq, perm))
    bf = ''.join(m[t] for t in toks)
    # check balance
    bal = 0
    ok = True
    for c in bf:
        if c == '[': bal += 1
        elif c == ']':
            bal -= 1
            if bal < 0: ok = False; break
    if not ok or bal != 0:
        continue
    res = run_bf(bf)
    if res and any(32 <= ord(ch) < 127 for ch in res):
        print('FOUND', perm)
        print(repr(res))
        break
end_of_edit

