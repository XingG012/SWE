import re
from collections import Counter

# rooster: token = cock-a-doodle-doo (14 letters)
with open('rooster') as f:
    data = f.read()
# remove whitespace
data2 = re.sub(r'\s', '', data)
# tokens separated by '-'
# reconstruct: split on '-'
parts = data2.split('-')
print('rooster parts:', len(parts))
# each token = 4 parts: cock, a, doodle, doo
# group into 4
toks = []
for i in range(0, len(parts)-3, 4):
    toks.append('-'.join(parts[i:i+4]))
print('rooster tokens:', len(toks))
print(Counter(toks).most_common(5))
print('distinct:', len(set(toks)))
end_of_edit

