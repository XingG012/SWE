import sys

def run_cow(code):
    # tokenize into 3-char tokens
    tokens = []
    i = 0
    while i < len(code):
        c = code[i]
        if c in 'mM':
            tok = code[i:i+3]
            if len(tok) == 3 and tok[1] in 'oO' and tok[2] in 'oO':
                tokens.append(tok)
                i += 3
                continue
        i += 1
    # build jump table
    stack = []
    jump = {}
    for idx, t in enumerate(tokens):
        if t == 'moo':
            stack.append(idx)
        elif t == 'MOO':
            if stack:
                j = stack.pop()
                jump[j] = idx
                jump[idx] = j
    mem = [0] * 30000
    ptr = 0
    pc = 0
    out = []
    steps = 0
    while pc < len(tokens):
        steps += 1
        if steps > 100000000:
            print('too many steps')
            break
        t = tokens[pc]
        if t == 'moo':
            if mem[ptr] == 0:
                pc = jump[pc]
        elif t == 'mOo':
            ptr -= 1
        elif t == 'moO':
            ptr += 1
        elif t == 'mOO':
            if mem[ptr] == 0:
                # read
                ch = sys.stdin.read(1)
                mem[ptr] = ord(ch) if ch else 0
            else:
                out.append(chr(mem[ptr]))
        elif t == 'Moo':
            if mem[ptr] != 0:
                pc = jump[pc]
        elif t == 'MOo':
            mem[ptr] = (mem[ptr] - 1) % 256
        elif t == 'MoO':
            mem[ptr] = (mem[ptr] + 1) % 256
        elif t == 'MOO':
            if mem[ptr] != 0:
                pc = jump[pc]
        pc += 1
    return ''.join(out)

with open('cow') as f:
    code = f.read()
print(run_cow(code))
