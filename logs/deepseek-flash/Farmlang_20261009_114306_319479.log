import re
from collections import Counter

with open('rooster') as f:
    data = f.read()
letters = [c for c in data if c.isalpha()]
print('total letters:', len(letters))
print('div by 14:', len(letters) % 14)
toks = [''.join(letters[i:i+14]) for i in range(0, len(letters)-13, 14)]
print('tokens:', len(toks))
print('distinct:', len(set(toks)))
for t in toks[:5]:
    print(t)
end_of_edit

