import re

mapping = {
    'baa': '>',
    'baA': '<',
    'bAa': '+',
    'bAA': '-',
    'Baa': '.',
    'BaA': ',',
    'BAa': '[',
    'BAA': ']',
}

with open('sheep') as f:
    data = f.read().replace('\n', '')
toks = re.findall('baa', data, re.IGNORECASE)
bf = ''.join(mapping[t] for t in toks)
print('len', len(bf))
print('open', bf.count('['), 'close', bf.count(']'))
# check balance
bal = 0
minbal = 0
for c in bf:
    if c == '[': bal += 1
    elif c == ']': bal -= 1
    minbal = min(minbal, bal)
print('final bal', bal, 'min', minbal)
end_of_edit

