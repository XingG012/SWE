table = b"keikaku_means_plan!!!!!"
print("table len:", len(table))
print("table values:", list(table))

# Need sum of table[b0..b5] == 498, and table[b0] & 8 == 8
# Find valid indices (0..22)
target = 498

# Find all combos of 6 indices summing to 498
# table values range from 33 ('!') to 117 ('u')
# Max sum = 6*117 = 702, min = 6*33 = 198
# Let's do a search

import itertools

# Get indices where table[i] & 8 == 8 for b0
b0_candidates = [i for i in range(len(table)) if table[i] & 8 == 8]
print("b0 candidates:", b0_candidates)

# For remaining 5 bytes, find combos summing to target - table[b0]
# Use DP or meet in the middle
from collections import defaultdict

# Build all sums of 5 indices
# Actually let's just do a recursive search
results = []

def search(remaining, count, current_sum, current):
    if count == 0:
        if current_sum == target:
            results.append(list(current))
        return
    # prune
    if current_sum > target:
        return
    if current_sum + count * max(table) < target:
        return
    for i in range(len(table)):
        current.append(i)
        search(remaining, count-1, current_sum + table[i], current)
        current.pop()

# This might be slow. Let's use meet in the middle for 5 bytes
# Actually, let's just find one solution

# Meet in the middle: split 5 bytes into 2 and 3
sums2 = defaultdict(list)
for a in range(len(table)):
    for b in range(len(table)):
        sums2[table[a]+table[b]].append((a,b))

sums3 = defaultdict(list)
for a in range(len(table)):
    for b in range(len(table)):
        for c in range(len(table)):
            sums3[table[a]+table[b]+table[c]].append((a,b,c))

found = None
for b0 in b0_candidates:
    rem = target - table[b0]
    for s2, pairs in sums2.items():
        s3 = rem - s2
        if s3 in sums3:
            found = (b0, pairs[0], sums3[s3][0])
            break
    if found:
        break

print("found:", found)
if found:
    b0, (b1,b2), (b3,b4,b5) = found
    num = b0 | (b1<<8) | (b2<<16) | (b3<<24) | (b4<<32) | (b5<<40)
    print("number:", num)
    print("hex:", hex(num))
    print("bytes:", [b0,b1,b2,b3,b4,b5])
    print("sum:", table[b0]+table[b1]+table[b2]+table[b3]+table[b4]+table[b5])
