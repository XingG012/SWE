2026-10-09 16:29:53,777 INFO 🎬 ACTION (primary)
edit 1:1
import struct

data = open("payload.bin","rb").read()

def read_node(addr):
    state = struct.unpack("<i", data[addr:addr+4])[0]
    child0 = struct.unpack("<Q", data[addr+8:addr+16])[0]
    child1 = struct.unpack("<Q", data[addr+16:addr+24])[0]
    return state, child0, child1

# Build mapping: char -> bit sequence
# Traverse: at branch, if char in child0 subtree -> bit 0, else bit 1
# We need to know which chars are in each subtree.

# First, collect all leaves (chars) reachable from each node.
from functools import lru_cache

@lru_cache(maxsize=None)
def leaves(addr):
    state, c0, c1 = read_node(addr)
    if state != -1:
        return frozenset([state & 0xff])
    return leaves(c0) | leaves(c1)

# Now build char -> bits mapping
mapping = {}
def traverse(addr, bits):
    state, c0, c1 = read_node(addr)
    if state != -1:
        mapping[state & 0xff] = bits
        return
    l0 = leaves(c0)
    l1 = leaves(c1)
    # For each char in l0, path goes 0; for l1, path goes 1
    for ch in l0:
        traverse(c0, bits + "0")
    for ch in l1:
        traverse(c1, bits + "1")

traverse(0x1300, "")
print("num chars:", len(mapping))
for ch in sorted(mapping):
    print(repr(chr(ch)), mapping[ch])
end_of_edit

