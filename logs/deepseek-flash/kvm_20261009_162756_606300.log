import struct

data = open("payload.bin","rb").read()

def read_node(addr):
    state = struct.unpack("<i", data[addr:addr+4])[0]
    child0 = struct.unpack("<Q", data[addr+8:addr+16])[0]
    child1 = struct.unpack("<Q", data[addr+16:addr+24])[0]
    return state, child0, child1

# Find all leaves by DFS
leaves_found = []
def dfs(addr, depth, path):
    state, c0, c1 = read_node(addr)
    if state != -1:
        leaves_found.append((addr, state & 0xff, depth, path))
        return
    dfs(c0, depth+1, path+"0")
    dfs(c1, depth+1, path+"1")

dfs(0x1300, 0, "")
print("num leaves:", len(leaves_found))
for addr, ch, depth, path in leaves_found[:50]:
    print(hex(addr), repr(chr(ch)), depth, path)
end_of_edit

