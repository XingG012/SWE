from pwn import *
import re

context.log_level = 'error'

def get_ct(payload):
    r = remote("crypto.chal.csaw.io", 8000)
    r.recvuntil(b"Tell me something: ")
    r.sendline(payload)
    data = r.recvuntil(b"Tell me something: ", timeout=3)
    r.close()
    # find hex line
    lines = data.split(b"\r\n")
    for ln in lines:
        ln = ln.strip()
        if ln and re.fullmatch(rb'[0-9a-fA-F]+', ln):
            return ln.decode()
    return None

