28:# Try to fit a polynomial of degree d over prime P using first d+1 points
29:# and check if remaining points fit
30:def poly_eval(coeffs, x, p):
31:    r = 0
32:    for c in reversed(coeffs):
33:        r = (r * x + c) % p
34:    return r
35:
36:def lagrange_interp(points, p):
37:    # returns coefficients of interpolating polynomial
38:    n = len(points)
39:    coeffs = [0] * n
40:    for i in range(n):
41:        xi, yi = points[i]
42:        # basis polynomial
43:        basis = [1]
44:        den = 1
45:        for j in range(n):
46:            if i == j:
47:                continue
48:            xj = points[j][0]
49:            # multiply basis by (x - xj)
50:            new_basis = [0] * (len(basis) + 1)
51:            for k in range(len(basis)):
52:                new_basis[k] = (new_basis[k] - basis[k] * xj) % p
53:                new_basis[k+1] = (new_basis[k+1] + basis[k]) % p
54:            basis = new_basis
55:            den = (den * (xi - xj)) % p
56:        factor = (yi * pow(den, -1, p)) % p
57:        for k in range(len(basis)):
58:            coeffs[k] = (coeffs[k] + basis[k] * factor) % p
59:    return coeffs
60:
61:# Try different primes
62:primes = [2**128 - 159, 2**128 + 51, 2**127 - 1, 2**128 - 1]
