from Crypto.Util.number import long_to_bytes

shares = {
    1: "c4ee528d1e7d1931e512ff263297e25c",
    2: "4b58b8b5285d2e8642a983881ed28fc7",
    3: "7180fe06299e1774e0a18f48441efdaf",
    4: "48359d52540614247337a5a1191034a7",
    5: "1fcd4a7279840854989b7ad086354b21",
    6: "f69f8e4ecde704a140705927160751d1",
    7: "b0ca40dc161b1baa61930b6b7c311c30",
    8: "04ed6f6bf5ec8c8c2a4d18dcce04ae48",
    9: "430ad338b7b603d1770f94580f23cb38",
    10: "d51669551515b6d31ce3510de343370f",
    11: "b303ee7908dcbc07b8e9dac7e925a417",
    12: "3c4a692ad1b13e27886e2b4893f8d761",
    13: "a8e53ef9ee51cf682f621cb4ea0cb398",
    14: "feb294f9380c462807bb3ea0c7402e12",
    15: "9b2b15a72430189048dee8e9594c9885",
    16: "f4d52e11f6f9b2a4bfbe23526160fdfd",
    17: "d0f902472175a3f2c47a88b3b3108bb2",
    18: "cc29eb96af9c82ab0ba6263a6e5a3768",
    19: "913227d2d7e1a01b4ec52ff630053b73",
    20: "8669dd2b508c2a5dfd24945f8577bd62",
}

pts = [(i, int(h, 16)) for i, h in shares.items()]

# Try to fit a polynomial of degree d over prime P using first d+1 points
# and check if remaining points fit
def poly_eval(coeffs, x, p):
    r = 0
    for c in reversed(coeffs):
        r = (r * x + c) % p
    return r

def lagrange_interp(points, p):
    # returns coefficients of interpolating polynomial
    n = len(points)
    coeffs = [0] * n
    for i in range(n):
        xi, yi = points[i]
        # basis polynomial
        basis = [1]
        den = 1
        for j in range(n):
            if i == j:
                continue
            xj = points[j][0]
            # multiply basis by (x - xj)
            new_basis = [0] * (len(basis) + 1)
            for k in range(len(basis)):
                new_basis[k] = (new_basis[k] - basis[k] * xj) % p
                new_basis[k+1] = (new_basis[k+1] + basis[k]) % p
            basis = new_basis
            den = (den * (xi - xj)) % p
        factor = (yi * pow(den, -1, p)) % p
        for k in range(len(basis)):
            coeffs[k] = (coeffs[k] + basis[k] * factor) % p
    return coeffs

# Try different primes
primes = [2**128 - 159, 2**128 + 51, 2**127 - 1, 2**128 - 1]
for P in primes:
    # use first 5 points to fit degree 4
    sub = pts[:5]
    coeffs = lagrange_interp(sub, P)
    # check remaining
    ok = True
    for x, y in pts[5:]:
        if poly_eval(coeffs, x, P) != y % P:
            ok = False
            break
    print(f"P={P}: degree-4 fit works for all: {ok}")
