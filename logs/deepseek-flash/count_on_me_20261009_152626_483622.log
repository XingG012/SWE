import random

def get_seq(seed, n):
    random.seed(seed)
    return [random.getrandbits(32) for _ in range(n)]

# Each encryption uses 3 values: ks0 (block0), ks1 (block1), ks2 (block2)
# We want ks1_i or ks2_i == ks0_j for some i,j so we can decrypt block1/2 of enc i
# using known E(ks0_j) from block0 of enc j.

found = None
for seed in range(0, 500000):
    seq = get_seq(seed, 300)  # 100 encryptions * 3
    ks0 = seq[0::3]  # block0 keystreams
    ks1 = seq[1::3]  # block1 keystreams
    ks2 = seq[2::3]  # block2 keystreams
    ks0_set = set(ks0)
    for i, v in enumerate(ks1):
        if v in ks0_set:
            found = (seed, 'ks1', i, v)
            break
    if found:
        break
    for i, v in enumerate(ks2):
        if v in ks0_set:
            found = (seed, 'ks2', i, v)
            break
    if found:
        break

print("Found:", found)
end_of_edit

