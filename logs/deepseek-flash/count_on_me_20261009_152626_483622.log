from pwn import *
import random

context.log_level = 'error'

def get_encrypted(seed):
    r = remote("crypto.chal.csaw.io", 1337)
    r.recvuntil(b"Send me a random seed")
    r.send(str(seed).encode().ljust(16, b'0'))
    r.recvuntil(b"Encrypted flag:\n")
    data = r.recvuntil(b"Okay bye")
    r.close()
    return data

data = get_encrypted(0)
# data contains 100 lines separated by \n, then "Okay bye"
lines = data.split(b'\n')
print("Number of lines:", len(lines))
for i, l in enumerate(lines[:5]):
    print(i, len(l), l.hex())
end_of_edit

