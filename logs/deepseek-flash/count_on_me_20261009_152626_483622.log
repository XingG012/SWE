import random

def get_seq(seed, n):
    random.seed(seed)
    return [random.getrandbits(32) for _ in range(n)]

found = None
for seed in range(0, 2000000):
    seq = get_seq(seed, 300)
    ks0 = seq[0::3]
    ks1 = seq[1::3]
    ks0_set = set(ks0)
    for i, v in enumerate(ks1):
        if v in ks0_set:
            found = (seed, i, v)
            break
    if found:
        break

print("Found:", found)
