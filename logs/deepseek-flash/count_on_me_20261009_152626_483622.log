from pwn import *
import random

context.log_level = 'error'

SEED = 71789

def get_seq(seed, n):
    random.seed(seed)
    return [random.getrandbits(32) for _ in range(n)]

# Connect and get ciphertexts
r = remote("crypto.chal.csaw.io", 1337)
r.recvuntil(b"Send me a random seed\n")
r.send(str(SEED).encode().ljust(16, b'0'))
r.recvuntil(b"Encrypted flag:\n")

# Each encryption: 48 bytes ciphertext + 1 newline = 49 bytes
raw = b""
for _ in range(100):
    raw += r.recv(49)
r.close()

ciphertexts = []
for i in range(100):
    block = raw[i*49:i*49+48]
    ciphertexts.append(block)

# Compute keystream sequence
seq = get_seq(SEED, 300)
ks0 = seq[0::3]
ks1 = seq[1::3]
ks2 = seq[2::3]

# Build dict: ks0 value -> E(ks0) = cipher[0:16] XOR b'Encrypted Flag: '
known = {}
for i in range(100):
    E = bytes(a ^ b for a, b in zip(ciphertexts[i][0:16], b'Encrypted Flag: '))
    known[ks0[i]] = E

# Now decrypt blocks 1 and 2
flag_bytes = bytearray()
for i in range(100):
    for blk_idx, ks in [(1, ks1[i]), (2, ks2[i])]:
        if ks in known:
            E = known[ks]
            ct = ciphertexts[i][blk_idx*16:blk_idx*16+16]
            pt = bytes(a ^ b for a, b in zip(ct, E))
            print(f"enc {i} block {blk_idx}: {pt}")
end_of_edit

