import random

def get_seq(seed, n):
    random.seed(seed)
    return [random.getrandbits(32) for _ in range(n)]

# Each encryption uses 2 values: ks0 (block0), ks1 (block1)
# We want ks1_i == ks0_j for some i,j so we can decrypt block1 of enc i
# using known E(ks0_j) from block0 of enc j.
# Search seeds.

found = None
for seed in range(0, 200000):
    seq = get_seq(seed, 200)  # 100 encryptions * 2
    ks0 = seq[0::2]  # block0 keystreams
    ks1 = seq[1::2]  # block1 keystreams
    ks0_set = set(ks0)
    for i, v in enumerate(ks1):
        if v in ks0_set:
            found = (seed, i, v)
            break
    if found:
        break

print("Found:", found)
end_of_edit

