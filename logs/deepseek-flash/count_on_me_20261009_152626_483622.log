from pwn import *
context.log_level = 'error'

r = remote("crypto.chal.csaw.io", 1337)
r.recvuntil(b"Send me a random seed\n")
r.send(b"0000000000000000")  # seed 0, exactly 16 bytes
r.recvuntil(b"Encrypted flag:\n")
# Read all data until "Okay bye\n"
data = r.recvuntil(b"Okay bye\n")
r.close()
# data = 100 lines of ciphertext each followed by \n, then "Okay bye\n"
# Remove trailing "Okay bye\n"
data = data[:-len(b"Okay bye\n")]
lines = data.split(b"\n")
print("num lines:", len(lines))
for i in range(3):
    print(i, "len:", len(lines[i]))
end_of_edit

