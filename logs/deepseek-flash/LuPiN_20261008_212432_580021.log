import socket
from concurrent.futures import ThreadPoolExecutor

def check(ip, port):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(0.3)
    try:
        s.connect((ip, port))
        s.close()
        return (ip, port)
    except:
        s.close()
        return None

# Scan gateways and a few hosts for all ports
hosts = ["172.17.0.1", "172.19.0.1", "172.17.0.2", "172.19.0.2"]
targets = [(h, p) for h in hosts for p in range(1, 65536)]

results = []
with ThreadPoolExecutor(max_workers=1000) as ex:
    for r in ex.map(lambda t: check(*t), targets):
        if r:
            results.append(r)
print("OPEN:", results)
end_of_edit

