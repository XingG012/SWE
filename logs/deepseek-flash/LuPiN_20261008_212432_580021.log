import socket, struct

def query_dns(server, name):
    # Build a simple DNS query
    tid = 0x1234
    flags = 0x0100  # standard query, recursion desired
    header = struct.pack(">HHHHHH", tid, flags, 1, 0, 0, 0)
    q = b""
    for part in name.split("."):
        q += bytes([len(part)]) + part.encode()
    q += b"\x00"
    q += struct.pack(">HH", 1, 1)  # A record, IN class
    packet = header + q
    s = socket.socket(socket.AF_INET, socket.SOCK_DGRAM)
    s.settimeout(3)
    s.sendto(packet, (server, 53))
    try:
        data, _ = s.recvfrom(512)
        # Parse answer
        ancount = struct.unpack(">H", data[6:8])[0]
        print(f"{name} via {server}: ancount={ancount}, raw={data.hex()}")
    except Exception as e:
        print(f"{name} via {server}: ERR {e}")
    s.close()

for server in ["127.0.0.11", "172.17.0.1", "172.19.0.1"]:
    query_dns(server, "crypto.chal.csaw.io")
end_of_edit

