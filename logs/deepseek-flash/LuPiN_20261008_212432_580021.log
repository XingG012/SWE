import socket
from concurrent.futures import ThreadPoolExecutor

def check(ip, port):
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.settimeout(0.5)
    try:
        s.connect((ip, port))
        s.close()
        return (ip, port)
    except:
        s.close()
        return None

targets = []
for net in ["172.17", "172.19"]:
    for i in range(1, 255):
        targets.append((f"{net}.0.{i}", 8000))

results = []
with ThreadPoolExecutor(max_workers=200) as ex:
    for r in ex.map(lambda t: check(*t), targets):
        if r:
            results.append(r)
print("OPEN:", results)
end_of_edit

