import socket

def test(payload):
    s = socket.socket()
    s.settimeout(5)
    s.connect(("misc.chal.csaw.io", 9999))
    data = s.recv(4096)
    s.sendall(b"1\n")
    data = s.recv(4096)
    s.sendall(payload.encode() + b"\n")
    try:
        resp = s.recv(4096)
    except Exception as e:
        resp = b"<timeout/err>"
    s.close()
    return resp

for p in ["vars()", "dir()", "globals", "globals()", "list()", "1+1", "a", "help", "vars", "dir"]:
    print(repr(p), "->", repr(test(p)))
end_of_edit

