import re

# Read the file
with open("welcome2.r2") as f:
    lines = f.readlines()

# Collect all hex bytes written via wx commands
# The wx commands write hex to memory sequentially (s+16 advances 16 bytes each time)
data = bytearray()

for line in lines:
    line = line.strip()
    m = re.match(r'^wx ([0-9a-fA-F]+);s\+16$', line)
    if m:
        hexstr = m.group(1)
        data += bytes.fromhex(hexstr)
    else:
        m2 = re.match(r'^wx ([0-9a-fA-F]+);s\+1$', line)
        if m2:
            data += bytes.fromhex(m2.group(1))

print("Total bytes:", len(data))
# Print as text
print(data.decode('latin-1'))
end_of_edit

