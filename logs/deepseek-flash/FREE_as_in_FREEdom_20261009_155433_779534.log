import re

# Initial hash from comments (0x2030)
hash_hex = """
3034 7b5e 5576 68ac a342 9edf 4561 7575
3072 427a 5b7c 7723 6d22 3654 7b79 2476
492f 2a5f 686f 6d11 867a 7367 7676 4d32
3657 7f39 4734 6447 5744 3520 31d9 8dc2
fd5f 3d3d 6e7c 7465 3e6c 3863 553f 5d3e
75a0 19bd 655d 7361 eda5 bc6f 644a 7040
7170 2a4f 3038 6877 7e52 316b 5126 2240
312f 4436 45c5 968e 584a 7235 8c08 e968
6426 4c5f 5d5a 7844 4f39 5f33 c075 436d
94dc 3048 6a69 647b 5a40 363f 2951 782a
633b 706c 674a 6634 fc2f 5a5d 2c3b 5325
3c61 6c44 6458 7250 2b55 646f 4b32 7519
0be2 742c 283f 2f6c 6b61 5c2c 3349 622d
5267 2c7b 4945 4170 7561 cf64 7fc5 585c
2a79 6776 7750 6c31 6c41 7466 7b48 7233
336c 5050 6b79 413e 3a7a 7b73 2d67 3277
"""
initial = bytes.fromhex(hash_hex.replace("\n","").replace(" ",""))
print("Initial hash len:", len(initial))

# Parse the r2 file for pc* commands
with open("welcome2.r2") as f:
    content = f.read()

# Find all pc* commands
flag = bytearray(48)
for m in re.finditer(r'pc\* 1@loc\.flag\+(\d+)>/tmp/\w+;s loc\.hash\+(\d+);\. /tmp/\w+(;w1([+-]\d+))?', content):
    n = int(m.group(1))
    off = int(m.group(2))
    val = initial[off]
    if m.group(3):
        delta = int(m.group(4))
        val = (val - delta) & 0xFF
    flag[n] = val

print("Flag:", flag)
print("Flag str:", flag.decode('latin-1'))
end_of_edit

