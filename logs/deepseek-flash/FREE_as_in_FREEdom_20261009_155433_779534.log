import re

with open("welcome2.r2") as f:
    lines = f.readlines()

data = bytearray()
for line in lines:
    line = line.strip()
    m = re.match(r'^wx ([0-9a-fA-F]+);s\+16$', line)
    if m:
        data += bytes.fromhex(m.group(1))
    else:
        m2 = re.match(r'^wx ([0-9a-fA-F]+);s\+1$', line)
        if m2:
            data += bytes.fromhex(m2.group(1))

# The command buffer starts at hit0=0. Split by null bytes
cmds = data.split(b'\x00')
for i, c in enumerate(cmds):
    print(i, repr(c))
end_of_edit

