import wave, numpy as np, matplotlib
matplotlib.use('Agg')
import matplotlib.pyplot as plt
import glob, os

for f in sorted(glob.glob('wavs/*.wav')):
    try:
        w = wave.open(f,'rb')
        n = w.getnframes()
        ch = w.getnchannels()
        sw = w.getsampwidth()
        fr = w.getframerate()
        data = w.readframes(n)
        w.close()
        if sw == 2:
            a = np.frombuffer(data, dtype=np.int16)
        elif sw == 1:
            a = np.frombuffer(data, dtype=np.uint8).astype(np.int16)-128
        else:
            continue
        if ch == 2:
            a = a.reshape(-1,2).mean(axis=1)
        if len(a) < 1000:
            continue
        plt.figure(figsize=(20,6))
        plt.specgram(a, NFFT=1024, Fs=fr, noverlap=512)
        plt.title(os.path.basename(f))
        out = 'spec_'+os.path.basename(f)+'.png'
        plt.savefig(out, dpi=80)
        plt.close()
        print('done', f, len(a), fr)
    except Exception as e:
        print('err', f, e)
