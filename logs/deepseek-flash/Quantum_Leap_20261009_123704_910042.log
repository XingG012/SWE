output = 'wxqvn$Zae${deyZv$d"i'

# Try CNOT on adjacent bits within each byte
# CNOT: target ^= control. Try both directions and various bit positions.

def cnot_bits(bits, c, t):
    b = list(bits)
    b[t] ^= b[c]
    return b

# Convert output to bits
out_bits = []
for ch in output:
    for i in range(8):
        out_bits.append((ord(ch) >> i) & 1)

# Try all pairs (c,t) of bit positions within a byte, applied per byte
for c in range(8):
    for t in range(8):
        if c == t:
            continue
        res = []
        for ch in output:
            bits = [(ord(ch) >> i) & 1 for i in range(8)]
            bits[t] ^= bits[c]
            v = 0
            for i in range(8):
                v |= bits[i] << i
            res.append(chr(v))
        s = ''.join(res)
        if 'flag' in s or 'ctf' in s.lower():
            print(c, t, s)
end_of_edit

