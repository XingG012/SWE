output = 'wxqvn$Zae${deyZv$d"i'

def bits_to_str(bits):
    res = []
    for j in range(0, len(bits), 8):
        v = 0
        for i in range(8):
            v |= bits[j+i] << i
        res.append(chr(v))
    return ''.join(res)

def str_to_bits(s):
    b = []
    for ch in s:
        for i in range(8):
