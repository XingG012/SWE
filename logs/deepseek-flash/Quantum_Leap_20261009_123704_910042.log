output = 'wxqvn$Zae${deyZv$d"i'

def to_bits(s):
    b = []
    for ch in s:
        for i in range(8):
            b.append((ord(ch) >> i) & 1)
    return b

def to_str(b):
    res = []
    for j in range(0, len(b), 8):
        v = 0
        for i in range(8):
            v |= b[j+i] << i
        res.append(chr(v))
    return ''.join(res)

ob = to_bits(output)
n = len(ob)

# Try CNOT with control i, target i+1 (forward and backward)
for direction in ['fwd', 'bwd']:
    b = list(ob)
    if direction == 'fwd':
        for i in range(n-1):
            b[i+1] ^= b[i]
    else:
        for i in range(n-1, 0, -1):
            b[i-1] ^= b[i]
    print(direction, repr(to_str(b)))

# Try CNOT with control i, target i+1 but only within each byte
for direction in ['fwd', 'bwd']:
    b = list(ob)
    for byte in range(len(output)):
        base = byte*8
        if direction == 'fwd':
            for i in range(7):
                b[base+i+1] ^= b[base+i]
        else:
            for i in range(7, 0, -1):
                b[base+i-1] ^= b[base+i]
    print('byte', direction, repr(to_str(b)))
end_of_edit

