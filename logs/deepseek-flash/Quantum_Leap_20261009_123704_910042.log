# Convert output to a bitstream (LSB first per byte)
out_bits = []
for ch in output:
    for i in range(8):
        out_bits.append((ord(ch) >> i) & 1)

def bits_to_str(bits):
    res = []
    for j in range(0, len(bits), 8):
        v = 0
        for i in range(8):
            v |= bits[j+i] << i
        res.append(chr(v))
    return ''.join(res)

# Try CNOT across whole bitstream: control at position c, target at position t
n = len(out_bits)
for c in range(n):
    for t in range(n):
        if c == t:
            continue
        b = list(out_bits)
        b[t] ^= b[c]
        s = bits_to_str(b)
        if 'flag' in s or 'ctf' in s.lower():
            print(c, t, s)
