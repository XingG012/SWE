def to_bits(s, msb=False):
    b = []
    for ch in s:
        for i in range(8):
            idx = (7-i) if msb else i
            b.append((ord(ch) >> idx) & 1)
    return b

def to_str(b, msb=False):
    res = []
    for j in range(0, len(b), 8):
        v = 0
        for i in range(8):
            idx = (7-i) if msb else i
            v |= b[j+i] << idx
        res.append(chr(v))
    return ''.join(res)

for msb in [False, True]:
    ob = to_bits(output, msb)
    n = len(ob)
    # CNOT within pairs of bits
    b = list(ob)
    for i in range(0, n-1, 2):
        b[i+1] ^= b[i]
    print('pair fwd msb=%s' % msb, repr(to_str(b, msb)))
    b = list(ob)
    for i in range(0, n-1, 2):
        b[i] ^= b[i+1]
    print('pair bwd msb=%s' % msb, repr(to_str(b, msb)))
    # CNOT sequential
    b = list(ob)
    for i in range(n-1):
        b[i+1] ^= b[i]
    print('seq fwd msb=%s' % msb, repr(to_str(b, msb)))
    b = list(ob)
    for i in range(n-1, 0, -1):
        b[i-1] ^= b[i]
    print('seq bwd msb=%s' % msb, repr(to_str(b, msb)))
