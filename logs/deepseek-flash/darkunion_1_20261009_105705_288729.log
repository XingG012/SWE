      obj->refs = (refcount_t)REFCOUNT_INIT(1);
      obj->name = NULL;
      obj->magic = LDW_MAGIC;
      obj->name_len = 0;
    } else
      return ERR_PTR(-ENOMEM);
  }

  return obj;
}

static inline void __put_rule(struct ldw_rule *obj) {
  if (unlikely(obj->magic != LDW_MAGIC)) {
    printk("Not a ldw_rule!\n");
    BUG();
