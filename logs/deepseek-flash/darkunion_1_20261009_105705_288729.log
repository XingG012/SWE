594:static void *ldw_start(struct seq_file *m, loff_t *ppos)
595:{
596:  struct ldw_itr *itr;
597:  int err;
598:
599:  printk("[*] ldw_start(%lld)\n", *ppos);
600:
601:  // Lock for read.
602:  read_lock(&ldw_rules_lock);
603:
604:  // Update iterator position.
605:  itr = m->private;
606:  err = update_itr(itr, *ppos - 1);
607:  if (unlikely(err < 0))
608:    return ERR_PTR(err);
609:  else if (unlikely(!err))
610:    return NULL;
611:  else
612:    return itr;
613:}
