import re

# Step 1: Read welcome2.r2
with open('welcome2.r2', 'r') as f:
    lines = f.readlines()

# Step 2 & 3: Extract and decode hex strings from wx commands
hex_pattern = re.compile(r'wx ([0-9a-f]+);')
decoded_strings = []
for line in lines:
    match = hex_pattern.search(line)
    if match:
        hex_str = match.group(1)
        # Pad to even length if necessary
        if len(hex_str) % 2 != 0:
            hex_str = '0' + hex_str
        try:
            decoded = bytes.fromhex(hex_str).decode('ascii', errors='ignore')
            decoded_strings.append(decoded)
        except:
            pass

# Step 4: Find /tmp/... patterns
tmp_pattern = re.compile(r'/tmp/([A-Z0-9]{10})')
key_parts = []
for s in decoded_strings:
    matches = tmp_pattern.findall(s)
    key_parts.extend(matches)

# Concatenate all key parts
xor_key = ''.join(key_parts)
print(f"XOR key length: {len(xor_key)}")
print(f"XOR key preview: {xor_key[:50]}...")

# Step 6: Get encrypted flag data from comments
encrypted_hex_lines = [
    "3034 7b5e 5576 68ac a342 9edf 4561 7575",
    "3072 427a 5b7c 7723 6d22 3654 7b79 2476",
    "492f 2a5f 686f 6d11 867a 7367 7676 4d32",
    "3657 7f39 4734 6447 5744 3520 31d9 8dc2",
    "fd5f 3d3d 6e7c 7465 3e6c 3863 553f 5d3e",
    "75a0 19bd 655d 7361 eda5 bc6f 644a 7040",
    "7170 2a4f 3038 6877 7e52 316b 5126 2240",
    "312f 4436 45c5 968e 584a 7235 8c08 e968",
    "6426 4c5f 5d5a 7844 4f39 5f33 c075 436d",
    "94dc 3048 6a69 647b 5a40 363f 2951 782a",
    "633b 706c 674a 6634 fc2f 5a5d 2c3b 5325",
    "3c61 6c44 6458 7250 2b55 646f 4b32 7519",
    "0be2 742c 283f 2f6c 6b61 5c2c 3349 622d",
    "5267 2c7b 4945 4170 7561 cf64 7fc5 585c",
    "2a79 6776 7750 6c31 6c41 7466 7b48 7233",
    "336c 5050 6b79 413e 3a7a 7b73 2d67 3277"
]

encrypted_hex = ''.join(line.replace(' ', '') for line in encrypted_hex_lines)
encrypted_data = bytes.fromhex(encrypted_hex)

# Step 7: XOR decrypt
decrypted = bytearray()
for i in range(len(encrypted_data)):
    key_byte = ord(xor_key[i % len(xor_key)])
    decrypted.append(encrypted_data[i] ^ key_byte)

# Step 8: Print result
try:
    flag = decrypted.decode('ascii')
    print("Flag:", flag)
except:
    print("Decrypted data (hex):", decrypted.hex())
    print("Decrypted data (raw):", decrypted)
end_of_edit

