import re

with open('welcome2.r2', 'r') as f:
    content = f.read()

# Find all wx commands
wx_pattern = re.compile(r'wx ([0-9a-f]+);')
matches = wx_pattern.findall(content)

key_parts = []
tmp_pattern = re.compile(r'/tmp/([A-Z0-9]{10})')

for hex_str in matches:
    # Pad to even length
    if len(hex_str) % 2 != 0:
        hex_str = '0' + hex_str
    try:
        decoded = bytes.fromhex(hex_str).decode('ascii', errors='ignore')
        tmp_matches = tmp_pattern.findall(decoded)
        key_parts.extend(tmp_matches)
    except:
        pass

print("Key parts in order:")
for i, part in enumerate(key_parts):
    print(f"{i}: {part}")

print(f"\nTotal key parts: {len(key_parts)}")
print(f"Concatenated key: {''.join(key_parts)}")
end_of_edit

