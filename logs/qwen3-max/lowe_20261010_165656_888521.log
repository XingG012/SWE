import base64

# Read Y from key.enc
with open('key.enc', 'r') as f:
    Y_str = f.read().strip()
Y = int(Y_str)

# Convert Y to 192-byte big-endian
Y_bytes = Y.to_bytes(192, 'big')

# Take first 64 bytes
Y_prefix = Y_bytes[:64]

# Read and decode C from file.enc
with open('file.enc', 'r') as f:
    C_b64 = f.read().strip()
C = base64.b64decode(C_b64)

# Ensure C is 64 bytes
assert len(C) == 64, f"C is {len(C)} bytes, expected 64"

# Compute S = Y_prefix xor C
S = bytes(a ^ b for a, b in zip(Y_prefix, C))

print(S.decode('utf-8'))
end_of_edit

