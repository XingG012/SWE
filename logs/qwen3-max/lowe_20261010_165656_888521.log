import base64
from Crypto.PublicKey import RSA

# Load public key to get N
with open('pubkey.pem', 'r') as f:
    pub_key = RSA.import_key(f.read())
N = pub_key.n
e = pub_key.e

# Read Y from key.enc
with open('key.enc', 'r') as f:
    Y_str = f.read().strip()
Y = int(Y_str)

# Verify that Y + N is a perfect cube
Z = Y + N

# Compute integer cube root of Z
def icbrt(n):
    # Binary search for cube root
    low = 0
    high = 1
    while high**3 <= n:
        high *= 2
    while low < high:
        mid = (low + high) // 2
        if mid**3 < n:
            low = mid + 1
        else:
            high = mid
    return low - 1

K = icbrt(Z)
if K**3 == Z:
    print("Verified: Y + N is a perfect cube.")
else:
    print("Not a perfect cube!")

# Now, try to recover S
# Convert Y to 192-byte big-endian
Y_bytes = Y.to_bytes(192, 'big')

# Try both first and last 64 bytes
for name, prefix in [("first", Y_bytes[:64]), ("last", Y_bytes[-64:])]:
    with open('file.enc', 'r') as f:
        C_b64 = f.read().strip()
    C = base64.b64decode(C_b64)
    S = bytes(a ^ b for a, b in zip(prefix, C))
    try:
        s_str = S.decode('utf-8')
        print(f"{name} 64 bytes: {s_str}")
    except UnicodeDecodeError:
        print(f"{name} 64 bytes (hex): {S.hex()}")
end_of_edit

