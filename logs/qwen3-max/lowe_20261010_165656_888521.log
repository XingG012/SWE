K_bytes = int(K).to_bytes(64, 'big')
try:
    s_str = K_bytes.decode('utf-8')
    print(f"K as string: {s_str}")
except UnicodeDecodeError:
    print(f"K as hex: {K_bytes.hex()}")

# Option 2: S = Y_prefix xor C for first and last
Y_bytes = Y.to_bytes(192, 'big')
for name, prefix in [("first", Y_bytes[:64]), ("last", Y_bytes[-64:])]:
    with open('file.enc', 'r') as f:
        C_b64 = f.read().strip()
    C = base64.b64decode(C_b64)
    S = bytes(a ^ b for a, b in zip(prefix, C))
    try:
        s_str = S.decode('utf-8')
        print(f"{name} 64 bytes: {s_str}")
    except UnicodeDecodeError:
        print(f"{name} 64 bytes (hex): {S.hex()}")
