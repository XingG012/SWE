import base64
from Crypto.Cipher import AES
from Crypto.Protocol.KDF import PBKDF2
from Crypto.Hash import MD5

# Encrypted flag from server
encrypted_flag_b64 = "U2FsdGVkX19P8k2Kpfg1J6BylRYREygfRxgLevygpsOKOUFEw88PCEmWQfo7jEvkh"
encrypted_data = base64.b64decode(encrypted_flag_b64)

# Check if it's OpenSSL format (starts with "Salted__")
if encrypted_data[:8] == b"Salted__":
    salt = encrypted_data[8:16]
    data = encrypted_data[16:]
    
    # Derive key and IV using OpenSSL's EVP_BytesToKey equivalent
    def evp_bytes_to_key(password, salt, key_len, iv_len):
        d = d_i = b''
        while len(d) < key_len + iv_len:
            d_i = MD5.new(d_i + password + salt).digest()
            d += d_i
        return d[:key_len], d[key_len:key_len+iv_len]
    
    # Our secret is the password
    password = base64.b64decode("c1BzcUIvdGNIL2dIdnAwd2dHQ2pIVUlpUUlvdkZxeEwvY3BqN2JNUkpxYz0=")
    key, iv = evp_bytes_to_key(password, salt, 32, 16)
    
    # Decrypt
    cipher = AES.new(key, AES.MODE_CBC, iv)
    decrypted = cipher.decrypt(data)
    
    # Remove PKCS#7 padding
    pad_len = decrypted[-1]
    if isinstance(pad_len, str):
        pad_len = ord(pad_len)
    decrypted = decrypted[:-pad_len]
    
    print("Decrypted flag:", decrypted.decode('utf-8'))
else:
    print("Not OpenSSL format, trying direct decryption...")
    # Try direct decryption with the key
    key = base64.b64decode("c1BzcUIvdGNIL2dIdnAwd2dHQ2pIVUlpUUlvdkZxeEwvY3BqN2JNUkpxYz0=")
    # Assume IV is all zeros or try other methods
    iv = b'\x00' * 16
    cipher = AES.new(key, AES.MODE_CBC, iv)
    decrypted = cipher.decrypt(encrypted_data)
    print("Decrypted (direct):", decrypted)
