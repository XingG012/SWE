# Parameters from the challenge
p = 6277101735386680763835789423207666416083908700390324961279
b = 2455155546008943817740293915197451784769108058161191238065

E = EllipticCurve(GF(p), [-3, b])
G = E([602046282375688656758213480587526111916698976636884684818, 174050332293622031404857552280219410364023488927386650641])

# Public key from server
pub_key = E([1376291677096536793341384931940921090784596019563852228955, 4095951091640912963153684808069716715715036990473354954285])

# Encrypted secret components
rG = E([4946643385795727964373856327583632704642180575237878367191, 1777562568780204141274504279954427086314571849716239247803])
c1 = 140054354502387730774202617402858777581449389416402577238
c2 = 3329461409383330961799451418869339070338908568134891210161

# Try to find the private key kpri such that pub_key = kpri * G
# Since the curve order is prime, we can't use Pohlig-Hellman directly
# But maybe the private key is small?

print("Trying to solve ECDLP...")
try:
    kpri = discrete_log(pub_key, G, operation='+')
    print("Private key found:", kpri)
    
    # Compute r*G = kpri * rG
    r_point = kpri * rG
    x = r_point[0]
    y = r_point[1]
    
    # Recover the message parts
    m1 = c1 / x
    m2 = c2 / y
    
    # Convert to bytes
    m1_bytes = int(m1).to_bytes((int(m1).bit_length() + 7) // 8, 'big')
    m2_bytes = int(m2).to_bytes((int(m2).bit_length() + 7) // 8, 'big')
    
    secret = m1_bytes + m2_bytes
    print("Recovered secret (hex):", secret.hex())
    print("Recovered secret (base64):", secret.decode('latin1').encode('base64').strip())
    
except Exception as e:
    print("Error:", e)
    print("Discrete log might be too hard. Trying alternative approach...")
    
    # Alternative: Maybe the encryption is vulnerable to known plaintext?
    # Or maybe the curve has a special property?
end_of_edit

