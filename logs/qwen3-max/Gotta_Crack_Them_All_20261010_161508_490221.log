with open('encrypted_passwords.txt', 'rb') as f:
    encrypted_passwords = f.read().split(b'\n')

leaked_password = "Cacturne-Grass-Dark"
target_length = len(leaked_password)

for i, enc in enumerate(encrypted_passwords):
    if len(enc) == target_length:
        print(f"Found potential match at index {i}:")
        print(f"Encrypted: {enc.hex()}")
        print(f"Leaked:    {leaked_password}")
        # Recover key
        key = bytes([enc[j] ^ ord(leaked_password[j]) for j in range(target_length)])
        print(f"Recovered key: {key.hex()}")
        break
end_of_edit

