# Since the curve order equals the field characteristic, it's anomalous
# Use the Smart attack for anomalous curves
print("Curve is anomalous (order = field characteristic)")
print("Applying Smart attack...")

try:
    # Lift the points to p-adic numbers
    p = FF
    Qp = Qp(p, 2)
    Eqp = EllipticCurve(Qp, [a, b])
    
    # Lift the points
    G_lift = Eqp(G[0], G[1])
    P_lift = Eqp(P[0], P[1])
    
    # Compute the p-adic elliptic logarithm
    phi_G = G_lift.formal_group().log()(G_lift[0] / G_lift[1])
    phi_P = P_lift.formal_group().log()(P_lift[0] / P_lift[1])
    
    # The discrete log is phi_P / phi_G mod p
