from sage.all import *

# Curve parameters from handout
p = 4079211623412602159436576854880565404392213421245358163957062650219138441233389311290884236330989600198400158483251311640833420916559186996716661065534756331
a = 2648089252143182574153823745896834765345361977855346851913065097972752819834370636007433949219153563353347621929792473352056603689300142308595500196681484715
b = 2640636613554195662803492377273397651071872147133797068159853320493797794760382065905880626537982439844385071174905293170870708493176922431618220384167739340

# Define the curve over F_p
Fp = GF(p)
E = EllipticCurve(Fp, [a, b])

# Points
G = E(2835124931680967399292763715241068733082955010482692941778975060177550045565873252916114065386731072675933657202784918206609499173114199830285672822076666812,
    3917051964324124246182777370059493628017925319159214920394084902768106573682907256149476836382399752202209827189288072241452544996871460642902049422562450204)

P = E(1201673966464508597332511457607538250497935144691770661539122404983678691094166105235067949576773833297917476372671447578123390251450634078667903889944175974,
    2549728089376241701979352238534953850683927781198029880111780652469308144313884103159306596064169377751896432424056208861929610592541122265583809022865481983)

print("Verifying curve is anomalous...")
assert E.order() == p, "Curve is not anomalous!"

print("Curve is anomalous. Applying Smart attack...")

# Create p-adic field with sufficient precision
Qp = Qp(p, 20)

# Lift curve coefficients to p-adics
a_lift = Qp(a)
b_lift = Qp(b)
E_lift = EllipticCurve(Qp, [a_lift, b_lift])

# Lift points to p-adics
G_lift = E_lift(Qp(G[0]), Qp(G[1]))
P_lift = E_lift(Qp(P[0]), Qp(P[1]))

# Compute the p-adic elliptic logarithm using the formula log(P) = x/y for points near infinity
# For points not at infinity, we use the formal group logarithm
# But since we're working with p-adics, we can use the standard approach

# The key insight: for anomalous curves, the discrete log d satisfies:
# log(P) = d * log(G) in the p-adic numbers
# So d = log(P) / log(G) mod p

# Compute the logarithms
log_G = G_lift[0] / G_lift[1]  # This is an approximation of the p-adic logarithm
log_P = P_lift[0] / P_lift[1]

# Compute d
d_approx = log_P / log_G
d = Integer(d_approx.lift()) % p

print("Computed discrete logarithm d:", d)

# Verify
if d * G == P:
    print("Verification successful!")
    print("Flag: flag{" + str(d) + "}")
else:
    print("Verification failed!")
    print("Trying higher precision...")
    
    # Try with higher precision
    Qp_high = Qp(p, 50)
    E_lift_high = EllipticCurve(Qp_high, [Qp_high(a), Qp_high(b)])
    G_lift_high = E_lift_high(Qp_high(G[0]), Qp_high(G[1]))
    P_lift_high = E_lift_high(Qp_high(P[0]), Qp_high(P[1]))
    
    log_G_high = G_lift_high[0] / G_lift_high[1]
    log_P_high = P_lift_high[0] / P_lift_high[1]
    
    d_approx_high = log_P_high / log_G_high
    d_high = Integer(d_approx_high.lift()) % p
    
    print("With higher precision, d =", d_high)
    
    if d_high * G == P:
        print("Verification successful with high precision!")
        print("Flag: flag{" + str(d_high) + "}")
    else:
        print("Still verification failed. Need better approach.")
