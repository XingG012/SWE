    print("Trying alternative approaches...")
    
    # For anomalous curves, there's a simple formula using x-coordinates
    # d = (P_x^p - P_x) / (G_x^p - G_x) mod p
    p = FF
    Fp = GF(p)
    
    Px = Fp(P[0])
    Gx = Fp(G[0])
    
    # Compute P_x^p - P_x and G_x^p - G_x
    # By Fermat's little theorem, x^p = x mod p, so this would be 0
    # But in the context of the curve, we need to be careful
    
    # Actually, for points on the curve over F_p, x^p = x, so this approach won't work
    
    # Let's try a different idea: check if the order has small factors
    print("Checking if curve order has small factors...")
    order = E.order()
    
    # Try to factor the order partially
    try:
        # Check for small prime factors up to 10^6
        small_factors = []
        temp_order = order
        for prime in primes(2, 1000000):
            if temp_order % prime == 0:
                small_factors.append(prime)
                while temp_order % prime == 0:
                    temp_order //= prime
        
        if small_factors:
            print("Found small factors:", small_factors)
            # Use Pohlig-Hellman with the small factors
            print("Attempting Pohlig-Hellman attack...")
            d = P.discrete_log(G)
            print("Discrete logarithm d:", d)
            if d * G == P:
                print("Verification successful!")
                print("Flag: flag{" + str(d) + "}")
            else:
                print("Verification failed!")
        else:
            print("No small factors found")
            
    except Exception as e4:
        print("Factorization attempt failed:", e4)
