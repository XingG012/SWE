import websocket
import json
import time
import sys
import random
import string

def on_message(ws, message):
    print(f"Received: {message}")
    
def on_error(ws, error):
    print(f"Error: {error}")
    
def on_close(ws, close_status_code, close_msg):
    print("Connection closed")
    
def on_open(ws):
    global email, password
    print("Connection opened")
    # Send connect message
    connect_msg = {
        "msg": "connect",
        "version": "1",
        "support": ["1", "pre2", "pre1"]
    }
    ws.send(json.dumps(connect_msg))
    
    # Wait a bit for connection to establish
    time.sleep(1)
    
    # Generate random email and password for registration
    random_suffix = ''.join(random.choices(string.ascii_lowercase + string.digits, k=8))
    email = f"testuser_{random_suffix}@example.com"
    password = "testpassword123"
    
    print(f"Attempting to register user: {email}")
    
    # Try to create a user
    create_user_msg = {
        "msg": "method",
        "id": "create_user",
        "method": "createUser",
        "params": [{
            "email": email,
            "password": password
        }]
    }
    ws.send(json.dumps(create_user_msg))
    time.sleep(2)

def handle_create_user_response(ws, message_data):
    global email, password
    if message_data.get("msg") == "result" and message_data.get("id") == "create_user":
        print("User created successfully")
        # Now login
        login_msg = {
            "msg": "method",
            "id": "login_user",
            "method": "login",
            "params": [{
                "user": {"email": email},
                "password": password
            }]
        }
        ws.send(json.dumps(login_msg))
        time.sleep(2)

def handle_login_response(ws, message_data):
    if message_data.get("msg") == "result" and message_data.get("id") == "login_user":
        print("Login successful")
        # Subscribe to notes.private
        sub_msg = {
            "msg": "sub",
            "id": "sub_notes_private",
            "name": "notes.private",
            "params": []
        }
        ws.send(json.dumps(sub_msg))
        time.sleep(2)
        
        # Add a test note
        note_body = "This is a test note"
        add_note_msg = {
            "msg": "method",
            "id": "add_note",
            "method": "notes.insert",
            "params": [note_body]
        }
        print(f"Adding note: {note_body}")
        ws.send(json.dumps(add_note_msg))
        time.sleep(3)

# Global variables to store credentials
email = ""
password = ""

if __name__ == "__main__":
    websocket.enableTrace(True)
    ws = websocket.WebSocketApp(
        "ws://web.chal.csaw.io:5000/websocket",
        on_open=on_open,
        on_message=on_message,
        on_error=on_error,
        on_close=on_close
    )
    
    ws.run_forever()
end_of_edit

