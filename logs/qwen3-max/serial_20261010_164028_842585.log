6:def validate_parity(bits):
7:    # bits should be 11 bits: [start=0][8 data][parity][stop=1]
8:    if len(bits) < 11:
9:        return False, None
10:    # Strip start (first bit) and stop (last bit)
11:    frame = bits[1:-1]  # 9 bits: 8 data + 1 parity
12:    if len(frame) != 9:
13:        return False, None
14:    data_bits = frame[:8]
15:    parity_bit = frame[8]
16:    num_ones = data_bits.count('1')
17:    # Even parity: total 1s (data + parity) should be even
18:    total_ones = num_ones + (1 if parity_bit == '1' else 0)
19:    is_valid = (total_ones % 2 == 0)
20:    if is_valid:
21:        byte_val = int(data_bits, 2)
22:        return True, byte_val
23:    else:
24:        return False, None
