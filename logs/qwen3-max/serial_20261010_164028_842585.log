26:def main():
27:    conn = remote('misc.chal.csaw.io', 8000)
28:    received_bytes = []
29:    
30:    try:
31:        # Read initial message
32:        conn.recvline()  # "8-1-1 even parity..."
33:        
34:        while True:
35:            line = conn.recvline().strip().decode('ascii')
36:            if not line:
37:                continue
38:                
39:            # Extract binary sequence (only 0s and 1s)
40:            bin_match = re.search(r'[01]+', line)
41:            if not bin_match:
42:                continue
43:            bin_str = bin_match.group()
44:            
45:            # Process 9-bit chunks (8 data + 1 parity)
46:            # Assume each transmission is one 9-bit sequence
47:            if len(bin_str) >= 9:
48:                is_valid, byte_val = validate_parity(bin_str[:9])
49:                if is_valid:
50:                    received_bytes.append(byte_val)
51:                    conn.sendline(b'1')
52:                    # Check if we have a flag
53:                    try:
54:                        current_data = bytes(received_bytes).decode('ascii')
55:                        if 'flag{' in current_data:
56:                            print(f"Flag found: {current_data}")
57:                            break
58:                    except:
59:                        pass
60:                else:
61:                    conn.sendline(b'0')
62:            else:
63:                # Not enough bits, request retransmit
