def validate_parity(bits):
    # bits should be 11 bits: [start=0][8 data][parity][stop=1]
    if len(bits) < 11:
        return False, None
    # Strip start (first bit) and stop (last bit)
    frame = bits[1:-1]  # 9 bits: 8 data + 1 parity
    if len(frame) != 9:
        return False, None
    data_bits = frame[:8]
    parity_bit = frame[8]
    num_ones = data_bits.count('1')
    # Even parity: total 1s (data + parity) should be even
    total_ones = num_ones + (1 if parity_bit == '1' else 0)
    is_valid = (total_ones % 2 == 0)
    if is_valid:
        byte_val = int(data_bits, 2)
        return True, byte_val
    else:
        return False, None
