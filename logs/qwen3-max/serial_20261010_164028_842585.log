#!/usr/bin/env python3

from pwn import *
import re

def validate_parity(bits):
    # bits should be 9 bits: 8 data + 1 parity
    if len(bits) < 9:
        return False, None
    data_bits = bits[:8]
    parity_bit = bits[8]
    num_ones = data_bits.count('1')
    # Even parity: total 1s (data + parity) should be even
    total_ones = num_ones + (1 if parity_bit == '1' else 0)
    is_valid = (total_ones % 2 == 0)
    if is_valid:
        byte_val = int(data_bits, 2)
        return True, byte_val
    else:
        return False, None

def main():
    conn = remote('misc.chal.csaw.io', 8000)
    received_bytes = []
    
    try:
        # Read initial message
        conn.recvline()  # "8-1-1 even parity..."
        
        while True:
            line = conn.recvline().strip().decode('ascii')
            if not line:
                continue
                
            # Extract binary sequence (only 0s and 1s)
            bin_match = re.search(r'[01]+', line)
            if not bin_match:
                continue
            bin_str = bin_match.group()
            
            # Process 9-bit chunks (8 data + 1 parity)
            # Assume each transmission is one 9-bit sequence
            if len(bin_str) >= 9:
                is_valid, byte_val = validate_parity(bin_str[:9])
                if is_valid:
                    received_bytes.append(byte_val)
                    conn.sendline(b'1')
                    # Check if we have a flag
                    try:
                        current_data = bytes(received_bytes).decode('ascii')
                        if 'flag{' in current_data:
                            print(f"Flag found: {current_data}")
                            break
                    except:
                        pass
                else:
                    conn.sendline(b'0')
            else:
                # Not enough bits, request retransmit
                conn.sendline(b'0')
                
    except EOFError:
        print("Connection closed.")
        print("Received bytes:", received_bytes)
        try:
            print("Decoded:", bytes(received_bytes).decode('ascii'))
        except:
            print("Could not decode as ASCII")
    finally:
        conn.close()

if __name__ == '__main__':
    main()
end_of_edit

