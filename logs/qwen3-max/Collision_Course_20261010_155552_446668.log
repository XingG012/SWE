import hashlib
from Crypto.Cipher import AES

# Read the encryption password
with open('encryption_password.txt', 'r') as f:
    encryption_password = f.read().strip()

# Read the encrypted password
with open('password.bin', 'rb') as f:
    encrypted_password = f.read()

# Derive the key using SHA-256
key = hashlib.sha256(encryption_password.encode()).digest()

# Set up AES decryption with the same parameters as in my_aes.py
iv = b'\x00' * 16  # 16 null bytes as IV
cipher = AES.new(key, AES.MODE_CBC, iv)

# Decrypt the password
decrypted = cipher.decrypt(encrypted_password)

# Remove PKCS7 padding
pad_length = decrypted[-1]
if pad_length <= 16:
    decrypted = decrypted[:-pad_length]

print("Decrypted password:", decrypted.decode('utf-8', errors='ignore'))
end_of_edit

