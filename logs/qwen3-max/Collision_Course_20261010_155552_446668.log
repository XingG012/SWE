from Crypto.Cipher import AES
from Crypto.Protocol.KDF import scrypt

# Read the encryption password
with open('encryption_password.txt', 'r') as f:
    encryption_password = f.read().strip()

# Read the encrypted password file
with open('password.bin', 'rb') as f:
    data = f.read()

# Parse the file format: nonce (16) + tag (16) + ciphertext
nonce = data[:16]
tag = data[16:32]
ciphertext = data[32:]

# Derive the key using scrypt as in my_aes.py
key = scrypt(
    encryption_password.encode(),
    b'',  # empty salt
    16,   # key length
    N=2**14,
    r=8,
    p=1
)

# Decrypt using AES-EAX mode
cipher = AES.new(key, AES.MODE_EAX, nonce)
decrypted = cipher.decrypt_and_verify(ciphertext, tag)

print("Decrypted password:", decrypted.decode('utf-8'))
end_of_edit

