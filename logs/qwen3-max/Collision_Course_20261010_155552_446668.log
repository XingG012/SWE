import hashlib
import itertools
import string
import csv

# Read hashed IDs from encrypted_database.csv
target_hashes = set()
with open('encrypted_database.csv', 'r') as f:
    reader = csv.DictReader(f)
    for row in reader:
        target_hashes.add(row['id'])

print(f"Loaded {len(target_hashes)} target hashes")

# Character set for salt
charset = string.ascii_lowercase + string.digits

# Try all possible 3-character salts
count = 0
for salt_chars in itertools.product(charset, repeat=3):
    salt = ''.join(salt_chars)
    count += 1
    
    if count % 1000 == 0:
        print(f"Tried {count} salts...")
    
    # Generate all hashes for this salt
    generated_hashes = set()
    valid = True
    
    for i in range(1, 501):
        salted_id = str(i) + salt
        hashed_id = hashlib.md5(salted_id.encode()).hexdigest()[:4]
        
        # If this hash is not in our target set, this salt is invalid
        if hashed_id not in target_hashes:
            valid = False
            break
            
        generated_hashes.add(hashed_id)
    
    # If we generated exactly the right number of unique hashes, we found it
    if valid and len(generated_hashes) == 500:
        print(f"Found correct salt: {salt}")
        
        # Save the salt
        with open('found_salt.txt', 'w') as f:
            f.write(salt)
            
        # The encryption password is just all IDs concatenated
        encryption_password = ''.join(str(i) for i in range(1, 501))
        with open('encryption_password.txt', 'w') as f:
            f.write(encryption_password)
            
        print("Salt and encryption password saved!")
        break
end_of_edit

