edit 1:1
import hashlib
import itertools
import string
import csv

# Read hashed IDs from encrypted_database.csv
hashed_ids = set()
with open('encrypted_database.csv', 'r') as f:
    reader = csv.DictReader(f)
    for row in reader:
        hashed_ids.add(row['id'])

# Character set for salt
charset = string.ascii_lowercase + string.digits

# Try all possible 3-character salts
for salt_chars in itertools.product(charset, repeat=3):
    salt = ''.join(salt_chars)
    
    # Generate hashes for IDs 1-500 with this salt
    generated_hashes = set()
    collision = False
    
    for i in range(1, 501):
        salted_id = str(i) + salt
        hashed_id = hashlib.md5(salted_id.encode()).hexdigest()[:4]
        
        # Check for collisions
        if hashed_id in generated_hashes:
            collision = True
            break
            
        generated_hashes.add(hashed_id)
    
    # If no collisions and matches our target set, we found the salt
    if not collision and generated_hashes == hashed_ids:
        print(f"Found salt: {salt}")
        break
end_of_edit

