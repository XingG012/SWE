import hashlib
import csv

# Read hashed IDs from encrypted_database.csv
target_hashes = set()
with open('encrypted_database.csv', 'r') as f:
    reader = csv.DictReader(f)
    for row in reader:
        target_hashes.add(row['id'])

salt = "v0o"
generated_hashes = set()

for i in range(1, 501):
    salted_id = str(i) + salt
    hashed_id = hashlib.md5(salted_id.encode()).hexdigest()[:4]
    generated_hashes.add(hashed_id)

print(f"Target hashes: {len(target_hashes)}")
print(f"Generated hashes: {len(generated_hashes)}")
print(f"Sets match: {target_hashes == generated_hashes}")

# Check for any missing hashes
missing_from_target = generated_hashes - target_hashes
missing_from_generated = target_hashes - generated_hashes

if missing_from_target:
    print(f"Hashes in generated but not in target: {len(missing_from_target)}")
if missing_from_generated:
    print(f"Hashes in target but not in generated: {len(missing_from_generated)}")
end_of_edit

