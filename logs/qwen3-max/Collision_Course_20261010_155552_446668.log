import hashlib
import itertools
import string
import csv

# Read hashed IDs from encrypted_database.csv
hashed_to_original = {}
with open('encrypted_database.csv', 'r') as f:
    reader = csv.DictReader(f)
    for row in reader:
        # We don't know the original ID yet, but we'll store the hash
        hashed_to_original[row['id']] = None

# Get a few sample hashes to work with
sample_hashes = list(hashed_to_original.keys())[:5]

# Character set for salt
charset = string.ascii_lowercase + string.digits

# Find candidate salts using the first sample hash
candidate_salts = set()
first_hash = sample_hashes[0]

# Try all possible original IDs (1-500) for the first hash
for orig_id in range(1, 501):
    for salt_chars in itertools.product(charset, repeat=3):
        salt = ''.join(salt_chars)
        salted_id = str(orig_id) + salt
        hashed_id = hashlib.md5(salted_id.encode()).hexdigest()[:4]
        
        if hashed_id == first_hash:
            candidate_salts.add(salt)

print(f"Found {len(candidate_salts)} candidate salts from first hash")

# Now verify each candidate salt against all hashes
for salt in candidate_salts:
    # Build mapping of hash -> original ID
    hash_to_id = {}
    valid_salt = True
    
    for i in range(1, 501):
        salted_id = str(i) + salt
        hashed_id = hashlib.md5(salted_id.encode()).hexdigest()[:4]
        
        # Check for collisions
        if hashed_id in hash_to_id:
            valid_salt = False
            break
            
        hash_to_id[hashed_id] = i
    
    # Check if all our target hashes are present
    if valid_salt and set(hash_to_id.keys()) == set(hashed_to_original.keys()):
        print(f"Found correct salt: {salt}")
        
        # Reconstruct the encryption password
        encryption_password = ''.join(str(i) for i in range(1, 501))
        print(f"Encryption password: {encryption_password[:50]}...")
        
        # Save the salt and password for decryption
        with open('found_salt.txt', 'w') as f:
            f.write(salt)
        with open('encryption_password.txt', 'w') as f:
            f.write(encryption_password)
            
        break
end_of_edit

