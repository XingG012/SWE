import socket

host = 'android-dropper.csaw.io'
port = 3000

# Create the input string: 30 "1"s separated by spaces
input_str = ' '.join(['1'] * 30) + '\n'

# Connect to the server
with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
    s.connect((host, port))
    
    # Receive the prompt
    prompt = s.recv(1024)
    print(prompt.decode())
    
    # Send the input
    s.sendall(input_str.encode())
    
    # Receive the response
    try:
        response = s.recv(1024)
        print(response.decode())
    except:
        print("No response received")
end_of_edit

