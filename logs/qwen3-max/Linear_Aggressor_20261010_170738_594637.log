from pwn import *

host = 'android-dropper.csaw.io'
port = 3000

# Create exactly 30 "1" values
input_data = ['1'] * 30
input_str = ' '.join(input_data)

conn = remote(host, port)
print(conn.recvuntil(b'Enter your input: ').decode())
conn.sendline(input_str.encode())
try:
    response = conn.recvall(timeout=5).decode()
    print(response)
except EOFError:
    print("Connection closed")
conn.close()
