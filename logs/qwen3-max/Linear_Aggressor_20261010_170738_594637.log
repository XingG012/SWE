from pwn import *

# Connect to the server
host = 'android-dropper.csaw.io'
port = 3000

# Create a list of 30 zeros as floats
input_data = ['0.0'] * 30
input_str = ' '.join(input_data)

# Start the connection
conn = remote(host, port)

# Receive the initial prompt
print(conn.recvuntil(b'Enter your input: ').decode())

# Send the input
conn.sendline(input_str.encode())

# Receive and print the response
try:
    response = conn.recvall(timeout=5).decode()
    print(response)
except EOFError:
    print("Connection closed by server")

conn.close()
end_of_edit

