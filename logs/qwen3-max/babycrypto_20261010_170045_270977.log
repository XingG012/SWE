import base64

# Read and decode the ciphertext
with open('ciphertext.txt', 'r') as f:
    ciphertext_b64 = f.read().strip()

ciphertext = base64.b64decode(ciphertext_b64)

# Try known plaintext attack with "flag{"
known_plaintext = b"flag{"

# XOR the first len(known_plaintext) bytes of ciphertext with known_plaintext
potential_key = []
for i in range(len(known_plaintext)):
    key_byte = ciphertext[i] ^ known_plaintext[i]
    potential_key.append(key_byte)

print("Potential key bytes from known plaintext attack:")
print([hex(b) for b in potential_key])

# Try to decrypt the entire message with this key (assuming repeating key)
decrypted = []
key_len = len(potential_key)
for i in range(len(ciphertext)):
    decrypted_byte = ciphertext[i] ^ potential_key[i % key_len]
    decrypted.append(decrypted_byte)

decrypted_bytes = bytes(decrypted)
print("\nDecrypted output (first 100 bytes):")
print(decrypted_bytes[:100])
print("\nFull decrypted output:")
try:
    print(decrypted_bytes.decode('utf-8'))
except UnicodeDecodeError:
    print("Decrypted data is not valid UTF-8")
    print("Hex representation:")
    print(decrypted_bytes.hex())
end_of_edit

