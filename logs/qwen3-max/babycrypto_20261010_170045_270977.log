import base64

# Read and decode the ciphertext
with open('ciphertext.txt', 'r') as f:
    ciphertext_b64 = f.read().strip()

ciphertext = base64.b64decode(ciphertext_b64)

# Decrypt with XOR key 0xff
decrypted = bytes([b ^ 0xff for b in ciphertext])

# Find the flag
flag_start = decrypted.find(b"flag{")
if flag_start != -1:
    # Find the closing brace
    flag_end = decrypted.find(b"}", flag_start)
    if flag_end != -1:
        flag = decrypted[flag_start:flag_end+1]
        print(f"Found flag: {flag.decode('utf-8')}")
    else:
        # Print from flag start onwards
        print(f"Partial flag found: {decrypted[flag_start:].decode('utf-8', errors='ignore')}")
else:
    print("Flag not found in decrypted text")
    print(decrypted[:200])
end_of_edit

