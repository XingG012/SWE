import base64
import string

# Read and decode the ciphertext
with open('ciphertext.txt', 'r') as f:
    ciphertext_b64 = f.read().strip()

ciphertext = base64.b64decode(ciphertext_b64)

def is_printable(s):
    try:
        s.decode('utf-8')
        return all(c in string.printable for c in s.decode('utf-8'))
    except:
        return False

# Try all possible single-byte XOR keys
for key in range(256):
    decrypted = bytes([b ^ key for b in ciphertext])
    
    # Check if it starts with "flag{"
    if decrypted.startswith(b"flag{"):
        print(f"Key: {key} (0x{key:02x})")
        print(f"Decrypted: {decrypted[:100]}")
        try:
            print(f"Full: {decrypted.decode('utf-8')}")
        except:
            print("Not valid UTF-8")
        break
    
    # Also check if it contains "flag{" somewhere
    if b"flag{" in decrypted:
        print(f"Key: {key} (0x{key:02x}) - contains flag{{")
        idx = decrypted.find(b"flag{")
        print(f"Decrypted around flag: {decrypted[max(0, idx-10):idx+50]}")
