import base64
import re

# Extract base64 ciphertexts from assignment.txt
with open('assignment.txt', 'r') as f:
    content = f.read()

# Parse the base64 strings
lines = content.split('\n')
ciphertexts = []
current_cipher = ""
    
for line in lines:
    line = line.strip()
    if not line:
        if current_cipher:
            ciphertexts.append(current_cipher)
            current_cipher = ""
        continue
        
    # Skip header lines
    if line.startswith('---') or 'Problem Text' in line:
        continue
        
    # Check if it looks like base64
    if re.match(r'^[A-Za-z0-9+/=]+$', line) and len(line) > 10:
        current_cipher += line
    else:
        if current_cipher:
            ciphertexts.append(current_cipher)
            current_cipher = ""

if current_cipher:
    ciphertexts.append(current_cipher)

# Decode all ciphertexts
decoded_ciphers = []
for cipher in ciphertexts:
    try:
        decoded = base64.b64decode(cipher)
        decoded_ciphers.append(decoded)
    except Exception as e:
        print(f"Error decoding cipher: {e}")

print(f"Total decoded ciphertexts: {len(decoded_ciphers)}")

# Group by length
length_groups = {}
for i, cipher in enumerate(decoded_ciphers):
    length = len(cipher)
    if length not in length_groups:
        length_groups[length] = []
    length_groups[length].append((i, cipher))

print(f"\nLength groups:")
for length in sorted(length_groups.keys()):
    print(f"  {length} bytes: {len(length_groups[length])} messages")

# Focus on the 194-byte group (indices 0 and 3)
if 194 in length_groups:
    group_194 = length_groups[194]
    print(f"\nAnalyzing 194-byte group ({len(group_194)} messages):")
    
    # XOR the two 194-byte messages
    if len(group_194) >= 2:
        idx1, cipher1 = group_194[0]
        idx2, cipher2 = group_194[1]
        
        xor_result = bytes(a ^ b for a, b in zip(cipher1, cipher2))
        
        # Try to find readable ASCII in the XOR result
        print(f"\nXOR of message {idx1} and {idx2}:")
        try:
            ascii_result = xor_result.decode('ascii')
            print("ASCII representation:")
            print(repr(ascii_result))
            
            # Also show as hex for analysis
            print("\nHex representation (first 100 chars):")
            print(xor_result.hex()[:100])
        except UnicodeDecodeError:
            print("Not valid ASCII, showing hex:")
            print(xor_result.hex()[:200])
            
        # Try to guess common words
        # Common words in English that might appear in messages
        common_words = ['the', 'and', 'flag', 'secret', 'enemy', 'attack', 'mission', 'hq', 'base', 'control']
        
        print(f"\nTrying common word guesses...")
        for word in common_words:
            word_bytes = word.encode('ascii')
            # Try at different positions
            for pos in range(len(xor_result) - len(word_bytes) + 1):
                # If we assume message1 has 'word' at position pos, then message2 would have word ^ xor_result[pos:pos+len(word)]
                candidate = bytes(word_bytes[i] ^ xor_result[pos + i] for i in range(len(word_bytes)))
                try:
                    candidate_str = candidate.decode('ascii')
                    # Check if candidate looks like reasonable text
                    if all(32 <= ord(c) <= 126 for c in candidate_str):  # printable ASCII
                        print(f"Position {pos}: if msg{idx1} has '{word}', msg{idx2} has '{candidate_str}'")
                except:
                    pass
