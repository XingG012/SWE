import base64
import re

# Read the assignment file and extract base64 ciphertexts
with open('assignment.txt', 'r') as f:
    content = f.read()

# Extract all base64 strings (they appear to be split across multiple lines)
# Join all lines and find base64 patterns
lines = content.split('\n')
ciphertexts = []
current_cipher = ""
    
for line in lines:
    # Skip non-base64 looking lines (headers, etc.)
    if re.match(r'^\s*[-=]+\s*$', line) or 'Problem Text' in line or line.strip() == '':
        if current_cipher:
            ciphertexts.append(current_cipher.strip())
            current_cipher = ""
        continue
        
    # Check if line looks like base64 (contains typical base64 chars)
    if re.match(r'^[A-Za-z0-9+/=]*$', line.strip()) and len(line.strip()) > 10:
        current_cipher += line.strip()
    else:
        if current_cipher:
            ciphertexts.append(current_cipher.strip())
            current_cipher = ""

# Don't forget the last one if exists
if current_cipher:
    ciphertexts.append(current_cipher.strip())

# Decode base64 to bytes
decoded_ciphers = []
for cipher in ciphertexts:
    try:
        decoded = base64.b64decode(cipher)
        decoded_ciphers.append(decoded)
        print(f"Ciphertext length: {len(decoded)}")
    except Exception as e:
        print(f"Error decoding: {cipher[:20]}... - {e}")

print(f"\nTotal ciphertexts found: {len(decoded_ciphers)}")

# Let's try XORing pairs to see if we can find patterns
def xor_bytes(a, b):
    return bytes(x ^ y for x, y in zip(a, b))

# Try XORing the first few ciphertexts with each other
for i in range(min(3, len(decoded_ciphers))):
    for j in range(i+1, min(4, len(decoded_ciphers))):
        xor_result = xor_bytes(decoded_ciphers[i], decoded_ciphers[j])
        # Try to decode as ASCII to see if we get readable text
        try:
            ascii_result = xor_result.decode('ascii')
            print(f"\nXOR of cipher {i} and {j}:")
            print(repr(ascii_result))
        except:
            # Print hex if not ASCII
            print(f"\nXOR of cipher {i} and {j} (hex):")
            print(xor_result.hex()[:100] + "...")
end_of_edit

