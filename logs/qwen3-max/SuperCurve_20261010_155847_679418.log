#!/usr/bin/env python3

from supercurve import SuperCurve

# Create the curve with the parameters from the server
curve = SuperCurve(
    field=14753, order=7919,
    a=1, b=-1, g=(1, 1),
)

# Public key from the server
pub_key = (13478, 1667)
base_point = (1, 1)

# Brute force search for the secret scalar
for i in range(1, curve.order):
    if curve.mult(i, base_point) == pub_key:
        print(f"Found secret: {i}")
        break
else:
    print("Secret not found")
