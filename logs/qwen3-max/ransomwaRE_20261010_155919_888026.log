#!/usr/bin/env python3

def get_keystream(plaintext_file, ciphertext_file):
    with open(plaintext_file, 'rb') as f:
        plaintext = f.read()
    with open(ciphertext_file, 'rb') as f:
        ciphertext = f.read()
    return bytes([p ^ c for p, c in zip(plaintext, ciphertext)])

# Get keystream from first pair
ks1 = get_keystream(
    'files/20180212_113048_Jones_C_ADMI2017_Ransomware.pdf.backup',
    'files/9df65cc45479c058ef4a600c1e607fec44d83682db732f077817c58bed47a191.pdf.cryptastic'
)

# Get keystream from second pair (use first 1000 bytes to avoid memory issues)
with open('files/2020_IC3Report.pdf.backup', 'rb') as f:
    plaintext2 = f.read(1000)
with open('files/cad0b75505847a4792a67bb33ece21ec9c7bd21395ca6b158095d92772e01637.pdf.cryptastic', 'rb') as f:
    ciphertext2 = f.read(1000)
ks2 = bytes([p ^ c for p, c in zip(plaintext2, ciphertext2)])

# Compare first 100 bytes of both keystreams
print("Keystream 1 (first 100 bytes):")
print(' '.join(f'{b:02x}' for b in ks1[:100]))
print("\nKeystream 2 (first 100 bytes):")
print(' '.join(f'{b:02x}' for b in ks2[:100]))

# Check if they're identical
if ks1[:100] == ks2[:100]:
    print("\nKeystreams are identical! Same key used for both files.")
else:
    print("\nKeystreams are different. Different keys or different encryption methods.")
end_of_edit

