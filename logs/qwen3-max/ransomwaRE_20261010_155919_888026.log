#!/usr/bin/env python3

# Get the keystream from the known plaintext-ciphertext pair
with open('files/20180212_113048_Jones_C_ADMI2017_Ransomware.pdf.backup', 'rb') as f:
    plaintext = f.read()
with open('files/9df65cc45479c058ef4a600c1e607fec44d83682db732f077817c58bed47a191.pdf.cryptastic', 'rb') as f:
    ciphertext = f.read()
keystream = bytes([p ^ c for p, c in zip(plaintext, ciphertext)])

# Read the encrypted flag file
encrypted_flag_file = 'files/ea6b505ffded681a256232ed214d4c3b410c8b4f052775eb7e67dcbd5af64e63.pdf.cryptastic'
with open(encrypted_flag_file, 'rb') as f:
    encrypted_flag = f.read()

# Decrypt using the keystream (take only as much keystream as needed)
decrypted_flag = bytes([e ^ k for e, k in zip(encrypted_flag, keystream)])

# Save the decrypted file
with open('decrypted_flag.pdf', 'wb') as f:
    f.write(decrypted_flag)

print(f"Decrypted {len(encrypted_flag)} bytes")
print("Saved as decrypted_flag.pdf")

# Try to extract any text that might contain the flag
try:
    # Look for flag format in the decrypted data
    decrypted_text = decrypted_flag.decode('utf-8', errors='ignore')
    if 'flag{' in decrypted_text.lower():
        start = decrypted_text.lower().find('flag{')
        end = decrypted_text.find('}', start)
        if end != -1:
            flag = decrypted_text[start:end+1]
            print(f"Found flag: {flag}")
        else:
            print("Flag pattern found but no closing brace")
    else:
        print("No flag pattern found in decrypted text")
except:
    print("Could not decode as UTF-8, checking binary for flag pattern")
    # Search for flag pattern in binary
    flag_bytes = b'flag{'
    if flag_bytes in decrypted_flag:
        start = decrypted_flag.find(flag_bytes)
        # Find the closing brace
        end = decrypted_flag.find(b'}', start)
        if end != -1:
            flag = decrypted_flag[start:end+1].decode('utf-8', errors='ignore')
            print(f"Found flag in binary: {flag}")
        else:
            print("Flag pattern found in binary but no closing brace")
    else:
        print("No flag pattern found in binary either")
