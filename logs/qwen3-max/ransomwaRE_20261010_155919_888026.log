#!/usr/bin/env python3

with open('files/20180212_113048_Jones_C_ADMI2017_Ransomware.pdf.backup', 'rb') as f:
    plaintext = f.read()

with open('files/9df65cc45479c058ef4a600c1e607fec44d83682db732f077817c58bed47a191.pdf.cryptastic', 'rb') as f:
    ciphertext = f.read()

# XOR them to get the keystream
keystream = bytes([p ^ c for p, c in zip(plaintext, ciphertext)])

# Print first 64 bytes of keystream in hex
print("Keystream (first 64 bytes):")
print(' '.join(f'{b:02x}' for b in keystream[:64]))

# Check if keystream repeats
for i in range(1, 33):
    if keystream[:i] == keystream[i:2*i]:
        print(f"Possible repeat every {i} bytes")
        break
else:
    print("No obvious repetition in first 64 bytes")
end_of_edit

