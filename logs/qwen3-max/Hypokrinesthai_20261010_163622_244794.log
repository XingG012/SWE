key = bytes([0x50, 0x50, 0x74, 0x4e])  # "PPtN"

with open('hypokrinesthai_clean.bin', 'rb') as f:
    data = f.read()

decrypted = bytearray()
for i in range(len(data)):
    decrypted.append(data[i] ^ key[i % len(key)])

with open('xor_key_decrypted.bin', 'wb') as out:
    out.write(decrypted)

# Check for flags in the decrypted data
if b'csawctf{' in decrypted or b'flag{' in decrypted:
    print("Flag found!")
    print(decrypted[decrypted.find(b'{')-8:decrypted.find(b'}')+1].decode('ascii', errors='ignore'))
else:
    # Print first 200 bytes as ASCII for inspection
    snippet = bytes(c if 32 <= c <= 126 else 46 for c in decrypted[:200])
    print("First 200 bytes (ASCII):", snippet.decode('ascii'))
end_of_edit

