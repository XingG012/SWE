import struct

with open('hypokrinesthai_clean.bin', 'rb') as f:
    data = f.read()

# Pad data to multiple of 4 bytes
remainder = len(data) % 4
if remainder:
    data += b'\x00' * (4 - remainder)

# Unpack as 32-bit little-endian, then repack as big-endian
words = struct.unpack('<' + 'I' * (len(data)//4), data)
swapped_data = struct.pack('>' + 'I' * len(words), *words)

with open('endian_swapped.bin', 'wb') as out:
    out.write(swapped_data)

# Check for flags
if b'csawctf{' in swapped_data:
    start = swapped_data.find(b'csawctf{')
    end = swapped_data.find(b'}', start)
    if end != -1:
        flag = swapped_data[start:end+1].decode('ascii')
        print("Flag found:", flag)
else:
    # Print first 200 bytes as ASCII
    snippet = bytes(c if 32 <= c <= 126 else 46 for c in swapped_data[:200])
    print("First 200 bytes (ASCII):", snippet.decode('ascii'))
end_of_edit

