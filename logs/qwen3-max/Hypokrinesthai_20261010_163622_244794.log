with open('hypokrinesthai_clean.bin', 'rb') as f:
    data = f.read()
reversed_data = data[::-1]  # Reverse the byte order

# Common patterns to check
patterns = [b'csawctf{', b'flag{', b'CTF{', b'png', b'PK', b'%PDF']

for key in range(256):
    decrypted = bytes(b ^ key for b in reversed_data)
    if any(pat in decrypted for pat in patterns) or b'{' in decrypted and b'}' in decrypted:
        print(f"Key: 0x{key:02x}")
        with open(f'reversed_decrypted_{key:02x}.bin', 'wb') as out:
            out.write(decrypted)
        # Print a snippet of the decrypted data
        snippet = decrypted[:200]
        print("Snippet (ASCII):", snippet.decode('ascii', errors='replace'))
        # Also check if it's a known file type
        import magic
        try:
            file_type = magic.from_buffer(decrypted[:1024])
            print("File type:", file_type)
        except:
            pass
end_of_edit

