from pwn import *

# Connect to server
r = remote('crypto.chal.csaw.io', 1337)

# Send seed = 0 (16 bytes)
r.send(b'0000000000000000')

# Read past the prompt
r.recvuntil(b'Encrypted flag:\n')

# Get the first few encrypted messages and print in hex
for i in range(5):
    enc_msg = r.recvline().strip()
    print(f"Message {i}: {enc_msg.hex()} (length: {len(enc_msg)})")

r.close()
end_of_edit

