from pwn import *
import random

def xor(a, b):
    return bytes([x ^ y for x, y in zip(a, b)])

# Connect to server
r = remote('crypto.chal.csaw.io', 1337)

# Send seed = 0
seed_str = '0000000000000000'
r.send(seed_str.encode())
r.recvuntil(b'Encrypted flag:\n')

# Get all 100 encrypted messages
encrypted_msgs = []
for _ in range(100):
    msg = r.recvline().strip()
    encrypted_msgs.append(msg)

# Simulate PRNG with same seed
random.seed(0)

# Determine message length from first encrypted message
msg_len = len(encrypted_msgs[0])
num_blocks = (msg_len + 15) // 16  # Ceiling division

# We'll recover the plaintext byte by byte
recovered = bytearray(b'Encrypted Flag: f')  # Assume flag starts with 'f'

# For each position beyond the known prefix
for pos in range(16, msg_len):
    # Collect all ciphertext bytes at this position
    cipher_bytes = [msg[pos] for msg in encrypted_msgs]
    
    # Simulate what random_bytes() returned for each message at this position
    random.seed(0)  # Reset PRNG for each position calculation
    
    # We need to advance the PRNG to the correct state for this position
    # For each message and each block before this position, we need to call random_bytes()
    rand_values = []
    for msg_idx in range(100):
        # For each message, simulate all blocks up to current position
        for block_idx in range(pos // 16 + 1):
            rb = random.getrandbits(32).to_bytes(16, 'little')
            if block_idx == pos // 16:
                # This is the block containing our position
                rand_byte = rb[pos % 16]
                rand_values.append(rand_byte)
                break
    
    # Now, for each message: cipher_byte = aes_enc_rand_byte XOR plain_byte
    # So plain_byte = cipher_byte XOR aes_enc_rand_byte
    # But we don't know aes_enc_rand_byte
    
    # However, if we assume the plaintext is ASCII printable, we can look for consistency
    # across all 100 messages
    
    # Since aes_enc_rand_byte is fixed for each message (determined by rand_byte),
    # and plain_byte is the same for all messages, then:
    # cipher_byte XOR plain_byte = aes_enc_rand_byte (which varies per message)
    
    # This doesn't directly help...
    
    # Alternative approach: since we have the first 16 bytes, let's try to decrypt
    # the second block assuming we know the first block completely
    
    # But I think I'm stuck in a loop here.
    
    # Let me try a completely different approach: what if I send a seed that makes
    # the PRNG generate all zeros? Then random_bytes() returns all zeros,
    # and the encryption becomes: ciphertext = aes.encrypt(zeros) XOR plaintext
    # If I can get two different encryptions with the same random_bytes(),
    # I could XOR them to eliminate the aes.encrypt(zeros) term.
    
    # But the server only allows one seed per connection.
    
    # Wait! The vulnerability might be that random_bytes() has only 32 bits of entropy,
    # so with 100 samples, I might see collisions in the random_bytes() values.
    # If two messages use the same random_bytes() for the same block position,
    # then their ciphertext blocks would be identical if the plaintext is the same.
    
    # But the plaintext is the same, so if R[i][j] == R[k][j], then C[i][j] == C[k][j].
    # This doesn't help me recover the plaintext.
    
    # I think I need to accept that I need to brute force the first unknown byte.
    # There are only 256 possibilities, and I can check which one gives a reasonable flag.
    
    # Let's do this for the first unknown byte (position 16)
    if pos == 16:
        candidates = {}
        for candidate in range(256):
            # Assume this is the correct byte
            test_plain = b'Encrypted Flag: ' + bytes([candidate])
            
            # For the first message, compute what aes.encrypt(rand_bytes) would be
            random.seed(0)
            rb = random.getrandbits(32).to_bytes(16, 'little')
            aes_enc_rb = xor(encrypted_msgs[0][:16], test_plain)
            
            # Now try to decrypt the rest of the first message
            recovered_test = bytearray(test_plain)
            current_pos = 16
            while current_pos < msg_len:
                block_idx = current_pos // 16
                rb = random.getrandbits(32).to_bytes(16, 'little')
                enc_block = encrypted_msgs[0][block_idx*16:(block_idx+1)*16]
                plain_block = xor(enc_block, aes_enc_rb)  # Wait, no! aes_enc_rb changes per block
                
                # This is wrong because aes_enc_rb is different for each block
                break
            
            # Instead, let's just check if the candidate leads to printable ASCII
            if 32 <= candidate <= 126:  # Printable ASCII
                candidates[candidate] = chr(candidate)
        
        # Print candidates
        print("Possible candidates for position 16:", candidates)
        # Assume it's 'f' for "flag{"
        recovered.append(ord('l'))  # Next should be 'l'
    else:
        # For now, just append a placeholder
        recovered.append(0)

print("Recovered so far:", bytes(recovered))
