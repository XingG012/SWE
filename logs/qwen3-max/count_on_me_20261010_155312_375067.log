from pwn import *
import random

def xor(a, b):
    return bytes([x ^ y for x, y in zip(a, b)])

# Connect to server
r = remote('crypto.chal.csaw.io', 1337)

# Send seed = 0 (16 bytes as ASCII)
r.send(b'0000000000000000')

# Read past the prompt
r.recvuntil(b'Encrypted flag:\n')

# Receive all 100 encrypted messages (48 bytes each)
encrypted_msgs = []
for i in range(100):
    msg = r.recvn(48)
    encrypted_msgs.append(msg)
    r.recv(1)  # consume newline

r.close()

# Simulate PRNG with same seed
random.seed(0)

# Known plaintext prefix
prefix = b'Encrypted Flag: '
block_size = 16

# Recover the flag byte by byte
recovered = bytearray(prefix)

# We'll use the first encrypted message for decryption
first_msg = encrypted_msgs[0]

# Process each block
for block_idx in range(3):  # 3 blocks total
    # Get the random bytes used for this block in the first message
    rand_bytes = random.getrandbits(32).to_bytes(16, 'little')
    
    # Extract the encrypted block
    enc_block = first_msg[block_idx*16:(block_idx+1)*16]
    
    # We don't know AES(rand_bytes), but we can use the known parts of plaintext
    if block_idx == 0:
        # First block: we know first 15 bytes, assume 16th is 'f'
        known_plain = prefix + b'f'
        aes_enc_rand = xor(enc_block, known_plain)
        plain_block = known_plain
    else:
        # For other blocks, we need to find AES(rand_bytes)
        # But we don't have known plaintext...
        # However, we can use the fact that we have 100 messages
        # Let's try a different approach
        
        # Actually, let's just assume the flag format and recover sequentially
        # We'll guess that after "flag{" it's printable ASCII
        aes_enc_rand = None
        # We need to find aes_enc_rand from somewhere...
        
        # This is still problematic
        break

# Alternative approach: since we control the seed, let's choose a seed that makes
# random.getrandbits(32) return 0 for the first call
# Then random_bytes() = b'\x00' * 16
# And we can recover aes.encrypt(b'\x00'*16) from the known prefix

# Let me find a seed that makes the first random.getrandbits(32) return 0
seed_found = None
for test_seed in range(1000000):
    random.seed(test_seed)
    if random.getrandbits(32) == 0:
        seed_found = test_seed
        break

if seed_found is not None:
    print(f"Found seed {seed_found} that makes first random.getrandbits(32) = 0")
else:
    print("No seed found in range")
    seed_found = 0  # fallback

# Use this seed instead
end_of_edit

