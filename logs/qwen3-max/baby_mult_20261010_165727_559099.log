# Read decimal bytes from program.txt and convert to binary
with open('program.txt', 'r') as f:
    data = f.read().strip()
    decimals = [int(x.strip()) for x in data.split(',')]

# Convert to bytes
byte_data = bytes(decimals)

# Write to binary file
with open('program.bin', 'wb') as f:
    f.write(byte_data)

print(f"Converted {len(byte_data)} bytes to program.bin")
