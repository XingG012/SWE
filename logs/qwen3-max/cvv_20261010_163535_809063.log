import socket

def send_cvv_header():
    host = 'cvv'
    port = 8000
    
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.connect((host, port))
    
    # Send request with CVV header
    request = "GET / HTTP/1.1\r\nHost: cvv:8000\r\nCVV: 123\r\n\r\n"
    
    s.send(request.encode())
    response = s.recv(4096).decode()
    print(response)
    
    s.close()

send_cvv_header()
