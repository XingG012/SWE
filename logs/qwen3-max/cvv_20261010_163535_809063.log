import socket

def send_cvv_request(cvv):
    host = 'cvv'
    port = 8000
    
    # Create socket connection
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.connect((host, port))
    
    # Construct HTTP POST request
    body = f"cvv={cvv}"
    request = f"POST / HTTP/1.1\r\nHost: cvv:8000\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: {len(body)}\r\n\r\n{body}"
    
    # Send request
    s.send(request.encode())
    
    # Receive response
    response = s.recv(4096).decode()
    print(response)
    
    s.close()

# Try with a sample CVV
send_cvv_request("123")
end_of_edit

