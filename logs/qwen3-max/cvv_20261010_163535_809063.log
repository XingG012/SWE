import socket
import time

def multi_connect():
    host = 'cvv'
    port = 8000
    
    for i in range(5):
        s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
        s.connect((host, port))
        response = s.recv(4096).decode()
        print(f"Connection {i+1}: {response.strip()}")
        s.close()
        time.sleep(0.1)

multi_connect()
