import socket

def send_custom_request():
    host = 'cvv'
    port = 8000
    
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.connect((host, port))
    
    # Try sending a request with CVV in User-Agent
    request = "GET / HTTP/1.1\r\nHost: cvv:8000\r\nUser-Agent: cvv\r\n\r\n"
    
    s.send(request.encode())
    response = s.recv(4096).decode()
    print(response)
    
    s.close()

send_custom_request()
