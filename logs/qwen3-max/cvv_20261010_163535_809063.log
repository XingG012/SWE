import socket

def send_hex_cvv():
    host = 'cvv'
    port = 8000
    
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.connect((host, port))
    
    # Send raw bytes for "cvv" (ASCII: 63 76 76)
    s.send(b'\x63\x76\x76')
    
    response = s.recv(4096).decode()
    print(response)
    
    s.close()

send_hex_cvv()
