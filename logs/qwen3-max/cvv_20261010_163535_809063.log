import socket

def send_query_cvv():
    host = 'cvv'
    port = 8000
    
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.connect((host, port))
    
    # Send GET request with cvv query parameter
    request = "GET /?cvv=123 HTTP/1.1\r\nHost: cvv:8000\r\n\r\n"
    
    s.send(request.encode())
    response = s.recv(4096).decode()
    print(response)
    
    s.close()

send_query_cvv()
