import socket
import hashlib

def send_hashed_cvv():
    host = 'cvv'
    port = 8000
    
    # Calculate MD5 hash of "cvv"
    cvv_hash = hashlib.md5(b"cvv").hexdigest()
    
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.connect((host, port))
    
    body = f"cvv={cvv_hash}"
    request = f"POST / HTTP/1.1\r\nHost: cvv:8000\r\nContent-Type: application/x-www-form-urlencoded\r\nContent-Length: {len(body)}\r\n\r\n{body}"
    
    s.send(request.encode())
    response = s.recv(4096).decode()
    print(response)
    
    s.close()

send_hashed_cvv()
end_of_edit

