import sys
from pwn import *

# Remove the limit for large integers
sys.set_int_max_str_digits(0)

# Connect to the server
r = remote("crypto.chal.csaw.io", 21200)

# Receive the prompt
prompt = r.recvline().decode()
print(f"Received: {prompt}")

# Extract the base from the prompt
import re
base_match = re.search(r'base (\d+)', prompt)
if not base_match:
    print("Could not find base in prompt")
    exit(1)

b = int(base_match.group(1))
print(f"Base: {b}")

# Calculate the self-descriptive number in base b
# Position 0: b-4, Position 1: 2, Position 2: 1, Position b-4: 1, others: 0
r_num = (b - 4) * (b ** (b - 1)) + 2 * (b ** (b - 2)) + 1 * (b ** (b - 3)) + 1 * (b ** 3)

# Send the number
r.sendline(str(r_num).encode())

# Receive the response
response = r.recvall(timeout=5).decode()
print(f"Response: {response}")

r.close()
end_of_edit

