            if ' = ' in problem:
                expr_part, result_part = problem.split(' = ')
                target = int(result_part)
                
                # Replace X with 0 and evaluate
                expr_x0 = expr_part.replace('X', '0')
                try:
                    val_x0 = eval(expr_x0)
                except:
                    print(f"Could not evaluate expression with X=0: {expr_x0}")
                    conn.close()
                    exit(1)
                    
                # Replace X with 1 and evaluate  
                expr_x1 = expr_part.replace('X', '1')
