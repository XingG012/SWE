#!/usr/bin/env python3

from pwn import *
import re

# Connect to the server
conn = remote('misc.chal.csaw.io', 4324)

# Receive the initial banner
banner = conn.recvuntil(b'What does X equal?: ')
print(banner.decode())

# We'll solve multiple problems in a loop
while True:
    try:
        # Receive the problem
        problem = conn.recvline().decode().strip()
        print(f"Problem: {problem}")
        
        # If we get the flag, break
        if 'flag' in problem:
            print(problem)
            break
            
        # Parse the equation - format is like "X + 11 = 48"
        # We need to handle different operators: +, -, *, /
        match = re.search(r'X ([+\-*/]) (\d+) = (\d+)', problem)
        if not match:
            # Try alternative format
            match = re.search(r'(\d+) ([+\-*/]) X = (\d+)', problem)
            if match:
                const1 = int(match.group(1))
                op = match.group(2)
                result = int(match.group(3))
                
                if op == '+':
                    # const1 + X = result => X = result - const1
                    answer = result - const1
                elif op == '-':
                    # const1 - X = result => X = const1 - result
                    answer = const1 - result
                elif op == '*':
                    # const1 * X = result => X = result / const1
                    answer = result // const1
                elif op == '/':
                    # const1 / X = result => X = const1 / result
                    answer = const1 // result
            else:
                # Try another format: X = ...
                match = re.search(r'X = (.+)', problem)
                if match:
                    # This shouldn't happen, but just in case
                    answer = eval(match.group(1))
                else:
                    print(f"Could not parse problem: {problem}")
                    break
        else:
            op = match.group(1)
            const = int(match.group(2))
            result = int(match.group(3))
            
            if op == '+':
                # X + const = result => X = result - const
                answer = result - const
            elif op == '-':
                # X - const = result => X = result + const
                answer = result + const
            elif op == '*':
                # X * const = result => X = result / const
                answer = result // const
            elif op == '/':
                # X / const = result => X = result * const
                answer = result * const
        
        print(f"Answer: {answer}")
        conn.sendline(str(answer).encode())
        
        # Receive response
        response = conn.recvline().decode().strip()
        print(f"Response: {response}")
        
        # Check if we got the flag
        if 'flag' in response:
            print(response)
            break
            
    except EOFError:
        print("Connection closed")
        break
    except Exception as e:
        print(f"Error: {e}")
        break

conn.close()
end_of_edit

