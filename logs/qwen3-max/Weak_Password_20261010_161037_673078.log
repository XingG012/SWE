import hashlib

target_hash = "7f4986da7d7b52fa81f98278e6ec9dcb"

# Try years from 1900 to 2023 (reasonable range for birthdays)
for year in range(1900, 2024):
    for month in range(1, 13):
        for day in range(1, 32):
            # Format date as YYYYMMDD
            date_str = f"{year:04d}{month:02d}{day:02d}"
            
            # Candidate 1: Aaron + date
            candidate1 = f"Aaron{date_str}"
            if hashlib.md5(candidate1.encode()).hexdigest() == target_hash:
                print(f"Found password: {candidate1}")
                exit()
            
            # Candidate 2: date + Aaron
            candidate2 = f"{date_str}Aaron"
            if hashlib.md5(candidate2.encode()).hexdigest() == target_hash:
                print(f"Found password: {candidate2}")
                exit()

print("Password not found in the tested range.")
