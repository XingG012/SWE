# Now implement BFS to find shortest path
def bfs_shortest_path(grid, start, end, grid_size):
    """Find shortest path using BFS"""
    if grid[start[0]][start[1]] == 1 or grid[end[0]][end[1]] == 1:
        return None  # Start or end is a wall
    
    # Directions: up, right, down, left
    directions = [(-1, 0), (0, 1), (1, 0), (0, -1)]
    
    # Queue for BFS: (row, col, path)
    queue = collections.deque([(start[0], start[1], "")])
    visited = set()
    visited.add(start)
    
    while queue:
        row, col, path = queue.popleft()
        
        # Check if we reached the end
        if (row, col) == end:
            return path
        
        # Explore neighbors
        for dr, dc in directions:
            new_row, new_col = row + dr, col + dc
            
            # Check bounds
            if 0 <= new_row < grid_size and 0 <= new_col < grid_size:
                # Check if it's a path and not visited
                if grid[new_row][new_col] == 0 and (new_row, new_col) not in visited:
                    visited.add((new_row, new_col))
                    # Convert direction to character: U, R, D, L
                    if dr == -1:
                        direction_char = 'U'
                    elif dc == 1:
                        direction_char = 'R'
                    elif dr == 1:
                        direction_char = 'D'
                    else:  # dc == -1
                        direction_char = 'L'
                    queue.append((new_row, new_col, path + direction_char))
    
    return None  # No path found

# Find the shortest path
shortest_path = bfs_shortest_path(grid, start, end, grid_size)
if shortest_path is None:
    print("No path found!")
else:
    print(f"Shortest path length: {len(shortest_path)}")
    print(f"Shortest path: {shortest_path}")
    
    # Calculate MD5 hash of the path
    import hashlib
    md5_hash = hashlib.md5(shortest_path.encode()).hexdigest()
    print(f"MD5 hash: {md5_hash}")
    print(f"Flag: flag{{{md5_hash}}}")
end_of_edit

