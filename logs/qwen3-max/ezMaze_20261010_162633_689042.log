import struct

def read_float_array(filename):
    with open(filename, 'rb') as f:
        data = f.read()
    num_floats = len(data) // 4
    return list(struct.unpack('<' + 'f' * num_floats, data[:num_floats * 4]))

maze_data = read_float_array('archive/data/0')
grid_size = 42
print(f"Value at (0,0): {maze_data[0 * grid_size + 0]}")
print(f"Value at (0,41): {maze_data[0 * grid_size + 41]}")
print(f"Value at (41,41): {maze_data[41 * grid_size + 41]}")
end_of_edit

