# Let's find the actual entrance and exit by checking the borders
def find_border_entrances(grid, grid_size):
    entrances = []
    # Check top row (row 0)
    for j in range(grid_size):
        if grid[0][j] == 0:
            entrances.append((0, j))
    # Check bottom row (row grid_size-1)
    for j in range(grid_size):
        if grid[grid_size-1][j] == 0:
            entrances.append((grid_size-1, j))
    # Check left column (col 0)
    for i in range(grid_size):
        if grid[i][0] == 0:
            entrances.append((i, 0))
    # Check right column (col grid_size-1)
    for i in range(grid_size):
        if grid[i][grid_size-1] == 0:
            entrances.append((i, grid_size-1))
    return entrances

border_entrances = find_border_entrances(grid, grid_size)
print(f"Border entrances: {border_entrances}")
