import struct
import collections

def read_float_array(filename):
    """Read a binary file containing 32-bit floats"""
    with open(filename, 'rb') as f:
        data = f.read()
    # Each float is 4 bytes
    num_floats = len(data) // 4
    return list(struct.unpack('<' + 'f' * num_floats, data[:num_floats * 4]))

# Read the main maze data (7056 bytes = 1764 floats = 42x42 grid)
maze_data = read_float_array('archive/data/0')
grid_size = 42
assert len(maze_data) == grid_size * grid_size, f"Expected {grid_size*grid_size} values, got {len(maze_data)}"

# Convert to 2D grid - let's assume 0.0 is path and 1.0 is wall
# But we need to check what the actual values are
print("Unique values in maze data:", sorted(set(round(x, 6) for x in maze_data)))

# Create the grid
grid = []
for i in range(grid_size):
    row = []
    for j in range(grid_size):
        val = maze_data[i * grid_size + j]
        # Convert to integer: if close to 0, it's a path (0), if close to 1, it's a wall (1)
        if abs(val - 0.0) < 0.1:
            row.append(0)  # path
        elif abs(val - 1.0) < 0.1:
            row.append(1)  # wall
        else:
            row.append(int(round(val)))  # fallback
    grid.append(row)

# Print the grid to visualize
print("Maze grid:")
for row in grid:
    print(''.join(['#' if cell == 1 else '.' for cell in row]))

# Now find start and end points
# Typically in mazes, start is top-left (0,0) and end is bottom-right (41,41)
# But let's verify these are not walls
print(f"Start (0,0): {grid[0][0]}, End ({grid_size-1},{grid_size-1}): {grid[grid_size-1][grid_size-1]}")

# If start or end is a wall, we need to find actual start/end points
# Let's assume standard positions for now
start = (0, 0)
end = (grid_size - 1, grid_size - 1)

if grid[start[0]][start[1]] == 1 or grid[end[0]][end[1]] == 1:
    print("Start or end is a wall! Looking for actual start/end...")
    # Find first and last path cells
    start_found = False
    end_found = False
    for i in range(grid_size):
        for j in range(grid_size):
            if not start_found and grid[i][j] == 0:
                start = (i, j)
                start_found = True
            if grid[grid_size-1-i][grid_size-1-j] == 0 and not end_found:
                end = (grid_size-1-i, grid_size-1-j)
                end_found = True
            if start_found and end_found:
                break
        if start_found and end_found:
            break
    print(f"Adjusted start: {start}, end: {end}")
