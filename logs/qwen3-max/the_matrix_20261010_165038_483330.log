import numpy as np

# Character set from encoder.py
charset = " abcdefghijklmnopqrstuvwxyz"

# Encryption matrix we found: a=1, b=9
enc_matrix = np.array([
    [3, 6, 1],
    [9, 4, 2],
    [1, 5, 7]
])

# Read messages.txt
with open('messages.txt', 'r') as f:
    lines = f.readlines()

for i, line in enumerate(lines):
    # Parse the encrypted message
    nums = eval(line.strip())
    # Group into chunks of 3
    chunks = []
    for j in range(0, len(nums), 3):
        chunk = nums[j:j+3]
        if len(chunk) < 3:
            # Pad with zeros (shouldn't happen in valid messages)
            chunk.extend([0] * (3 - len(chunk)))
        chunks.append(chunk)
    
    # Try to decrypt each chunk
    plaintext = ""
    try:
        for chunk in chunks:
            # Solve enc_matrix * p = chunk
            p = np.linalg.solve(enc_matrix, chunk)
            # Round to nearest integer
            p_rounded = [round(x) for x in p]
            
            # Convert to characters
            for val in p_rounded:
                if val == -1:
                    # Padding, skip
                    continue
                elif 0 <= val < len(charset):
                    plaintext += charset[val]
                else:
                    plaintext += f"[{val}]"
        
        print(f"Message {i+1}: '{plaintext}'")
    except Exception as e:
        print(f"Message {i+1}: Error - {e}")
