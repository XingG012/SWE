# Character set from encoder.py
charset = " abcdefghijklmnopqrstuvwxyz"

# Encryption matrix coefficients
# [3, 6, 1]
# [9, 4, 2]
# [1, 5, 7]

def solve_system(c0, c1, c2):
    """
    Solve the system:
    3*p0 + 6*p1 + 1*p2 = c0
    9*p0 + 4*p1 + 2*p2 = c1
    1*p0 + 5*p1 + 7*p2 = c2
    """
    # Using Gaussian elimination manually
    
    # Original equations:
    # Eq1: 3p0 + 6p1 + p2 = c0
    # Eq2: 9p0 + 4p1 + 2p2 = c1  
    # Eq3: p0 + 5p1 + 7p2 = c2
    
    # Let's eliminate p0 from Eq2 and Eq3 using Eq1
    
    # Multiply Eq1 by 3: 9p0 + 18p1 + 3p2 = 3*c0
    # Subtract from Eq2: (9p0 + 4p1 + 2p2) - (9p0 + 18p1 + 3p2) = c1 - 3*c0
    # Result: -14p1 - p2 = c1 - 3*c0  --> Eq4
    
    # Multiply Eq1 by 1/3: p0 + 2p1 + (1/3)p2 = c0/3
    # But better to avoid fractions. Instead, multiply Eq3 by 3: 3p0 + 15p1 + 21p2 = 3*c2
    # Subtract Eq1: (3p0 + 15p1 + 21p2) - (3p0 + 6p1 + p2) = 3*c2 - c0
    # Result: 9p1 + 20p2 = 3*c2 - c0  --> Eq5
    
    # Now we have:
    # Eq4: -14p1 - p2 = c1 - 3*c0
    # Eq5: 9p1 + 20p2 = 3*c2 - c0
    
    # Solve Eq4 for p2: p2 = -14p1 - (c1 - 3*c0) = -14p1 - c1 + 3*c0
    
    # Substitute into Eq5:
    # 9p1 + 20*(-14p1 - c1 + 3*c0) = 3*c2 - c0
    # 9p1 - 280p1 - 20*c1 + 60*c0 = 3*c2 - c0
    # -271p1 = 3*c2 - c0 + 20*c1 - 60*c0
    # -271p1 = 3*c2 + 20*c1 - 61*c0
    # p1 = (61*c0 - 20*c1 - 3*c2) / 271
    
    p1 = (61*c0 - 20*c1 - 3*c2) / 271.0
    
    # Now get p2 from Eq4:
    p2 = -14*p1 - c1 + 3*c0
    
    # Now get p0 from Eq1:
    p0 = (c0 - 6*p1 - p2) / 3.0
    
    return round(p0), round(p1), round(p2)

# Read messages.txt
with open('messages.txt', 'r') as f:
    lines = f.readlines()

for i, line in enumerate(lines):
    # Parse the encrypted message
    nums = eval(line.strip())
    plaintext = ""
    
    try:
        # Process in chunks of 3
        for j in range(0, len(nums), 3):
            if j + 2 < len(nums):
                c0, c1, c2 = nums[j], nums[j+1], nums[j+2]
                p0, p1, p2 = solve_system(c0, c1, c2)
                
                # Convert to characters
                for val in [p0, p1, p2]:
                    if val == -1:
                        # Padding, skip
                        continue
                    elif 0 <= val < len(charset):
                        plaintext += charset[val]
                    else:
                        plaintext += f"[{val}]"
        
        print(f"Message {i+1}: '{plaintext}'")
    except Exception as e:
        print(f"Message {i+1}: Error - {e}")
