from pwn import *

# List of decrypted passwords
passwords = [
    "triangle", "master", "oven", "revenge", "stand", "association", 
    "dribble", "price", "pumpkin", "rebel", "machinery", "poem", 
    "sink", "proud", "trust", "recover", "spread", "lesson", 
    "green", "tycoon", "immune", "terrace", "regular", "gravity", 
    "foster", "civilization", "image", "shower", "virtue", "piece", 
    "promote", "endorse"
]

# Connect to server
r = remote("crypto.chal.csaw.io", 5000)

# Send each password
for i, pwd in enumerate(passwords):
    print(f"Sending password {i+1}: {pwd}")
    r.recvuntil(b"Give me a message...")
    r.sendline(pwd.encode())

# After sending all passwords, see what the server responds with
try:
    response = r.recvall(timeout=5)
    print("Final response:")
    print(response.decode())
except:
    print("No more response")

r.close()
end_of_edit

