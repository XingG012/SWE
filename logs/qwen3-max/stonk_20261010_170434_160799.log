response = requests.post('http://android-dropper.csaw.io:4657/login', data={"key": injected_key})
print("Login response status code:", response.status_code)
print("Login response text:")
print(response.text)

# If login succeeds, try to get the flag
if response.status_code == 200:
    # Extract the session key from the login response
    import json
    try:
        login_data = response.json()
        session_key = login_data.get("session")
        if session_key:
            # Use the session key to request the flag
            flag_response = requests.post('http://android-dropper.csaw.io:4657/flag', data={"key": session_key})
            print("\nFlag response status code:", flag_response.status_code)
            print("Flag response text:")
            print(flag_response.text)
    except json.JSONDecodeError:
        print("Response is not valid JSON")
