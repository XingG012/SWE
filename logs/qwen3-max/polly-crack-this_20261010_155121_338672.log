# Solve with current server values using characteristic 2 arithmetic

# Current constant terms from server output
homer_const = 4175562021798618967283811302731803765974810535764751867793
morris_const = 9147518114600160820238762375741299621698880632920397350742
phisem_const = 22966120109145712705958594540530792634996542578053706172760

# In characteristic 2, addition is XOR
total_const = homer_const ^ morris_const ^ phisem_const

# The equation is: total_const = 999 * admin_code + 123
# In characteristic 2, this is: total_const = 999 * admin_code ^ 123
# So: 999 * admin_code = total_const ^ 123
rhs = total_const ^ 123

# Now we need to divide by 999, which means multiply by the multiplicative inverse of 999
# But we're working with integers, not field elements. However, if admin_code is small,
# we can try to solve: (999 * admin_code) ^ 123 = total_const

# Let's assume admin_code is the flag as an integer, and try to compute it directly
# If 999 * admin_code + 123 = total_const (as integers), then:
admin_code_int = (total_const - 123) // 999

print("Admin code (integer division):", admin_code_int)
print("Hex:", hex(admin_code_int))

# Also try the XOR version
# We need to find admin_code such that 999 * admin_code = rhs
# This is difficult without knowing the field structure

# Let's also try interpreting total_const as the admin_code directly
print("Total const as potential flag:", total_const)
print("Total const hex:", hex(total_const))

# Convert to bytes
try:
    bytes_val = total_const.to_bytes((total_const.bit_length() + 7) // 8, 'big')
    print("Total const as bytes:", bytes_val)
    try:
        print("As string:", bytes_val.decode('utf-8'))
    except:
        print("Not valid UTF-8")
except:
    print("Too large for bytes conversion")
