# Simple solution for Polly Cracker
# Extract constant terms from each ciphertext and compute admin code

# Constant term from Homer's ciphertext
homer_const = 10830353114286885433346195800536232949048547259370949058994

# Constant term from Morris's ciphertext  
morris_const = 77233839822023325017689546310973311881881363804900876377130

# Constant term from Phisem's ciphertext
phisem_const = 57075527983756518205035094401003293468758447708576412791703

# Sum of constant terms = 999 * admin_code + 123
total_const = homer_const + morris_const + phisem_const

# Compute admin code
admin_code = (total_const - 123) // 999

print("Admin code:", admin_code)

# Convert to bytes to see if it contains the flag
try:
    flag_bytes = admin_code.to_bytes((admin_code.bit_length() + 7) // 8, 'big')
    print("Flag as bytes:", flag_bytes)
    # Try to decode as ASCII/UTF-8
    try:
        flag_str = flag_bytes.decode('utf-8')
        print("Flag as string:", flag_str)
    except:
        print("Could not decode as UTF-8")
except:
    print("Admin code too large to convert to bytes directly")
