from pwn import *
import re

# Java Random constants
MULTIPLIER = 0x5DEECE66D
ADDEND = 0xB
MASK = (1 << 48) - 1

def next_seed(seed):
    return (seed * MULTIPLIER + ADDEND) & MASK

def prev_seed(seed):
    # Reverse the LCG: seed = (prev_seed * MULTIPLIER + ADDEND) & MASK
    # => prev_seed = (seed - ADDEND) * inv(MULTIPLIER) mod 2^48
    # Since MULTIPLIER is odd, it has an inverse mod 2^48
    inv_multiplier = pow(MULTIPLIER, -1, 1 << 48)
    return ((seed - ADDEND) * inv_multiplier) & MASK

def next_int(seed):
    return (next_seed(seed) >> 16) & 0xFFFFFFFF

def find_seed_from_outputs(outputs):
    # outputs: list of nextInt() outputs (as signed 32-bit integers, but we treat as unsigned)
    if len(outputs) < 2:
        return None
    
    # Convert to unsigned 32-bit
    outputs = [o & 0xFFFFFFFF for o in outputs]
    
    # First output gives possible next seeds
    first_output = outputs[0]
    candidates = []
    for low16 in range(0x10000):
        next_seed1 = (first_output << 16) | low16
        prev_seed1 = prev_seed(next_seed1)
        # Check if this seed produces the second output
        next_seed2 = next_seed(prev_seed1)
        predicted_second = (next_seed2 >> 16) & 0xFFFFFFFF
        if predicted_second == (outputs[1] & 0xFFFFFFFF):
            candidates.append(prev_seed1)
    
    if len(candidates) == 1:
        return candidates[0]
    else:
        # Try with more outputs if available
        for candidate in candidates:
            valid = True
            current_seed = candidate
            for i in range(len(outputs)):
                current_seed = next_seed(current_seed)
                predicted = (current_seed >> 16) & 0xFFFFFFFF
                if predicted != (outputs[i] & 0xFFFFFFFF):
                    valid = False
                    break
            if valid:
                return candidate
        return None

# Test the seed recovery
# Example: seed=12345, generate two nextInts, then recover
test_seed = 12345
test_next1 = next_int(test_seed)
test_next2 = next_int(next_seed(test_seed))
recovered = find_seed_from_outputs([test_next1, test_next2])
print(f"Test: original={test_seed}, recovered={recovered}")
end_of_edit

