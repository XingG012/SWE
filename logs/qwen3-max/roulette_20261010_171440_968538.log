def internal_seed(provided_seed):
    return (provided_seed ^ MULTIPLIER) & MASK

def next_seed(internal):
    return (internal * MULTIPLIER + ADDEND) & MASK

def next_int_from_provided(provided_seed):
    internal = internal_seed(provided_seed)
    next_internal = next_seed(internal)
    return (next_internal >> 16) & 0xFFFFFFFF

def find_provided_seed_from_outputs(outputs):
    # outputs are nextInt() results from new Random(provided_seed)
    if len(outputs) < 2:
        return None
    
    outputs = [o & 0xFFFFFFFF for o in outputs]
    first_output = outputs[0]
    candidates = []
    
    # The first nextInt comes from the first next_internal after internal_seed
    # next_internal1 = (internal_seed * MULTIPLIER + ADDEND) & MASK
    # first_output = next_internal1 >> 16
    # So next_internal1 is in [first_output << 16, (first_output << 16) + 0xFFFF]
    for low16 in range(0x10000):
        next_internal1 = (first_output << 16) | low16
        # internal_seed = (next_internal1 - ADDEND) * inv(MULTIPLIER) mod 2^48
        inv_multiplier = pow(MULTIPLIER, -1, 1 << 48)
        internal_seed_candidate = ((next_internal1 - ADDEND) * inv_multiplier) & MASK
        # provided_seed = internal_seed_candidate ^ MULTIPLIER
        provided_seed_candidate = internal_seed_candidate ^ MULTIPLIER
        
        # Check against second output
        next_internal2 = next_seed(internal_seed_candidate)
        predicted_second = (next_internal2 >> 16) & 0xFFFFFFFF
        if predicted_second == (outputs[1] & 0xFFFFFFFF):
            candidates.append(provided_seed_candidate)
    
    if len(candidates) == 1:
        return candidates[0]
    else:
        for candidate in candidates:
            internal = internal_seed(candidate)
            valid = True
            for i in range(len(outputs)):
                internal = next_seed(internal)
                predicted = (internal >> 16) & 0xFFFFFFFF
                if predicted != (outputs[i] & 0xFFFFFFFF):
                    valid = False
                    break
            if valid:
                return candidate
        return None
