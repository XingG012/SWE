# Parse translation table from .data section
trans_tbl_hex = """

"""

# Convert hex string to bytes
trans_tbl = bytes.fromhex(trans_tbl_hex.replace("\n", ""))

# Expected transformed bytes (from decompiled main function)
expected = [
    0x6c, 0x4a, 0x2e, 0x22, 0x45, 0x33, 0xb8, 0xd5, 0x06, 0x0a,
    0xbc, 0xfa, 0x79, 0x24, 0xe1, 0xb2, 0xbf, 0x2c, 0xad, 0x86,
    0x60, 0xa4, 0xb6, 0xd8, 0x59, 0x87, 0x41, 0x94, 0x77, 0xf0,
    0x4f, 0xcb, 0x61, 0x25, 0xc0, 0x97, 0x2a
]

# Reverse the transformation
flag_chars = []
for exp_byte in expected:
    # Find the position of exp_byte in odd indices of trans_tbl
    found = False
    for i in range(1, len(trans_tbl), 2):
        if trans_tbl[i] == exp_byte:
            flag_chars.append(trans_tbl[i-1])
            found = True
            break
    if not found:
        print(f"Error: Could not find {exp_byte:02x} in translation table")
        exit(1)

flag = bytes(flag_chars).decode('ascii')
print(f"flag{{{flag}}}")
