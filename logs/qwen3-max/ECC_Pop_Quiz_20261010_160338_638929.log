#!/usr/bin/env sage -python

from sage.all import *

# Given parameters
p = 91892616383427266468674202228912830649717987467576278296903248698025962570137
a = 59633934909137121923180007457251515075489623761860272147460815197499978774180
b = 6663438346177529828451307723237392568844685859913999433187680268780609137027

# Define the elliptic curve
E = EllipticCurve(GF(p), [a, b])

# Define the points
P1 = E(42586510344204321270112256619674014743921146755193395322400110676991183074311, 
       45576877987663431861711596533366974015117910086257344545792841214578294981401)
P2 = E(65964311273044065672902572883544427190914400232469937333306381526969153174592, 
       52394163038094251474927487188645477226231610419608022289546701162737953306899)

print("Trying brute force for small secret values...")
for i in range(1, 100001):
    if i % 10000 == 0:
        print(f"Checked up to {i}...")
    if P1 * i == P2:
        print(f"Secret found: {i}")
        break
else:
    print("Secret not found in range 1-100000")
end_of_edit

