#!/usr/bin/env sage -python

from sage.all import *

# Given parameters
p = 91892616383427266468674202228912830649717987467576278296903248698025962570137
a = 59633934909137121923180007457251515075489623761860272147460815197499978774180
b = 6663438346177529828451307723237392568844685859913999433187680268780609137027

# Define the elliptic curve over GF(p)
E = EllipticCurve(GF(p), [a, b])

# Define the points
P1 = E(42586510344204321270112256619674014743921146755193395322400110676991183074311, 
       45576877987663431861711596533366974015117910086257344545792841214578294981401)
P2 = E(65964311273044065672902572883544427190914400232469937333306381526969153174592, 
       52394163038094251474927487188645477226231610419608022289546701162737953306899)

print("Curve is anomalous (order = p), applying Smart's attack...")

# Smart's attack implementation
def smart_attack(P, Q, p):
    # Lift the curve and points to Z/p^2Z
    R = IntegerModRing(p**2)
    E_lift = EllipticCurve(R, [ZZ(a), ZZ(b)])
    
    # Lift points P and Q
    P_lift = E_lift([ZZ(P[0]), ZZ(P[1])])
    Q_lift = E_lift([ZZ(Q[0]), ZZ(Q[1])])
    
    # Compute p*P and p*Q in the lifted curve
    pP = p * P_lift
    pQ = p * Q_lift
    
    # Extract the "logarithmic" components
    if pP[0] != 0:
        x_pP = pP[0]
        y_pP = pP[1]
        x_pQ = pQ[0]
        y_pQ = pQ[1]
        
        # Compute the discrete log using the formula
        # secret = (phi(Q) / phi(P)) mod p
        # where phi(P) = (p*P).x / p mod p
        phi_P = (x_pP // p) % p
        phi_Q = (x_pQ // p) % p
        
        # Handle the case where phi_P might be 0
        if phi_P == 0:
            # Try with y-coordinate
            phi_P = (y_pP // p) % p
            phi_Q = (y_pQ // p) % p
        
        if phi_P != 0:
            secret = (phi_Q * inverse_mod(phi_P, p)) % p
            return secret
        else:
            raise ValueError("phi_P is zero, cannot compute discrete log")
    else:
        raise ValueError("p*P has x-coordinate 0, cannot apply standard Smart's attack")

try:
    secret = smart_attack(P1, P2, p)
    print(f"Secret found using Smart's attack: {secret}")
    
    # Verify the solution
    assert P1 * secret == P2, "Verification failed!"
    print("Verification successful!")
    
except Exception as e:
    print(f"Smart's attack failed: {e}")
    print("Trying alternative approach...")
    
    # Fallback: try to use Sage's built-in discrete_log with the knowledge that curve is anomalous
    try:
        print("Trying Sage's discrete_log with anomalous curve...")
        secret = P2.discrete_log(P1)
        print(f"Secret found: {secret}")
        assert P1 * secret == P2, "Verification failed!"
        print("Verification successful!")
    except Exception as e2:
        print(f"Sage's discrete_log also failed: {e2}")
