#!/usr/bin/env sage -python

from sage.all import *

# Given parameters
p = 91892616383427266468674202228912830649717987467576278296903248698025962570137
a = 59633934909137121923180007457251515075489623761860272147460815197499978774180
b = 6663438346177529828451307723237392568844685859913999433187680268780609137027

# Define the elliptic curve over GF(p)
E = EllipticCurve(GF(p), [a, b])

# Define the points
P1 = E(42586510344204321270112256619674014743921146755193395322400110676991183074311, 
       45576877987663431861711596533366974015117910086257344545792841214578294981401)
P2 = E(65964311273044065672902572883544427190914400232469937333306381526969153174592, 
       52394163038094251474927487188645477226231610419608022289546701162737953306899)

print("Implementing correct Smart's attack for anomalous curve...")

# Create p-adic field with sufficient precision
Qp = Qp(p, prec=2)
Fp2 = Qp.residue_field()

# Lift the curve coefficients to Z_p (p-adic integers)
a_padic = Qp(a)
b_padic = Qp(b)

# Define the lifted curve over Qp
E_padic = EllipticCurve(Qp, [a_padic, b_padic])

# Lift the points to the p-adic curve
P1_padic = E_padic([Qp(P1[0]), Qp(P1[1])])
P2_padic = E_padic([Qp(P2[0]), Qp(P2[1])])

# Compute p*P1 and p*P2 in the p-adic curve
pP1 = p * P1_padic
pP2 = p * P2_padic

# Extract the coordinates
x_pP1 = pP1[0]
y_pP1 = pP1[1]
x_pP2 = pP2[0]
y_pP2 = pP2[1]

# For anomalous curves, p*P = (phi(P)*p + O(p^2), psi(P)*p + O(p^2))
# So phi(P) = (x-coordinate of p*P) / p mod p
phi_P1 = (x_pP1 / p).lift()
phi_P2 = (x_pP2 / p).lift()

# The discrete logarithm k satisfies: phi(k*P1) = k*phi(P1) mod p
# So k = phi(P2) / phi(P1) mod p
if phi_P1 != 0:
    k = (phi_P2 * inverse_mod(phi_P1, p)) % p
    print(f"Secret found: {k}")
    
    # Verify the solution
    if P1 * k == P2:
        print("Verification successful!")
        print(f"flag{{{k}}}")
    else:
        print("Verification failed!")
else:
    print("phi_P1 is zero, trying with y-coordinates...")
    psi_P1 = (y_pP1 / p).lift()
    psi_P2 = (y_pP2 / p).lift()
    if psi_P1 != 0:
        k = (psi_P2 * inverse_mod(psi_P1, p)) % p
        print(f"Secret found: {k}")
        if P1 * k == P2:
            print("Verification successful!")
            print(f"flag{{{k}}}")
        else:
            print("Verification failed!")
    else:
        print("Both phi and psi are zero, attack failed")
