with open('thoroughlyStripped', 'rb') as f:
    data = f.read()

flag_chars = []
i = 0
while i < len(data) - 1:
    if data[i] == 0xbe:
        # The next byte is the character (since we're dealing with ASCII chars < 128)
        if i + 1 < len(data):
            char_byte = data[i + 1]
            # Only consider printable ASCII characters (32-126) and {, } (123, 125)
            if 32 <= char_byte <= 126 or char_byte in (123, 125):
                flag_chars.append(chr(char_byte))
    i += 1

print(''.join(flag_chars))
