import base64
import socket

# Connect to the server and get the Base64 string
def get_base64_data():
    with socket.create_connection(("android-dropper.csaw.io", 3003), timeout=5) as sock:
        # Send a simple HTTP GET request
        request = "GET / HTTP/1.1\r\nHost: android-dropper.csaw.io:3003\r\nConnection: close\r\n\r\n"
        sock.sendall(request.encode())
        response = b""
        while True:
            data = sock.recv(4096)
            if not data:
                break
            response += data
    # Split headers and body
    header_end = response.find(b"\r\n\r\n")
    if header_end == -1:
        raise ValueError("Invalid HTTP response")
    body = response[header_end + 4:]
    # The body should be a single line (Base64 string)
    return body.decode().strip()

# Decode and extract flag
def extract_flag(b64_str):
    decoded = base64.b64decode(b64_str)
    start = 275
    end = 306
    key = 42
    flag_bytes = []
    for i in range(start, end):
        flag_bytes.append(decoded[i] ^ key)
    return bytes(flag_bytes).decode()

if __name__ == "__main__":
    b64_data = get_base64_data()
    flag = extract_flag(b64_data)
    print(f"Flag: {flag}")
end_of_edit

