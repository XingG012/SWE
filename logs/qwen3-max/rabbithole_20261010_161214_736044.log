#!/usr/bin/env python3

import struct

def read_qword(data, offset):
    """Read a 64-bit little-endian integer from data at offset"""
    if offset + 8 > len(data):
        return 0
    return struct.unpack('<Q', data[offset:offset+8])[0]

def read_byte(data, offset):
    """Read a byte from data at offset"""
    if offset >= len(data):
        return 0
    return struct.unpack('<B', data[offset:offset+1])[0]

def find_leaf_char(data, node_vaddr):
    """Find the character in the leaf node starting from node_vaddr"""
    # Convert virtual address to file offset
    # .data section: vaddr 0x256880 -> file offset 0x56880
    # So file_offset = vaddr - 0x256880 + 0x56880 = vaddr - 0x200000
    node_offset = node_vaddr - 0x200000
    
    if node_offset < 0 or node_offset >= len(data):
        return 0
        
    # Read the flag byte (offset 0)
    flag = read_byte(data, node_offset)
    
    if flag != 0:
        # This is a leaf node, return the character at offset 8
        char_val = read_byte(data, node_offset + 8)
        return char_val
    
    # This is an internal node. We need to find which child leads to a leaf.
    # Try left child first
    left_child = read_qword(data, node_offset + 16)
    if left_child != 0:
        try:
            result = find_leaf_char(data, left_child)
            if result != 0:
                return result
        except:
            pass
    
    # Try right child
    right_child = read_qword(data, node_offset + 24)
    if right_child != 0:
        try:
            result = find_leaf_char(data, right_child)
            if result != 0:
                return result
        except:
            pass
    
    return 0

