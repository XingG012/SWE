#!/usr/bin/env python3

import subprocess
import string

def test_input(input_str):
    """Test if the input passes the binary's checks"""
    try:
        # Run the binary with the input
        result = subprocess.run(['./rabbithole'], input=input_str, 
                              capture_output=True, text=True, timeout=1)
        output = result.stdout + result.stderr
        
        # Check if it passed the current position
        # The binary prints "Pass X" for each successful check
        # We need to find the highest pass number
        lines = output.split('\n')
        max_pass = -1
        for line in lines:
            if line.startswith('Pass '):
                try:
                    pass_num = int(line.split()[1])
                    max_pass = max(max_pass, pass_num)
                except:
                    pass
        
        return max_pass
    except:
        return -1

# Build the flag character by character
flag_chars = []
known_prefix = ''

for pos in range(59):
    print(f"Finding character at position {pos}...")
    
    found = False
    # Try printable ASCII characters first
    for c in string.printable:
        test_input_str = known_prefix + c + 'A' * (58 - pos) + '\n'
        max_pass = test_input(test_input_str)
        
        if max_pass >= pos:
            # This character passed at least up to position pos
            flag_chars.append(c)
            known_prefix += c
            found = True
            print(f"Found: '{c}' (ASCII {ord(c)})")
            break
    
    if not found:
        # Try all possible bytes if printable chars don't work
        for c_val in range(256):
            c = chr(c_val)
            test_input_str = known_prefix + c + 'A' * (58 - pos) + '\n'
            max_pass = test_input(test_input_str)
            
            if max_pass >= pos:
                flag_chars.append(c)
                known_prefix += c
                found = True
                print(f"Found: chr({c_val})")
                break
    
    if not found:
        print(f"Could not find character for position {pos}")
        flag_chars.append('?')
        known_prefix += '?'

flag = ''.join(flag_chars)
