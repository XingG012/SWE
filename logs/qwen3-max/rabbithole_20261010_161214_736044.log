#!/usr/bin/env python3

import struct

def read_qword(data, offset):
    """Read a 64-bit little-endian integer from data at offset"""
    return struct.unpack('<Q', data[offset:offset+8])[0]

def read_byte(data, offset):
    """Read a byte from data at offset"""
    return struct.unpack('<B', data[offset:offset+1])[0]

def find_expected_char(data, base_addr, node_addr):
    """Recursively traverse the tree to find the expected character"""
    # Convert virtual address to file offset
    # The .data section starts at virtual address 0x256880 and file offset 0x56880
    data_section_vaddr = 0x256880
    data_section_offset = 0x56880
    
    node_offset = node_addr - data_section_vaddr + data_section_offset
    
    # Read the flag byte (offset 0)
    flag = read_byte(data, node_offset)
    
    if flag != 0:
        # This is a leaf node, return the character at offset 8
        char_val = read_byte(data, node_offset + 8)
        return char_val
    
    # This is an internal node, we need to determine which path to take
    # But since we just want the expected character, we can traverse both paths
    # However, looking at the check_value function, it seems like the tree structure
    # encodes a single expected character per tree, so we should be able to find it
    # by following any path to a leaf.
    
    # Try left child first
    left_child = read_qword(data, node_offset + 16)
    if left_child != 0:
        try:
            return find_expected_char(data, base_addr, left_child)
        except:
            pass
    
    # Try right child
    right_child = read_qword(data, node_offset + 24)
    if right_child != 0:
        try:
            return find_expected_char(data, base_addr, right_child)
        except:
            pass
    
    # If both fail, this might be an error
    raise Exception(f"Could not find leaf node from {node_addr:x}")

# Read the binary file
with open('rabbithole', 'rb') as f:
    data = f.read()

# The roots array starts at virtual address 0x28f900
roots_vaddr = 0x28f900
data_section_vaddr = 0x256880
data_section_offset = 0x56880

roots_offset = roots_vaddr - data_section_vaddr + data_section_offset

flag_chars = []
for i in range(59):  # 0x3b = 59 characters
    # Read the root pointer for this character
    root_ptr = read_qword(data, roots_offset + i * 8)
    if root_ptr == 0:
        # Handle null pointer case
        flag_chars.append(0)
    else:
        try:
            expected_char = find_expected_char(data, 0, root_ptr)
            flag_chars.append(expected_char)
        except Exception as e:
            print(f"Error at position {i}: {e}")
            flag_chars.append(0)

# Convert to string
flag = ''.join(chr(c) for c in flag_chars)
print(f"flag{{{flag}}}")
