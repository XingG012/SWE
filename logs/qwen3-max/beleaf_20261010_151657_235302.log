#!/usr/bin/env python3
import struct

# Open the binary file
with open('beleaf', 'rb') as f:
    # Tree node values start at file offset 0x1020 (each node is 4 bytes)
    f.seek(0x1020)
    tree_data = f.read(512)  # Read 128 nodes (128*4=512 bytes)
    
    # Expected node indices start at file offset 0x14e0 (33 entries, 8 bytes each)
    f.seek(0x14e0)
    indices_data = f.read(33 * 8)

# Extract the flag characters
flag_chars = []
for i in range(33):
    # Read the expected node index (little-endian 64-bit integer)
    idx = struct.unpack('<Q', indices_data[i*8:i*8+8])[0]
    
    # Get the character value from the tree node at this index
    # Each node is 4 bytes (little-endian integer), we only need the low byte
    node_val = struct.unpack('<I', tree_data[idx*4:idx*4+4])[0]
    char = chr(node_val & 0xFF)
    flag_chars.append(char)

flag = ''.join(flag_chars)
print(flag)
end_of_edit

