from sympy import Poly, ZZ
from sympy.abc import x
import numpy as np

# Ciphertext polynomial coefficients (from server output)
ciphertext_coeffs = [
    12, 1, -51, 40, 40, -23, 15, -33, -5, 48, -63, 17, -29, 53, -12,
    -39, -32, 16, -38, -48, -25, -30, -34, -27, -8, -35, 10, -42, -37,
    -6, -11, -52, -8, -2, -63, -7, -20, 60, 29, 28, -15, 55, 29, 16, 44,
    -58, 24, 31, -62, -16, 0, -21, -46, 50, 19, -19, -56, -39, -54, 15,
    -58, 14, -48, 5, 55, -24, 51, 26, -40, 15, 51, 22, 8, -45, -63, -28,
    64, 23, -11, 34, 39, 39, 30, 55, -46, -57, -59, 31, -63, -60, 30,
    -5, 23, 35, -18, -14, 23
]

# Public key polynomial coefficients (from server output)
public_key_coeffs = [
    12, 0, -51, 39, 40, -23, 15, -33, -6, 47, 64, 16, -29, 52, -12,
    -40, -32, 15, -38, -48, -25, -30, -34, -28, -8, -35, 9, -42, -38,
    -7, -12, -52, -8, -3, 64, -8, -20, 59, 29, 28, -15, 55, 28, 15, 44,
    -58, 24, 30, -62, -16, 0, -21, -46, 49, 18, -19, -56, -40, -54, 15,
    -58, 13, -48, 5, 55, -25, 50, 25, -40, 15, 50, 22, 8, -45, 64, -29,
    64, 23, -11, 34, 39, 39, 30, 55, -46, -57, -59, 31, -63, -60, 30,
    -5, 23, 35, -18, -15, 23
]

# Compute message coefficients: message = ciphertext - public_key (mod q)
q = 128
message_coeffs = []
for i in range(len(ciphertext_coeffs)):
    diff = ciphertext_coeffs[i] - public_key_coeffs[i]
    # Ensure the result is in the correct range for p=3
    # Since p=3, message coefficients should be in {-1, 0, 1} or {0, 1, 2}
    # We'll normalize to the range [-1, 1] first
    diff = diff % q
    if diff > q // 2:
        diff = diff - q
    message_coeffs.append(diff)

print("Message coefficients:", message_coeffs)

# Convert message coefficients to bytes
# In NTRU, message is typically encoded as: -1 -> 0, 0 -> 1, 1 -> 2 (or similar)
# But let's check what we actually get
decoded_bytes = []
for coeff in message_coeffs:
    if coeff == -1:
        decoded_bytes.append(0)
    elif coeff == 0:
        decoded_bytes.append(1)
    elif coeff == 1:
        decoded_bytes.append(2)
    else:
        # This shouldn't happen if our assumption is correct
        print(f"Unexpected coefficient: {coeff}")
        decoded_bytes.append(coeff % 3)

# Convert to string
# The password is likely ASCII, so we need to convert from base-3 or similar
# But let's first see what the actual differences are
actual_diffs = [ciphertext_coeffs[i] - public_key_coeffs[i] for i in range(len(ciphertext_coeffs))]
print("Actual differences:", actual_diffs)

# Let's try a different approach: the message might be directly encoded as ASCII values mod 3
# But looking at the differences, they seem to be mostly 0, 1, or -1
non_zero_diffs = [(i, diff) for i, diff in enumerate(actual_diffs) if diff != 0]
print("Non-zero differences:", non_zero_diffs)

# Given that most differences are small, let's assume the message is encoded with 
# coefficients in {-1, 0, 1} and convert accordingly
message_str = ""
for coeff in actual_diffs:
    if coeff == 1:
        message_str += "1"
    elif coeff == -1:
        message_str += "0"  
    elif coeff == 0:
        message_str += "2"
    else:
        # Handle other cases by taking mod 3
        mod_val = coeff % 3
        if mod_val == 0:
            message_str += "0"
        elif mod_val == 1:
            message_str += "1"
        else:
            message_str += "2"

print("Message as ternary string:", message_str)

# Now convert ternary string to bytes
# Group into chunks of appropriate size
def ternary_to_bytes(ternary_str):
    # Convert ternary string to integer
    num = 0
    for digit in ternary_str:
        num = num * 3 + int(digit)
    
    # Convert integer to bytes
    byte_length = (num.bit_length() + 7) // 8
    return num.to_bytes(byte_length, 'big')

try:
    password_bytes = ternary_to_bytes(message_str)
    password = password_bytes.decode('ascii')
    print("Recovered password:", password)
except:
    print("Failed to decode as ASCII")
    print("Raw bytes:", password_bytes.hex())

# Alternative approach: maybe the message coefficients directly represent ASCII values
# Let's check if the non-zero coefficients correspond to printable ASCII
print("\nTrying direct coefficient interpretation:")
direct_chars = []
for coeff in actual_diffs:
    if coeff != 0:
        # Try interpreting as ASCII offset
        ascii_val = coeff + 128  # Shift to positive range
        if 32 <= ascii_val <= 126:
            direct_chars.append(chr(ascii_val))
        else:
            # Try without shift
            if 32 <= coeff <= 126:
                direct_chars.append(chr(coeff))
            else:
                direct_chars.append('?')
    else:
        direct_chars.append('\x00')  # Null byte for zero coefficients

direct_str = ''.join(direct_chars).rstrip('\x00')
print("Direct interpretation:", repr(direct_str))

# Another approach: look at the positions where coefficients differ
print("\nPositions with non-zero differences:")
for pos, diff in non_zero_diffs:
    print(f"Position {pos}: difference = {diff}")
