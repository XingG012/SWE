# So binary_str[0] corresponds to x^96, binary_str[96] corresponds to x^0 (constant term)
# For ASCII, we probably want to read from constant term upward, so reverse the string
binary_str_reversed = binary_str[::-1]
print("Reversed binary string:", binary_str_reversed[:64], "...")

# Convert reversed binary string to bytes
bytes_list = []
for i in range(0, len(binary_str_reversed), 8):
    chunk = binary_str_reversed[i:i+8]
    if len(chunk) < 8:
        chunk = chunk.ljust(8, '0')
    byte_val = int(chunk, 2)
    bytes_list.append(byte_val)

try:
    password = bytes(bytes_list).decode('ascii')
    print("Recovered password:", repr(password))
except UnicodeDecodeError:
    print("Raw bytes:", bytes_list)
    print("Hex:", bytes(bytes_list).hex())

# Let's also try without reversing
bytes_list_normal = []
for i in range(0, len(binary_str), 8):
    chunk = binary_str[i:i+8]
    if len(chunk) < 8:
        chunk = chunk.ljust(8, '0')
    byte_val = int(chunk, 2)
    bytes_list_normal.append(byte_val)

try:
    password_normal = bytes(bytes_list_normal).decode('ascii')
    print("Password (normal order):", repr(password_normal))
except UnicodeDecodeError:
    print("Raw bytes (normal):", bytes_list_normal)
    print("Hex (normal):", bytes(bytes_list_normal).hex())
