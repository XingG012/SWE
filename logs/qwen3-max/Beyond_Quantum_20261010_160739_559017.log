ents:\", message_coeffs)\n\n# Convert message coefficients to bytes\n# In NTRU, message is typically encoded as: -1 -> 0, 0 -> 1, 1 -> 2 (or similar)\n# But let's check what we actually get\ndecoded_bytes = []\nfor coeff in message_coeffs:\n    if coeff == -1:\n        decoded_bytes.append(0)\n    elif coeff == 0:\n        decoded_bytes.append(1)\n    elif coeff == 1:\n        decoded_bytes.append(2)\n    else:\n        # This shouldn't happen if our assumption is correct\n        print(f\"Unexpected coefficient: {coeff}\")\n        decoded_bytes.append(coeff % 3)\n\n# Convert to string\n# The password is likely ASCII, so we need to convert from base-3 or similar\n# But let's first see what the actual differences are\nactual_diffs = [ciphertext_coeffs[i] - public_key_coeffs[i] for i in range(len(ciphertext_coeffs))]\nprint(\"Actual differences:\", actual_diffs)\n\n# Let's try a different approach: the message might be directly encoded as ASCII values mod 3\n# But looking at the differences, they seem to be mostly 0, 1, or -1\nnon_zero_diffs = [(i, diff) for i, diff in enumerate(actual_diffs) if diff != 0]\nprint(\"Non-zero differences:\", non_zero_diffs)\n\n# Given that most differences are small, let's assume the message is encoded with \n# coefficients in {-1, 0, 1} and convert accordingly\nmessage_str = \"\"\nfor coeff in actual_diffs:\n    if coeff == 1:\n        message_str += \"1\"\n    elif coeff == -1:\n        message_str += \"0\"  \n    elif coeff == 0:\n        message_str += \"2\"\n    else:\n        # Handle other cases by taking mod 3\n        mod_val = coeff % 3\n        if mod_val == 0:\n            message_str += \"0\"\n        elif mod_val == 1:\n            message_str += \"1\"\n        else:\n            message_str += \"2\"\n\nprint(\"Message as ternary string:\", message_str)\n\n# Now convert ternary string to bytes\n# Group into chunks of appropriate size\ndef ternary_to_bytes(ternary_str):\n    # Convert ternary string to integer\n    num = 0