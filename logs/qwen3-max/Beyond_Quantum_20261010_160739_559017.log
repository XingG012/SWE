positions = [1, 3, 8, 9, 10, 11, 13, 15, 17, 23, 26, 28, 29, 30, 33, 34, 35, 37, 42, 43, 47, 53, 54, 57, 61, 65, 66, 67, 70, 74, 75, 95]

# Create a binary string of length 97 (N=97)
binary_str = ['0'] * 97
for pos in positions:
    binary_str[pos] = '1'

binary_str = ''.join(binary_str)
print("Binary string:", binary_str)

# Convert binary string to bytes
# Group into 8-bit chunks
bytes_list = []
for i in range(0, len(binary_str), 8):
    chunk = binary_str[i:i+8]
    if len(chunk) < 8:
        chunk = chunk.ljust(8, '0')  # Pad with zeros if necessary
    byte_val = int(chunk, 2)
    bytes_list.append(byte_val)

password = bytes(bytes_list).decode('ascii', errors='ignore')
print("Recovered password:", repr(password))

# Try different groupings in case it's not 8-bit
print("\nTrying different interpretations:")

# Maybe it's a flag format starting with "flag{"
# Let's see what the first few bytes are
first_bytes = bytes_list[:10]
print("First 10 bytes as integers:", first_bytes)
print("First 10 bytes as chars:", [chr(b) if 32 <= b <= 126 else '?' for b in first_bytes])

# Alternative: maybe the binary string represents the password directly
# without padding, so let's try converting the exact binary string
num = int(binary_str, 2)
byte_length = (num.bit_length() + 7) // 8
password_alt = num.to_bytes(byte_length, 'big').decode('ascii', errors='ignore')
print("Alternative password:", repr(password_alt))
