#!/usr/bin/env python3

with open('output', 'r') as f:
    encoded = f.read().strip()

print(f"Encoded string: {encoded}")
print(f"Length: {len(encoded)}")

# Try to see if it's a simple XOR with a key derived from "flag{"
# Assume first 5 chars should be "flag{"
target_start = "flag{"
if len(encoded) >= 5:
    key_candidates = []
    for i in range(5):
        key_byte = ord(encoded[i]) ^ ord(target_start[i])
        key_candidates.append(key_byte)
    print(f"XOR key candidates from first 5 chars: {key_candidates}")
    
    # Try using the first key byte as repeating key
    key = key_candidates[0]
    decoded = ''.join(chr(ord(c) ^ key) for c in encoded)
    print(f"Decoded with key {key}: {decoded}")
    
    # Try using alternating keys (since 2 qubits, maybe key length 2)
    if len(key_candidates) >= 2:
        key1, key2 = key_candidates[0], key_candidates[1]
        decoded_alt = ''
        for i, c in enumerate(encoded):
            if i % 2 == 0:
                decoded_alt += chr(ord(c) ^ key1)
            else:
                decoded_alt += chr(ord(c) ^ key2)
        print(f"Decoded with alternating keys {key1},{key2}: {decoded_alt}")

# Try Caesar cipher shifts
print("\nTrying Caesar cipher shifts...")
for shift in range(1, 26):
    decoded_caesar = ''
    for c in encoded:
        if c.isalpha():
            base = ord('a') if c.islower() else ord('A')
            decoded_caesar += chr((ord(c) - base - shift) % 26 + base)
        else:
            decoded_caesar += c
    if decoded_caesar.startswith('flag{'):
        print(f"Found with shift {shift}: {decoded_caesar}")
        break
else:
    print("No Caesar cipher found starting with 'flag{'")
end_of_edit

