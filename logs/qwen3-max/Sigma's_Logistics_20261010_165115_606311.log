#!/usr/bin/env python3

from pwn import *

# Connect to the server
host = 'mandf.csaw.io'
port = 3000

# Create a list of 30 test inputs (starting with zeros)
inputs = ['0'] * 30

# Connect and send inputs
io = remote(host, port)
print(io.recvline().decode())  # Welcome message
print(io.recvline().decode())  # Instructions

for i, inp in enumerate(inputs):
    print(f"Sending input {i+1}: {inp}")
    io.sendline(inp.encode())
    if i < 29:  # Don't wait for prompt after last input
        print(io.recvline().decode())

# Get final response
final_response = io.recvall(timeout=2).decode()
print("Final response:")
print(final_response)

io.close()
end_of_edit

