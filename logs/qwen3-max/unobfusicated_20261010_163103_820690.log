import subprocess
import re

# Get full disassembly
result = subprocess.run(['objdump', '-d', 'prog'], capture_output=True, text=True)
lines = result.stdout.split('\n')

# Parse XOR checks
checks = []
current_pos = 0
for i, line in enumerate(lines):
    if 'mov' in line and '$0x' in line and ',%eax' in line:
        # Found key load
        key_match = re.search(r'\$0x([0-9a-f]+)', line)
        if key_match:
            key = int(key_match.group(1), 16)
            # Look for the cmp instruction a few lines ahead
            for j in range(i+1, min(i+10, len(lines))):
                if 'cmp' in lines[j] and '$0x' in lines[j]:
                    cmp_match = re.search(r'\$0x([0-9a-f]+)', lines[j])
                    if cmp_match:
                        expected = int(cmp_match.group(1), 16)
                        checks.append((key, expected))
                        break

# Compute password
password = ""
for key, expected in checks:
    char_val = expected ^ key
    password += chr(char_val)

print(password)
