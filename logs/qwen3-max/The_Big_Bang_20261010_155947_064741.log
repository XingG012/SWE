#!/usr/bin/env python3
import socket
import re

# Connect to the server
s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
s.connect(("rev.chal.csaw.io", 5000))

# Receive the initial message
data = s.recv(1024).decode()
print("Received:", data)

# Extract the bit string
bit_string = re.search(r'([01]+)', data).group(1)
MAGIC = len(bit_string)
print(f"MAGIC = {MAGIC}")

# Calculate the target value from the bit string
target_value = int(bit_string, 2)

# Create data with first MAGIC bytes as zeros
first_part = b'\x00' * MAGIC

# Remaining bytes should encode target_value
remaining_bytes = MAGIC**2 - MAGIC
if remaining_bytes > 0:
    # Convert target_value to bytes
    if target_value == 0:
        second_part = b'\x00' * remaining_bytes
    else:
        target_bytes = target_value.to_bytes((target_value.bit_length() + 7) // 8, 'big')
        if len(target_bytes) <= remaining_bytes:
            second_part = b'\x00' * (remaining_bytes - len(target_bytes)) + target_bytes
        else:
            # This shouldn't happen for MAGIC=73
            second_part = target_bytes[-remaining_bytes:]
else:
    second_part = b''

data_bytes = first_part + second_part
data_hex = data_bytes.hex()

s.sendall(data_hex.encode() + b"\n")

# Receive the response
response = s.recv(4096).decode()
print("Response:", response)

s.close()
end_of_edit

