import struct

data = open("rabbithole","rb").read()

e_shoff = struct.unpack_from("<Q", data, 0x28)[0]
e_shentsize = struct.unpack_from("<H", data, 0x3a)[0]
e_shnum = struct.unpack_from("<H", data, 0x3c)[0]
e_shstrndx = struct.unpack_from("<H", data, 0x3e)[0]

sections = []
for i in range(e_shnum):
    off = e_shoff + i*e_shentsize
    sh_name, sh_type, sh_flags, sh_addr, sh_offset, sh_size = struct.unpack_from("<IIQQQQ", data, off)
    sections.append(dict(name=sh_name, type=sh_type, addr=sh_addr, off=sh_offset, size=sh_size))

shstr = sections[e_shstrndx]
strtab = data[shstr["off"]:shstr["off"]+shstr["size"]]

def sec_name(i):
    n = sections[i]["name"]
    end = strtab.find(b"\0", n)
    return strtab[n:end].decode()

for i, s in enumerate(sections):
    s["sname"] = sec_name(i)

def v2o(v):
    for s in sections:
        if s["type"] == 8:
            continue
        if s["addr"] <= v < s["addr"] + s["size"]:
            return s["off"] + (v - s["addr"])
    return None

# relocations
reloc = {}
rd = [s for s in sections if s["sname"] == ".rela.dyn"][0]
for i in range(rd["size"] // 24):
    o, info, addend = struct.unpack_from("<QQq", data, rd["off"] + i*24)
    reloc[o] = addend

def rptr(v):
    if v in reloc:
        return reloc[v]
    return struct.unpack_from("<Q", data, v2o(v))[0]

def rb(v, off=0):
    return data[v2o(v) + off]

ROOTS = 0x28f900
roots = [rptr(ROOTS + 8*i) for i in range(0x3b)]

def walk(addr, c):
    steps = 0
    while True:
        steps += 1
        if steps > 1000:
            return None
        b0 = rb(addr, 0)
        if b0 != 0:
            return rb(addr, 8)
        lo = rb(addr, 8)
        hi = rb(addr, 9)
        if lo <= c < hi:
            addr = rptr(addr + 0x10)
        else:
            addr = rptr(addr + 0x18)

table = []
for i in range(0x3b):
    outs = {}
    for c in range(256):
        o = walk(roots[i], c)
        outs.setdefault(o, []).append(c)
    table.append(outs)
    printable = {o: [c for c in cs if 0x20 <= c < 0x7f] for o, cs in outs.items()}
    printable = {o: cs for o, cs in printable.items() if cs}
    print(i, "outs:", sorted(outs.keys()), "printable:", {k: v[:6] for k, v in sorted(printable.items())})

# find a common bit across all indices
for bit in range(8):
    if all(any((o >> bit) & 1 for o in t) for t in table):
        print("common bit", bit)
        break

flag = []
for i, t in enumerate(table):
    cand = None
    for o in sorted(t):
        if o != 0:
            pcs = [c for c in t[o] if 0x20 <= c < 0x7f]
            if pcs:
                cand = pcs[0]
                break
    if cand is None:
        for o in sorted(t):
            pcs = [c for c in t[o] if 0x20 <= c < 0x7f]
            if pcs:
                cand = pcs[0]
                break
    flag.append(cand)
print("FLAG:", bytes(flag))
end_of_edit

