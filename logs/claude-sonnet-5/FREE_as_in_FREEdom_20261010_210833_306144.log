import re

data = {}
with open("welcome2.r2") as f:
    lines = f.readlines()

for line in lines:
    line = line.strip()
    m = re.match(r'^wx ([0-9a-fA-F]+)@loc\.flag\+(\d+)', line)
    if m:
        hx, off = m.group(1), int(m.group(2))
        data[off] = bytes.fromhex(hx)

out = bytearray()
for off in sorted(data):
    if off > len(out):
        out.extend(b'\x00' * (off - len(out)))
    out.extend(data[off])

with open("stage2.bin", "wb") as f:
    f.write(out)
print(len(out))
print(out[:300])
end_of_edit

