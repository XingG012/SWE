def up(x):
    x = [f"{ord(x[i]) << 1:08b}" for i in range(len(x))]
    return ''.join(x)

def down(x):
    return ''.join('1' if c == '0' else '0' for c in x)

def right(x, d):
    return x[d:] + x[0:d]

def left(x, d):
    return right(x, len(x)-d)[::-1]

def encode(plain):
    d = 24
    x = up(plain)
    x = right(x, d)
    x = down(x)
    x = left(x, d)
    return x

# inverse helpers
def inv_left(y, d):
    # y = left(x,d) = right(x, n-d)[::-1]  => rotate_right_d(x) = y[::-1]
    r = y[::-1]
    return right(r, len(r)-d)

def inv_right(y, d):
    return right(y, len(y)-d)

def inv_up(y):
    chars = [chr(int(y[i:i+8], 2) >> 1) for i in range(0, len(y), 8)]
    return ''.join(chars)

encoded = "1010000011111000101010101000001010100100110110001111111010001000100000101000111011000100101111011001100011011000101011001100100010011001110110001001000010001100101111001110010011001100"

d = 24
x = inv_left(encoded, d)
x = down(x)
x = inv_right(x, d)
plain = inv_up(x)
print("plaintext:", plain)

# sanity check: re-encode
assert encode(plain) == encoded, "roundtrip failed"
print("roundtrip OK")
