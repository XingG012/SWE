import ast
from math import gcd
from functools import reduce
from Crypto.Util.number import long_to_bytes

vals = {}
with open("values.txt") as f:
    for line in f:
        k, v = line.strip().split(":")
        vals[k] = int(v)

ns = [vals["n1"], vals["n2"], vals["n3"], vals["n4"]]
cs = [vals["c1"], vals["c2"], vals["c3"], vals["c4"]]
e = vals["e"]
print("e =", e)
print("bits of n:", [n.bit_length() for n in ns])

# check shared primes
for i in range(len(ns)):
    for j in range(i + 1, len(ns)):
        g = gcd(ns[i], ns[j])
        if g > 1:
            print("shared factor between", i, j, g)

# CRT
def crt(remainders, moduli):
    M = reduce(lambda a, b: a * b, moduli)
    x = 0
    for r, m in zip(remainders, moduli):
        Mi = M // m
        x += r * Mi * pow(Mi, -1, m)
    return x % M, M

x, M = crt(cs, ns)
print("CRT result bits:", x.bit_length(), "M bits:", M.bit_length())

def iroot(k, n):
    lo, hi = 0, 1 << ((n.bit_length() // k) + 2)
    while lo < hi:
        mid = (lo + hi) // 2
        if mid ** k < n:
            lo = mid + 1
        else:
            hi = mid
    return lo

r = iroot(e, x)
print("exact power:", r ** e == x)
print("m as bytes:", long_to_bytes(r))
end_of_edit

