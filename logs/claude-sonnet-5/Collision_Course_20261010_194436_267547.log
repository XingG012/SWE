import csv
import hashlib
import string
import my_aes

# Read the encrypted database
hashed_ids = []
with open('encrypted_database.csv') as fin:
    dictreader = csv.DictReader(fin)
    for row in dictreader:
        hashed_ids.append(row['id'])

print(f"Found {len(hashed_ids)} hashed IDs")
print(f"First few hashed IDs: {hashed_ids[:5]}")

# Try to find the salt by brute force
# Salt is 3 characters from 'abcdefghijklmnopqrstuvwxyz0123456789'
charset = 'abcdefghijklmnopqrstuvwxyz0123456789'

# For each possible salt, try to match all hashed IDs
def try_salt(salt):
    # Build a mapping of hash -> list of possible original IDs
    hash_to_ids = {}
    for id_num in range(1, 501):
        salted_id = str(id_num) + salt
        hashed = hashlib.md5(salted_id.encode()).hexdigest()[:4]
        if hashed not in hash_to_ids:
            hash_to_ids[hashed] = []
        hash_to_ids[hashed].append(id_num)
    
    # Check if all hashed_ids can be found
    found = 0
    for hid in hashed_ids:
        if hid in hash_to_ids:
            found += 1
    
    return found, hash_to_ids

print("\nSearching for salt...")
best_salt = None
best_count = 0
best_mapping = None

# Try all 3-character combinations
for c1 in charset:
    for c2 in charset:
        for c3 in charset:
            salt = c1 + c2 + c3
            count, mapping = try_salt(salt)
            if count > best_count:
                best_count = count
                best_salt = salt
                best_mapping = mapping
                print(f"Salt {salt}: matched {count}/{len(hashed_ids)} hashes")
            
            # If we found a salt that matches all, we're done
            if count == len(hashed_ids):
                print(f"\nFound salt: {salt}")
                break
        if best_count == len(hashed_ids):
            break
    if best_count == len(hashed_ids):
        break

print(f"\nBest salt found: {best_salt} with {best_count}/{len(hashed_ids)} matches")

# Now we need to figure out which specific ID maps to each hash
# Since there might be multiple IDs mapping to the same hash, we need to try different combinations
print("\nAttempting to decrypt with different ID combinations...")

# Try to recover the password by trying all possible combinations
# We'll use a constraint: each ID should appear exactly once
def try_decrypt(password_candidate):
    try:
        result = my_aes.decrypt_from_file(password_candidate, 'password.bin')
        return result.decode()
    except:
        return None

# Simple approach: for each hash, if there's only one possible ID, use it
# Otherwise, we'll need to try combinations
print("\nAnalyzing hash collisions...")
for hid in hashed_ids[:10]:
    if hid in best_mapping:
        print(f"Hash {hid} -> {best_mapping[hid]}")
end_of_edit

