from pwn import *
import math

def query(vals):
    r = remote('mandf.csaw.io', 3000)
    r.recvuntil(b'Enter your input:')
    for v in vals:
        r.sendline(str(v).encode())
        try:
            r.recvuntil(b'Enter your input:', timeout=2)
        except:
            pass
    data = r.recvall(timeout=5)
    r.close()
    return data.decode(errors='replace')

probes = {
    'zeros': [0]*30,
    'ones': [1]*30,
    'neg1': [-1]*30,
    'e0': [1]+[0]*29,
    'e1': [0,1]+[0]*28,
    'neg_e0': [-1]+[0]*29,
    'big_neg': [-1000]*30,
}
for name, v in probes.items():
    print(name, '->', repr(query(v)[-60:]))
end_of_edit

