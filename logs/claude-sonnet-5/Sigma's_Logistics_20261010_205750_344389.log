from pwn import *
import math

def query(vals):
    r = remote('mandf.csaw.io', 3000)
    r.recvuntil(b'Enter your input:')
    for v in vals:
        r.sendline(str(v).encode())
        try:
            r.recvuntil(b'Enter your input:', timeout=2)
        except:
            pass
    data = r.recvall(timeout=5)
    r.close()
    txt = data.decode(errors='replace')
    for line in txt.splitlines():
        line = line.strip()
        try:
            return float(line)
        except:
            continue
    return None

def z_of(p):
    # z = ln(p/(1-p))
    if p <= 0:
        return None
    if p >= 1:
        return None
    return math.log(p/(1-p))

z0 = z_of(query([0]*30))
print('z0 =', z0)
for i in range(30):
    v = [0]*30
    v[i] = 1
    p = query(v)
    z = z_of(p)
    if z is None:
        print(i, 'p=', p, 'z=None')
        w = None
    else:
        w = z - z0
        print(i, 'p=', p, 'z=', z, 'w=', w, 'w+128=', w+128 if w is not None else None)
end_of_edit

