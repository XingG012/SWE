edit 1:1
import string
import numpy as np
from sympy import Matrix

chars = list(" " + string.ascii_lowercase)
MOD = 27

def decrypt_block(inv, block):
    # block: list of 3 ciphertext ints
    vec = Matrix(block)
    res = (inv * vec) % MOD
    return [int(x) % MOD for x in res]

def solve(mat_vals, messages):
    mat = Matrix(3, 3, mat_vals)
    if mat.det() % MOD == 0 or np.gcd(int(mat.det()), MOD) != 1:
        return None
    inv = mat.inv_mod(MOD)
    out = []
    for msg in messages:
        text = ""
        for i in range(0, len(msg), 3):
            block = msg[i:i+3]
            if len(block) < 3:
                continue
            vals = decrypt_block(inv, block)
            for v in vals:
                text += chars[v]
        out.append(text)
    return out

messages = []
with open("messages.txt") as f:
    for line in f:
        line = line.strip()
        if not line:
            continue
        messages.append(eval(line))

candidates = {
    "A [[3,6,8],[9,4,2],[1,5,7]]": [[3,6,8],[9,4,2],[1,5,7]],
    "B [[3,6,9],[8,4,2],[1,5,7]]": [[3,6,9],[8,4,2],[1,5,7]],
    "C [[3,6,2],[8,4,1],[5,7,9]]": [[3,6,2],[8,4,1],[5,7,9]],
}

for name, vals in candidates.items():
    print("=== ", name)
    d = solve(vals, messages)
    if d is None:
        print("  not invertible")
        continue
    for t in d:
        print("  ", repr(t))
end_of_edit

