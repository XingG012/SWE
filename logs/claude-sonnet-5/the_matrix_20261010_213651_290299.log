def mat_inv_mod(mat_vals, mod):
    import itertools
    n = 3
    M = [[mat_vals[i][j] % mod for j in range(n)] for i in range(n)]
    det = 0
    for perm in itertools.permutations(range(n)):
        sign = 1
        for i in range(n):
            for j in range(i+1, n):
                if perm[i] > perm[j]:
                    sign = -sign
        term = sign
        for i in range(n):
            term *= M[i][perm[i]]
        det += term
    det %= mod
    det_inv = pow(det, -1, mod)
    adj = [[0]*n for _ in range(n)]
    for i in range(n):
        for j in range(n):
            minor = [[M[r][c] for c in range(n) if c != j] for r in range(n) if r != i]
            mdet = minor[0][0]*minor[1][1] - minor[0][1]*minor[1][0]
            cof = ((-1) ** (i + j)) * mdet
            adj[j][i] = (cof * det_inv) % mod
    return adj

def solve(mat_vals, messages):
    if gcd(int(Matrix(3,3,[v for row in mat_vals for v in row]).det()), MOD) != 1:
        return None
    inv = mat_inv_mod(mat_vals, MOD)
    out = []
    for msg in messages:
        text = ""
        for i in range(0, len(msg), 3):
            block = msg[i:i+3]
            if len(block) < 3:
                continue
            vals = [sum(inv[r][c] * block[c] for c in range(3)) % MOD for r in range(3)]
            for v in vals:
                text += chars[v]
        out.append(text)
    return out
end_of_edit

