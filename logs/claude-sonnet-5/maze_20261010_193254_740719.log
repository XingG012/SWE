import subprocess
import re

# Base address of FUN_00403eb6
BASE_ADDR = 0x00403eb6

# Direction mappings (digit -> (lVar3, lVar2))
directions = {
    '1': (-2, 1),
    '2': (-1, 2),
    '3': (1, 2),
    '4': (2, 1),
    '5': (2, -1),
    '6': (1, -2),
    '7': (-1, -2),
    '8': (-2, -1)
}

def calculate_next_address(current_addr, digit):
    """Calculate next address based on the digit input"""
    lVar3, lVar2 = directions[digit]
    offset = (lVar3 * 12 + lVar2) * 205
    return current_addr + offset

def is_valid_address(addr):
    """Check if address is in valid range (avoiding RET-only blocks)"""
    # These are the RET-only addresses we saw in the disassembly
    ret_addrs = [
        0x004001da, 0x004002a7, 0x00400374, 0x00400441,
        0x0040050e, 0x004005db, 0x004006a8, 0x00400775,
        0x00400842, 0x0040090f, 0x00400aa9, 0x00400b76,
        0x00400c43, 0x00400d10, 0x00400ddd, 0x00400eaa,
        0x00400f77, 0x00401044, 0x00401111, 0x004011de,
        0x004012ab, 0x00401378, 0x00401445, 0x00401512
    ]
    
    if addr in ret_addrs:
        return False
    
    # Check if address is within reasonable bounds
    if addr < 0x00400000 or addr > 0x00500000:
        return False
    
    return True

def find_path_bfs():
    """Use BFS to find a valid 64-digit path through the maze"""
    from collections import deque
    
    queue = deque()
    # (current_address, path_taken, depth)
    queue.append((BASE_ADDR, "", 0))
    
    visited = set()
    
    while queue:
        curr_addr, path, depth = queue.popleft()
        
        # If we've reached depth 64, we found a solution
        if depth == 64:
            return path
        
        # Avoid revisiting same state
        state = (curr_addr, depth)
        if state in visited:
            continue
        visited.add(state)
        
        # Try each direction
        for digit in '12345678':
            next_addr = calculate_next_address(curr_addr, digit)
            
            if is_valid_address(next_addr):
                queue.append((next_addr, path + digit, depth + 1))
    
    return None

# Find the path
print("Searching for path through maze...")
path = find_path_bfs()

if path:
    print(f"Found path of length {len(path)}:")
    print(path)
else:
    print("No valid path found")
end_of_edit

