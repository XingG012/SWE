import hashlib

target = "7f4986da7d7b52fa81f98278e6ec9dcb"

names = ["aaron", "Aaron", "AARON", "aaron1", "aaron123"]

found = None
for year in range(1950, 2026):
    for month in range(1, 13):
        for day in range(1, 32):
            date = f"{year:04d}{month:02d}{day:02d}"
            for name in names:
                for cand in [name + date, date + name, name.capitalize() + date]:
                    if hashlib.md5(cand.encode()).hexdigest() == target:
                        found = cand
                        print("FOUND:", cand)
                        break
                if found:
                    break
            if found:
                break
        if found:
            break
    if found:
        break

if not found:
    print("not found")
