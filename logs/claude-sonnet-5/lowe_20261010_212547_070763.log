import base64
from gmpy2 import iroot
from Crypto.PublicKey import RSA

pub = RSA.import_key(open("pubkey.pem", "rb").read())
N, e = pub.n, pub.e
print(f"[*] PEM: e={e}, N = {N.bit_length()} bits")

Y = int(open("key.enc").read().strip())
C = base64.b64decode(open("file.enc").read().strip())
print(f"[*] Y = {Y.bit_length()} bits, C = {len(C)} bytes")

# K^3 == Y + N because N^(1/3) < K < (2N)^(1/3) -> N < K^3 < 2N
root, exact = iroot(Y + N, 3)
assert exact, "Y+N not a perfect cube"
K = int(root)
assert K ** 3 == Y + N
print(f"[*] K = {K.bit_length()} bits, cube check OK")

