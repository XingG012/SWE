import base64, itertools
from gmpy2 import iroot
from Crypto.PublicKey import RSA

pub = RSA.import_key(open("pubkey.pem","rb").read())
N, e = pub.n, pub.e
Y = int(open("key.enc").read().strip())
raw = open("file.enc").read().strip()
root, exact = iroot(Y + N, 3)
assert exact and int(root)**3 == Y + N, "cube check failed"
print(f"[*] N {N.bit_length()}b, Y {Y.bit_length()}b, K {int(root).bit_length()}b (cube OK)")

# candidate ciphertext decodings (64 bytes expected)
cands = {}
try:
    cands["b64"] = base64.b64decode(raw)
except Exception as ex:
    print("b64 fail", ex)
try:
    cands["hex"] = bytes.fromhex(raw.decode())
except Exception as ex:
    print("hex fail", ex)
cands["raw"] = raw.encode()
for k, v in cands.items():
    print(f"    cand {k}: {len(v)} bytes")

# candidate keystream encodings of Y
ks_streams = {}
ks_streams["be192"] = Y.to_bytes(192, "big")
ks_streams["le192"] = Y.to_bytes(192, "little")

def score(b):
    # count printable + flag markers
    p = sum(1 for c in b if 32 <= c < 127)
    return p

for cname, C in cands.items():
    for kname, ks in ks_streams.items():
        for off in range(0, len(ks) - len(C) + 1):
            S = bytes(c ^ k for c, k in zip(C, ks[off:off+len(C)]))
            sc = score(S)
            if sc >= len(C) - 2 or b"flag" in S.lower() or b"{" in S:
                print(f"[HIT] C={cname} ks={kname} off={off} score={sc}/{len(C)}")
                print("      ", repr(S))
end_of_edit

