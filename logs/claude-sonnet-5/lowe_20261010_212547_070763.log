import sys
from gmpy2 import iroot

DATA = "deliverables"

# ---- get N from the PEM public key ----
try:
    from Crypto.PublicKey import RSA
    with open(f"{DATA}/pubkey.pem", "rb") as f:
        pub = RSA.import_key(f.read())
    N = pub.n
    e = pub.e
    print(f"[*] Parsed PEM: e={e}, N bits={N.bit_length()}")
except Exception as ex:
    print(f"[!] PyCryptodome failed ({ex}), parsing manually")
    import base64
    der = b""
    with open(f"{DATA}/pubkey.pem", "r") as f:
        lines = f.read().splitlines()
    body = [l for l in lines if not l.startswith("-----")]
    der = base64.b64decode("".join(body))
    # minimal DER walk to pull out INTEGERs
    ints = []
    i = 0
    while i < len(der):
        if der[i] == 0x02:  # INTEGER
            ln = der[i + 1]
            j = i + 2
            if ln & 0x80:
                nb = ln & 0x7f
                ln = int.from_bytes(der[j:j + nb], "big")
                j += nb
            ints.append(int.from_bytes(der[j:j + ln], "big"))
            i = j + ln
        else:
            i += 1
    e, N = ints[0], ints[-1]
    print(f"[*] Manual parse: e={e}, N bits={N.bit_length()}")

# ---- load ciphertext and keystream ----
C = open(f"{DATA}/file.enc", "rb").read()
Y_os = open(f"{DATA}/key.enc", "rb").read()
print(f"[*] file.enc = {len(C)} bytes, key.enc = {len(Y_os)} bytes")

Y = int.from_bytes(Y_os, "big")

# ---- the crux: Y + N is an exact cube, K^3 == Y + N ----
root, exact = iroot(Y + N, 3)
assert exact, "Y+N is not a perfect cube - assumption broken"
K = int(root)
