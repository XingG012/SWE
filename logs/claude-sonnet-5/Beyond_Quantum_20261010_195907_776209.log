from pwn import *
import re
from sympy import Poly, symbols, ZZ
from sympy.parsing.sympy_parser import parse_expr
import numpy as np

context.log_level = 'error'
x = symbols('x')

r = remote("crypto.chal.csaw.io", 5000)
r.recvuntil(b"> ")

# Get ciphertext poly
r.sendline(b"1")
line = r.recvline().decode().strip()
c_poly = parse_expr(line, local_dict={'x': x})
r.recvuntil(b"> ")

# Get public key poly
r.sendline(b"2")
line = r.recvline().decode().strip()
hc_poly = parse_expr(line, local_dict={'x': x})
r.recvuntil(b"> ")

N = 97
q = 128

c_coeffs = Poly(c_poly, x, domain=ZZ).all_coeffs()[::-1]
h_coeffs = Poly(hc_poly, x, domain=ZZ).all_coeffs()[::-1]
c_coeffs = list(c_coeffs) + [0]*(N - len(c_coeffs))
h_coeffs = list(h_coeffs) + [0]*(N - len(h_coeffs))

# m = (c - h) mod q, coefficients should be 0 or 1
m_bits_asc = [(c_coeffs[i] - h_coeffs[i]) % q for i in range(N)]
print("m bits asc:", m_bits_asc[:40])

# Find length
ones = [i for i, v in enumerate(m_bits_asc) if v == 1]
L = max(ones) + 1
print("L =", L)

# input_arr[j] = m_asc[L-1-j]
input_arr = [m_bits_asc[L-1-j] for j in range(L)]
pw = np.packbits(np.array(input_arr).astype(np.uint8)).tobytes()
print("Password:", pw)

r.sendline(b"3 " + pw)
print(r.recvuntil(b"> ", timeout=3).decode(errors='replace'))
r.close()
end_of_edit

