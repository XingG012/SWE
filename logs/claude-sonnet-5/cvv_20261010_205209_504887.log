        if name in msg.lower():
            return luhn_gen(pfx, ln)
    return luhn_gen('4', 16)

s = socket.socket()
s.connect(("cvv", 8000))
s.settimeout(3)

buf = b""
time.sleep(0.5)
try:
    buf += s.recv(8192)
except Exception:
    pass
print(buf.decode(errors='replace'))

