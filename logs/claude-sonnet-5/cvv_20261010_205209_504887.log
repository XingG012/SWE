import socket, re, random, time

def luhn_gen(prefix, length):
    # generate digit that makes Luhn valid
    body = [int(c) for c in prefix]
    while len(body) < length - 1:
        body.append(random.randint(0,9))
    # compute check digit
    digits = body[:]
    # Luhn: double every second digit from right, but we add check digit at end
    total = 0
    # process body as if no check digit; positions from right
    rev = digits[::-1]
    for i, d in enumerate(rev):
        if i % 2 == 0:  # these will be doubled once check digit added
            d *= 2
            if d > 9:
                d -= 9
        total += d
    check = (10 - (total % 10)) % 10
    return ''.join(map(str,digits)) + str(check)

prefixes = {
    'American Express': ('34', 15),
    'Amex': ('34', 15),
    'MasterCard': ('55', 16),
    'Mastercard': ('55', 16),
    'Visa': ('4', 16),
}

def get_card(msg):
    for name,(pfx,ln) in prefixes.items():
        if name.lower() in msg.lower():
            return luhn_gen(pfx, ln)
    return luhn_gen('4', 16)

s = socket.socket()
s.connect(("cvv", 8000))
s.settimeout(5)
buf = b""
def recv_until_question():
    global buf
    while b"?" not in buf.split(b"\n")[-1] and b">" not in buf:
        try:
            data = s.recv(4096)
        except socket.timeout:
            break
        if not data:
            break
        buf += data
        if b"flag{" in buf:
            break
    # return last chunk
    txt = buf.decode(errors='replace')
    return txt

# read initial
time.sleep(0.5)
try:
    buf += s.recv(4096)
except: pass
print(buf.decode(errors='replace'))

for i in range(200):
    txt = buf.decode(errors='replace')
    if 'flag{' in txt:
        m = re.search(r'flag\{[^}]+\}', txt)
        print("FLAG:", m.group(0))
        break
    # find the most recent request
    if 'I need a new' in txt:
        last = txt.split('I need a new')[-1]
        card = get_card('new '+last)
        print("Sending for:", last.strip()[:40], "->", card)
        s.sendall((card + "\n").encode())
        buf = b""
        time.sleep(0.4)
        try:
            while True:
                d = s.recv(4096)
                if not d: break
                buf += d
                if b'>' in buf or b'flag{' in buf: break
        except socket.timeout:
            pass
        print(buf.decode(errors='replace'))
    else:
        time.sleep(0.3)
        try:
            d = s.recv(4096)
            if not d: break
            buf += d
        except: pass

