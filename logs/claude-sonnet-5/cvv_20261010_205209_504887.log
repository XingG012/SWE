    txt = buf.decode(errors='replace')
    m = re.search(r'flag\{[^}]+\}', txt)
    if m:
        print("FLAG:", m.group(0))
        break
    if 'I need a new' in txt:
        last = txt.split('I need a new')[-1]
        card = get_card('new ' + last)
        print("REQ:", last.strip().replace('\n', ' ')[:50], "->", card)
        s.sendall((card + "\n").encode())
        buf = b""
        time.sleep(0.3)
        try:
            while True:
                d = s.recv(8192)
                if not d:
                    break
                buf += d
                if b'flag{' in buf:
                    break
        except Exception:
            pass
        print(buf.decode(errors='replace'))
    else:
        time.sleep(0.3)
        try:
            d = s.recv(8192)
            if not d:
                break
            buf += d
        except Exception:
            pass
