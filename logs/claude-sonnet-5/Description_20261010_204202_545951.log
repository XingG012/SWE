edit 1:1
from pwn import *
from collections import defaultdict, Counter

def check(b, r):
    dic = defaultdict(int)
    for i in range(b):
        dic[b-i-1] = r % b
        r = r // b
    count = Counter(dic.values())
    count = defaultdict(int, count)
    for i,j in dic.items():
        if dic[i] != count[i]:
            return False
    return r == 0

def build(b):
    # self-descriptive number, most-significant digit first
    digits = [0]*b
    digits[0] = b - 4
    digits[1] = 2
    digits[2] = 1
    digits[b-4] = 1
    r = 0
    for d in digits:
        r = r*b + d
    return r

# local sanity check
for b in [2000, 9000, 15000]:
    r = build(b)
    assert check(b, r), f"failed base {b}"
print("[*] local check passed")

r = remote("crypto.chal.csaw.io", 21200)
r.recvuntil(b"base ")
line = r.recvline().decode()
b = int(line.split()[0])
print(f"[*] base = {b}")
val = build(b)
r.sendline(str(val).encode())
print(r.recvall(timeout=10).decode())
end_of_edit

