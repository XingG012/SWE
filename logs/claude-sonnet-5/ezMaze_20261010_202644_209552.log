import struct, zipfile, hashlib
from collections import deque

z = zipfile.ZipFile('maze.pt')
raw = z.read('archive/data/0')
vals = struct.unpack('<%df' % (len(raw)//4), raw)
n = 42
grid = [list(vals[i*n:(i+1)*n]) for i in range(n)]
g = [[int(round(v)) for v in row] for row in grid]

start = end = None
for i in range(n):
    for j in range(n):
        if g[i][j] == 2: start = (i, j)
        if g[i][j] == 3: end = (i, j)
print("start", start, "end", end)

# directions: (dr,dc,char) using A=left,W=up,S=down,D=right
moves = [(-1,0,'W'), (1,0,'S'), (0,-1,'A'), (0,1,'D')]

def passable(i, j):
    return 0 <= i < n and 0 <= j < n and g[i][j] != 1

def bfs(order):
    prev = {start: None}
    pv = {}
    q = deque([start])
    while q:
        cur = q.popleft()
        if cur == end:
            break
        for dr, dc, ch in order:
            ni, nj = cur[0]+dr, cur[1]+dc
            if passable(ni, nj) and (ni, nj) not in prev:
                prev[(ni, nj)] = cur
                pv[(ni, nj)] = ch
                q.append((ni, nj))
    if end not in prev:
        return None
    path = []
    cur = end
    while cur != start:
        path.append(pv[cur])
        cur = prev[cur]
    path.reverse()
    return ''.join(path)

base = [(-1,0,'W'), (1,0,'S'), (0,-1,'A'), (0,1,'D')]
for name, order in [("WASD", base),
                    ("DSAW", [(0,1,'D'),(1,0,'S'),(0,-1,'A'),(-1,0,'W')]),
                    ("updownleftright", [(-1,0,'W'),(1,0,'S'),(0,-1,'A'),(0,1,'D')])]:
    p = bfs(order)
    if p:
        print(name, len(p), p)
        print("md5:", hashlib.md5(p.encode()).hexdigest())
end_of_edit

