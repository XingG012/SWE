import struct, zipfile

z = zipfile.ZipFile('attachment/maze.pt')
raw = z.read('archive/data/0')
vals = struct.unpack('<%df' % (len(raw)//4), raw)
n = 42
for i in range(n):
    row = vals[i*n:(i+1)*n]
    print(''.join(str(int(round(v))) for v in row))
print("unique:", sorted(set(int(round(v)) for v in vals)))
