import base64, re, zipfile
d = zipfile.ZipFile('maze.pt').read('archive/data.pkl')
for m in re.finditer(rb'[A-Za-z0-9+/=]{16,}', d):
    s = m.group()
    try:
        dec = base64.b64decode(s + b'=' * (-len(s) % 4)).decode('utf-8', 'replace')
        if any(c.isalpha() for c in dec):
            print(repr(dec))
    except Exception:
        pass
