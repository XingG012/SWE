import base64, re

with open("assignment.txt") as f:
    lines = f.read().splitlines()

# Find the region of ciphertext blocks: they start around line 8 (index 7) and end before line 143
blocks = []
cur = []
started = False
for i, ln in enumerate(lines):
    stripped = ln.strip()
    if i >= 7 and i <= 142:
        if stripped == "":
            if cur:
                blocks.append("".join(cur))
                cur = []
        else:
            cur.append(stripped)
if cur:
    blocks.append("".join(cur))

print("number of blocks:", len(blocks))
cts = []
for b in blocks:
    try:
        cts.append(base64.b64decode(b))
    except Exception as e:
        print("decode fail", e)
print("number of ciphertexts:", len(cts))
print("lengths:", [len(c) for c in cts])
end_of_edit

