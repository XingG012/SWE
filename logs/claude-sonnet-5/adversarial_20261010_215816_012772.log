import base64, re, string

raw = open("assignment.txt").read()

# The ciphertext region is between the "Problem Text" intro and "Upon further investigation"
end = raw.index("Upon further investigation")
region = raw[:end]

# base64 blocks: sequences of base64 lines (len 76), separated by blank lines
blocks = re.findall(r'(?:[A-Za-z0-9+/=]{16,}\n)+', region)
cts = []
for b in blocks:
    s = "".join(b.split())
    try:
        cts.append(base64.b64decode(s))
    except Exception as e:
        print("fail", e)

print("num blocks:", len(cts))
for i,c in enumerate(cts):
    print(i, len(c), "mod16=", len(c)%16)
end_of_edit

