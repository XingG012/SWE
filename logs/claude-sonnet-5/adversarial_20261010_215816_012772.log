edit 1:1
import base64

with open("assignment.txt") as f:
    lines = f.read().splitlines()

blocks = []
cur = []
for i, ln in enumerate(lines):
    stripped = ln.strip()
    if 7 <= i <= 142:
        if stripped == "":
            if cur:
                blocks.append("".join(cur)); cur = []
        else:
            cur.append(stripped)
if cur:
    blocks.append("".join(cur))

cts = [base64.b64decode(b) for b in blocks]
maxlen = max(len(c) for c in cts)

# printable set including common whitespace
import string
printable = set(bytes(string.printable, "ascii"))

def score(bs):
    return sum(1 for b in bs if b in printable)

keystream = []
for pos in range(maxlen):
    best_k = None
    best_s = -1
    for k in range(256):
        chars = [c[pos] ^ k for c in cts if pos < len(c)]
        s = score(chars)
        if s > best_s:
            best_s = s
            best_k = k
    keystream.append(best_k)

ks = bytes(keystream)

# print recovered plaintexts
for idx, c in enumerate(cts):
    pt = bytes(a ^ b for a, b in zip(c, ks))
    print(f"[{idx}] {pt}")
end_of_edit

