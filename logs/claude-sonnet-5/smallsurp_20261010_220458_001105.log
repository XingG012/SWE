import hashlib, requests, re
from exploit import N, hmac_sha256

BASE = "http://crypto.chal.csaw.io:5000"
users = [l.strip().rstrip(":") for l in open("database.txt") if l.strip()]

s = requests.Session()
A = 2 * N
r = s.post(BASE + "/", data={"username": users[0], "token1": str(A)}, timeout=15)
salt = r.json()["nacl"]
K = hashlib.sha256(b"0").digest()
h = hmac_sha256(K, salt.encode())

for u in users:
    r2 = s.get(BASE + "/dash/" + u, params={"hmac": h}, timeout=15)
    m = re.findall(r"<td>([^<]+)</td>", r2.text)
    print(u, m)
end_of_edit

