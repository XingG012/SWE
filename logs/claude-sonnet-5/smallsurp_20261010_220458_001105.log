import hashlib, requests, sys

BASE = "http://crypto.chal.csaw.io:5000"
N = int("00ab76f585834c3c2b7b7b2c8a04c66571539fa660d39762e338cd8160589f08e3d223744cb7894ea6b424ebab899983ff61136c8315d9d03aef12bd7c0486184945998ff80c8d3d59dcb0196fb2c37c43d9cbff751a0745b9d796bcc155cfd186a3bb4ff6c43be833ff1322693d8f76418a48a51f43d598d78a642072e9fff533", 16)

def xor_data(a, b):
    return bytes(x ^ y for x, y in zip(a, b))

def hmac_sha256(key, message):
    if len(key) > 64:
        key = hashlib.sha256(key).digest()
    if len(key) < 64:
        key += b'\x00' * (64 - len(key))
    o_key_pad = xor_data(b'\x5c' * 64, key)
    i_key_pad = xor_data(b'\x36' * 64, key)
    return hashlib.sha256(o_key_pad + hashlib.sha256(i_key_pad + message).digest()).hexdigest()

user = sys.argv[1] if len(sys.argv) > 1 else "Jere"

s = requests.Session()
A = 2 * N  # accepted, and A % N == 0 => S == 0
r = s.post(BASE + "/", data={"username": user, "token1": str(A)}, timeout=15)
data = r.json()
salt = data["nacl"]
print("salt:", salt)

K = hashlib.sha256(b"0").digest()
h = hmac_sha256(K, salt.encode())
print("computed hmac:", h)

r2 = s.get(BASE + "/dash/" + user, params={"hmac": h}, timeout=15)
print(r2.status_code)
print(r2.text)
end_of_edit

