Now I'll write a minimal DDP client that connects over WebSocket and calls `notes.count` with a given filter. First test: count all notes.

```
edit 1:1
import json, sys
import websocket

URL = "ws://web.chal.csaw.io:5000/websocket"

class DDP:
    def __init__(self, url=URL):
        self.ws = websocket.create_connection(url, timeout=15)
        self._id = 0
        self._recv_until({"server_id": None})

    def _next(self):
        while True:
            raw = self.ws.recv()
            msg = json.loads(raw)
            if msg.get("msg") == "ping":
                self.ws.send(json.dumps({"msg": "pong", "id": msg.get("id")}))
                continue
            yield msg

    def _recv_until(self, predicate):
        for msg in self._next():
            if predicate is None:
                return msg
            if callable(predicate) and predicate(msg):
                return msg
        return None

    def connect(self):
        self.ws.send(json.dumps({"msg": "connect", "version": "1", "support": ["1"]}))
        return self._recv_until(lambda m: m.get("msg") == "connected")

    def call(self, method, params):
        self._id += 1
        mid = str(self._id)
        self.ws.send(json.dumps({"msg": "method", "id": mid, "method": method, "params": params}))
        for msg in self._next():
            if msg.get("msg") == "result" and msg.get("id") == mid:
                return msg
        return None

if __name__ == "__main__":
    d = DDP()
    print("connected:", d.connect())
    print("count all:", d.call("notes.count", [{}]))
end_of_edit
```

