from pwn import *
import sympy
import re

context.log_level = 'error'

def solve(equation):
    # equation like "2 - X = 156"
    lhs, rhs = equation.split('=')
    lhs = lhs.replace('X', 'x').strip()
    rhs = rhs.strip()
    x = sympy.Symbol('x')
    expr = sympy.sympify(lhs) - sympy.sympify(rhs)
    sol = sympy.solve(expr, x)
    return sol[0]

io = remote('misc.chal.csaw.io', 4324)
io.recvuntil(b'What does X equal?:')
count = 0
while True:
    try:
        io.sendline(b'0')
        data = io.recvuntil(b'What does X equal?:', timeout=10)
    except Exception as e:
        print("err", e)
        break
    text = data.decode(errors='replace')
    # find the equation line
    m = re.search(r'([\-0-9XYXx\*\+\/\^\(\) ]+=\s*[\-0-9]+)', text)
    if m:
        eq = m.group(1)
        ans = solve(eq)
        count += 1
        print(count, eq, '->', ans)
        io.sendline(str(ans).encode())
    else:
        print("NO EQ:", repr(text))
        break

io.interactive()
