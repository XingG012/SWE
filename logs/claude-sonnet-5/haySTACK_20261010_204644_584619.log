from pwn import *
import ctypes, time

context.log_level = 'error'
libc = ctypes.CDLL("libc.so.6")

def predict(seed):
    libc.srand(ctypes.c_uint(seed))
    return libc.rand() % 0x100000

p = process("./haySTACK")
now = int(time.time())
# try seeds spanning a wide window, 3 guesses per run isn't enough; use one run and send candidates
cands = set(predict(now+d) for d in range(-2, 3))
print("now", now, "cands", sorted(cands))
for c in sorted(cands):
    p.sendline(str(c).encode())
time.sleep(0.5)
out = p.recvrepeat(3)
print(out.decode(errors="replace"))
end_of_edit

