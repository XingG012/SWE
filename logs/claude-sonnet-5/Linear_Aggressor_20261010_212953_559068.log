from pwn import *

HOST = "android-dropper.csaw.io"
PORT = 3000

def query(vec):
    p = remote(HOST, PORT)
    p.recvuntil(b"input:")
    for v in vec:
        p.sendline(str(v).encode())
    out = p.recvall(timeout=5)
    p.close()
    return int(out.decode().split("Your result is:")[1].strip())

bias = query([0]*30)
print("bias:", bias)

weights = []
for i in range(30):
    v = [0]*30
    v[i] = 1
    w = query(v) - bias
    weights.append(w)
    print(i, w, chr(w) if 32 <= w < 127 else '?')

print("weights:", weights)
