from pwn import *

HOST = "android-dropper.csaw.io"
PORT = 3000

weights = []
for i in range(30):
    p = remote(HOST, PORT)
    p.recvuntil(b"input:")
    for j in range(30):
        p.sendline(str(int(j == i)).encode())
    # collect response lines; final line should be the numeric prediction
    p.recvline()  # blank
    line = p.recvline().strip()
    while line == b"":
        line = p.recvline().strip()
    val = int(line.decode())
    weights.append(val)
    print(f"weight {i}: {val}")
    p.close()

offset = weights[0] - ord('c')
flag = bytearray([w - offset for w in weights]).decode('ascii')
print("FLAG:", flag)
end_of_edit

