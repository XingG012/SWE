# Let's compute what happens when we use all zeros as input
def compute_output_with_zeros(iv_b):
    output = b"\x00" * MAGIC
    for i in range(MAGIC):
        inner = foo(b"\x00"*MAGIC, iv_b[i], K5, K6)
        middle = foo(b"\x00"*MAGIC, inner, K3, K4)  # assuming keys[i] unknown, using 0
        output = foo(output, middle, K1, K2)
    return output

