#!/usr/bin/env python3
from pwn import *

MAGIC = 73

def chunks(lst, n):
    for i in range(0, len(lst), n):
        yield lst[i:i + n]

def iterate(inp, iv):
    out = b''
    for chunk, bit in zip(chunks(inp, MAGIC), iv):
        out += bytes([sum(bit) ^ c for c in chunk])
    return out

# Connect to server
conn = remote('rev.chal.csaw.io', 5000)

# Read the welcome message and random bits
conn.recvuntil(b'random bits : ')
random_bits = conn.recvline().strip().decode()
print(f"Received random bits: {random_bits}")

# Convert random bits to iv_b format
iv_a = [int(b) for b in random_bits]
iv_b = [b"\xff"*MAGIC if b else b"\x00"*MAGIC for b in iv_a]

# We need to find an input that when processed results in keys[0] XOR keys[1] = flag
# The key observation: we need to work backwards from the desired output
# But we don't know the flag yet. Let's try sending a specific pattern.

# Strategy: Send an input that we can trace through the iterations
# Let's try sending all zeros first to see what happens
input_hex = "00" * (MAGIC * MAGIC)

print(f"Sending input (length {len(input_hex)}): {input_hex[:100]}...")
conn.sendlineafter(b'Give me your input : ', input_hex.encode())

# Receive all output
response = conn.recvall(timeout=2)
print(f"Server response:\n{response.decode()}")

conn.close()
end_of_edit

