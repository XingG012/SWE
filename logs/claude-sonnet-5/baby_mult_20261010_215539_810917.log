import sympy

data = open("program.txt").read()
bytes_ = [int(x) for x in data.split(",")]

# Identify constants loaded via "mov qword [rbp-X], imm" and "movabs rax, imm"
# We'll parse manually instead: emulate the imul sequence.

# Constants in load order:
vals = [
    0x4f,
    0x14be74f15,
    4, 3, 0x13, 0x115, 0x77cf4b645b61,
    2, 0x11, 0x21c1, 0x182265e9,
