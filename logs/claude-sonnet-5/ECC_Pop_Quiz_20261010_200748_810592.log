import socket

class remote:
    def __init__(self, host, port):
        self.s = socket.create_connection((host, port))
        self.buf = b""

    def _recv(self, timeout=30):
        self.s.settimeout(timeout)
        try:
            data = self.s.recv(4096)
        except Exception:
            return b""
        if not data:
            return b""
        self.buf += data
        return data

    def recvline(self):
        while b"\n" not in self.buf:
            if not self._recv():
                break
        if b"\n" in self.buf:
            line, self.buf = self.buf.split(b"\n", 1)
            return line + b"\n"
        line, self.buf = self.buf, b""
        return line

    def recvall(self, timeout=15):
        data = self.buf
        self.buf = b""
        self.s.settimeout(timeout)
        while True:
            try:
                chunk = self.s.recv(4096)
            except Exception:
                break
            if not chunk:
                break
            data += chunk
        return data

    def sendline(self, line):
        if isinstance(line, str):
            line = line.encode()
        self.s.sendall(line + b"\n")

    def close(self):
        try:
            self.s.close()
        except Exception:
            pass
end_of_edit

