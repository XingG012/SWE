edit 1:1
import socket
from supercurve import SuperCurve

c = SuperCurve(field=14753, order=7919, a=1, b=-1, g=(1, 1))

s = socket.create_connection(("crypto.chal.csaw.io", 8000), timeout=10)
s.settimeout(15)
buf = b""
while b"Public key: " not in buf:
    buf += s.recv(4096)
line = buf.split(b"Public key: ")[1]
pub = eval(line.split(b"\n")[0].decode())
print("pub =", pub)

# incremental brute force
P = None  # identity
secret = None
for k in range(1, 7919):
    P = c.add(c.g, P) if P is not None else c.g
    if P == pub:
        secret = k
        break
print("secret =", secret)

while b"Asking for secret" not in buf:
    buf += s.recv(4096)
s.sendall(str(secret).encode() + b"\n")
out = b""
try:
    while True:
        d = s.recv(4096)
        if not d:
            break
        out += d
except Exception:
    pass
print("RESPONSE:", out.decode(errors="replace"))
end_of_edit

