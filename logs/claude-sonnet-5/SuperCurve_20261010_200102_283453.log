from pwn import *
from supercurve import SuperCurve

context.log_level = 'error'

c = SuperCurve(field=14753, order=7919, a=1, b=-1, g=(1, 1))

r = remote("crypto.chal.csaw.io", 8000)
r.recvuntil(b"Public key: ")
data = r.recvline().decode().strip()
pub = eval(data)
print("Public key:", pub)

secret = None
for s in range(7919):
    if c.mult(s, c.g) == pub:
        secret = s
        break

print("Recovered secret:", secret)

r.recvuntil(b"Asking for secret")
r.sendline(str(secret).encode())
print(r.recvall(timeout=5).decode())
end_of_edit

