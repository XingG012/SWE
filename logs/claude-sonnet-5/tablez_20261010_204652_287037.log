import struct

# Read the trans_tbl from the ELF file at file offset 0x1280 (510 bytes = 255 pairs)
with open("tablez", "rb") as f:
    f.seek(0x1280)
    tbl = f.read(510)

# Build inverse map: output byte -> input byte
inv = {}
for i in range(255):
    src = tbl[2*i]
    dst = tbl[2*i+1]
    inv[dst] = src

# Target bytes from main (little-endian constants)
target = b""
target += struct.pack("<Q", 0xb1e711f59d73b327)
target += struct.pack("<Q", 0x30f4f9f9b399beb3)
target += struct.pack("<Q", 0xb19965237399711b)
target += struct.pack("<Q", 0xf9279923be111165)
target += struct.pack("<I", 0x65059923)
target += struct.pack("<H", 0x00ce)

print("target len:", len(target))
flag = bytes(inv[b] for b in target)
print("decoded:", flag)
print("flag (37):", flag[:37].decode())
end_of_edit

