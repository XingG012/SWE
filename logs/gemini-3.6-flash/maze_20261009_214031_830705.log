import capstone

with open("maze_public", "rb") as f:
    code = f.read()

# Load address: ELF starts at 0x400000
# ELF header -> entry at 0x400080
# Text section starts at file offset 0x80 (or load address 0x400080)
# Let's verify VA mapping.

# Check Phdrs or just raw offset:
# Address 0x400000 maps to offset 0 in file.
