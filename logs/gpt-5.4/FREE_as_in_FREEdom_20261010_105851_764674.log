import re

data = bytearray()
with open("welcome2.r2", "r", encoding="utf-8") as f:
    for line in f:
        line = line.strip()
        if line.startswith("wx ") and ";s+16" in line:
            hx = line.split()[1].split(";")[0]
            data.extend(bytes.fromhex(hx))

print("blob_len", len(data))

parts = [p.decode("latin1") for p in data.split(b"\x00") if p]
for i, p in enumerate(parts):
    if "loc.flag" in p or "loc.hash" in p or "/tmp/" in p:
        print(i, repr(p))
