import re

hash_init = bytearray()
data = bytearray()
hits = []

with open("welcome2.r2", "r", encoding="utf-8") as f:
    for line in f:
        s = line.rstrip("\n")
        m = re.match(r"# 0x[0-9a-f]+  ((?:[0-9a-f]{4} ){7}[0-9a-f]{4})", s)
        if m:
            hash_init.extend(bytes.fromhex(m.group(1)))
        t = s.strip()
        m = re.match(r"wx ([0-9a-f]+);s\+\d+", t)
        if m:
            data.extend(bytes.fromhex(m.group(1)))
        m = re.match(r"f hit\d+ = (\d+)", t)
        if m:
            hits.append(int(m.group(1)))

print("hash_init", len(hash_init))
print("blob", len(data))
print("hits", len(hits))

for i, off in enumerate(hits):
    end = data.find(b"\x00", off)
    cmd = data[off:end].decode("latin1") if end != -1 else "<no nul>"
    print(i, off, repr(cmd))
end_of_edit
