from fractions import Fraction

def lamb(i, S):
    out = Fraction(1, 1)
    for j in S:
        if j != i:
            out *= Fraction(0 - j, i - j)
    return out

cases = [
    (1, [1,2]),
    (2, [1,2]),
    (1, [1,3]),
    (3, [1,3]),
    (2, [2,3]),
    (3, [2,3]),
]
for i,S in cases:
    print(i, S, lamb(i,S))

print("3-of-3:")
for i in [1,2,3]:
    print(i, lamb(i,[1,2,3]))
end_of_edit

