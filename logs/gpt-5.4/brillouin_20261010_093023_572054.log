from pwn import *
import re

HOST = "crypto.chal.csaw.io"
PORT = 8000

r = remote(HOST, PORT)

data = r.recvuntil(b"what do you want to do? (1) talk to Abe, (2) talk to Bernie, (3) talk to C-money, (4) see the flag\n")
text = data.decode()
print(text)

keys = re.findall(r"([A-Za-z0-9+/]{10,}={0,2})", text)
print("parsed keys:", keys)
# expected order: abe, bernie, chester
abe, bernie, chester = keys[-3], keys[-2], keys[-1]

r.sendline(b"3")
r.recvuntil(b"nervous?\n")
r.sendline(b"this stuff")
line = r.recvline().strip().decode()
print("chester sig:", line)
sig = line

r.recvuntil(b"what do you want to do? (1) talk to Abe, (2) talk to Bernie, (3) talk to C-money, (4) see the flag\n")
r.sendline(b"4")
r.recvuntil(b"gonna have to come up with a valid collective signature\n")
payload = "\n".join([
    abe,
    chester,
    chester,
    "AA==",
    sig,
    sig,
]) + "\n"
print(payload)
r.send(payload.encode())

print(r.recvall(timeout=3).decode(errors="ignore"))
end_of_edit

