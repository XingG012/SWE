        counts[t[i]] += 1
    ndp = {}
    for s, pref in dp.items():
        for c in alphabet:
            ns = s + (n - counts[c])
            if ns > goal:
                continue
            if ns not in ndp:
                ndp[ns] = pref + c
    dp = ndp
    print("after", i, "states", len(dp))

print("found", goal in dp)
if goal in dp:
