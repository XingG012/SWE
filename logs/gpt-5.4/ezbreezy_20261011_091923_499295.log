data = bytes.fromhex("8e94898fa39d87905c9e5b879a5b8b589e5b9a5b8c87955ba5")

def score(bs):
    return sum(32 <= b < 127 for b in bs)

for k in range(256):
    x = bytes(b ^ k for b in data)
    s = x.decode("latin1")
    if "flag{" in s.lower() or "csaw" in s.lower() or score(x) == len(x):
        print("xor", k, repr(s))

for k in range(256):
    x = bytes((b - k) & 0xff for b in data)
    s = x.decode("latin1")
    if "flag{" in s.lower() or "csaw" in s.lower() or score(x) == len(x):
        print("sub", k, repr(s))

for k in range(256):
    x = bytes((b + k) & 0xff for b in data)
    s = x.decode("latin1")
    if "flag{" in s.lower() or "csaw" in s.lower() or score(x) == len(x):
        print("add", k, repr(s))
