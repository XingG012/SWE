from pwn import *
import re
from sympy import symbols, Eq, solve, sympify

HOST = "misc.chal.csaw.io"
PORT = 4324

x = symbols('X')

def to_decimal_string(v):
    try:
        f = float(v)
    except Exception:
        f = float(v.evalf())
    if abs(f - round(f)) < 1e-9:
        return f"{round(f):.1f}"
    s = f"{f:.10f}".rstrip('0')
    if s.endswith('.'):
        s += '0'
    return s

def solve_equation(line):
    m = re.search(r'(.+?)\s*=\s*(.+)', line)
    if not m:
        return None
    left = m.group(1).strip().replace('^', '**')
    right = m.group(2).strip().replace('^', '**')
    left_expr = sympify(left, locals={'X': x})
    right_expr = sympify(right, locals={'X': x})
    sols = solve(Eq(left_expr, right_expr), x)
    if not sols:
        return None
    return to_decimal_string(sols[0])

io = remote(HOST, PORT)
buf = b""

while True:
    try:
        data = io.recvuntil(b": ", timeout=3)
    except EOFError:
        break
    if not data:
        break
    print(data.decode(errors="replace"), end="")
    text = data.decode(errors="replace")
    lines = text.splitlines()
    eq_line = None
    for line in lines:
        if "What does X equal?" not in line and "=" in line and "X" in line:
            eq_line = line.strip()
    if eq_line is None:
        continue
    ans = solve_equation(eq_line)
    if ans is None:
        print("Could not parse equation:", eq_line)
        break
    print(ans)
    io.sendline(ans.encode())

try:
    rest = io.recvall(timeout=2)
    if rest:
        print(rest.decode(errors="replace"), end="")
except EOFError:
    pass
end_of_edit
