import requests
import time
import json
import uuid

BASE = "http://android-dropper.csaw.io:4657"
KEY = "atk_" + uuid.uuid4().hex[:8]
BUY = "GOOBER"
TARGET = "BURPSHARKHAT"

s = requests.Session()

def post(path, data):
    r = s.post(BASE + path, data=data, timeout=5)
    print(path, data, "=>", r.text)
    return r.text

def get(path):
    r = s.get(BASE + path, timeout=5)
    print(path, "=>", r.text)
    return r.text

def status():
    return json.loads(post("/login", {"key": KEY}))

print("KEY", KEY)
get("/listCalls")
print("initial", status())

for i in range(10):
    post("/buy", {"key": KEY, "stock": BUY})

time.sleep(1)
print("after buys", status())

for i in range(5):
    post("/trade", {"key": KEY, "stock": BUY, "stock1": TARGET})

for i in range(10):
    post("/buy", {"key": KEY, "stock": BUY})

time.sleep(2)
print("after trade+throttle", status())
end_of_edit
