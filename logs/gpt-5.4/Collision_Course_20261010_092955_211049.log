import csv
import hashlib
import itertools
import string

import my_aes

ALPHABET = string.ascii_lowercase + string.digits

hashed_ids = []
with open('encrypted_database.csv') as f:
    reader = csv.DictReader(f)
    for row in reader:
        hashed_ids.append(row['id'])

hashed_set = set(hashed_ids)
assert len(hashed_ids) == 500
assert len(hashed_set) == 500

found = None
found_map = None

for salt_tuple in itertools.product(ALPHABET, repeat=3):
    salt = ''.join(salt_tuple)
    mapping = {}
    ok = True
    for i in range(1, 501):
        h = hashlib.md5((str(i) + salt).encode()).hexdigest()[:4]
        if h in mapping:
            ok = False
            break
        mapping[h] = str(i)
    if ok and set(mapping.keys()) == hashed_set:
        found = salt
        found_map = mapping
        print(f'salt={salt}')
        break

assert found is not None, 'salt not found'

password = ''.join(found_map[h] for h in hashed_ids)
print(f'password_length={len(password)}')

pt = my_aes.decrypt_from_file(password, 'password.bin')
print(pt.decode())
end_of_edit
