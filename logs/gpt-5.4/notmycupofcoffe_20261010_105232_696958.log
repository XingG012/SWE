import itertools
import string

TARGET = 870259942
MOD = 2**32
alphabet = string.ascii_uppercase + string.ascii_lowercase + string.digits

def jhash_u32(s):
    h = 0
    for ch in s:
        h = (31 * h + ord(ch)) % MOD
    return h

pow31_3 = pow(31, 3, MOD)

front = {}
for tup in itertools.product(alphabet, repeat=3):
    s = ''.join(tup)
    front[jhash_u32(s)] = s

for tup in itertools.product(alphabet, repeat=3):
    s2 = ''.join(tup)
    h2 = jhash_u32(s2)
    needed = (TARGET - h2) % MOD
    for h1, s1 in front.items():
        if (h1 * pow31_3) % MOD == needed:
            cand = s1 + s2
            if jhash_u32(cand) == TARGET:
                print(cand)
                raise SystemExit

print("not found")
end_of_edit
