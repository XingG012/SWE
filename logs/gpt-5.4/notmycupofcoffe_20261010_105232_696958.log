import itertools
import string

TARGET = 870259942 & 0xffffffff
MOD = 2**32
ALPH = string.ascii_letters + string.digits

def jhash_u32(s):
    h = 0
    for ch in s:
        h = (31 * h + ord(ch)) & 0xffffffff
    return h

pow31_4 = pow(31, 4, MOD)

prefix = {}
for tup in itertools.product(ALPH, repeat=4):
    s = ''.join(tup)
    prefix[jhash_u32(s)] = s

for tup in itertools.product(ALPH, repeat=4):
    s2 = ''.join(tup)
    h2 = jhash_u32(s2)
    need = (TARGET - h2) & 0xffffffff
    inv = pow(pow31_4, -1, MOD)
    h1 = (need * inv) & 0xffffffff
    if h1 in prefix:
        cand = prefix[h1] + s2
        if jhash_u32(cand) == TARGET:
            print(cand)
            break
else:
    print("not found")
end_of_edit
