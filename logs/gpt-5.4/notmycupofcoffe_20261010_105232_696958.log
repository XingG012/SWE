edit 1:1
import string
from functools import lru_cache

TARGET = 870259942 & 0xffffffff
ALPH = string.ascii_letters + string.digits
CODES = [ord(c) for c in ALPH]
INV31 = pow(31, -1, 2**32)
MAXLEN = 12

@lru_cache(None)
def solve(h, depth):
    if depth == 0:
        return "" if h == 0 else None
    for c, code in zip(ALPH, CODES):
        prev = ((h - code) * INV31) & 0xffffffff
        s = solve(prev, depth - 1)
        if s is not None:
            return s + c
    return None

for n in range(1, MAXLEN + 1):
    ans = solve(TARGET, n)
    if ans is not None:
        print(ans)
        break
else:
    print("not found")
end_of_edit
