edit 1:1
#!/usr/bin/env python3
import json
import sys
from websocket import create_connection

URL = "ws://web.chal.csaw.io:5000/sockjs/450/abc/websocket"

def main():
    if len(sys.argv) != 3:
        print(f"usage: {sys.argv[0]} <username> <password>")
        sys.exit(1)

    username, password = sys.argv[1], sys.argv[2]
    ws = create_connection(URL)
    ws.send(json.dumps(["{\"msg\":\"connect\",\"version\":\"1\",\"support\":[\"1\",\"pre2\",\"pre1\"]}"]))
    connected = False
    while True:
        msg = ws.recv()
        if msg == "o":
            continue
        if not msg.startswith("a"):
            continue
        arr = json.loads(msg[1:])
        for item in arr:
            data = json.loads(item)
            print(data)
            if data.get("msg") == "connected" and not connected:
                connected = True
                req = {
                    "msg": "method",
                    "method": "createUser",
                    "params": [{
                        "username": username,
                        "password": password
                    }],
                    "id": "1"
                }
                ws.send(json.dumps([json.dumps(req)]))
            if data.get("msg") == "result" and data.get("id") == "1":
                ws.close()
                return

if __name__ == "__main__":
    main()
end_of_edit
