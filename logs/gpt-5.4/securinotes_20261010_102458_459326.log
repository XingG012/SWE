#!/usr/bin/env python3
import json
import sys
from websocket import create_connection

URL = "ws://web.chal.csaw.io:5000/websocket"

def recv_json(ws):
    while True:
        msg = ws.recv()
        if msg == "o":
            continue
        if msg.startswith("a"):
            arr = json.loads(msg[1:])
            for item in arr:
                data = json.loads(item)
                if data.get("msg") in ("connected", "result", "updated", "nosub", "error"):
                    return data

def main():
    if len(sys.argv) != 2:
        print(f"usage: {sys.argv[0]} '<json_filter>'")
        sys.exit(1)

    filt = json.loads(sys.argv[1])
    ws = create_connection(URL)
    ws.send(json.dumps(["{\"msg\":\"connect\",\"version\":\"1\",\"support\":[\"1\",\"pre2\",\"pre1\"]}"]))
    print(recv_json(ws))
    ws.send(json.dumps([json.dumps({
        "msg": "method",
        "method": "notes.count",
        "params": [filt],
        "id": "1"
    })]))
    while True:
        data = recv_json(ws)
        print(data)
        if data.get("msg") == "result" and data.get("id") == "1":
            break
    ws.close()

if __name__ == "__main__":
    main()
