import hashlib
from datetime import date, timedelta

target = "7f4986da7d7b52fa81f98278e6ec9dcb"

patterns = [
    lambda n, d: f"{n}{d}",
    lambda n, d: f"{n.lower()}{d}",
    lambda n, d: f"{n.upper()}{d}",
    lambda n, d: f"{n.capitalize()}{d}",
    lambda n, d: f"{d}{n}",
    lambda n, d: f"{d}{n.lower()}",
    lambda n, d: f"{n}_{d}",
    lambda n, d: f"{n.lower()}_{d}",
]

start = date(1940, 1, 1)
end = date(2021, 12, 31)
cur = start

while cur <= end:
    d = cur.strftime("%Y%m%d")
    for name in ["Aaron", "aaron"]:
        for pat in patterns:
            s = pat(name, d)
            if hashlib.md5(s.encode()).hexdigest() == target:
                print(s)
    cur += timedelta(days=1)
end_of_edit

