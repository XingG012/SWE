import base64
import string

data = open("assignment.txt").read().splitlines()

blocks = []
cur = []
for line in data:
    line = line.strip()
    if not line:
        if cur:
            blocks.append("".join(cur))
            cur = []
        continue
    if set(line) <= set("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/="):
        if len(line) > 20 and not line.startswith("#!"):
            cur.append(line)
if cur:
    blocks.append("".join(cur))

cts = [base64.b64decode(b) for b in blocks]

print("count", len(cts))
for i, c in enumerate(cts):
    print(i, len(c))

maxlen = max(len(c) for c in cts)
votes = [[0] * len(c) for c in cts]

for i in range(len(cts)):
    for j in range(len(cts)):
        if i == j:
            continue
        x = bytes(a ^ b for a, b in zip(cts[i], cts[j]))
        for k, ch in enumerate(x):
            if chr(ch) in string.ascii_letters:
                votes[i][k] += 1

key = [None] * maxlen
threshold = max(1, len(cts) // 2)
for i, c in enumerate(cts):
    for k in range(len(c)):
        if votes[i][k] >= threshold:
            key[k] = c[k] ^ 0x20

for i, c in enumerate(cts):
    out = []
    for k, ch in enumerate(c):
        if key[k] is None:
            out.append("*")
        else:
            p = ch ^ key[k]
            if 32 <= p <= 126 or p in (9, 10, 13):
                out.append(chr(p))
            else:
                out.append("?")
    print(i, "".join(out))
end_of_edit
