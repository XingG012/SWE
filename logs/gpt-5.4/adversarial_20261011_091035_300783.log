import base64

data = open("assignment.txt").read().splitlines()

blocks = []
cur = []
for line in data:
    line = line.strip()
    if not line:
        if cur:
            blocks.append("".join(cur))
            cur = []
        continue
    if set(line) <= set("ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/="):
        if len(line) > 20 and not line.startswith("#!"):
            cur.append(line)
if cur:
    blocks.append("".join(cur))

cts = [base64.b64decode(b) for b in blocks]

print("count", len(cts))
for i, c in enumerate(cts):
    print(i, len(c))
