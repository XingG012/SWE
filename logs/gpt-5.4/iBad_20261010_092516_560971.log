import requests
from urllib.parse import unquote

BASE = "http://crypto.chal.csaw.io:8000"
seen = {}
for i in range(500):
    s = requests.Session()
    s.post(BASE + "/login", data={"username": "admin"}, allow_redirects=False, timeout=10)
    c = unquote(s.cookies.get("auth"))
    nonce = c.split(".")[1]
    if nonce in seen:
        print("duplicate nonce", i, seen[nonce], nonce)
        break
    seen[nonce] = i
else:
    print("no duplicates")
