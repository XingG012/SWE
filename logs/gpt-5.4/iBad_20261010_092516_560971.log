import base64
import requests
from urllib.parse import unquote

BASE = "http://crypto.chal.csaw.io:8000"

def login(u):
    s = requests.Session()
    s.post(BASE + "/login", data={"username": u}, allow_redirects=False, timeout=10)
    c = unquote(s.cookies.get("auth"))
    print("raw cookie:", repr(c))
    parts = c.split(".")
    print("parts:", len(parts), [len(x) for x in parts])
    tag, nonce, ct = parts
    ctb = base64.b64decode(ct + "=" * (-len(ct) % 4))
    print("username len:", len(u), "ciphertext len:", len(ctb))
    print("blocks:", [ctb[i:i+16].hex() for i in range(0, len(ctb), 16)])

for n in [0,1,2,3,4,5,8,12,16,24,32]:
    login("A"*n)
end_of_edit
