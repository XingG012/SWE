DISCUSSION
I'll write a script to collect many cookies and use the fact that for each login the plaintext is `A*n + b"|regular|" + flag`. While nonces differ, this lets us infer the flag length and test whether any accidental nonce reuse occurs across different lengths; if one does, the flag falls immediately. If not, I'll at least automate the collection for deeper analysis.
COMMAND
edit 1:1
import base64
from urllib.parse import unquote
import requests

BASE = "http://crypto.chal.csaw.io:8000"
flag_len = 51 - 9

seen = {}
for n in range(0, 80):
    s = requests.Session()
    s.post(BASE + "/login", data={"username": "A"*n}, allow_redirects=False, timeout=10)
    auth = unquote(s.cookies.get("auth"))
    tag, nonce, ct = auth.split(".")
    ctb = base64.b64decode(ct + "=" * (-len(ct) % 4))
    pt = b"A"*n + b"|regular|"
    print(n, nonce, len(ctb))
    if nonce in seen:
        pn, pct, ppt = seen[nonce]
        x = bytes(a ^ b for a, b in zip(ctb, pct))
        print("NONCE REUSE!", n, pn)
        print("ct_xor:", x.hex())
        print("pt_xor_known_prefix:", bytes(a ^ b for a, b in zip(pt, ppt)).hex())
        break
    seen[nonce] = (n, ctb, pt)
else:
    print("no reuse found")
end_of_edit
