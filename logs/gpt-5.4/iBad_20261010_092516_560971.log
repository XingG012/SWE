I'll write a helper that logs in with chosen usernames, parses the auth cookie, and prints plaintext length and block structure so we can see whether a simple known-plaintext/keystream recovery across varying usernames is enough to expose the whole flag.
COMMAND
edit 1:1
import base64
import requests

BASE = "http://crypto.chal.csaw.io:8000"

def login(u):
    s = requests.Session()
    r = s.post(BASE + "/login", data={"username": u}, allow_redirects=False, timeout=10)
    c = s.cookies.get("auth")
    tag, nonce, ct = c.split(".")
    ctb = base64.b64decode(ct)
    print("username len:", len(u), "ciphertext len:", len(ctb))
    print("blocks:", [ctb[i:i+16].hex() for i in range(0, len(ctb), 16)])

for n in [0,1,2,3,4,5,8,12,16,24,32]:
    login("A"*n)
end_of_edit
