import base64
import requests

URL = "http://crypto.chal.csaw.io:8000/profile"
BLOCK = 16

session = requests.Session()

def cookie(iv, c):
    return {"auth": f"{base64.b64encode(iv).decode()}.{base64.b64encode(c).decode()}"}

def oracle(iv, c):
    r = session.get(URL, cookies=cookie(iv, c), allow_redirects=False, timeout=10)
    return r.status_code != 500

def recover_intermediate(c):
    iv = bytearray(BLOCK)
    interm = [0] * BLOCK
    for pad in range(1, BLOCK + 1):
        idx = BLOCK - pad
        for j in range(idx + 1, BLOCK):
            iv[j] = interm[j] ^ pad
        found = None
