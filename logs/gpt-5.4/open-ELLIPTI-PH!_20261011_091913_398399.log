    d = hashlib.md5(d + password + salt).digest()
    out += d

key = out[:32]
iv = out[32:48]
pt = AES.new(key, AES.MODE_CBC, iv).decrypt(ct)
pad = pt[-1]
pt = pt[:-pad]
print(pt.decode())
