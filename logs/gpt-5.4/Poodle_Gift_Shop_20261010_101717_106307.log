from pwn import *
from base64 import b64encode, b64decode

HOST = "crypto.chal.csaw.io"
PORT = 6000
BS = 16

context.log_level = "error"


def recv_menu(r):
    return r.recvuntil(b"> ")


def get_ciphertext():
    r = remote(HOST, PORT)
    recv_menu(r)
    r.sendline(b"1")
    r.recvuntil(b"What type of canine would you like to purchase?")
    r.recvuntil(b"> ")
    r.sendline(b"poodle")
    r.recvuntil(b"How many would you like to purchase? (We have unlimited supplies...)")
    r.recvuntil(b"> ")
    r.sendline(b"1")
    out = r.recvuntil(b"Enter your selection:")
    r.close()

    text = out.decode(errors="ignore")
    marker = "A plane flies overhead flying a banner that reads: b'"
    if marker in text:
        s = text.split(marker, 1)[1].split("'", 1)[0]
        return s.encode()
    raise Exception("ciphertext not found")


def oracle(ct_b64):
    r = remote(HOST, PORT)
    recv_menu(r)
    r.sendline(b"2")
    r.recvuntil(b"Enter the base64-encoded ciphertext to decrypt:")
    r.recvuntil(b"> ")
    r.sendline(ct_b64)
    out = r.recvuntil(b"Enter your selection:")
    r.close()
    txt = out.decode(errors="ignore")
    if "Something went wrong during decryption. Try again?" in txt:
        return True
    if "Something went wrong......try again?" in txt:
        return False
    if "Valid plaintext" in txt:
        return True
    return False


def decrypt_block(prev_block, block):
    recovered = [0] * BS
    intermediate = [0] * BS
    prefix = bytearray(prev_block)

    for pad in range(1, BS + 1):
        idx = BS - pad

        for j in range(BS - 1, idx, -1):
            prefix[j] = intermediate[j] ^ pad

        found = None
        for guess in range(256):
            prefix[idx] = guess
            test = b64encode(bytes(prefix) + block)
            if oracle(test):
                if pad == 1 and idx > 0:
                    prefix2 = bytearray(prefix)
                    prefix2[idx - 1] ^= 1
                    if not oracle(b64encode(bytes(prefix2) + block)):
                        continue
                found = guess
                break

        if found is None:
            raise Exception(f"failed at byte {idx}")

        intermediate[idx] = found ^ pad
        recovered[idx] = intermediate[idx] ^ prev_block[idx]

    return bytes(recovered)


def main():
    ct_b64 = get_ciphertext()
    ct = b64decode(ct_b64)
    print(f"ciphertext_len={len(ct)}")
    blocks = [ct[i:i+BS] for i in range(0, len(ct), BS)]

    pt = b""
    for i in range(1, len(blocks)):
        print(f"decrypting block {i}/{len(blocks)-1}")
        pt += decrypt_block(blocks[i-1], blocks[i])
        print(pt)

    print("PLAINTEXT_HEX:", pt.hex())
    print("PLAINTEXT_RAW:", pt)


if __name__ == "__main__":
    main()
end_of_edit

