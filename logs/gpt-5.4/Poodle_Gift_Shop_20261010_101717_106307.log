55:def decrypt_block(prev_block, block):
56:    recovered = [0] * BS
57:    intermediate = [0] * BS
58:    prefix = bytearray(prev_block)
59:
60:    for pad in range(1, BS + 1):
61:        idx = BS - pad
62:
63:        for j in range(BS - 1, idx, -1):
64:            prefix[j] = intermediate[j] ^ pad
65:
66:        found = None
67:        for guess in range(256):
68:            prefix[idx] = guess
69:            test = b64encode(bytes(prefix) + block)
70:            if oracle(test):
71:                if pad == 1 and idx > 0:
72:                    prefix2 = bytearray(prefix)
73:                    prefix2[idx - 1] ^= 1
74:                    if not oracle(b64encode(bytes(prefix2) + block)):
75:                        continue
76:                found = guess
77:                break
78:
79:        if found is None:
80:            raise Exception(f"failed at byte {idx}")
81:
82:        intermediate[idx] = found ^ pad
83:        recovered[idx] = intermediate[idx] ^ prev_block[idx]
84:
85:    return bytes(recovered)
86:
