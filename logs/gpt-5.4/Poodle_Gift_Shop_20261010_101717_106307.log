from pwn import *
from binascii import unhexlify, hexlify

HOST = "crypto.chal.csaw.io"
PORT = 6000
BS = 16

context.log_level = "error"


def recv_menu(r):
    return r.recvuntil(b"> ")


def get_ciphertext():
    r = remote(HOST, PORT)
    data = recv_menu(r)
    r.sendline(b"1")
    out = r.recvuntil(b"> ")
    r.close()

    text = out.decode(errors="ignore")
    for line in text.splitlines():
        line = line.strip()
        if all(c in "0123456789abcdefABCDEF" for c in line) and len(line) >= 32 and len(line) % 32 == 0:
            return bytes.fromhex(line)
    raise Exception("ciphertext not found")


def oracle(ct):
    r = remote(HOST, PORT)
    recv_menu(r)
    r.sendline(b"2")
    r.recvuntil(b"Enter the ciphertext:\n")
    r.sendline(hexlify(ct))
    out = r.recvrepeat(0.4)
    r.close()
    txt = out.decode(errors="ignore")
    if "invalid hmac" in txt.lower():
        return True
    if "invalid padding" in txt.lower():
        return False
    if "success" in txt.lower():
        return True
    return False


def decrypt_block(prev_block, block):
    recovered = [0] * BS
    intermediate = [0] * BS
    prefix = bytearray(prev_block)

    for pad in range(1, BS + 1):
        idx = BS - pad

        for j in range(BS - 1, idx, -1):
            prefix[j] = intermediate[j] ^ pad

        found = None
        for guess in range(256):
            prefix[idx] = guess

            test = bytes(prefix) + block
            if oracle(test):
                if pad == 1:
                    prefix2 = bytearray(prefix)
                    prefix2[idx - 1] ^= 1
                    if not oracle(bytes(prefix2) + block):
                        continue
                found = guess
                break

        if found is None:
            raise Exception(f"failed at byte {idx}")

        intermediate[idx] = found ^ pad
        recovered[idx] = intermediate[idx] ^ prev_block[idx]

    return bytes(recovered)


def main():
    ct = get_ciphertext()
    print(f"ciphertext_len={len(ct)}")
    blocks = [ct[i:i+BS] for i in range(0, len(ct), BS)]

    pt = b""
    for i in range(1, len(blocks)):
        print(f"decrypting block {i}/{len(blocks)-1}")
        pt += decrypt_block(blocks[i-1], blocks[i])
        print(pt)

    print("PLAINTEXT_HEX:", pt.hex())
    print("PLAINTEXT_RAW:", pt)


if __name__ == "__main__":
    main()
end_of_edit

