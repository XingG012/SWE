36:def oracle(ct_b64):
37:    r = remote(HOST, PORT)
38:    recv_menu(r)
39:    r.sendline(b"2")
40:    r.recvuntil(b"Enter the base64-encoded ciphertext to decrypt:")
41:    r.recvuntil(b"> ")
42:    r.sendline(ct_b64)
43:    out = r.recvuntil(b"Enter your selection:")
44:    r.close()
45:    txt = out.decode(errors="ignore")
46:    if "Something went wrong during decryption. Try again?" in txt:
47:        return True
48:    if "Something went wrong......try again?" in txt:
49:        return False
50:    if "Valid plaintext" in txt:
51:        return True
52:    return False
