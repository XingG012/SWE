def solve_smart(p, a, b, x1, y1, x2, y2):
    sage_code = f"""
p = {p}
a = {a}
b = {b}
x1 = {x1}
y1 = {y1}
x2 = {x2}
y2 = {y2}

def attack(p, a, b, P, Q):
    E = EllipticCurve(GF(p), [a, b])
    assert E.order() == p
    Ep = EllipticCurve(Qp(p, 2), [ZZ(a) + randint(0, p) * p, ZZ(b) + randint(0, p) * p])

    Px, Py = P.xy()
    Qx, Qy = Q.xy()

    P_lift = None
    for cand in Ep.lift_x(ZZ(Px), all=True):
        if GF(p)(cand[1]) == Py:
            P_lift = cand
            break

    Q_lift = None
    for cand in Ep.lift_x(ZZ(Qx), all=True):
        if GF(p)(cand[1]) == Qy:
            Q_lift = cand
            break

    pP = p * P_lift
    pQ = p * Q_lift
    phiP = -(pP[0] / pP[1])
    phiQ = -(pQ[0] / pQ[1])
    return ZZ(GF(p)(phiQ / phiP))

E = EllipticCurve(GF(p), [a, b])
P = E(x1, y1)
Q = E(x2, y2)
print(attack(p, a, b, P, Q))
"""
    with tempfile.NamedTemporaryFile("w", suffix=".sage", delete=False) as f:
        f.write(sage_code)
        name = f.name
    out = subprocess.check_output(["sage", name], text=True)
    return out.strip().splitlines()[-1].strip()
