from pwn import remote
import re
import subprocess
import tempfile
import json

HOST = "crypto.chal.csaw.io"
PORT = 5000

def recv_until_question(r):
    data = b""
    while b"What is the value of 'secret'?" not in data and b"flag{" not in data and b"CSAW{" not in data:
        chunk = r.recv(timeout=2)
        if not chunk:
            break
        data += chunk
    return data.decode()

def parse_part1(text):
    p = int(re.search(r"p = (\\d+)", text).group(1))
    a = int(re.search(r"a = (\\d+)", text).group(1))
    b = int(re.search(r"b = (\\d+)", text).group(1))
    x1, y1 = map(int, re.search(r"P1: \\((\\d+) : (\\d+) : 1\\)", text).groups())
    x2, y2 = map(int, re.search(r"P2: \\((\\d+) : (\\d+) : 1\\)", text).groups())
    return p, a, b, x1, y1, x2, y2

def solve_smart(p, a, b, x1, y1, x2, y2):
    sage_code = f"""
p = {p}
a = {a}
b = {b}
x1 = {x1}
y1 = {y1}
x2 = {x2}
y2 = {y2}

def lift_point(EQp, x, y, p):
    for P in EQp.lift_x(ZZ(x), all=True):
        if GF(p)(P[1]) == GF(p)(y):
            return P
    raise ValueError("lift failed")

EQp = EllipticCurve(Qp(p, 2), [ZZ(a), ZZ(b)])
P1 = lift_point(EQp, x1, y1, p)
P2 = lift_point(EQp, x2, y2, p)
pP1 = p * P1
pP2 = p * P2
phi1 = -(pP1[0] / pP1[1])
phi2 = -(pP2[0] / pP2[1])
print(ZZ(phi2 / phi1))
"""
    with tempfile.NamedTemporaryFile("w", suffix=".sage", delete=False) as f:
        f.write(sage_code)
        name = f.name
    out = subprocess.check_output(["sage", name], text=True)
    return out.strip().splitlines()[-1].strip()

r = remote(HOST, PORT)
r.sendline(b"")
text = recv_until_question(r)
if "What is the value of 'secret'?" not in text:
    r.sendline(b"")
    text += recv_until_question(r)
print(text)

p, a, b, x1, y1, x2, y2 = parse_part1(text)
ans1 = solve_smart(p, a, b, x1, y1, x2, y2)
print("ANS1 =", ans1)
r.sendline(ans1.encode())

more = b""
while True:
    chunk = r.recv(timeout=2)
    if not chunk:
        break
    more += chunk
print(more.decode(errors="ignore"))
end_of_edit
