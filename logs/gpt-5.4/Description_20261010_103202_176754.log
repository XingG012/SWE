from collections import defaultdict, Counter

def check(b, r):
    dic = defaultdict(int)
    for i in range(b):
        dic[b-i-1] = r % b
        r = r // b
    count = Counter(dic.values())
    count = defaultdict(int, count)
    for i, j in dic.items():
        if dic[i] != count[i]:
            return False
    return r == 0

def build(b):
    digits = [0] * b
    digits[0] = b - 4
    digits[1] = 2
    digits[2] = 1
    digits[b - 4] = 1
    r = 0
    for d in digits:
        r = r * b + d
    return r

if __name__ == "__main__":
    for b in [7, 10, 2000]:
        r = build(b)
        print(b, check(b, r), r)
end_of_edit
