from pwn import *
import re

HOST = "misc.chal.csaw.io"
PORT = 8000"

def even_parity_ok(bits8, parity_bit):
    ones = sum(int(b) for b in bits8) + int(parity_bit)
    return ones % 2 == 0

def decode_lsb_first(bits8):
    val = 0
    for i, b in enumerate(bits8):
        val |= (int(b) << i)
    return val

def main():
    r = remote(HOST, PORT)
    data = b""
    text = ""

    while True:
        line = r.recvline(timeout=5)
        if not line:
            break
        s = line.decode(errors="ignore").strip()
        if not s:
            continue
        if re.fullmatch(r"[01]{11}", s):
            start = s[0]
            bits8 = s[1:9]
            parity = s[9]
            stop = s[10]
            if start != "0" or stop != "1" or not even_parity_ok(bits8, parity):
                r.sendline(b"0")
                continue
            ch = decode_lsb_first(bits8)
            data += bytes([ch])
            text = data.decode(errors="ignore")
            print(repr(text))
            r.sendline(b"1")
            m = re.search(r"flag\{[^}]+\}", text)
            if m:
                print(m.group(0))
                break
        else:
            print(s)

    r.close()

if __name__ == "__main__":
    main()
end_of_edit
