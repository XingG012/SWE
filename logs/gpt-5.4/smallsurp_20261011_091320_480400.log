from Crypto.Cipher import AES
from Crypto.Util.Padding import unpad
from hashlib import sha256

shares = []
for line in open("shares.txt"):
    _, x, y, bits = line.strip().split(":")
    shares.append((int(x), int(y, 16)))

mode, iv_hex, ct_hex = open("encrypted.txt").read().strip().split(":")
iv = bytes.fromhex(iv_hex)
ct = bytes.fromhex(ct_hex)

primes = [
    2**128 - 159,
    340282366920938463463374607431768211283,
    340282366920938463463374607431768211297,
    340282366920938463463374607431768211319,
]

def lagrange_at_zero(points, p):
    total = 0
    for i, (xi, yi) in enumerate(points):
        num = 1
        den = 1
        for j, (xj, yj) in enumerate(points):
            if i == j:
                continue
            num = (num * (-xj)) % p
            den = (den * (xi - xj)) % p
        total = (total + yi * num * pow(den, -1, p)) % p
    return total

def try_dec(key_bytes, label):
    for k in [key_bytes, sha256(key_bytes).digest()[:16], sha256(key_bytes).digest(), sha256(key_bytes).digest()[:32]]:
        if len(k) not in (16, 24, 32):
            continue
        try:
            pt = AES.new(k, AES.MODE_CBC, iv).decrypt(ct)
            try:
                pt = unpad(pt, 16)
            except:
                pass
            if all(9 <= b < 127 or b in (10, 13) for b in pt):
                print(label, len(k), pt)
        except:
            pass

for p in primes:
    try:
        s = lagrange_at_zero(shares, p)
    except ValueError:
        continue
    kb = s.to_bytes(16, "big", signed=False)
    print("prime", p, "secret", hex(s))
    try_dec(kb, f"p={p}")
end_of_edit
