from Crypto.Cipher import AES
from Crypto.Util.Padding import unpad
from hashlib import sha256

shares = []
for line in open("shares.txt"):
    _, x, y, bits = line.strip().split(":")
    shares.append((int(x), int(y, 16)))

mode, iv_hex, ct_hex = open("encrypted.txt").read().strip().split(":")
iv = bytes.fromhex(iv_hex)
ct = bytes.fromhex(ct_hex)

RED = 0x100000000000000000000000000000087

def gf_mul(a, b):
    r = 0
    while b:
        if b & 1:
            r ^= a
        b >>= 1
        a <<= 1
        if a >> 128:
            a ^= RED
    return r & ((1 << 128) - 1)

def gf_pow(a, e):
    r = 1
    while e:
        if e & 1:
            r = gf_mul(r, a)
        a = gf_mul(a, a)
        e >>= 1
    return r

def gf_inv(a):
    return gf_pow(a, (1 << 128) - 2)

def lagrange0(points):
    out = 0
    for i, (xi, yi) in enumerate(points):
        num = 1
        den = 1
        for j, (xj, yj) in enumerate(points):
            if i == j:
                continue
            num = gf_mul(num, xj)
            den = gf_mul(den, xi ^ xj)
        out ^= gf_mul(yi, gf_mul(num, gf_inv(den)))
    return out

def try_dec(kb):
    cands = [kb, sha256(kb).digest()[:16], sha256(kb).digest(), sha256(kb).digest()[:32]]
    for k in cands:
        if len(k) not in (16, 24, 32):
            continue
        pt = AES.new(k, AES.MODE_CBC, iv).decrypt(ct)
        try:
            pt = unpad(pt, 16)
        except:
            pass
        if all(9 <= b < 127 or b in (10, 13) for b in pt):
            print("keylen", len(k), pt)

s = lagrange0(shares)
kb = s.to_bytes(16, "big")
print(hex(s))
try_dec(kb)
end_of_edit
