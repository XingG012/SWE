DISCUSSION
I'll write a compact enumerator that reuses the SRP-zero trick, fetches each dashboard, and extracts the password column.
COMMAND
edit 1:1
import hashlib
import hmac
import re

import requests

BASE = "http://crypto.chal.csaw.io:5000/"
N = int("00ab76f585834c3c2b7b7b2c8a04c66571539fa660d39762e338cd8160589f08e3d223744cb7894ea6b424ebab899983ff61136c8315d9d03aef12bd7c0486184945998ff80c8d3d59dcb0196fb2c37c43d9cbff751a0745b9d796bcc155cfd186a3bb4ff6c43be833ff1322693d8f76418a48a51f43d598d78a642072e9fff533", 16)

users = [line.split(":")[0] for line in open("database.txt") if line.strip()]

for user in users:
    s = requests.Session()
    r = s.post(BASE, data={"username": user, "token1": str(N * 2)})
    salt = r.json()["nacl"]
    K = hashlib.sha256(b"0").digest()
    mac = hmac.new(K, salt.encode(), hashlib.sha256).hexdigest()
    r2 = s.post(BASE, data={"username": user, "computed": mac}, allow_redirects=False)
    r3 = s.get(r2.headers["Location"])
    m = re.search(r"<td>%s</td>\s*<td>([^<]+)</td>" % re.escape(user), r3.text)
    print(f"{user}:{m.group(1) if m else 'PARSE_FAIL'}")
end_of_edit
