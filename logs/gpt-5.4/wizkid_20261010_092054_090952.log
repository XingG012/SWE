import subprocess

cands = [str(i) for i in range(0,201)] + [f"{a}+{b}" for a in range(0,51) for b in range(0,51)] + [f"{a}*{b}" for a in range(0,31) for b in range(0,31)]

seen = set()
for expr in cands:
    if expr in seen:
        continue
    seen.add(expr)
    p = subprocess.run(
        ["./wizkid"],
        input=(expr + "\n").encode(),
        capture_output=True,
        env={"LD_LIBRARY_PATH": "."}
    )
    out = (p.stdout + p.stderr).decode("latin1", "ignore")
    if "Getting deeper I see" in out or "almost there" in out or "./flag.txt" in out or "keep going!" in out:
        print("EXPR:", expr)
        print(out)
