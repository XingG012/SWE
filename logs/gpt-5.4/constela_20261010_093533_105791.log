edit 1:1
import base64
import re
import subprocess

cmd = [
    "tshark", "-r", "constela.pcapng",
    "-Y", 'dns.flags.response==0 && dns.qry.name matches "^[A-Za-z0-9+/=]+\\.com$"',
    "-T", "fields", "-e", "dns.qry.name"
]
out = subprocess.check_output(cmd, text=True)

pts = set()
last = None

for line in out.splitlines():
    name = line.strip()
    if not name:
        continue
    label = name[:-4] if name.endswith(".com") else name
    try:
        dec = base64.b64decode(label).decode("ascii", errors="ignore")
    except Exception:
        continue

    m1 = re.match(r'^\$GPGGA,,([0-9]+(?:\.[0-9]+)?),N,([0-9]+(?:\.[0-9]+)?),W,7,', dec)
    if m1:
        last = (int(float(m1.group(1))), int(float(m1.group(2))))
        continue

    m2 = re.match(r'^00,,([0-9]+(?:\.[0-9]+)?),ft', dec)
    if m2 and last is not None:
        alt = int(float(m2.group(1))) - 10000
        pts.add((last[0], last[1], alt))

for p in sorted(pts):
    print(p)
print("count", len(pts))
end_of_edit

