def read_pbm(path):
    with open(path) as f:
        lines = [line.strip() for line in f if line.strip()]
    assert lines[0] == "P1"
    w, h = map(int, lines[1].split())
    data = []
    for line in lines[2:]:
        data.append(line.split())
    return data

def show(name, g):
    print(name)
    for row in g:
        print("".join("#" if x == "1" else " " for x in row))
    print()

def rot90(g):
    h = len(g)
    w = len(g[0])
    return [[g[h - 1 - r][c] for r in range(h)] for c in range(w)]

def flip(g):
    return [list(reversed(r)) for r in g]

g = read_pbm("out.pbm")
show("orig", g)
r1 = rot90(g)
show("rot90", r1)
r2 = rot90(r1)
show("rot180", r2)
r3 = rot90(r2)
show("rot270", r3)
show("flip", flip(g))
end_of_edit

