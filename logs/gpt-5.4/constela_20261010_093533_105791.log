edit 1:1
def read_pbm(path):
    with open(path) as f:
        lines = [line.strip() for line in f if line.strip()]
    w, h = map(int, lines[1].split())
    data = [line.split() for line in lines[2:2+h]]
    return data

def rot90(g):
    h = len(g)
    w = len(g[0])
    return [[g[h-1-r][c] for r in range(h)] for c in range(w)]

def show(name, g):
    print(name)
    for row in g:
        s = "".join("██" if x == "1" else "  " for x in row)
        print(s)
    print()

g = read_pbm("out.pbm")
show("orig", g)
g1 = rot90(g)
show("rot90", g1)
g2 = rot90(g1)
show("rot180", g2)
g3 = rot90(g2)
show("rot270", g3)
