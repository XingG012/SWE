import base64

pts = set()
with open("labels.txt") as f:
    for line in f:
        s = line.strip()
        if not s:
            continue
        try:
            d = base64.b64decode(s).decode("ascii", errors="ignore")
        except Exception:
            continue
        parts = d.split(",")
        if len(parts) >= 5 and parts[0] == "$GPGGA":
            try:
                lat = int(float(parts[2]))
                lon = int(float(parts[4]))
                pts.add((lat, lon))
            except Exception:
                pass

min_lat = min(p[0] for p in pts)
max_lat = max(p[0] for p in pts)
min_lon = min(p[1] for p in pts)
max_lon = max(p[1] for p in pts)

w = max_lon - min_lon + 1
h = max_lat - min_lat + 1

with open("out.pbm", "w") as f:
    f.write("P1\n")
    f.write(f"{w} {h}\n")
    for lat in range(max_lat, min_lat - 1, -1):
        row = []
        for lon in range(min_lon, max_lon + 1):
            row.append("1" if (lat, lon) in pts else "0")
        f.write(" ".join(row) + "\n")

print(w, h)
end_of_edit

