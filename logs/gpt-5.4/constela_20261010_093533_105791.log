import base64

rows = []
with open("labels.txt") as f:
    for line in f:
        s = line.strip()
        if not s:
            continue
        try:
            d = base64.b64decode(s).decode("ascii", errors="ignore")
            rows.append(d)
        except Exception:
            pass

for r in sorted(rows):
    print(r)
end_of_edit

