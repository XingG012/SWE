from pwn import remote

HOST = "rev.chal.csaw.io"
PORT = 8000

ADD=0; INC=1; SUB=2; MOVF=3; RDTM=4; MOVFU=5; MOVFS=6; MOVFI=7
MOVFSI=8; MOVT=9; JGT=10; JEQ=11; JMP=12; ENT=13; EXT=14; FLUSH=15

def op3(op, a=0, b=0, c=0):
    return ((b & 3) << 6) | ((a & 3) << 4) | (op & 0xF), (c & 3)

def op2(op, a=0, b=0):
    return ((b & 3) << 6) | ((a & 3) << 4) | (op & 0xF)

def run(prog):
    line = " ".join(f"{x:02x}" for x in prog)
    io = remote(HOST, PORT)
    io.recvuntil(b"WELCOME")
    io.sendline(line.encode())
    data = io.recvall(timeout=5).decode(errors="ignore")
    return data

if __name__ == "__main__":
    prog = [0x00]
    print(run(prog))
end_of_edit
