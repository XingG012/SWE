from pwn import *
import re

HOST = "android-dropper.csaw.io"
PORT = 3000

def query(vals):
    io = remote(HOST, PORT)
    io.recvuntil(b"Enter your input: ")
    for i, v in enumerate(vals):
        io.sendline(str(v).encode())
        if i != len(vals) - 1:
            io.recvuntil(b"Enter your input: ")
    out = io.recvall(timeout=2).decode(errors="ignore")
    io.close()
    m = re.search(r"Your result is:\s*([\-0-9\.]+)", out)
    if not m:
        print(out)
        raise SystemExit("parse failed")
    s = m.group(1)
    return float(s) if "." in s else int(s)

base = query([0] * 30)
print("intercept =", base)

coefs = []
for i in range(30):
    vals = [0] * 30
    vals[i] = 1
    y = query(vals)
    c = y - base
    coefs.append(c)
    print(i, c)

print("coefs =", coefs)
end_of_edit
```

