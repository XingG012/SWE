12:    return sympify(s, locals={'X': x})
13:
14:def solve_equation(line):
15:    m = re.match(r"\s*(.*?)\s*=\s*(.*?)\s*$", line)
16:    if not m:
17:        return None
18:    left = parse_expr(m.group(1))
19:    right = parse_expr(m.group(2))
20:    sol = solve(Eq(left, right), x)
21:    if not sol:
22:        return None
23:    ans = sol[0]
24:    if getattr(ans, "is_Integer", False):
25:        return str(int(ans))
26:    val = ans.evalf()
27:    s = str(val)
28:    if "." in s:
29:        s = s.rstrip("0").rstrip(".")
30:    return s
31:
32:def main():
33:    io = remote(HOST, PORT)
34:    data = b""
35:    while True:
36:        chunk = io.recvuntil(b": ", timeout=5)
37:        if not chunk:
38:            break
39:        data += chunk
40:        text = data.decode(errors="ignore")
41:        print(text, end="")
42:        lines = text.splitlines()
43:        eq = None
44:        for line in reversed(lines):
45:            if '=' in line and 'X' in line:
46:                eq = line.strip()
47:                break
48:        if eq is None:
49:            break
50:        ans = solve_equation(eq)
51:        print(ans)
52:        io.sendline(ans.encode())
53:        data = b""
54:    try:
55:        rest = io.recvall(timeout=2)
56:        if rest:
57:            print(rest.decode(errors="ignore"), end="")
58:    except EOFError:
59:        pass
60:
61:if __name__ == "__main__":
62:    main()
