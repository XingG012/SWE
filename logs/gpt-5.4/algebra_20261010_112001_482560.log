from pwn import *
import re
from sympy import symbols, Eq, solve, sympify

HOST = "misc.chal.csaw.io"
PORT = 4324

x = symbols('X')

def parse_expr(s):
    s = s.strip().replace('^', '**')
    return sympify(s, locals={'X': x})

def solve_equation(line):
    m = re.match(r"\s*(.*?)\s*=\s*(.*?)\s*$", line)
    if not m:
        return None
    left = parse_expr(m.group(1))
    right = parse_expr(m.group(2))
    sol = solve(Eq(left, right), x)
    if not sol:
        return None
    ans = sol[0]
    if getattr(ans, "is_Integer", False):
        return str(int(ans))
    return str(ans)

def main():
    io = remote(HOST, PORT)
    data = b""
    while True:
        chunk = io.recvuntil(b": ", timeout=5)
        if not chunk:
            break
        data += chunk
        text = data.decode(errors="ignore")
        print(text, end="")
        lines = text.splitlines()
        eq = None
        for line in reversed(lines):
            if '=' in line and 'X' in line:
                eq = line.strip()
                break
        if eq is None:
            break
        ans = solve_equation(eq)
        print(ans)
        io.sendline(ans.encode())
        data = b""
    try:
        rest = io.recvall(timeout=2)
        if rest:
            print(rest.decode(errors="ignore"), end="")
    except EOFError:
        pass

if __name__ == "__main__":
    main()
end_of_edit
