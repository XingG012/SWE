def node_fields(va):
    off = DATA_OFF + (va - DATA_VA)
    flag = blob[off]
    lo = blob[off + 8]
    hi = blob[off + 9]
    left = struct.unpack_from("<Q", blob, off + 16)[0]
    right = struct.unpack_from("<Q", blob, off + 24)[0]
    return flag, lo, hi, left, right

def check_value(ch, root):
    p = root
    seen = 0
    while True:
        flag, lo, hi, left, right = node_fields(p)
        if flag != 0:
            return lo
        if lo <= ch < hi:
            p = left
        else:
            p = right
        seen += 1
        if seen > 10000 or p == 0:
            return 0
