DISCUSSION
I'll write a parser based on the observed node layout: 8-byte left pointer, 8-byte right pointer, 8-byte zero sentinel/unused field, then a 2-byte little-endian range/value field where the low byte is the return character and the high byte appears to be the upper bound. For each root entry I'll brute-force bytes 0..255 through the tree logic and collect those that return nonzero.
COMMAND
edit 1:1
import struct

BIN = "rabbithole"
DATA_VA = 0x256880
DATA_OFF = 0x56880
ROOTS_VA = 0x28F900
ROOT_COUNT = 59

with open(BIN, "rb") as f:
    blob = f.read()

def read_u64_va(va):
    off = DATA_OFF + (va - DATA_VA)
    return struct.unpack_from("<Q", blob, off)[0]

def node_fields(va):
    off = DATA_OFF + (va - DATA_VA)
    left = struct.unpack_from("<Q", blob, off)[0]
    right = struct.unpack_from("<Q", blob, off + 8)[0]
    zero = struct.unpack_from("<Q", blob, off + 16)[0]
    word = struct.unpack_from("<H", blob, off + 24)[0]
    lo = word & 0xff
    hi = (word >> 8) & 0xff
    return left, right, zero, lo, hi

def check_value(ch, root):
    p = root
    seen = 0
    while True:
        left, right, zero, lo, hi = node_fields(p)
        if zero != 0:
            return lo
        if ch < lo or hi <= ch:
            p = right
        else:
            p = left
        seen += 1
        if seen > 10000 or p == 0:
            return 0

roots = [read_u64_va(ROOTS_VA + i * 8) for i in range(ROOT_COUNT)]

out = []
for idx, r in enumerate(roots):
    vals = [b for b in range(256) if check_value(b, r) != 0]
    print(idx, len(vals), vals[:20], "..." if len(vals) > 20 else "")
    if len(vals) == 1:
        out.append(vals[0])
    else:
        out.append(ord("?"))

print(bytes(out))
print(bytes(out).decode("latin1"))
end_of_edit
