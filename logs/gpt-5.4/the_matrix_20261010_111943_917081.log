print(r.recvline(timeout=2).decode(errors="ignore"), end="")
for w in words:
    r.sendline(w.encode())
    print(r.recvline(timeout=2).decode(errors="ignore"), end="")
r.sendline(b"Close")
try:
    while True:
        data = r.recvline(timeout=2)
        if not data:
            break
        print(data.decode(errors="ignore"), end="")
except EOFError:
    pass
end_of_edit

