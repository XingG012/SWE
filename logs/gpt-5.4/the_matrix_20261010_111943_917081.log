import ast
from collections import Counter, defaultdict

lines = []
with open("messages.txt") as f:
    for line in f:
        line = line.strip()
        if line:
            lines.append(ast.literal_eval(line))

blocks = []
where = defaultdict(list)
for li, arr in enumerate(lines, 1):
    assert len(arr) % 3 == 0
    bs = [tuple(arr[i:i+3]) for i in range(0, len(arr), 3)]
    for bi, b in enumerate(bs):
        blocks.append(b)
        where[b].append((li, bi))

cnt = Counter(blocks)

print("unique blocks:", len(cnt))
print("most common blocks:")
for b, n in cnt.most_common():
    if n > 1:
        print(n, b, where[b])

print("\\nmessages as blocks:")
for li, arr in enumerate(lines, 1):
    bs = [tuple(arr[i:i+3]) for i in range(0, len(arr), 3)]
    print(li, bs)
end_of_edit
