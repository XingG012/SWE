import ast
from fractions import Fraction

chars = " abcdefghijklmnopqrstuvwxyz"

A = [
    [3, 6, 1],
    [9, 4, 2],
    [1, 5, 7],
]

def inv3(m):
    a,b,c = m[0]
    d,e,f = m[1]
    g,h,i = m[2]
    det = a*(e*i-f*h) - b*(d*i-f*g) + c*(d*h-e*g)
    cof = [
        [ e*i-f*h, -(d*i-f*g),  d*h-e*g],
        [-(b*i-c*h), a*i-c*g, -(a*h-b*g)],
        [ b*f-c*e, -(a*f-c*d), a*e-b*d],
    ]
    adj = list(map(list, zip(*cof)))
    return [[Fraction(x, det) for x in row] for row in adj]

INV = inv3(A)

def dec_block(v):
    out = []
    for row in INV:
        s = sum(row[j] * v[j] for j in range(3))
        out.append(s)
    return out

with open("messages.txt") as f:
    for idx, line in enumerate(f, 1):
        arr = ast.literal_eval(line.strip())
        pts = []
        ok = True
        for i in range(0, len(arr), 3):
            vals = dec_block(arr[i:i+3])
            for x in vals:
                if x.denominator != 1:
                    ok = False
            pts.extend(int(x) for x in vals)
        print("MSG", idx, "OK" if ok else "BAD", pts)
        s = ""
        for x in pts:
            if x == -1:
                continue
            if 0 <= x < len(chars):
                s += chars[x]
            else:
                s += f"<{x}>"
        print(s)
end_of_edit

