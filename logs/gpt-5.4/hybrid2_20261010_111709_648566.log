from math import prod
from Crypto.Util.number import long_to_bytes
from gmpy2 import iroot
from cryptography.fernet import Fernet

vals = {}
with open("values.txt") as f:
    for line in f:
        k, v = line.strip().split(":")
        vals[k] = int(v)

ns = [vals[f"n{i}"] for i in range(1, 5)]
cs = [vals[f"c{i}"] for i in range(1, 5)]
e = vals["e"]

N = prod(ns)
x = 0
for ni, ci in zip(ns, cs):
    Ni = N // ni
    inv = pow(Ni, -1, ni)
    x += ci * Ni * inv
x %= N

root, exact = iroot(x, e)
print("exact_root:", exact)
print("root:", int(root))

m = int(root)
pwd = long_to_bytes(m)
print("password_bytes:", pwd)
print("password_len:", len(pwd))

token = open("encrypted_flag.txt", "rb").read().strip()
key = pwd
try:
    print(Fernet(key).decrypt(token).decode())
except Exception as ex:
    print("decrypt_error:", repr(ex))
end_of_edit

