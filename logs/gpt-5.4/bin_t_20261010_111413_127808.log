from pwn import remote
import re


class Node:
    def __init__(self, key):
        self.key = key
        self.left = None
        self.right = None


def build(arr):
    if not arr:
        return None
    mid = len(arr) // 2
    node = Node(arr[mid])
    node.left = build(arr[:mid])
    node.right = build(arr[mid + 1:])
    return node


def pre(n, out):
    if not n:
        return
    out.append(str(n.key))
    pre(n.left, out)
    pre(n.right, out)


io = remote("misc.chal.csaw.io", 8000)
data = io.recvrepeat(1).decode()
print(data)
m = re.search(r'(\d+(?:,\d+)*)', data)
nums = [int(x) for x in m.group(1).split(",")]
nums.sort()
root = build(nums)
out = []
pre(root, out)
ans = ",".join(out)
print(ans)
io.sendline(ans.encode())
resp = io.recvrepeat(2).decode(errors="replace")
print(resp)
end_of_edit
