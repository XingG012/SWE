from pwn import remote
import re


class Node:
    def __init__(self, key):
        self.key = key
        self.left = None
        self.right = None
        self.height = 1


def h(n):
    return n.height if n else 0


def upd(n):
    n.height = 1 + max(h(n.left), h(n.right))


def rr(y):
    x = y.left
    t2 = x.right
    x.right = y
    y.left = t2
    upd(y)
    upd(x)
    return x


def rl(x):
    y = x.right
    t2 = y.left
    y.left = x
    x.right = t2
    upd(x)
    upd(y)
    return y


def insert(node, key):
    if node is None:
        return Node(key)
    if key < node.key:
        node.left = insert(node.left, key)
    else:
        node.right = insert(node.right, key)
    upd(node)
    bf = h(node.left) - h(node.right)
    if bf > 1 and key < node.left.key:
        return rr(node)
    if bf < -1 and key >= node.right.key:
        return rl(node)
    if bf > 1 and key >= node.left.key:
        node.left = rl(node.left)
        return rr(node)
    if bf < -1 and key < node.right.key:
        node.right = rr(node.right)
        return rl(node)
    return node


def pre(n, out):
    if not n:
        return
    out.append(str(n.key))
    pre(n.left, out)
    pre(n.right, out)


io = remote("misc.chal.csaw.io", 8000)
data = io.recvrepeat(1).decode()
print(data)
m = re.search(r'(\d+(?:,\d+)*)', data)
nums = [int(x) for x in m.group(1).split(",")]
root = None
for x in nums:
    root = insert(root, x)
out = []
pre(root, out)
ans = ",".join(out)
print(ans)
io.sendline(ans.encode())
resp = io.recvrepeat(2).decode(errors="replace")
print(resp)
end_of_edit
