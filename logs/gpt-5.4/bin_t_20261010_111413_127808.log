def make_insert(go_left_on_equal=None):
    def insert(node, key):
        if node is None:
            return Node(key)
        if key < node.key:
            node.left = insert(node.left, key)
        elif key > node.key:
            node.right = insert(node.right, key)
        else:
            return node

        upd(node)
        bf = h(node.left) - h(node.right)

        if bf > 1 and key < node.left.key:
            return rr(node)
        if bf < -1 and key > node.right.key:
            return rl(node)
        if bf > 1 and key > node.left.key:
            node.left = rl(node.left)
            return rr(node)
        if bf < -1 and key < node.right.key:
            node.right = rr(node.right)
            return rl(node)
        return node
    return insert


def pre(n, out):
    if not n:
        return
    out.append(str(n.key))
    pre(n.left, out)
    pre(n.right, out)


data = None
nums = None
variants = [
    ("ignore_duplicates", make_insert()),
]

for name, insert in variants:
    io = remote("misc.chal.csaw.io", 8000)
    data = io.recvrepeat(1).decode()
    if nums is None:
        print(data)
        m = re.search(r'(\d+(?:,\d+)*)', data)
        nums = [int(x) for x in m.group(1).split(",")]

    root = None
    for x in nums:
        root = insert(root, x)

    out = []
    pre(root, out)
    ans = ",".join(out)
    print(name)
    print(ans)
    io.sendline(ans.encode())
    resp = io.recvrepeat(2).decode(errors="replace")
    print(resp)
    io.close()
    if "flag{" in resp:
        break
