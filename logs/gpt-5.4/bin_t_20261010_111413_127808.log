from pwn import remote
import re


class Node:
    def __init__(self, key):
        self.key = key
        self.left = None
        self.right = None
        self.height = 1


def h(n):
    return n.height if n else 0


def upd(n):
    n.height = 1 + max(h(n.left), h(n.right))


def rr(y):
    x = y.left
    t2 = x.right
    x.right = y
    y.left = t2
    upd(y)
    upd(x)
    return x


def rl(x):
    y = x.right
    t2 = y.left
    y.left = x
    x.right = t2
    upd(x)
    upd(y)
    return y


def make_insert(go_left_on_equal, left_eq_single, right_eq_single, left_eq_double, right_eq_double):
    def insert(node, key):
        if node is None:
            return Node(key)
        if key < node.key or (go_left_on_equal and key == node.key):
            node.left = insert(node.left, key)
        else:
            node.right = insert(node.right, key)

        upd(node)
        bf = h(node.left) - h(node.right)

        cond_ll = key < node.left.key or (left_eq_single and key == node.left.key)
        cond_rr = key > node.right.key or (right_eq_single and key == node.right.key)
        cond_lr = key > node.left.key or (left_eq_double and key == node.left.key)
        cond_rl = key < node.right.key or (right_eq_double and key == node.right.key)

        if bf > 1 and cond_ll:
            return rr(node)
        if bf < -1 and cond_rr:
            return rl(node)
        if bf > 1 and cond_lr:
            node.left = rl(node.left)
            return rr(node)
        if bf < -1 and cond_rl:
            node.right = rr(node.right)
            return rl(node)
        return node
    return insert


def pre(n, out):
    if not n:
        return
    out.append(str(n.key))
    pre(n.left, out)
    pre(n.right, out)


data = None
nums = None
variants = [
    ("right_eq_right", make_insert(False, False, True, True, False)),
    ("left_eq_left", make_insert(True, True, False, False, True)),
    ("right_eq_leftrot_ties_left", make_insert(False, False, False, True, True)),
    ("left_eq_rightrot_ties_right", make_insert(True, False, False, True, True)),
]

for name, insert in variants:
    io = remote("misc.chal.csaw.io", 8000)
    data = io.recvrepeat(1).decode()
    if nums is None:
        print(data)
        m = re.search(r'(\d+(?:,\d+)*)', data)
        nums = [int(x) for x in m.group(1).split(",")]

    root = None
    for x in nums:
        root = insert(root, x)

    out = []
    pre(root, out)
    ans = ",".join(out)
    print(name)
    print(ans)
    io.sendline(ans.encode())
    resp = io.recvrepeat(2).decode(errors="replace")
    print(resp)
    io.close()
    if "flag{" in resp:
        break
