class Node:
    def __init__(self, key):
        self.key = key
        self.left = None
        self.right = None
        self.height = 1


def h(n):
    return n.height if n else 0


def upd(n):
    n.height = 1 + max(h(n.left), h(n.right))


def rr(y):
    x = y.left
    t2 = x.right
    x.right = y
    y.left = t2
    upd(y)
    upd(x)
    return x


def rl(x):
    y = x.right
    t2 = y.left
    y.left = x
    x.right = t2
    upd(x)
    upd(y)
    return y


def pre(n, out):
    if not n:
        return
    out.append(str(n.key))
    pre(n.left, out)
    pre(n.right, out)


nums = [9,48,56,3,63,87,33,48,29,36,8,25,30,36,69,15,21,80,63,36,24,9,39,17,81,58,51,55,68,10,12,16,38,74,36,60,41,1,8,47,36,51,48,41,63,80,42,93,20,89,7,4,32,64,53,68,34,59,12,19,54,46,84,95,56,66,26,47,94,58,58,76,79,80,90,90,22,68,87,93,7,8,22,94,74,51,44,20,38,76,83,59,14,76,98,40,34,44,83,76]


def insert_right(node, key):
    if node is None:
        return Node(key)
    if key < node.key:
        node.left = insert_right(node.left, key)
    else:
        node.right = insert_right(node.right, key)
    upd(node)
    bf = h(node.left) - h(node.right)
    if bf > 1 and key < node.left.key:
        return rr(node)
    if bf < -1 and key >= node.right.key:
        return rl(node)
    if bf > 1 and key >= node.left.key:
        node.left = rl(node.left)
        return rr(node)
    if bf < -1 and key < node.right.key:
        node.right = rr(node.right)
        return rl(node)
    return node


def insert_left(node, key):
    if node is None:
        return Node(key)
    if key <= node.key:
        node.left = insert_left(node.left, key)
    else:
        node.right = insert_left(node.right, key)
    upd(node)
    bf = h(node.left) - h(node.right)
    if bf > 1 and key <= node.left.key:
        return rr(node)
    if bf < -1 and key > node.right.key:
        return rl(node)
    if bf > 1 and key > node.left.key:
        node.left = rl(node.left)
        return rr(node)
    if bf < -1 and key <= node.right.key:
        node.right = rr(node.right)
        return rl(node)
    return node


