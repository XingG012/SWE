75:    def mult(self, scal, point):
76:        if scal % self.order == 0 or point is None:
77:            return None
78:        if scal < 0:
79:            return self.neg(self.mult(-scal, point))
80:
81:        result = None
82:        addend = point
83:
84:        while scal:
85:            if scal & 1:
86:                result = self.add(result, addend)
87:            addend = self.double(addend)
88:            scal >>= 1
89:
90:        return result
