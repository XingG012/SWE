31:        if point is None:
32:            return True
33:
34:        (x, y) = point
35:        return (y * y - x * x * x - self.a * x - self.b) % self.field == 0
36:
37:    def add(self, p1, p2):
38:        assert self.is_on_curve(p1)
39:        assert self.is_on_curve(p2)
40:
41:        if p1 is None:
42:            return p2
43:        if p2 is None:
44:            return p1
45:
46:        (x1, y1) = p1
47:        (x2, y2) = p2
48:
49:        if x1 == x2 and y1 != y2:
50:            return None
51:
52:        if x1 == x2:
53:            m = (3 * x1 * x1 + self.a) * SuperCurve.inv_mod(2 * y1, self.field)
54:        else:
55:            m = (y1 - y2) * SuperCurve.inv_mod(x1 - x2, self.field)
56:
57:        x3 = m * m - x1 - x2
58:        y3 = y1 + m * (x3 - x1)
59:        result = (x3 % self.field, -y3 % self.field)
60:        assert self.is_on_curve(result)
61:        return result
62:
63:    def double(self, p):
64:        return self.add(p, p)
65:
66:    def neg(self, p):
67:        if p is None:
68:            return None
69:
70:        (x, y) = p
71:        res = x, -y % self.field
72:        assert self.is_on_curve(res)
73:        return res
