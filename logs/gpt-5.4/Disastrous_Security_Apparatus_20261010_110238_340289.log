import ast
import binascii
import hashlib
import json
import re
import requests

from cryptography.hazmat.backends import default_backend
from cryptography.hazmat.primitives import hashes
from cryptography.hazmat.primitives.asymmetric import dsa

BASE = "http://crypto.chal.csaw.io:5000"

U = 11
S = 7
T = 15
L = 18
B = 0x9D2C5680
C = 0xEFC60000
N = 624
M = 397
MATRIX_A = 0x9908B0DF
UPPER_MASK = 0x80000000
LOWER_MASK = 0x7FFFFFFF


def unshift_right_xor(y, shift):
    x = 0
    for i in range(31, -1, -1):
        bit = (y >> i) & 1
        if i + shift <= 31:
            bit ^= (x >> (i + shift)) & 1
        x |= bit << i
    return x


def unshift_left_xor_mask(y, shift, mask):
    x = 0
    for i in range(32):
        bit = (y >> i) & 1
        if i - shift >= 0 and ((mask >> i) & 1):
            bit ^= (x >> (i - shift)) & 1
        x |= bit << i
    return x


def untemper(y):
    y = unshift_right_xor(y, L)
    y = unshift_left_xor_mask(y, T, C)
    y = unshift_left_xor_mask(y, S, B)
    y = unshift_right_xor(y, U)
    return y & 0xFFFFFFFF


class MT19937Recover:
    def __init__(self, outputs):
        assert len(outputs) >= 624
        self.mt = [untemper(x) for x in outputs[:624]]
        self.index = 624

    def twist(self):
        for i in range(N):
            y = (self.mt[i] & UPPER_MASK) + (self.mt[(i + 1) % N] & LOWER_MASK)
            self.mt[i] = self.mt[(i + M) % N] ^ (y >> 1)
            if y & 1:
                self.mt[i] ^= MATRIX_A
        self.index = 0

    def getrandbits32(self):
        if self.index >= N:
            self.twist()
        y = self.mt[self.index]
        self.index += 1
        y ^= y >> U
        y ^= (y << S) & B
        y ^= (y << T) & C
        y ^= y >> L
        return y & 0xFFFFFFFF

    def randbelow(self, n):
        k = n.bit_length()
        while True:
            r = 0
            bits = 0
            while bits < k:
                r = (r << 32) | self.getrandbits32()
                bits += 32
            r &= (1 << k) - 1
            if r < n:
                return r

    def randrange(self, start, stop=None):
        if stop is None:
            stop = start
            start = 0
        return start + self.randbelow(stop - start)


def sha1_int(data):
    return int(hashlib.sha1(data.encode("utf-8")).hexdigest(), 16)


def parse_sig(text):
    d = ast.literal_eval(text)
    return d["r"], d["s"]


def get_reset_value():
    text = requests.get(BASE + "/forgotpass").text.strip()
    m = re.search(r"/resetpass/([0-9a-fA-F]{16})$", text)
    if not m:
        raise ValueError(f"bad forgotpass response: {text!r}")
    raw = bytes.fromhex(m.group(1))
    return int.from_bytes(raw, "big")


def main():
    pub = requests.get(BASE + "/public_key").json()
    p = int(pub["p"])
    q = int(pub["q"])
    g = int(pub["g"])
    y = int(pub["y"])

    leaked32 = []
    for i in range(312):
        val = get_reset_value()
        leaked32.append((val >> 32) & 0xFFFFFFFF)
        leaked32.append(val & 0xFFFFFFFF)
        if (i + 1) % 50 == 0:
            print(f"leaks: {i+1}/312")

    rec = MT19937Recover(leaked32)

    msg = "aaa"
    sig_text = requests.get(BASE + "/sign/" + msg).text
    r, s = parse_sig(sig_text)
    print("observed signature:", r, s)

    k = rec.randrange(2, q)
    print("predicted k:", k)

    hm = sha1_int(msg)
    x = ((s * k - hm) * pow(r, -1, q)) % q
    print("recovered x:", x)

    assert pow(g, x, p) == y

    params = dsa.DSAParameterNumbers(p, q, g)
