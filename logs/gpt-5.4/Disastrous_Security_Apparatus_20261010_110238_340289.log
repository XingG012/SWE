        self.index += 1
        y ^= y >> U
        y ^= (y << S) & B
        y ^= (y << T) & C
        y ^= y >> L
        return y & 0xFFFFFFFF

    def getrandbits64(self):
        a = self.getrandbits32()
        b = self.getrandbits32()
        return ((a << 32) | b) & ((1 << 64) - 1)

    def randbelow(self, n):
        k = n.bit_length()
        while True:
            r = 0
            bits = 0
            while bits < k:
                r = (r << 32) | self.getrandbits32()
                bits += 32
            r &= (1 << k) - 1
            if r < n:
                return r

    def randrange(self, start, stop=None):
        if stop is None:
            stop = start
            start = 0
        return start + self.randbelow(stop - start)


def sha1_int(data):
    return int(hashlib.sha1(data.encode("utf-8")).hexdigest(), 16)


def parse_sig(text):
