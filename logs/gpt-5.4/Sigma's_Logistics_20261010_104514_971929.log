from pwn import *
import re

HOST = "mandf.csaw.io"
PORT = 3000

def query(vec):
    io = remote(HOST, PORT)
    io.recvuntil(b"Enter your input: ")
    for i, x in enumerate(vec):
        io.sendline(str(x).encode())
        if i < 29:
            io.recvuntil(b"Enter your input: ")
    out = io.recvall(timeout=2).decode(errors="ignore")
    m = re.search(r"Your result is:\s*([0-9eE+\-.]+)", out)
    if not m:
        print("FAILED OUTPUT")
        print(out)
        return None
    return float(m.group(1))

vecs = []
vecs.append([0]*30)
for i in range(30):
    v = [0]*30
    v[i] = 1
    vecs.append(v)

for idx, v in enumerate(vecs):
    r = query(v)
    print(idx, r)
end_of_edit
