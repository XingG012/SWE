from pwn import *
import re

HOST = "mandf.csaw.io"
PORT = 3000

def query(vec):
    io = remote(HOST, PORT)
    io.recvuntil(b"Enter your input: ")
    for i, x in enumerate(vec):
        io.sendline(str(x).encode())
        if i < 29:
            io.recvuntil(b"Enter your input: ")
    out = io.recvall(timeout=2).decode(errors="ignore")
    m = re.search(r"Your result is:\s*([-+0-9.eE]+)", out)
    if m:
        return ("ok", float(m.group(1)), out)
    return ("bad", None, out)

tests = [[0]*30]
for i in range(30):
    v = [0]*30
    v[i] = -1
    tests.append(v)

for idx, v in enumerate(tests):
    status, val, out = query(v)
    print(idx, status, val)
    if status != "ok":
        print(out)
end_of_edit
