data = open("blob.bin", "rb").read()

def rol(x, n):
    return ((x << n) & 0xff) | (x >> (8 - n))

def ror(x, n):
    return (x >> n) | ((x << (8 - n)) & 0xff)

tests = {
    "shr1": bytes([b >> 1 for b in data]),
    "shl1": bytes([(b << 1) & 0xff for b in data]),
    "ror1": bytes([ror(b, 1) for b in data]),
    "rol1": bytes([rol(b, 1) for b in data]),
    "nibbleswap": bytes([((b & 0xf) << 4) | (b >> 4) for b in data]),
    "not": bytes([b ^ 0xff for b in data]),
}

for name, out in tests.items():
    print("==", name, "==")
    print(out[:300].decode("latin1"))
    print()
end_of_edit
