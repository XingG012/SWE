import re

data = bytearray()
with open("hypokrinesthai.txt", "r", encoding="utf-8", errors="ignore") as f:
    for line in f:
        m = re.match(r'^([0-9a-fA-F]+)  ((?:[0-9a-fA-F]{2} ?)+)', line)
        if not m:
            continue
        for b in m.group(2).split():
            data.append(int(b, 16))

with open("blob.bin", "wb") as f:
    f.write(data)

print(len(data))
