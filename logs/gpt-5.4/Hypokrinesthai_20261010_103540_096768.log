import re

data = []
with open("hypokrinesthai.txt", "r", encoding="utf-8", errors="ignore") as f:
    for line in f:
        m = re.match(r'^[0-9a-fA-F]+  ((?:[0-9a-fA-F]{2} ?)+)', line)
        if not m:
            continue
        for b in m.group(1).split():
            data.append(int(b, 16))

for name, arr in [("forward", data), ("reverse", list(reversed(data)))]:
    shifted = [b >> 1 for b in arr]
    for k in range(256):
        dec = bytes([b ^ k for b in shifted])
        if b"csawctf{" in dec:
            print(name, k, dec[dec.index(b"csawctf{"):dec.index(b"}", dec.index(b"csawctf{"))+1])
end_of_edit
