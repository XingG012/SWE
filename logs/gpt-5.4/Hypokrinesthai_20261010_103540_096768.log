edit 1:1
from collections import Counter
import re

data = open("blob.bin", "rb").read()
text = ''.join(chr(b >> 1) if (b >> 1) != 2 else ' ' for b in data)

words = re.findall(r"[^\s]+", text)
for n in [1, 2, 3, 4, 5]:
    c = Counter(w for w in words if len(w) == n)
    print("LEN", n)
    for w, k in c.most_common(20):
        print(repr(w), k)
    print()
end_of_edit
