I'll fill the decoder script with minimal logic to parse the hexdump and decode each byte by shifting right one bit.
COMMAND
edit 1:1
import re

data = []
with open("hypokrinesthai.txt", "r", encoding="utf-8", errors="ignore") as f:
    for line in f:
        m = re.match(r'^[0-9a-fA-F]+  ((?:[0-9a-fA-F]{2} ?)+)', line)
        if not m:
            continue
        for b in m.group(1).split():
            data.append(int(b, 16))

decoded = bytes([b >> 1 for b in data])
print(decoded.decode("latin1"))
end_of_edit
