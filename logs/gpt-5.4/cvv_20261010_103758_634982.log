def next_by_suffix(suffix):
    key = f"suffix:{suffix}"
    counters[key] = counters.get(key, 0) + 1
    idx = counters[key]
    lengths = (16,) if len(suffix) > 1 else (16, 15, 14)
    for total_len in lengths:
        missing = total_len - len(suffix) - 1
        if missing < 0:
            continue
        fill_len = max(0, missing - 3)
        fill = str(idx).zfill(fill_len)[-fill_len:] if fill_len else ""
        for first in "987654321":
            base = first + fill
            for mid in range(1000):
                middle = str(mid).zfill(missing - fill_len)
                candidate = base + middle + suffix
                if len(candidate) == total_len and candidate not in used and luhn_valid(candidate):
                    return remember(candidate)
    raise ValueError(suffix)
