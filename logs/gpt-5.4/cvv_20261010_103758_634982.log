edit 1:1
import socket

HOST = "cvv"
PORT = 8000

cards = {
    "American Express": "378282246310005",
    "Visa": "4111111111111111",
    "Discover": "6011111111111117",
    "MasterCard": "5555555555554444",
    "JCB": "3530111333300000",
    "Diners Club": "30569309025904",
}

s = socket.create_connection((HOST, PORT))
buf = b""

while True:
    data = s.recv(4096)
    if not data:
        break
    print(data.decode("utf-8", errors="replace"), end="")
    buf += data
    text = buf.decode("utf-8", errors="replace")
    sent = False
    for brand, number in cards.items():
        needle = f"I need a new {brand}!"
        if needle in text:
            s.sendall((number + "\n").encode())
            buf = b""
            sent = True
            break
    if not sent and ("flag{" in text or "FLAG{" in text):
        break
end_of_edit
