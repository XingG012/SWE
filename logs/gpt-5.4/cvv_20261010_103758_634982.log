import re
import socket

HOST = "cvv"
PORT = 8000

counters = {}
brand_counters = {
    "American Express": 0,
    "Visa": 0,
    "Discover": 0,
    "MasterCard": 0,
    "JCB": 0,
    "Diners Club": 0,
}

def luhn_valid(number):
    digits = [int(d) for d in number]
    total = 0
    parity = len(digits) % 2
    for i, d in enumerate(digits):
        if i % 2 == parity:
            d *= 2
            if d > 9:
                d -= 9
        total += d
    return total % 10 == 0

def luhn_check_digit(number_without_check):
    digits = [int(d) for d in number_without_check]
    parity = (len(digits) + 1) % 2
    total = 0
    for i, d in enumerate(digits):
        if i % 2 == parity:
            d *= 2
            if d > 9:
                d -= 9
        total += d
    return str((10 - (total % 10)) % 10)

def make_card(prefix, total_len, n):
    body_len = total_len - len(prefix) - 1
    body = str(n).zfill(body_len)
    partial = prefix + body
    return partial + luhn_check_digit(partial)

def next_by_prefix(prefix, total_len=None):
    if total_len is None:
        if prefix.startswith(("34", "37")):
            total_len = 15
        elif prefix.startswith(("300", "301", "302", "303", "304", "305", "36", "38")):
            total_len = 14
        else:
            total_len = 16
    counters[prefix] = counters.get(prefix, 0) + 1
    return make_card(prefix, total_len, counters[prefix])

def next_by_suffix(suffix):
    key = f"suffix:{suffix}"
    counters[key] = counters.get(key, 0) + 1
    n = counters[key]
    for total_len in (16, 15, 14):
        body_len = total_len - len(suffix) - 1
        if body_len < 0:
            continue
        body = str(n).zfill(body_len)
        for first in "4563729810":
            candidate = first + body + suffix
            if len(candidate) == total_len and luhn_valid(candidate):
                return candidate
    raise ValueError(suffix)

def next_card(brand):
    brand_counters[brand] += 1
    n = brand_counters[brand]
    if brand == "American Express":
        return make_card("37", 15, n)
    if brand == "Visa":
        return make_card("4", 16, n)
    if brand == "Discover":
        return make_card("6011", 16, n)
    if brand == "MasterCard":
        return make_card("55", 16, n)
    if brand == "JCB":
        return make_card("35", 16, n)
    if brand == "Diners Club":
        return make_card("300", 14, n)
    raise ValueError(brand)

s = socket.create_connection((HOST, PORT))
buf = b""

while True:
    data = s.recv(4096)
    if not data:
        break
    text_chunk = data.decode("utf-8", errors="replace")
    print(text_chunk, end="")
    buf += data
    text = buf.decode("utf-8", errors="replace")

    m = re.search(r"starts with (\d+)", text)
    if m:
        prefix = m.group(1)
        number = next_by_prefix(prefix)
        print(f"[>] prefix {prefix}: {number}")
        s.sendall((number + "\n").encode())
        buf = b""
        continue

    m = re.search(r"ends with (\d+)", text)
    if m:
        suffix = m.group(1)
        number = next_by_suffix(suffix)
        print(f"[>] suffix {suffix}: {number}")
        s.sendall((number + "\n").encode())
        buf = b""
        continue

    for brand in brand_counters:
        needle = f"I need a new {brand}!"
        if needle in text:
            number = next_card(brand)
            print(f"[>] {brand}: {number}")
            s.sendall((number + "\n").encode())
            buf = b""
            break

    if "flag{" in text or "FLAG{" in text:
        break
