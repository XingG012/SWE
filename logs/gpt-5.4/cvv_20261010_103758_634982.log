counters = {}
used = set()
brand_counters = {
    "American Express": 0,
    "Visa": 0,
    "Discover": 0,
    "MasterCard": 0,
    "JCB": 0,
    "Diners Club": 0,
}

def luhn_valid(number):
    digits = [int(d) for d in number]
    total = 0
    parity = len(digits) % 2
    for i, d in enumerate(digits):
        if i % 2 == parity:
            d *= 2
            if d > 9:
                d -= 9
        total += d
    return total % 10 == 0

def luhn_check_digit(number_without_check):
    digits = [int(d) for d in number_without_check]
    parity = (len(digits) + 1) % 2
    total = 0
    for i, d in enumerate(digits):
        if i % 2 == parity:
            d *= 2
            if d > 9:
                d -= 9
        total += d
    return str((10 - (total % 10)) % 10)

def remember(number):
    used.add(number)
    return number

def make_card(prefix, total_len, n):
    body_len = total_len - len(prefix) - 1
    body = str(n).zfill(body_len)
    partial = prefix + body
    return partial + luhn_check_digit(partial)

def next_by_prefix(prefix, total_len=None):
    if total_len is None:
        if prefix.startswith(("34", "37")):
            total_len = 15
        elif prefix.startswith(("300", "301", "302", "303", "304", "305", "36", "38")):
            total_len = 14
        else:
            total_len = 16
    key = f"prefix:{prefix}:{total_len}"
    counters[key] = counters.get(key, 0) + 1
    n = counters[key]
    while True:
        number = make_card(prefix, total_len, n)
        if number not in used:
            counters[key] = n
            return remember(number)
        n += 1

def next_by_suffix(suffix):
    key = f"suffix:{suffix}"
    counters[key] = counters.get(key, 0) + 1
    base = counters[key]
    for total_len in (16, 15, 14):
        body_len = total_len - len(suffix) - 1
        if body_len < 0:
            continue
        for k in range(10000):
            body = str(base + k * 1000).zfill(body_len)
            for first in "2987654310":
                candidate = first + body + suffix
                if len(candidate) == total_len and luhn_valid(candidate) and candidate not in used:
                    counters[key] = base + k
                    return remember(candidate)
    raise ValueError(suffix)

def next_card(brand):
    brand_counters[brand] += 1
    n = brand_counters[brand]
    while True:
        if brand == "American Express":
            number = make_card("37", 15, n)
        elif brand == "Visa":
            number = make_card("4", 16, n)
        elif brand == "Discover":
            number = make_card("6011", 16, n)
        elif brand == "MasterCard":
            number = make_card("55", 16, n)
        elif brand == "JCB":
            number = make_card("35", 16, n)
        elif brand == "Diners Club":
            number = make_card("300", 14, n)
        else:
            raise ValueError(brand)
        if number not in used:
            brand_counters[brand] = n
            return remember(number)
        n += 1
