N = 64

def ordered_next(node, seen):
    opts = []
    for d, nxt in graph[node].items():
        if nxt in seen:
            continue
        onward_nodes = [z for z in graph[nxt].values() if z not in seen and z != nxt]
        onward = len(onward_nodes)
        opts.append((onward, d, nxt))
    opts.sort()
    return [(d, nxt) for onward, d, nxt in opts]

solution = None

def prune(seen):
    unvisited = [n for n in active if n not in seen]
    if not unvisited:
        return False

    deg1 = 0
    for n in unvisited:
        deg = sum(1 for z in graph[n].values() if z not in seen)
        if deg == 0:
            return True
        if deg == 1:
            deg1 += 1
            if deg1 > 2:
                return True

    start = unvisited[0]
    stack = [start]
    reached = {start}
    while stack:
        cur = stack.pop()
        for z in graph[cur].values():
            if z in seen or z in reached:
                continue
            reached.add(z)
            stack.append(z)
    return len(reached) != len(unvisited)

def dfs(node, seen, path_digits):
    global solution
    if solution is not None:
        return True
    if len(seen) == N:
        solution = ''.join(map(str, path_digits))
        return True

    candidates = ordered_next(node, seen)
    for d, nxt in candidates:
        seen.add(nxt)
        path_digits.append(d)
        if not prune(seen):
            if dfs(nxt, seen, path_digits):
                return True
        path_digits.pop()
        seen.remove(nxt)
    return False

dfs(START, {START}, [])
print(solution if solution is not None else "NO_SOLUTION")
