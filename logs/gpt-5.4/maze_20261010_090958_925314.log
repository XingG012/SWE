DISCUSSION
That confirms the per-digit offsets, and it also shows each active state starts at the `lea` address like `0x403f83`, not the earlier label. I’ll rewrite the parser so each node is keyed by that `lea` state address and start from the first state `0x403eb6`.
COMMAND
edit 22:127
active = set()
for i, line in enumerate(lines):
    if 'mov    BYTE PTR [rax],0xc3' in line:
        lea_addr = None
        for j in range(i - 1, max(i - 8, -1), -1):
            if 'lea    rax,[rip+' in lines[j]:
                m = label_re.match(lines[j])
                if m:
                    lea_addr = int(m.group(1), 16)
                    break
        if lea_addr is not None:
            active.add(lea_addr)

moves = {
    1: (-2, +1),
    2: (-1, +2),
    3: (+1, +2),
    4: (+2, +1),
    5: (+2, -1),
    6: (+1, -2),
    7: (-1, -2),
    8: (-2, -1),
}

graph = {}
for a in sorted(active):
    edges = {}
    for d, (dx, dy) in moves.items():
        target = a - 0xba + ((12 * dx + dy) * 0xcd)
        if target in active:
            edges[d] = target
    graph[a] = edges

print("active states:", len(active))
print("start active:", START in active)
print("start degree:", len(graph.get(START, {})))

N = 64

def ordered_next(node, seen):
    opts = []
    for d, nxt in graph[node].items():
        if nxt in seen:
            continue
        onward = sum(1 for z in graph[nxt].values() if z not in seen)
        opts.append((onward, d, nxt))
    opts.sort()
    return [(d, nxt) for onward, d, nxt in opts]

solution = None

def dfs(node, seen, path_digits):
    global solution
    if solution is not None:
        return True
    if len(seen) == N:
        solution = ''.join(map(str, path_digits))
        return True
    for d, nxt in ordered_next(node, seen):
        seen.add(nxt)
        path_digits.append(d)
        if dfs(nxt, seen, path_digits):
            return True
        path_digits.pop()
        seen.remove(nxt)
    return False

dfs(START, {START}, [])
print(solution if solution is not None else "NO_SOLUTION")
