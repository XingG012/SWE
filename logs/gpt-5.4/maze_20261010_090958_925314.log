import re
from collections import defaultdict

DISASM = "disasm.txt"
START = 0x403eb6

label_re = re.compile(r'^\s*([0-9a-f]+):')
lea_self_re = re.compile(r'lea\s+rax,\[rip\+0x([0-9a-f]+)\]\s+#\s+0x([0-9a-f]+)')
jmp_re = re.compile(r'jmp\s+rax')

with open(DISASM, "r", encoding="utf-8", errors="ignore") as f:
    lines = f.readlines()

labels = []
for line in lines:
    m = label_re.match(line)
    if m:
        labels.append(int(m.group(1), 16))

label_set = set(labels)

active = set()
for i, line in enumerate(lines):
    if 'mov    BYTE PTR [rax],0xc3' in line:
        for j in range(i - 1, max(i - 8, -1), -1):
            m = label_re.match(lines[j])
            if m:
                active.add(int(m.group(1), 16))
                break

moves = {
    1: (-2, +1),
    2: (-1, +2),
    3: (+1, +2),
    4: (+2, +1),
    5: (+2, -1),
    6: (+1, -2),
    7: (-1, -2),
    8: (-2, -1),
}

graph = {}
for a in sorted(active):
    edges = {}
    for d, (dx, dy) in moves.items():
        target = a - 0xba + ((12 * dx + dy) * 0xcd)
        if target in active:
            edges[d] = target
    graph[a] = edges

print("active states:", len(active))
print("start active:", START in active)
print("start degree:", len(graph.get(START, {})))

N = 64

# Warnsdorff-style ordering
def ordered_next(node, seen):
    opts = []
    for d, nxt in graph[node].items():
        if nxt in seen:
            continue
        onward = sum(1 for _, z in graph[nxt].items() if z not in seen)
        opts.append((onward, d, nxt))
    opts.sort()
    return [(d, nxt) for onward, d, nxt in opts]

solution = None

def dfs(node, seen, path_digits):
    global solution
    if solution is not None:
        return True
    if len(seen) == N:
        solution = ''.join(map(str, path_digits))
        return True
    for d, nxt in ordered_next(node, seen):
        seen.add(nxt)
        path_digits.append(d)
        if dfs(nxt, seen, path_digits):
            return True
        path_digits.pop()
        seen.remove(nxt)
    return False

dfs(START, {START}, [])
print(solution if solution is not None else "NO_SOLUTION")
end_of_edit
