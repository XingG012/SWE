import ast
from fractions import Fraction

chars = " " + "abcdefghijklmnopqrstuvwxyz"

K = [
    [3, 6, 1],
    [9, 4, 2],
    [1, 5, 7],
]

def inv3(m):
    a,b,c = m[0]
    d,e,f = m[1]
    g,h,i = m[2]
    det = a*(e*i-f*h) - b*(d*i-f*g) + c*(d*h-e*g)
    adj = [
        [ e*i-f*h, -(b*i-c*h),  b*f-c*e],
        [-(d*i-f*g),  a*i-c*g, -(a*f-c*d)],
        [ d*h-e*g, -(a*h-b*g),  a*e-b*d],
    ]
    return det, [[Fraction(x, det) for x in row] for row in adj]

det, Kinv = inv3(K)
print("det =", det)
print("Kinv =", Kinv)

def dec_block(v):
    out = []
    for row in Kinv:
        s = sum(row[j] * v[j] for j in range(3))
        out.append(s)
    return out

with open("messages.txt") as f:
    msgs = [ast.literal_eval(line.strip()) for line in f if line.strip()]

for idx, msg in enumerate(msgs, 1):
    plain = []
    for i in range(0, len(msg), 3):
        blk = msg[i:i+3]
        vals = dec_block(blk)
        for x in vals:
            if x == -1:
                continue
            if x.denominator != 1:
                plain.append("?")
            else:
                n = x.numerator
                if 0 <= n < len(chars):
                    plain.append(chars[n])
                else:
                    plain.append("?")
    print(idx, "".join(plain))
end_of_edit
