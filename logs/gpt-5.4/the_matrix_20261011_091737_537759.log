import ast
from collections import Counter, defaultdict

chars = " " + "abcdefghijklmnopqrstuvwxyz"
c2i = {c:i for i,c in enumerate(chars)}

with open("messages.txt") as f:
    msgs = [ast.literal_eval(line.strip()) for line in f if line.strip()]

blocks = []
for mi, msg in enumerate(msgs):
    assert len(msg) % 3 == 0
    for bi in range(0, len(msg), 3):
        blk = tuple(msg[bi:bi+3])
        blocks.append((mi, bi//3, blk))

ctr = Counter(blk for _,_,blk in blocks)
print("Repeated blocks:")
for blk, n in ctr.most_common():
    if n > 1:
        print(n, blk)

common = """
the and ing ion ent her for tha nth int ere tio ter est ers ati hat ate all eth hes ver his oft ith fth sti oth res on  re  ed  to  it  ha  en  at  nd  ou  ea  ng as is or ti te et of
""".split()

def vec(s):
    return [c2i[c] for c in s]

# key = [[3,6,a],[b,4,2],[1,5,7]]
# maps plaintext p=(x,y,z) to:
# c1 = 3x+6y+a z
# c2 = b x+4y+2z
# c3 =  x+5y+7z
repeated = [blk for blk,n in ctr.items() if n > 1]

for blk in repeated:
    c1,c2,c3 = blk
    for w in common:
        if len(w) != 3:
            continue
        x,y,z = vec(w)
        if 3*x + 6*y == c1 and z == 0:
            pass
        denom_a = z
        denom_b = x
        if denom_a != 0 and denom_b != 0:
            a_num = c1 - 3*x - 6*y
            b_num = c2 - 4*y - 2*z
            if a_num % denom_a == 0 and b_num % denom_b == 0:
                a = a_num // denom_a
                b = b_num // denom_b
                if abs(a) < 100 and abs(b) < 100:
                    if x + 5*y + 7*z == c3:
                        print("candidate from", blk, w, "=> a,b =", a,b)
end_of_edit

