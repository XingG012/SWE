from pwn import remote
import re

MASK = (1 << 48) - 1
MULT = 0x5DEECE66D
ADD = 0xB
INV_MULT = pow(MULT, -1, 1 << 48)

def next_seed(seed):
    return (seed * MULT + ADD) & MASK

def prev_seed(seed):
    return ((seed - ADD) * INV_MULT) & MASK

def next_int(seed):
    seed = next_seed(seed)
    x = seed >> 16
    if x >= (1 << 31):
        x -= (1 << 32)
    return seed, x

def java_abs(x):
    return x if x >= 0 else (2147483648 if x == -2147483648 else -x)

def color_of(n):
    if n == 0:
        return "green"
    if n <= 7:
        return "red"
    return "black"

def gen_round(seed):
    seed, x = next_int(seed)
    win_num = x & 15

    seed, x = next_int(seed)
    count = 1 + (java_abs(x) % 10)

    ips = []
    for _ in range(count):
        seed, x = next_int(seed)
        ips.append(x & 0xffff)

    bets = []
    for _ in range(count):
        seed, x = next_int(seed)
        bets.append(java_abs(x % 50))

    wons = []
    for _ in range(count):
        seed, x = next_int(seed)
        wons.append((java_abs(x) & 1) == 0)

    return seed, win_num, count, ips, bets, wons

def parse_money(text):
    m = re.search(r'You have:\s*([0-9]+)\s*dollars', text)
    return int(m.group(1)) if m else None

def parse_round(text):
    color_m = re.search(r'The color was (red|black|green)!', text)
    round_color = color_m.group(1) if color_m else None
    entries = re.findall(
        r'xxx\.xxx\.(\d+)\.(\d+)\s+(Won|Lost)!\s+This player betted\s+(\d+)\s+dollars!',
        text
    )
    ips = [((int(a) << 8) | int(b)) for a, b, _, _ in entries]
    wons = [w == "Won" for _, _, w, _ in entries]
    bets = [int(v) for _, _, _, v in entries]
    return round_color, ips, bets, wons

def recover_candidates(ips, bets, wons, round_color):
    n = len(ips)
    out = []
    # s2 is internal seed after the gambler-count call, just before first IP nextInt()
    for hi in range(1 << 16):
        s2 = ((hi << 32) | (ips[0] << 16)) & MASK

        s = s2
        ok = True
        calc_ips = [ips[0]]
        for i in range(1, n):
            s, x = next_int(s)
            v = x & 0xffff
            calc_ips.append(v)
            if v != ips[i]:
                ok = False
                break
        if not ok:
            continue

        sb = s
        for b in bets:
            sb, x = next_int(sb)
            if java_abs(x % 50) != b:
                ok = False
                break
        if not ok:
            continue

        sw = sb
        for w in wons:
            sw, x = next_int(sw)
            if ((java_abs(x) & 1) == 0) != w:
                ok = False
                break
        if not ok:
            continue

        s1 = prev_seed(s2)
        s0 = prev_seed(s1)

        # Verify count and color too
        _, x1 = next_int(s0)
        if color_of(x1 & 15) != round_color:
            continue
        s_chk, x2 = next_int(s1)
        if 1 + (java_abs(x2) % 10) != n:
            continue

        out.append((s0, sw))
    return out

def main():
    io = remote("rev.chal.csaw.io", 4200)
    banner = io.recvuntil(b'> ')
    money = parse_money(banner.decode(errors="ignore"))
    if money is None:
        money = 50

    # first probe round
    io.sendline(b"1")
    io.recvuntil(b'> ')
    io.sendline(b"red")
    blob = io.recvuntil(b'> ')
    text = blob.decode(errors="ignore")

    round_color, ips, bets, wons = parse_round(text)
    money = parse_money(text)

    cands = recover_candidates(ips, bets, wons, round_color)
    if not cands:
        print(text)
        print("failed to recover")
        return

    round_start_seed, end_seed = cands[0]
    last_ip = ips[-1]

    while True:
        # compute next round seed based on current money and last gambler ip
        tmp_seed, x = next_int(end_seed)
        reseed = last_ip + money + (x & 0xffff)
        round_seed = (reseed ^ MULT) & MASK

        future_end, win_num, cnt, p_ips, p_bets, p_wons = gen_round(round_seed)
        clr = color_of(win_num)
        bet = money if clr == "green" else 1
        if bet < 1:
            bet = 1

        io.sendline(str(bet).encode())
        io.recvuntil(b'> ')
        io.sendline(clr.encode())
        blob = io.recvuntil(b'> ', timeout=5)
        text = blob.decode(errors="ignore")

        if "flag{" in text.lower() or "major prize" in text.lower():
            print(text)
            break

        new_money = parse_money(text)
        if new_money is None:
            print(text)
            break

        # sync using actual printed round in case of any accounting mistake
        round_color, ips, bets, wons = parse_round(text)
        cands = recover_candidates(ips, bets, wons, round_color)
        if not cands:
            print(text)
            print("desync")
            break
        round_start_seed, end_seed = cands[0]
        last_ip = ips[-1]
        money = new_money

    io.close()

if __name__ == "__main__":
    main()
