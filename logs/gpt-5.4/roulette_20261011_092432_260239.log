from pwn import remote
import re

MASK = (1 << 48) - 1
MULT = 0x5DEECE66D
ADD = 0xB

def next_seed(seed):
    return (seed * MULT + ADD) & MASK

def prev_seed(seed):
    inv = pow(MULT, -1, 1 << 48)
    return ((seed - ADD) * inv) & MASK

def next_int(seed):
    seed = next_seed(seed)
    x = seed >> 16
    if x >= (1 << 31):
        x -= (1 << 32)
    return seed, x

def next_int_nosign(seed):
    seed = next_seed(seed)
    return seed, seed >> 16

def abs_java(x):
    return x if x >= 0 else (-x if x != -2147483648 else -2147483648)

def gen_win(seed):
    seed, x = next_int(seed)
    return seed, x & 15

def gen_count(seed):
    seed, x = next_int(seed)
    return seed, 1 + (abs_java(x) % 10)

def gen_ip(seed):
    return next_int(seed)

def gen_bet(seed):
    seed, x = next_int(seed)
    return seed, abs_java(x % 50)

def gen_won(seed):
    seed, x = next_int(seed)
    return seed, (abs_java(x) & 1) == 0

def color_of(n):
    if n == 0:
        return "green"
    if n <= 7:
        return "red"
    return "black"

def recover_state_from_two_low16(a, b):
    seeds = []
    for hi in range(1 << 16):
        s1 = ((hi << 32) | (a << 16)) & MASK
        s2 = next_seed(s1)
        if ((s2 >> 16) & 0xffff) == b:
            seeds.append(s1)
    return seeds

def parse_ips(text):
    return [(int(a) << 8) | int(b) for a, b in re.findall(r'(\d+)\.(\d+)', text)]

def parse_money(text):
    m = re.search(r'\$([0-9]+)', text)
    return int(m.group(1)) if m else None

def parse_round_output(blob):
    ips = parse_ips(blob)
    return ips

def advance_round_from_seed(seed):
    seed, wn = gen_win(seed)
    seed, cnt = gen_count(seed)
    ips = []
    bets = []
    wins = []
    for _ in range(cnt):
        seed, x = gen_ip(seed)
        ips.append(x & 0xffff)
    for _ in range(cnt):
        seed, x = gen_bet(seed)
        bets.append(x)
    for _ in range(cnt):
        seed, x = gen_won(seed)
        wins.append(x)
    return seed, wn, cnt, ips, bets, wins

def main():
    io = remote("rev.chal.csaw.io", 4200)
    data = io.recvuntil(b'> ')
    money = parse_money(data.decode(errors="ignore"))
    if money is None:
        money = 50

    # First round: minimal bet, choose a dummy color; use output to recover state after reseed.
    io.sendline(b"1")
    io.recvuntil(b'> ')
    io.sendline(b"red")

    out = io.recvuntil(b'How much do you want to bet?\n> ')
    text = out.decode(errors="ignore")
    ips = parse_round_output(text)
    if len(ips) < 2:
        print(text)
        return

    candidates = recover_state_from_two_low16(ips[0], ips[1])

    valid = []
    for s_after_first_ip in candidates:
        s = prev_seed(s_after_first_ip)
        # Rewind for winning number and gambler count
        s_before_count = prev_seed(s)
        s_before_win = prev_seed(s_before_count)
        test_seed = s_before_win
        end_seed, wn, cnt, tips, bets, wins = advance_round_from_seed(test_seed)
        if cnt == len(ips) and tips == ips:
            valid.append((test_seed, end_seed, wn, cnt))

    if not valid:
        print("no valid states")
        print(text)
        return

    round_seed = valid[0][0]
    end_seed = valid[0][1]
    last_ip_low16 = ips[-1]
    money = money - 1

    greens = 0
    if "green" in text and "! You won" in text:
        greens += 1

    while True:
        # choose all-in if predicted green else minimum
        probe_seed, rnd = next_int(end_seed)
        reseed_val = (last_ip_low16 + money + (rnd & 0xffff)) & 0xffffffffffffffff
        new_internal = (reseed_val ^ MULT) & MASK

        future_end, wn, cnt, tips, bets, wins = advance_round_from_seed(new_internal)
        clr = color_of(wn)
        bet = money if clr == "green" else 1
        if bet <= 0:
            bet = 1

        io.sendline(str(bet).encode())
        io.recvuntil(b'> ')
        io.sendline(clr.encode())

        out = io.recvuntil(b'How much do you want to bet?\n> ', timeout=2)
        text = out.decode(errors="ignore")

        if clr == "green" and "! You won" in text:
            greens += 1
            money += bet * 13
        elif clr != "green" and "! You won" in text:
            money += bet
        else:
            money -= bet

        last_ip_low16 = tips[-1]
        end_seed = future_end

        if b'major prize' in out or b'flag' in out.lower():
            print(text)
            break

    io.close()

if __name__ == "__main__":
    main()
end_of_edit

