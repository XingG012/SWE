from pwn import remote
import re
from z3 import BitVec, BitVecVal, Solver, LShR, If, sat

MASK = (1 << 48) - 1
MULT = 0x5DEECE66D
ADD = 0xB

def next_seed(seed):
    return (seed * MULT + ADD) & MASK

def next_int(seed):
    seed = next_seed(seed)
    x = seed >> 16
    if x >= (1 << 31):
        x -= (1 << 32)
    return seed, x

def jdiv(a, b):
    return int(a / b)

def jmod(a, b):
    return a - jdiv(a, b) * b

def jabs(x):
    return x if x >= 0 else (2147483648 if x == -2147483648 else -x)

def color_of(n):
    if n == 0:
        return "green"
    if n <= 7:
        return "red"
    return "black"

def gen_round(seed):
    seed, x = next_int(seed)
    win = x & 15
    seed, x = next_int(seed)
    cnt = 1 + (jabs(x) % 10)
    ips = []
    for _ in range(cnt):
        seed, x = next_int(seed)
        ips.append(x & 0xffff)
    bets = []
    for _ in range(cnt):
        seed, x = next_int(seed)
        bets.append(jabs(jmod(x, 50)))
    wons = []
    for _ in range(cnt):
        seed, x = next_int(seed)
        wons.append((jabs(x) & 1) == 0)
    return seed, win, cnt, ips, bets, wons

def parse_money(text):
    m = re.search(r'You have:\s*([0-9]+)\s*dollars', text)
    return int(m.group(1)) if m else None

def parse_round(text):
    c = re.search(r'The color was (red|black|green)!', text)
    color = c.group(1) if c else None
    entries = re.findall(
        r'xxx\.xxx\.(\d+)\.(\d+)\s+(Won|Lost)!\s+This player betted\s+(\d+)\s+dollars!',
        text
    )
    ips = [((int(a) << 8) | int(b)) for a, b, _, _ in entries]
    wons = [w == "Won" for _, _, w, _ in entries]
    bets = [int(v) for _, _, _, v in entries]
    return color, ips, bets, wons

def recover_seed(round_color, ips, bets, wons):
    n = len(ips)
    s = Solver()
    seed0 = BitVec("seed0", 48)
    cur = seed0

    cur = (cur * MULT + ADD) & MASK
    out = LShR(cur, 16)
    if round_color == "green":
        s.add((out & 15) == 0)
    elif round_color == "red":
        s.add((out & 15) >= 1, (out & 15) <= 7)
    else:
        s.add((out & 15) >= 8, (out & 15) <= 15)

    cur = (cur * MULT + ADD) & MASK
    out = LShR(cur, 16)
    abs_out = If(LShR(out, 31) == 1, BitVecVal(0, 32) - out, out)
    s.add((abs_out % 10) + 1 == n)

    for ip in ips:
        cur = (cur * MULT + ADD) & MASK
        out = LShR(cur, 16)
        s.add((out & 0xffff) == ip)

    for bet in bets:
        cur = (cur * MULT + ADD) & MASK
        out = LShR(cur, 16)
        signed = out
        mod_candidates = []
        for k in range(-50, 51):
            if abs(k) == bet:
                mod_candidates.append(signed == signed / 50 * 50 + k)
        s.add(If(BitVecVal(1, 1) == BitVecVal(1, 1), True, True))

    # Simpler concrete filtering from model candidates using only color/count/ips
    if s.check() != sat:
        return None
    seed = s.model()[seed0].as_long()

    # refine concretely until full round matches
    for delta in range(1 << 16):
        cand = (seed + delta) & MASK
        _, _, cnt, c_ips, c_bets, c_wons = gen_round(cand)
        if cnt == n and c_ips == ips and c_bets == bets and c_wons == wons:
            return cand
    return None

def main():
    io = remote("rev.chal.csaw.io", 4200)
    text = io.recvuntil(b'> ').decode(errors="ignore")
    money = parse_money(text)

    io.sendline(b"1")
    io.recvuntil(b'> ')
    io.sendline(b"red")
    text = io.recvuntil(b'> ').decode(errors="ignore")

    color, ips, bets, wons = parse_round(text)
    money = parse_money(text)
    seed0 = recover_seed(color, ips, bets, wons)
    if seed0 is None:
        print(text)
        print("recover failed")
        return

    end_seed, _, _, _, _, _ = gen_round(seed0)
    last_ip = ips[-1]

    for _ in range(30):
        end_seed, x = next_int(end_seed)
        reseed = last_ip + money + (x & 0xffff)
        round_seed = (reseed ^ MULT) & MASK
        end2, win, cnt, p_ips, p_bets, p_wons = gen_round(round_seed)

        clr = color_of(win)
        bet = money if clr == "green" else 1
        if bet < 1:
            bet = 1

        io.sendline(str(bet).encode())
        io.recvuntil(b'> ')
        io.sendline(clr.encode())
        text = io.recvuntil(b'> ', timeout=5).decode(errors="ignore")
        if "flag{" in text.lower():
            print(text)
            return

        nm = parse_money(text)
        if nm is None:
            print(text)
            return

        color, ips, bets, wons = parse_round(text)
        money = nm
        last_ip = ips[-1]
        seed0 = recover_seed(color, ips, bets, wons)
        if seed0 is None:
            print(text)
            print("desync")
            return
        end_seed, _, _, _, _, _ = gen_round(seed0)

    print("done without flag")

if __name__ == "__main__":
    main()
end_of_edit

