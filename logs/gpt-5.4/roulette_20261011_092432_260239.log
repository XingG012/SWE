or_of(n):\n    if n == 0:\n        return \"green\"\n    if n <= 7:\n        return \"red\"\n    return \"black\"\n\ndef gen_round_py(seed):\n    seed, x = next_int_py(seed)\n    win_num = x & 15\n    seed, x = next_int_py(seed)\n    cnt = 1 + (java_abs(x) % 10)\n    ips = []\n    for _ in range(cnt):\n        seed, x = next_int_py(seed)\n        ips.append(x & 0xffff)\n    bets = []\n    for _ in range(cnt):\n        seed, x = next_int_py(seed)\n        bets.append(java_abs(java_mod(x, 50)))\n    wons = []\n    for _ in range(cnt):\n        seed, x = next_int_py(seed)\n        wons.append((java_abs(x) & 1) == 0)\n    return seed, win_num, cnt, ips, bets, wons\n\ndef parse_money(text):\n    m = re.search(r'You have:\\s*([0-9]+)\\s*dollars', text)\n    return int(m.group(1)) if m else None\n\ndef parse_round(text):\n    color_m = re.search(r'The color was (red|black|green)!', text)\n    round_color = color_m.group(1) if color_m else None\n    won_game = \"! You won\" in text\n    entries = re.findall(\n        r'xxx\\.xxx\\.(\\d+)\\.(\\d+)\\s+(Won|Lost)!\\s+This player betted\\s+(\\d+)\\s+dollars!',\n        text\n    )\n    ips = [((int(a) << 8) | int(b)) for a, b, _, _ in entries]\n    wons = [w == \"Won\" for _, _, w, _ in entries]\n    bets = [int(v) for _, _, _, v in entries]\n    return round_color, won_game, ips, bets, wons\n\ndef build_abs32(x):\n    sign = LShR(x, 31)\n    neg = BitVecVal(0, 32) - x\n    return (sign == 1, neg)\n\ndef recover_seed(round_color, ips, bets, wons):\n    n = len(ips)\n    s = Solver()\n\n    seed = BitVec('seed0', 48)\n    cur = seed\n\n    # nextInt for winning number\n    cur = (cur * MULT + ADD) & MASK\n    out1 = LShR(cur, 16)\n\n    color_id = {\"green\": 0, \"red\": 1, \"black\": 2}[round_color]\n    if round_color == \"green\":\n        s.add((out1 & 15) == 0)\n    elif round_color == \"red\":\n        s.add((out1 & 15) >= 1, (out1 & 15) <= 7)\n    else:\n        s.add((out1 & 15) >= 8, (out1 & 15) <= 15)\n\n    # nextInt for gambler count\n    cur = (cur * MULT + ADD) & MASK\n    out2 = LShR(cur, 16)\n    out2_32 = out2\n    sign2 = LShR(out2_32, 31)\n    abs2 = sign2 * ((BitVecVal(0, 32) - out2_32) & 0xffffffff) + (BitVecVal(1, 32) - sign2) * out2_32\n    s.add((abs2 % 10) + 1 == n)\n\n    # IPs\n    for ip in ips:\n        cur = (cur * MULT + ADD) & MASK\n        out = LShR(cur, 16)\n        s.add((out & 0xffff) == ip)\n\n    # Bets\n    for b in bets:\n        cur = (cur * MULT + ADD) & MASK\n        out = LShR(cur, 16)\n        signed = out\n        modv = signed % 50\n        negmod = (BitVecVal(0, 32) - modv) & 0xffffffff\n        absmod = If(LShR(modv, 31) == 1, negmod, modv)\n        s.add(absmod == b)\n\n    # Wins\n    for w in wons:\n        cur = (cur * MULT + ADD) & MASK\n        out = LShR(cur, 16)\n        absout = If(LShR(out, 31) == 1, (BitVecVal(0, 32) - out) & 0xffffffff, out)\n        if w:\n            s.add((absout & 1) == 0)\n        else:\n            s.add((absout & 1) == 1)\n\n    if s.check() != sat:\n        return None\n    m = s.model()\n    return m[seed].as_long()\n\ndef main():\n    io = remote(\"rev.chal.csaw.io\", 4200)\n    text = io.recvuntil(b'> ').decode(errors=\"ignore\")\n    money = parse_money(text)\n\n    io.sendline(b\"1\")\n    io.recvuntil(b'> ')\n    io.sendline(b\"red\")\n    text = io.recvuntil(b'> ').decode(errors=\"ignore\")\n\n    round_color, won_game, ips, bets, wons = parse_round(text)\n    money = parse_money(text)\n    seed0 = recover_seed(round_color, ips, bets, wons)\n    if seed0 is None:\n        print(text)\n        print(\"seed recovery failed\")\n        return\n\n    end_seed, _, _, _, _, _ = gen_round_py(seed0)\n    last_ip = ips[-1]\n\n    while True:\n        end_seed, x = next_int_py(end_seed)\n        reseed = last_ip + money + (x & 0xffff)\n        round_seed = (reseed ^ MULT) & MASK\n\n        predicted_end, win_num, cnt, p_ips, p_bets, p_wons = gen_round_py(round_seed)\n        clr = color_of(win_num)\n       