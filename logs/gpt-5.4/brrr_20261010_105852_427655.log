    ["gdb", "-q", "./brrr", "-batch"] + sum([["-ex", c] for c in cmds], []),
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT,
    text=True,
)

lines = proc.stdout.splitlines()
vals = []
for line in lines:
    m = re.search(r'^\$\d+\s+=\s+(-?\d+)$', line.strip())
    if m:
        vals.append(int(m.group(1)))

if not vals:
    print(proc.stdout)
    raise SystemExit("no gdb values parsed")

pc = vals[0]
results = vals[1:]

out = bytearray()
i = 0
for _ in PTRS:
    found = None
    for b in range(256):
        if results[i] != 0:
            found = b
            i += 1
            break
        i += 1
    if found is None:
        raise SystemExit("no match")
    out.append(found)

print(out.decode("latin1"))
print(out.hex())
end_of_edit

