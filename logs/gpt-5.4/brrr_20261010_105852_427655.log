import ctypes
import os

PTRS = [
    0x5dd18e0, 0x5dd1c20, 0x5dd1ee0, 0x5dd1ae0, 0x5dd18e0, 0x5dd2060,
    0x5dd1de0, 0x5dd1f60, 0x5dd19e0, 0x5dd1820, 0x5dd15e0, 0x5dd1ca0,
    0x5dd1860, 0x5dd2060, 0x5dd12e0, 0x5dd1f20, 0x5dd15a0, 0x5dd1820,
    0x5dd1fa0, 0x5dd1ee0, 0x5dd19e0, 0x5dd1360, 0x5dd13e0, 0x5dd2020,
    0x5dd15a0, 0x5dd1fe0, 0x5dd21e0, 0x5dd1fa0, 0x5dd15a0, 0x5dd2020,
    0x5dd15e0, 0x5dd1ca0, 0x5dd1960, 0x5dd1b60, 0x5dd12e0, 0x5dd1da0,
    0x5dd15a0, 0x5dd1420, 0x5dd19e0, 0x5dd20e0, 0x5dd1a60, 0x5dd16a0,
    0x5dd1ca0, 0x5dd1220,
]

lib = ctypes.CDLL(os.path.abspath("./brrr"))

base = None
with open("/proc/self/maps", "r") as f:
    for line in f:
        if "/brrr" in line and "r-xp" in line:
            start = int(line.split("-")[0], 16)
            base = start - 0x77000
            break

if base is None:
    raise SystemExit("failed to find base")

FUNC = base + 0x47db80
check = ctypes.CFUNCTYPE(ctypes.c_int, ctypes.c_ubyte, ctypes.c_void_p)(FUNC)

out = bytearray()
for ptr in PTRS:
    addr = base + ptr
    found = None
    for b in range(256):
        if check(b, addr):
            found = b
            break
    if found is None:
        raise SystemExit(f"no match for {ptr:#x}")
    out.append(found)

print(out.decode("latin1"))
print(out.hex())
