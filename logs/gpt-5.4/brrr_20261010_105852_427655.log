edit 8:19
with open("brrr", "rb") as f:
    elf = ELFFile(f)
    segments = []
    for seg in elf.iter_segments():
        if seg["p_type"] == "PT_LOAD":
            segments.append((seg["p_vaddr"], seg["p_offset"], seg["p_filesz"]))

    def read_va(va, n):
        for vaddr, off, filesz in segments:
            if vaddr <= va and va + n <= vaddr + filesz:
                f.seek(off + (va - vaddr))
                return f.read(n)
        raise ValueError(f"unmapped va {va:#x}")

    ptrs = [struct.unpack("<Q", read_va(PTR_TABLE + 8*i, 8))[0] for i in range(COUNT)]
    targets = [read_va(p, 64) for p in ptrs]
end_of_edit
