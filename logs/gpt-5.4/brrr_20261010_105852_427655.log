import subprocess
import re

PTRS = [
    0x5dd18e0, 0x5dd1c20, 0x5dd1ee0, 0x5dd1ae0, 0x5dd18e0, 0x5dd2060,
    0x5dd1de0, 0x5dd1f60, 0x5dd19e0, 0x5dd1820, 0x5dd15e0, 0x5dd1ca0,
    0x5dd1860, 0x5dd2060, 0x5dd12e0, 0x5dd1f20, 0x5dd15a0, 0x5dd1820,
    0x5dd1fa0, 0x5dd1ee0, 0x5dd19e0, 0x5dd1360, 0x5dd13e0, 0x5dd2020,
    0x5dd15a0, 0x5dd1fe0, 0x5dd21e0, 0x5dd1fa0, 0x5dd15a0, 0x5dd2020,
    0x5dd15e0, 0x5dd1ca0, 0x5dd1960, 0x5dd1b60, 0x5dd12e0, 0x5dd1da0,
    0x5dd15a0, 0x5dd1420, 0x5dd19e0, 0x5dd20e0, 0x5dd1a60, 0x5dd16a0,
    0x5dd1ca0, 0x5dd1220,
]

cmds = [
    "set pagination off",
    "b *main",
    "run",
    "p/x $pc",
]

for ptr in PTRS:
    for b in range(256):
        cmds.append(f"p/d ((int(*)())($pc-0x780+0x5b80))({b}, $pc-0x780+{ptr:#x})")

cmds.append("quit")

proc = subprocess.run(
    ["gdb", "-q", "./brrr", "-batch"] + sum([["-ex", c] for c in cmds], []),
    stdout=subprocess.PIPE,
    stderr=subprocess.STDOUT,
    text=True,
)

lines = proc.stdout.splitlines()
vals = []
for line in lines:
    m = re.search(r'^\$\d+\s+=\s+(-?\d+)$', line.strip())
    if m:
        vals.append(int(m.group(1)))

if not vals:
    print(proc.stdout)
    raise SystemExit("no gdb values parsed")

pc = vals[0]
results = vals[1:]

out = bytearray()
i = 0
for _ in PTRS:
    found = None
    for b in range(256):
        if results[i] != 0:
            found = b
            i += 1
            break
        i += 1
    if found is None:
        raise SystemExit("no match")
    out.append(found)

print(out.decode("latin1"))
print(out.hex())
end_of_edit

