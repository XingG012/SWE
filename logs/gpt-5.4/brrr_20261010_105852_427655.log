from elftools.elf.elffile import ELFFile
import hashlib
import struct

PTR_TABLE = 0x5CA780
COUNT = 44

with open("brrr", "rb") as f:
    elf = ELFFile(f)
    data = elf.get_section_by_name(".data")
    base = data["sh_addr"]
    blob = data.data()

    def read_va(va, n):
        off = va - base
        return blob[off:off+n]

    ptrs = [struct.unpack("<Q", read_va(PTR_TABLE + 8*i, 8))[0] for i in range(COUNT)]
    targets = [read_va(p, 64) for p in ptrs]

lookup = {}
for i in range(256):
    d = hashlib.sha512(str(i).encode()).digest()
    lookup[d] = i

ans = bytearray()
for t in targets:
    if t not in lookup:
        raise SystemExit("unmatched digest")
    ans.append(lookup[t])

print(ans.decode())
print(ans.hex())
end_of_edit
