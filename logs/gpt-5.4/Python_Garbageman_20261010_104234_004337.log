import ast
from chall import BANNED

samples = [
    "raise Exception",
    "assert all(x for x in y)",
    "while a:break",
    "del a",
    "a(b)",
    "a|b",
    "a+b",
    "a==b",
    "a is b",
    "x for x in y",
]

for s in samples:
    try:
        t = ast.parse(s)
        bad = sorted({type(n).__name__ for n in ast.walk(t) if type(n) in BANNED})
        print("SRC:", s)
        print("BAD:", bad)
        print("NODES:", sorted({type(n).__name__ for n in ast.walk(t)}))
    except Exception as e:
        print("ERR:", s, e)
    print("---")
end_of_edit
