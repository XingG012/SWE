import ast

BANNED = {
    ast.Import, ast.ImportFrom, ast.With, ast.alias, ast.Attribute, ast.Constant,
    ast.Subscript, ast.Assign, ast.AnnAssign, ast.AugAssign, ast.For, ast.Try,
    ast.ExceptHandler, ast.withitem, ast.FunctionDef, ast.Lambda, ast.ClassDef,
    ast.If, ast.And, ast.comprehension, ast.In, ast.Await, ast.Global, ast.Gt,
    ast.ListComp, ast.Slice, ast.Return, ast.List, ast.Dict, ast.Lt,
    ast.AsyncFunctionDef, ast.Eq, ast.keyword, ast.Mult, ast.arguments,
    ast.FormattedValue, ast.Not, ast.BoolOp, ast.Or, ast.Compare, ast.GtE,
    ast.Tuple, ast.NotEq, ast.IfExp, ast.alias, ast.UnaryOp, ast.arg,
    ast.JoinedStr,
}

samples = [
    "raise Exception",
    "assert a",
    "while a:break",
    "del a",
    "a(b)",
    "a|b",
    "a+b",
    "a-b",
    "a/b",
    "a%b",
    "a<<b",
    "a^b",
    "a is b",
    "a[b]",
    "{a}",
    "(a)",
    "yield a",
]

for s in samples:
    try:
        t = ast.parse(s)
        bad = sorted({type(n).__name__ for n in ast.walk(t) if type(n) in BANNED})
        print("SRC:", s)
        print("BAD:", bad)
        print("NODES:", sorted({type(n).__name__ for n in ast.walk(t)}))
    except Exception as e:
        print("ERR:", s, e)
    print("---")
end_of_edit
