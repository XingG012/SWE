from collections import namedtuple

Point = namedtuple("Point", "x y")
O = "Origin"

curve = {
    "p": 2**256 - 2**32 - 977,
    "a": 0,
    "b": 7,
    "n": 0xfffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141,
}

def check_point(P):
    p, a, b = curve["p"], curve["a"], curve["b"]
    if P == O:
        return True
    return (P.y * P.y - (P.x * P.x * P.x + a * P.x + b)) % p == 0 and 0 <= P.x < p and 0 <= P.y < p

def point_inverse(P):
    if P == O:
        return P
    return Point(P.x, (-P.y) % curve["p"])

def point_addition(P, Q):
    p, a = curve["p"], curve["a"]
    if P == O:
        return Q
    elif Q == O:
        return P
    elif Q == point_inverse(P):
        return O
    else:
        if P == Q:
            lam = (3 * P.x * P.x + a) * pow(2 * P.y, -1, p)
            lam %= p
        else:
            lam = (Q.y - P.y) * pow(Q.x - P.x, -1, p)
            lam %= p
    Rx = (lam * lam - P.x - Q.x) % p
    Ry = (lam * (P.x - Rx) - P.y) % p
    return Point(Rx, Ry)

def mul(P, n):
    Q = P
    R = O
    while n > 0:
        if n & 1:
            R = point_addition(R, Q)
        Q = point_addition(Q, Q)
        n >>= 1
    return R

def sqrt_mod(v, p):
    return pow(v, (p + 1) // 4, p)

p = curve["p"]
for x in range(100):
    rhs = (x * x * x + 7) % p
    y = sqrt_mod(rhs, p)
    if (y * y) % p != rhs:
        continue
    P = Point(x, y)
    print("P =", P)
    for k in range(1, 16):
        try:
            print(k, mul(P, k))
        except Exception as e:
            print("ERR at", k, type(e).__name__, e)
            break
    print("---")
end_of_edit

