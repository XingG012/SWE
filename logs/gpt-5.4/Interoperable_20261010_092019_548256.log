from math import prod
from sympy import factorint

# curve params from chal.py
p256_p = 2**256 - 2**224 + 2**192 + 2**96 - 1
p256_n = 0xffffffff00000000ffffffffffffffffbce6faada7179e84f3b9cac2fc632551

s256_p = 2**256 - 2**32 - 977
s256_n = 0xfffffffffffffffffffffffffffffffebaaedce6af48a03bbfd25e8cd0364141

def analyze(name, p, n):
    t = p + 1 - n
    twist = p + 1 + t
    print(name)
    print("n factors:", factorint(int(n)))
    print("twist factors:", factorint(int(twist)))
    print("trace:", t)
    print()

analyze("p256", p256_p, p256_n)
analyze("s256", s256_p, s256_n)

from pwn import remote
r = remote("crypto.chal.csaw.io", 5000)
print(r.recvline(timeout=2).decode(errors="ignore"))
r.sendline(b'{"curve":"curve_s256"}')
print(r.recvline(timeout=2).decode(errors="ignore"))
print(r.recvline(timeout=2).decode(errors="ignore"))
end_of_edit

