import sympy as sp

def roots_mod(poly_coeffs, p):
    x = sp.symbols('x')
    poly = sum(c * x**i for i, c in enumerate(poly_coeffs))
    return sp.Poly(poly, x, modulus=p).ground_roots()

p1 = 2**256 - 2**224 + 2**192 + 2**96 - 1
a1 = -3
b1 = 0x5ac635d8aa3a93e7b3ebbd55769886bc651d06b0cc53b0f63bce3c3e27d2604b

p2 = 2**256 - 2**32 - 977
a2 = 0
b2 = 7

print("p256 roots:", roots_mod([b1, a1, 0, 1], p1))
print("s256 roots:", roots_mod([b2, a2, 0, 1], p2))
end_of_edit

