from itertools import permutations

s = 'wxqvn$Zae${deyZv$d"i'

def decode_char(c, perm, reverse_chunks=False):
    b = ord(c)
    chunks = [(b >> (2 * i)) & 0b11 for i in range(4)]
    if reverse_chunks:
        chunks = chunks[::-1]
    mapped = [perm[x] for x in chunks]
    if reverse_chunks:
        mapped = mapped[::-1]
    out = 0
    for i, v in enumerate(mapped):
        out |= (v & 0b11) << (2 * i)
    return chr(out)

for perm in permutations(range(4)):
    for rev in [False, True]:
        t = ''.join(decode_char(c, perm, rev) for c in s)
        if 'flag{' in t:
            print("perm=", perm, "rev=", rev, "text=", t)
