from pwn import *

HOST = "crypto.chal.csaw.io"
PORT = 1337
SEED = b"0000000000000000"

r = remote(HOST, PORT)
r.recvuntil(b"Send me a random seed\n")
r.send(SEED)
r.recvuntil(b"Encrypted flag:\n")
data = r.recvn(4900)
tail = r.recvuntil(b"Okay bye\n")
r.close()

print("len(data) =", len(data))
recs = []
ok = True
for i in range(100):
    chunk = data[i*49:(i+1)*49]
    ct, nl = chunk[:48], chunk[48:]
    if nl != b"\n":
        ok = False
    recs.append(ct)
print("record_structure_ok =", ok)
print("tail =", tail.decode(errors="replace").strip())

p0 = b"Encrypted Flag: "
for i in range(5):
    ks0 = bytes([recs[i][j] ^ p0[j] for j in range(16)])
    print(i, recs[i].hex(), ks0.hex())
end_of_edit
```

