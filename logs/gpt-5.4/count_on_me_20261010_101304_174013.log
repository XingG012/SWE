DISCUSSION
I’ll write a script that queries several seeds, counts total bytes, number of newline-separated chunks, and how many exact 48-byte chunks appear. If the service leaks structure through raw newlines inside ciphertext, that may allow recovering plaintext bytes statistically or with a chosen-seed strategy.
COMMAND
edit 1:1
from pwn import *

HOST = "crypto.chal.csaw.io"
PORT = 1337

def run(seed):
    r = remote(HOST, PORT)
    r.recvuntil(b"Send me a random seed\n")
    r.send(seed)
    r.recvuntil(b"Encrypted flag:\n")
    data = r.recvuntil(b"Okay bye\n", drop=True)
    r.close()
    parts = data.split(b"\n")
    exact48 = sum(1 for x in parts if len(x) == 48)
    return len(data), len(parts), exact48

seeds = [f"{i:016d}".encode() for i in range(10)]
for s in seeds:
    try:
        a, b, c = run(s)
        print(s.decode(), "bytes", a, "parts", b, "exact48", c)
    except Exception as e:
        print(s.decode(), "ERR", repr(e))
end_of_edit

