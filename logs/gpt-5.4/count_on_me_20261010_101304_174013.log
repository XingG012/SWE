from pwn import *
from collections import Counter

HOST = "crypto.chal.csaw.io"
PORT = 1337
SEED = b"0000000000000000"

r = remote(HOST, PORT)
r.recvuntil(b"Send me a random seed\n")
r.send(SEED)
r.recvuntil(b"Encrypted flag:\n")
data = r.recvuntil(b"Okay bye\n", drop=True)
r.close()

lines = [x for x in data.split(b"\n") if x]
print("num_lines =", len(lines))
for i, line in enumerate(lines[:5]):
    print("line", i, "len", len(line), "hex", line.hex())

if lines:
    nblocks = len(lines[0]) // 16
    print("blocks_per_line =", nblocks)
    for b in range(nblocks):
        ctr = Counter(line[b*16:(b+1)*16] for line in lines)
        dup = [v for v in ctr.values() if v > 1]
        print("block", b, "unique", len(ctr), "maxfreq", max(ctr.values()), "dups", sorted(dup, reverse=True)[:10])
end_of_edit

