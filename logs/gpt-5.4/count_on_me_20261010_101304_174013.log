edit 1:1
import random
from collections import Counter

def stats(seed):
    random.seed(seed)
    outs = [random.getrandbits(32) for _ in range(300)]
    res = []
    for b in range(3):
        seq = outs[b::3][:100]
        ctr = Counter(seq)
        res.append((len(ctr), max(ctr.values())))
    return res

best = []
for seed in range(20000):
    s = stats(seed)
    score = tuple(x[1] for x in s)
    best.append((score, seed, s))

best.sort(reverse=True)
for item in best[:20]:
    print(item)
end_of_edit

